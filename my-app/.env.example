# Configuración de Flask-Mail para recuperación de contraseña
# Para Gmail: https://myaccount.google.com/apppasswords

# Tu correo Gmail
MAIL_USERNAME=tu-correo@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña personal)
# Genera una en: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=tu-contraseña-de-aplicación

# Base de datos principal
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=balto04*
DB_NAME=invilara

# Base de datos de seguridad (usuarios y login)
DB_NAME_SEGURIDAD=invilara_seguridad
DB_AUTH_PLUGIN=mysql_native_password