# Configuración de Flask-Mail para recuperación de contraseña
# Para Gmail: https://myaccount.google.com/apppasswords

# Tu correo Gmail
MAIL_USERNAME=tu-correo@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña personal)
# Genera una en: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=tu-contraseña-de-aplicación

# Secretos de la aplicación (generar valores propios; nunca reutilizar valores expuestos)
FLASK_SECRET_KEY=
RECAPTCHA_SECRET_KEY=

# Activar solo cuando la aplicación se publique detrás de HTTPS
SESSION_COOKIE_SECURE=false

# Base de datos principal
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=invilara
DB_PORT=3306
DB_CONNECT_TIMEOUT=5

# Base de datos de seguridad (usuarios y login)
DB_NAME_SEGURIDAD=invilara_seguridad
# Dejar vacío para que el conector negocie el plugin con el servidor.
# MySQL 8.4/9.x usa caching_sha2_password; forzar mysql_native_password
# provoca "Access denied ... (using password: YES)" al usar contraseña.
DB_AUTH_PLUGIN=