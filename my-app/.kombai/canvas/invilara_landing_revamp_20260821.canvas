nt: ''; position: absolute; left: 0; right: 0; height: 17px; z-index: 1; background: repeating-linear-gradient(90deg, rgba(255,255,255,.12) 0 8px, transparent 8px 20px); opacity: .48; }\n.inv-page .inv-film::before { top: 0; }\n.inv-page .inv-film::after { bottom: 0; }\n.inv-page .inv-film-inner { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(0, 1.5fr); gap: 62px; align-items: center; padding: 104px 0; }\n.inv-page .inv-film-copy h2 { margin: 10px 0 18px; font-family: 'Atkinson Hyperlegible', sans-serif; font-size: clamp(2.3rem, 4vw, 4.5rem); line-height: .98; letter-spacing: -.045em; color: #fff; }\n.inv-page .inv-film-copy p { max-width: 360px; margin: 0; color: rgba(255,255,255,.7); }\n.inv-page .inv-film-frame { position: relative; padding: 12px; border: 1px solid rgba(255,255,255,.26); background: rgba(255,255,255,.05); }\n.inv-page .inv-film-frame video { display: block; width: 100%; max-height: 480px; object-fit: cover; aspect-ratio: 16 / 9; background: #07110b; }\n.inv-page .inv-film-caption { display: flex; justify-content: space-between; gap: 14px; margin-top: 12px; color: rgba(255,255,255,.58); font-size: .72rem; }\n\n.inv-page .inv-ledger { display: grid; grid-template-columns: minmax(235px, .62fr) minmax(0, 1.38fr); gap: 60px; align-items: start; }\n.inv-page .inv-ledger-intro { position: sticky; top: 110px; }\n.inv-page .inv-ledger-intro h2 { margin: 12px 0 16px; font-family: 'Atkinson Hyperlegible', sans-serif; font-size: clamp(2.1rem, 3.6vw, 3.7rem); line-height: 1; letter-spacing: -.04em; }\n.inv-page .inv-ledger-intro p { color: var(--inv-muted); }\n.inv-page .inv-ledger-list { border-top: 1px solid var(--inv-line); }\n.inv-page .inv-ledger-row { display: grid; grid-template-columns: 52px minmax(145px, .6fr) minmax(0, 1.25fr) 44px; gap: 20px; align-items: center; min-height: 126px; padding: 20px 0; border-bottom: 1px solid var(--inv-line); cursor: pointer; }\n.inv-page .inv-ledger-row:hover, .inv-page .inv-ledger-row.is-active {