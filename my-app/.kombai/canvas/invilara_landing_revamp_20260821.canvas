</button>\n                <button aria-controls=\"inv-drawer\" aria-expanded=\"false\" aria-label=\"Abrir menú móvil\" class=\"inv-menu-button\" data-drawer-open=\"\" data-kid=\"1-3-1-3-3\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bx bx-menu\" data-kid=\"1-3-1-3-3-1\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <div aria-hidden=\"true\" class=\"inv-drawer-backdrop\" data-drawer-backdrop=\"\" data-kid=\"1-4\">\n    </div>\n    <aside aria-hidden=\"true\" aria-label=\"Menú móvil\" class=\"inv-drawer\" data-kid=\"1-5\" id=\"inv-drawer\">\n        <div class=\"inv-drawer-head\" data-kid=\"1-5-1\">\n            <strong data-kid=\"1-5-1-1\">\n                Menú\n            </strong>\n            <button aria-label=\"Cerrar menú\" class=\"inv-drawer-close\" data-drawer-close=\"\" data-kid=\"1-5-1-2\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-x\" data-kid=\"1-5-1-2-1\">\n                </i>\n            </button>\n        </div>\n        <div class=\"inv-drawer-body\" data-kid=\"1-5-2\">\n            <a class=\"inv-drawer-link\" data-kid=\"1-5-2-1\" href=\"#inicio\">\n                Inicio\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-right\" data-kid=\"1-5-2-1-1\">\n                </i>\n            </a>\n            <a class=\"inv-drawer-link\" data-kid=\"1-5-2-2\" href=\"#acerca\">\n                Institución\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-right\" data-kid=\"1-5-2-2-1\">\n                </i>\n            </a>\n            <a class=\"inv-drawer-link\" data-kid=\"1-5-2-3\" href=\"#servicios\">\n                Capacidades\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-right\" data-kid=\"1-5-2-3-1\">\n                </i>\n            </a>\n            <a class=\"inv-drawer-link\" data-kid=\"1-5-2-4\" href=\"#contacto\">\n                Contacto\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-right\" data-kid=\"1-5-2-4-1\">\n                </i>\n            </a>\n            <div class=\"inv-drawer-tools\" data-kid=\"1-5-2-5\">\n                <button aria-label=\"Activar modo oscuro\" class=\"inv-drawer-theme\" data-kid=\"1-5-2-5-1\" data-theme-toggle=\"\" type=\"button\">\n                    <span data-kid=\"1-5-2-5-1-1\">\n                        <i aria-hidden=\"true\" class=\"bx bx-moon\" data-kid=\"1-5-2-5-1-1-1\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-5-2-5-1-1-2\" data-name=\"theme mode label\" data-reason=\"text toggled between 'Modo claro' and 'Modo oscuro' by script\" data-theme-label=\"\">\n                            Modo oscuro\n                        </span>\n                    </span>\n                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-5-2-5-1-2\">\n                    </i>\n                </button>\n                <a class=\"inv-button is-gold\" data-kid=\"1-5-2-5-2\" href=\"#acceso\">\n                    Entrar al sistema\n                    <i aria-hidden=\"true\" class=\"bx bx-log-in-circle\" data-kid=\"1-5-2-5-2-1\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </aside>\n    <main data-kid=\"1-6\" id=\"contenido\">\n        <section aria-labelledby=\"hero-title\" class=\"inv-hero\" data-kid=\"1-6-1\" data-section=\"\" id=\"inicio\">\n            <div aria-hidden=\"true\" class=\"inv-hero-rail\" data-kid=\"1-6-1-1\">\n                <span class=\"inv-rail-number\" data-kid=\"1-6-1-1-1\">\n                    LARA · 01 / 05\n                </span>\n                <span class=\"inv-rail-line\" data-kid=\"1-6-1-1-2\">\n                </span>\n                <span class=\"inv-rail-links\" data-kid=\"1-6-1-1-3\">\n                    <a data-kid=\"1-6-1-1-3-1\" href=\"#acerca\" title=\"Ir a institución\">\n                        <i class=\"bx bx-down-arrow-alt\" data-kid=\"1-6-1-1-3-1-1\">\n                        </i>\n                    </a>\n                    <a data-kid=\"1-6-1-1-3-2\" href=\"#contacto\" title=\"Ir a contacto\">\n                        <i class=\"bx bx-phone\" data-kid=\"1-6-1-1-3-2-1\">\n                        </i>\n                    </a>\n                </span>\n            </div>\n            <div class=\"inv-hero-copy inv-reveal\" data-kid=\"1-6-1-2\">\n                <span class=\"inv-label\" data-kid=\"1-6-1-2-1\">\n                    Instituto de Vialidad del Estado Lara\n                </span>\n                <h1 data-kid=\"1-6-1-2-2\" id=\"hero-title\">\n                    Vialidad que\n                    <em data-kid=\"1-6-1-2-2-1\">\n                        conecta\n                    </em>\n                    a Lara.\n                </h1>\n                <p data-kid=\"1-6-1-2-3\">\n                    Planificamos, construimos y conservamos la infraestructura vial que une municipios, parroquias y comunidades con trabajo técnico y presencia en el territorio.\n                </p>\n                <div class=\"inv-hero-ctas\" data-kid=\"1-6-1-2-4\">\n                    <a class=\"inv-button is-gold\" data-kid=\"1-6-1-2-4-1\" href=\"#acceso\">\n                        Acceder al sistema\n                        <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-1-2-4-1-1\">\n                        </i>\n                    </a>\n                    <a class=\"inv-button is-quiet\" data-kid=\"1-6-1-2-4-2\" href=\"#acerca\">\n                        Conocer cómo trabajamos\n                        <i aria-hidden=\"true\" class=\"bx bx-down-arrow-alt\" data-kid=\"1-6-1-2-4-2-1\">\n                        </i>\n                    </a>\n                </div>\n                <div aria-label=\"Áreas de trabajo de Invilara\" class=\"inv-proofline\" data-kid=\"1-6-1-2-5\">\n                    <span data-kid=\"1-6-1-2-5-1\">\n                        <i aria-hidden=\"true\" class=\"bx bx-check-shield\" data-kid=\"1-6-1-2-5-1-1\">\n                        </i>\n                        Trabajo en campo\n                    </span>\n                    <span data-kid=\"1-6-1-2-5-2\">\n                        <i aria-hidden=\"true\" class=\"bx bx-git-branch\" data-kid=\"1-6-1-2-5-2-1\">\n                        </i>\n                        Gestión conectada\n                    </span>\n                    <span data-kid=\"1-6-1-2-5-3\">\n                        <i aria-hidden=\"true\" class=\"bx bx-map-alt\" data-kid=\"1-6-1-2-5-3-1\">\n                        </i>\n                        Presencia territorial\n                    </span>\n                </div>\n            </div>\n            <figure class=\"inv-hero-media inv-reveal\" data-kid=\"1-6-1-3\">\n                <img alt=\"Sede del Instituto de Vialidad del Estado Lara\" data-kid=\"1-6-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/invilara_entrada.jpeg\"/>\n                <figcaption class=\"inv-media-caption\" data-kid=\"1-6-1-3-2\">\n                    <strong data-kid=\"1-6-1-3-2-1\">\n                        Una institución al servicio de la vía pública.\n                    </strong>\n                    <small data-kid=\"1-6-1-3-2-2\">\n                        Barquisimeto, Estado Lara\n                        <br data-kid=\"1-6-1-3-2-2-1\"/>\n                        Gestión vial con propósito.\n                    </small>\n                </figcaption>\n            </figure>\n        </section>\n        <section aria-labelledby=\"acerca-title\" class=\"inv-section\" data-kid=\"1-6-2\" data-section=\"\" id=\"acerca\">\n            <div class=\"inv-shell\" data-kid=\"1-6-2-1\">\n                <div class=\"inv-section-heading inv-reveal\" data-kid=\"1-6-2-1-1\">\n                    <div data-kid=\"1-6-2-1-1-1\">\n                        <span class=\"inv-label\" data-kid=\"1-6-2-1-1-1-1\">\n                            01 — La institución\n                        </span>\n                        <div aria-hidden=\"true\" class=\"inv-rule\" data-kid=\"1-6-2-1-1-1-2\">\n                        </div>\n                    </div>\n                    <div data-kid=\"1-6-2-1-1-2\">\n                        <h2 data-kid=\"1-6-2-1-1-2-1\" id=\"acerca-title\">\n                            El trabajo se mide en el territorio.\n                        </h2>\n                        <p data-kid=\"1-6-2-1-1-2-2\">\n                            Invilara articula las necesidades de la ciudadanía con la planificación, la inspección y la ejecución de obras que hacen más segura y accesible la movilidad en Lara.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"inv-impact-grid\" data-kid=\"1-6-2-1-2\">\n                    <div class=\"inv-impact-visual inv-reveal\" data-kid=\"1-6-2-1-2-1\">\n                        <figure class=\"inv-impact-main\" data-kid=\"1-6-2-1-2-1-1\">\n                            <img alt=\"Personal trabajando en una intervención vial\" data-kid=\"1-6-2-1-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                            <figcaption class=\"inv-image-note\" data-kid=\"1-6-2-1-2-1-1-2\">\n                                Obras y mantenimiento vial\n                            </figcaption>\n                        </figure>\n                        <figure class=\"inv-impact-side\" data-kid=\"1-6-2-1-2-1-2\">\n                            <img alt=\"Equipo realizando una inspección en campo\" data-kid=\"1-6-2-1-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/2.jpeg\"/>\n                            <figcaption class=\"inv-image-note\" data-kid=\"1-6-2-1-2-1-2-2\">\n                                Inspección en campo\n                            </figcaption>\n                        </figure>\n                    </div>\n                    <div class=\"inv-impact-copy inv-reveal\" data-kid=\"1-6-2-1-2-2\">\n                        <p data-kid=\"1-6-2-1-2-2-1\">\n                            Desde una solicitud ciudadana hasta una intervención concreta, cada etapa necesita coordinación, criterio técnico y seguimiento. Ese es el puente entre la gestión pública y la vida diaria de quienes recorren el estado.\n                        </p>\n                        <div aria-label=\"Proceso de gestión vial\" class=\"inv-process\" data-kid=\"1-6-2-1-2-2-2\">\n                            <div class=\"inv-process-row\" data-kid=\"1-6-2-1-2-2-2-1\">\n                                <span class=\"inv-process-index\" data-kid=\"1-6-2-1-2-2-2-1-1\">\n                                    01\n                                </span>\n                                <strong data-kid=\"1-6-2-1-2-2-2-1-2\">\n                                    Escuchar la necesidad\n                                </strong>\n                                <span data-kid=\"1-6-2-1-2-2-2-1-3\">\n                                    Solicitudes y prioridades\n                                </span>\n                            </div>\n                            <div class=\"inv-process-row\" data-kid=\"1-6-2-1-2-2-2-2\">\n                                <span class=\"inv-process-index\" data-kid=\"1-6-2-1-2-2-2-2-1\">\n                                    02\n                                </span>\n                                <strong data-kid=\"1-6-2-1-2-2-2-2-2\">\n                                    Conocer el tramo\n                                </strong>\n                                <span data-kid=\"1-6-2-1-2-2-2-2-3\">\n                                    Inspección y diagnóstico\n                                </span>\n                            </div>\n                            <div class=\"inv-process-row\" data-kid=\"1-6-2-1-2-2-2-3\">\n                                <span class=\"inv-process-index\" data-kid=\"1-6-2-1-2-2-2-3-1\">\n                                    03\n                                </span>\n                                <strong data-kid=\"1-6-2-1-2-2-2-3-2\">\n                                    Diseñar la respuesta\n                                </strong>\n                                <span data-kid=\"1-6-2-1-2-2-2-3-3\">\n                                    Proyecto y coordinación\n                                </span>\n                            </div>\n                            <div class=\"inv-process-row\" data-kid=\"1-6-2-1-2-2-2-4\">\n                                <span class=\"inv-process-index\" data-kid=\"1-6-2-1-2-2-2-4-1\">\n                                    04\n                                </span>\n                                <strong data-kid=\"1-6-2-1-2-2-2-4-2\">\n                                    Hacerlo realidad\n                                </strong>\n                                <span data-kid=\"1-6-2-1-2-2-2-4-3\">\n                                    Obra, control y seguimiento\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div aria-label=\"Áreas de impacto institucional\" class=\"inv-proof-ticker inv-reveal\" data-kid=\"1-6-2-1-3\">\n                    <div class=\"inv-ticker-track\" data-kid=\"1-6-2-1-3-1\">\n                        <span class=\"inv-ticker-item\" data-kid=\"1-6-2-1-3-1-1\">\n                            <i aria-hidden=\"true\" class=\"bx bxs-circle\" data-kid=\"1-6-2-1-3-1-1-1\">\n                            </i>\n                            Municipios y parroquias\n                        </span>\n                        <span class=\"inv-ticker-item\" data-kid=\"1-6-2-1-3-1-2\">\n                            <i aria-hidden=\"true\" class=\"bx bxs-circle\" data-kid=\"1-6-2-1-3-1-2-1\">\n                            </i>\n                            Seguridad vial\n                        </span>\n                        <span class=\"inv-ticker-item\" data-kid=\"1-6-2-1-3-1-3\">\n                            <i aria-hidden=\"true\" class=\"bx bxs-circle\" data-kid=\"1-6-2-1-3-1-3-1\">\n                            </i>\n                            Transparencia en la gestión\n                        </span>\n                        <span class=\"inv-ticker-item\" data-kid=\"1-6-2-1-3-1-4\">\n                            <i aria-hidden=\"true\" class=\"bx bxs-circle\" data-kid=\"1-6-2-1-3-1-4-1\">\n                            </i>\n                            Equipos en territorio\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"video-title\" class=\"inv-film\" data-kid=\"1-6-3\">\n            <div class=\"inv-shell inv-film-inner\" data-kid=\"1-6-3-1\">\n                <div class=\"inv-film-copy inv-reveal\" data-kid=\"1-6-3-1-1\">\n                    <span class=\"inv-label\" data-kid=\"1-6-3-1-1-1\">\n                        02 — En movimiento\n                    </span>\n                    <h2 data-kid=\"1-6-3-1-1-2\" id=\"video-title\">\n                        La vía también cuenta nuestra historia.\n                    </h2>\n                    <p data-kid=\"1-6-3-1-1-3\">\n                        Una mirada al trabajo institucional que ocurre detrás de cada tramo atendido, cada inspección y cada proyecto.\n                    </p>\n                </div>\n                <figure class=\"inv-film-frame inv-reveal\" data-kid=\"1-6-3-1-2\">\n                    <video aria-label=\"Video institucional de Invilara\" autoplay=\"\" data-kid=\"1-6-3-1-2-1\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"/api/local/images/static/img/1.jpeg\" preload=\"metadata\">\n                        <source data-kid=\"1-6-3-1-2-1-1\" src=\"/api/local/images/static/video/invilara.mp4\" type=\"video/mp4\"/>\n                    </video>\n                    <figcaption class=\"inv-film-caption\" data-kid=\"1-6-3-1-2-2\">\n                        <span data-kid=\"1-6-3-1-2-2-1\">\n                            Video institucional · Invilara\n                        </span>\n                        <span data-kid=\"1-6-3-1-2-2-2\">\n                            Trabajo que se mueve con Lara\n                        </span>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section aria-labelledby=\"servicios-title\" class=\"inv-section is-soft\" data-kid=\"1-6-4\" data-section=\"\" id=\"servicios\">\n            <div class=\"inv-shell\" data-kid=\"1-6-4-1\">\n                <div class=\"inv-ledger\" data-kid=\"1-6-4-1-1\">\n                    <div class=\"inv-ledger-intro inv-reveal\" data-kid=\"1-6-4-1-1-1\">\n                        <span class=\"inv-label\" data-kid=\"1-6-4-1-1-1-1\">\n                            03 — Capacidades\n                        </span>\n                        <h2 data-kid=\"1-6-4-1-1-1-2\" id=\"servicios-title\">\n                            Una gestión vial, varias formas de servir.\n                        </h2>\n                        <p data-kid=\"1-6-4-1-1-1-3\">\n                            Conoce cómo se organiza el trabajo de Invilara y encuentra el punto de entrada adecuado para cada necesidad.\n                        </p>\n                    </div>\n                    <div class=\"inv-ledger-content\" data-kid=\"1-6-4-1-1-2\">\n                        <div aria-label=\"Capacidades de Invilara\" class=\"inv-ledger-list\" data-kid=\"1-6-4-1-1-2-1\" role=\"list\">\n                            <button class=\"inv-ledger-row is-active inv-reveal\" data-alt=\"Obras viales en Lara\" data-image=\"/api/local/images/static/img/1.jpeg\" data-kid=\"1-6-4-1-1-2-1-1\" data-service=\"\" role=\"listitem\" type=\"button\">\n                                <span class=\"inv-ledger-number\" data-kid=\"1-6-4-1-1-2-1-1-1\">\n                                    01\n                                </span>\n                                <h3 data-kid=\"1-6-4-1-1-2-1-1-2\">\n                                    Obras viales\n                                </h3>\n                                <p data-kid=\"1-6-4-1-1-2-1-1-3\">\n                                    Construcción, rehabilitación y mantenimiento de carreteras y autopistas para mejorar la conexión regional.\n                                </p>\n                                <span class=\"inv-ledger-arrow\" data-kid=\"1-6-4-1-1-2-1-1-4\">\n                                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-4-1-1-2-1-1-4-1\">\n                                    </i>\n                                </span>\n                            </button>\n                            <button class=\"inv-ledger-row inv-reveal\" data-alt=\"Inspección técnica de una vía\" data-image=\"/api/local/images/static/img/2.jpeg\" data-kid=\"1-6-4-1-1-2-1-2\" data-service=\"\" role=\"listitem\" type=\"button\">\n                                <span class=\"inv-ledger-number\" data-kid=\"1-6-4-1-1-2-1-2-1\">\n                                    02\n                                </span>\n                                <h3 data-kid=\"1-6-4-1-1-2-1-2-2\">\n                                    Inspecciones\n                                </h3>\n                                <p data-kid=\"1-6-4-1-1-2-1-2-3\">\n                                    Evaluación técnica del estado de la vialidad para orientar decisiones seguras y oportunas.\n                                </p>\n                                <span class=\"inv-ledger-arrow\" data-kid=\"1-6-4-1-1-2-1-2-4\">\n                                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-4-1-1-2-1-2-4-1\">\n                                    </i>\n                                </span>\n                            </button>\n                            <button class=\"inv-ledger-row inv-reveal\" data-alt=\"Proyecto de infraestructura vial\" data-image=\"/api/local/images/static/img/3.jpeg\" data-kid=\"1-6-4-1-1-2-1-3\" data-service=\"\" role=\"listitem\" type=\"button\">\n                                <span class=\"inv-ledger-number\" data-kid=\"1-6-4-1-1-2-1-3-1\">\n                                    03\n                                </span>\n                                <h3 data-kid=\"1-6-4-1-1-2-1-3-2\">\n                                    Proyectos\n                                </h3>\n                                <p data-kid=\"1-6-4-1-1-2-1-3-3\">\n                                    Planificación y coordinación de soluciones que responden a las prioridades del Estado Lara.\n                                </p>\n                                <span class=\"inv-ledger-arrow\" data-kid=\"1-6-4-1-1-2-1-3-4\">\n                                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-4-1-1-2-1-3-4-1\">\n                                    </i>\n                                </span>\n                            </button>\n                            <button class=\"inv-ledger-row inv-reveal\" data-alt=\"Maquinaria para trabajo vial\" data-image=\"/api/local/images/static/img/5.jpeg\" data-kid=\"1-6-4-1-1-2-1-4\" data-service=\"\" role=\"listitem\" type=\"button\">\n                                <span class=\"inv-ledger-number\" data-kid=\"1-6-4-1-1-2-1-4-1\">\n                                    04\n                                </span>\n                                <h3 data-kid=\"1-6-4-1-1-2-1-4-2\">\n                                    Contrataciones\n                                </h3>\n                                <p data-kid=\"1-6-4-1-1-2-1-4-3\">\n                                    Procesos transparentes para incorporar aliados técnicos calificados a la ejecución de obras y servicios.\n                                </p>\n                                <span class=\"inv-ledger-arrow\" data-kid=\"1-6-4-1-1-2-1-4-4\">\n                                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-4-1-1-2-1-4-4-1\">\n                                    </i>\n                                </span>\n                            </button>\n                            <button class=\"inv-ledger-row inv-reveal\" data-alt=\"Solicitud ciudadana relacionada con una obra vial\" data-image=\"/api/local/images/static/img/6.jpeg\" data-kid=\"1-6-4-1-1-2-1-5\" data-service=\"\" role=\"listitem\" type=\"button\">\n                                <span class=\"inv-ledger-number\" data-kid=\"1-6-4-1-1-2-1-5-1\">\n                                    05\n                                </span>\n                                <h3 data-kid=\"1-6-4-1-1-2-1-5-2\">\n                                    Solicitudes\n                                </h3>\n                                <p data-kid=\"1-6-4-1-1-2-1-5-3\">\n                                    Canalización de requerimientos ciudadanos para identificar, priorizar y dar seguimiento a intervenciones.\n                                </p>\n                                <span class=\"inv-ledger-arrow\" data-kid=\"1-6-4-1-1-2-1-5-4\">\n                                    <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt\" data-kid=\"1-6-4-1-1-2-1-5-4-1\">\n                                    </i>\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"inv-ledger-preview inv-reveal\" data-kid=\"1-6-4-1-1-2-2\">\n                            <p data-kid=\"1-6-4-1-1-2-2-1\">\n                                Selecciona una capacidad para ver una referencia visual del trabajo que hacemos en campo.\n                            </p>\n                            <figure data-kid=\"1-6-4-1-1-2-2-2\">\n                                <img alt=\"Obras viales en Lara\" data-dynamic=\"true\" data-kid=\"1-6-4-1-1-2-2-2-1\" data-name=\"service capacity preview image\" data-reason=\"src attribute replaced by script when service selection changes\" data-service-preview=\"\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                            </figure>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contacto-title\" class=\"inv-contact\" data-kid=\"1-6-5\" data-section=\"\" id=\"contacto\">\n            <div class=\"inv-shell inv-contact-grid\" data-kid=\"1-6-5-1\">\n                <div class=\"inv-contact-info inv-reveal\" data-kid=\"1-6-5-1-1\">\n                    <span class=\"inv-label\" data-kid=\"1-6-5-1-1-1\">\n                        04 — Atención\n                    </span>\n                    <h2 data-kid=\"1-6-5-1-1-2\" id=\"contacto-title\">\n                        Hablemos de la vía que necesitas.\n                    </h2>\n                    <p data-kid=\"1-6-5-1-1-3\">\n                        Estamos disponibles para orientar solicitudes, recibir información y acercar la gestión vial a las comunidades del Estado Lara.\n                    </p>\n                    <ul class=\"inv-contact-list\" data-kid=\"1-6-5-1-1-4\">\n                        <li data-kid=\"1-6-5-1-1-4-1\">\n                            <i aria-hidden=\"true\" class=\"bx bx-map\" data-kid=\"1-6-5-1-1-4-1-1\">\n                            </i>\n                            <span data-kid=\"1-6-5-1-1-4-1-2\">\n                                Avenida Fuerzas Armadas, esquina con Calle 57, Barquisimeto, Estado Lara.\n                            </span>\n                        </li>\n                        <li data-kid=\"1-6-5-1-1-4-2\">\n                            <i aria-hidden=\"true\" class=\"bx bx-phone\" data-kid=\"1-6-5-1-1-4-2-1\">\n                            </i>\n                            <span data-kid=\"1-6-5-1-1-4-2-2\">\n                                +58 251-4424548\n                            </span>\n                        </li>\n                        <li data-kid=\"1-6-5-1-1-4-3\">\n                            <i aria-hidden=\"true\" class=\"bx bx-envelope\" data-kid=\"1-6-5-1-1-4-3-1\">\n                            </i>\n                            <span data-kid=\"1-6-5-1-1-4-3-2\">\n                                info@invilara.gob.ve\n                            </span>\n                        </li>\n                        <li data-kid=\"1-6-5-1-1-4-4\">\n                            <i aria-hidden=\"true\" class=\"bx bx-time-five\" data-kid=\"1-6-5-1-1-4-4-1\">\n                            </i>\n                            <span data-kid=\"1-6-5-1-1-4-4-2\">\n                                Lunes a viernes · 8:00 AM a 4:00 PM\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"inv-access inv-reveal\" data-kid=\"1-6-5-1-2\" id=\"acceso\">\n                    <span class=\"inv-label\" data-kid=\"1-6-5-1-2-1\">\n                        Acceso para funcionarios\n                    </span>\n                    <h3 data-kid=\"1-6-5-1-2-2\">\n                        La gestión continúa dentro del sistema.\n                    </h3>\n                    <p data-kid=\"1-6-5-1-2-3\">\n                        Ingresa para administrar solicitudes, proyectos, inspecciones y procesos institucionales desde un solo lugar.\n                    </p>\n                    <a class=\"inv-button is-gold\" data-kid=\"1-6-5-1-2-4\" href=\"#inicio\">\n                        Iniciar sesión\n                        <i aria-hidden=\"true\" class=\"bx bx-log-in-circle\" data-kid=\"1-6-5-1-2-4-1\">\n                        </i>\n                    </a>\n                    <span class=\"inv-access-note\" data-kid=\"1-6-5-1-2-5\">\n                        <i aria-hidden=\"true\" class=\"bx bx-lock-alt\" data-kid=\"1-6-5-1-2-5-1\">\n                        </i>\n                        Acceso protegido para personal autorizado\n                    </span>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"inv-footer\" data-kid=\"1-7\">\n        <div class=\"inv-shell\" data-kid=\"1-7-1\">\n            <div class=\"inv-footer-grid\" data-kid=\"1-7-1-1\">\n                <div class=\"inv-footer-brand\" data-kid=\"1-7-1-1-1\">\n                    <img alt=\"Invilara\" data-kid=\"1-7-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/assets/img/INVILARA LOGO OFICIAL HORIZONTAL.png\"/>\n                    <p data-kid=\"1-7-1-1-1-2\">\n                        Instituto de Vialidad del Estado Lara. Gestionando el desarrollo vial con excelencia, transparencia y compromiso institucional.\n                    </p>\n                </div>\n                <div data-kid=\"1-7-1-1-2\">\n                    <h4 data-kid=\"1-7-1-1-2-1\">\n                        Explorar\n                    </h4>\n                    <ul data-kid=\"1-7-1-1-2-2\">\n                        <li data-kid=\"1-7-1-1-2-2-1\">\n                            <a data-kid=\"1-7-1-1-2-2-1-1\" href=\"#acerca\">\n                                La institución\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-2-2-2\">\n                            <a data-kid=\"1-7-1-1-2-2-2-1\" href=\"#servicios\">\n                                Capacidades\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-2-2-3\">\n                            <a data-kid=\"1-7-1-1-2-2-3-1\" href=\"#contacto\">\n                                Atención\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-7-1-1-3\">\n                    <h4 data-kid=\"1-7-1-1-3-1\">\n                        Accesos\n                    </h4>\n                    <ul data-kid=\"1-7-1-1-3-2\">\n                        <li data-kid=\"1-7-1-1-3-2-1\">\n                            <a data-kid=\"1-7-1-1-3-2-1-1\" href=\"#acceso\">\n                                Sistema institucional\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-3-2-2\">\n                            <a data-kid=\"1-7-1-1-3-2-2-1\" href=\"#acerca\">\n                                Cómo trabajamos\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-3-2-3\">\n                            <a data-kid=\"1-7-1-1-3-2-3-1\" href=\"#inicio\">\n                                Volver al inicio\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-7-1-1-4\">\n                    <h4 data-kid=\"1-7-1-1-4-1\">\n                        Redes y contacto\n                    </h4>\n                    <ul data-kid=\"1-7-1-1-4-2\">\n                        <li data-kid=\"1-7-1-1-4-2-1\">\n                            <a data-kid=\"1-7-1-1-4-2-1-1\" href=\"#contacto\">\n                                info@invilara.gob.ve\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-4-2-2\">\n                            <a data-kid=\"1-7-1-1-4-2-2-1\" href=\"https://www.instagram.com/invilaraoficial\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                @invilaraoficial\n                            </a>\n                        </li>\n                        <li data-kid=\"1-7-1-1-4-2-3\">\n                            <a data-kid=\"1-7-1-1-4-2-3-1\" href=\"#contacto\">\n                                Barquisimeto, Lara\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"inv-footer-bottom\" data-kid=\"1-7-1-2\">\n                <span data-kid=\"1-7-1-2-1\">\n                    © Instituto de Vialidad del Estado Lara (Invilara).\n                </span>\n                <span data-kid=\"1-7-1-2-2\">\n                    Excelencia · transparencia · compromiso institucional\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    (() => {\n    const page = document.querySelector('.inv-page');\n    if (!page) return;\n    const drawer = page.querySelector('#inv-drawer');\n    const backdrop = page.querySelector('[data-drawer-backdrop]');\n    const drawerOpen = page.querySelector('[data-drawer-open]');\n    const drawerClose = page.querySelector('[data-drawer-close]');\n    const drawerLinks = [...page.querySelectorAll('.inv-drawer-link')];\n    let lastFocus = drawerOpen;\n\n    const applyTheme = (theme) => {\n      const isDark = theme === 'dark';\n      page.dataset.theme = isDark ? 'dark' : 'light';\n      page.querySelectorAll('[data-theme-toggle]').forEach((button) => {\n        const icon = button.querySelector('i');\n        if (icon) icon.className = isDark ? 'bx bx-sun' : 'bx bx-moon';\n        button.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');\n        const label = button.querySelector('[data-theme-label]');\n        if (label) label.textContent = isDark ? 'Modo claro' : 'Modo oscuro';\n      });\n      try { localStorage.setItem('invilara-theme', isDark ? 'dark' : 'light'); } catch (error) {}\n    };\n    let savedTheme = 'light';\n    try { savedTheme = localStorage.getItem('invilara-theme') || 'light'; } catch (error) {}\n    applyTheme(savedTheme);\n    page.querySelectorAll('[data-theme-toggle]').forEach((button) => button.addEventListener('click', () => applyTheme(page.dataset.theme === 'dark' ? 'light' : 'dark')));\n\n    const setDrawer = (open, returnFocus = true) => {\n      drawer.classList.toggle('is-open', open);\n      backdrop.classList.toggle('is-open', open);\n      drawer.setAttribute('aria-hidden', String(!open));\n      drawerOpen.setAttribute('aria-expanded', String(open));\n      document.body.style.overflow = open ? 'hidden' : '';\n      if (open) { lastFocus = document.activeElement; drawerClose.focus(); }\n      else if (returnFocus && lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();\n    };\n    drawerOpen.addEventListener('click', () => setDrawer(true));\n    drawerClose.addEventListener('click', () => setDrawer(false));\n    backdrop.addEventListener('click', () => setDrawer(false, false));\n    drawerLinks.forEach((link) => link.addEventListener('click', () => setDrawer(false, false)));\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape' && drawer.classList.contains('is-open')) { setDrawer(false); return; }\n      if (event.key === 'Tab' && drawer.classList.contains('is-open')) {\n        const focusable = [drawerClose, ...drawer.querySelectorAll('a, button')];\n        const first = focusable[0]; const last = focusable[focusable.length - 1];\n        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }\n        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }\n      }\n    });\n\n    const updateProgress = () => {\n      const max = document.documentElement.scrollHeight - window.innerHeight;\n      page.style.setProperty('--inv-scroll-progress', max > 0 ? window.scrollY / max : 0);\n    };\n    updateProgress();\n    window.addEventListener('scroll', updateProgress, { passive: true });\n\n    const navLinks = [...page.querySelectorAll('[data-nav]')];\n    const sections = [...page.querySelectorAll('[data-section]')];\n    const setActive = (id) => navLinks.forEach((link) => { const active = link.dataset.nav === id; link.classList.toggle('is-active', active); if (active) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current'); });\n    const sectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) setActive(entry.target.id); }), { rootMargin: '-35% 0px -55% 0px', threshold: 0 });\n    sections.forEach((section) => sectionObserver.observe(section));\n\n    const preview = page.querySelector('[data-service-preview]');\n    const serviceRows = [...page.querySelectorAll('[data-service]')];\n    serviceRows.forEach((row) => {\n      const activate = () => {\n        serviceRows.forEach((item) => item.classList.toggle('is-active', item === row));\n        preview.src = row.dataset.image;\n        preview.alt = row.dataset.alt;\n      };\n      row.addEventListener('mouseenter', activate);\n      row.addEventListener('focus', activate);\n      row.addEventListener('click', activate);\n    });\n\n    if (window.gsap && window.ScrollTrigger) {\n      gsap.registerPlugin(ScrollTrigger);\n      gsap.fromTo(page.querySelectorAll('.inv-reveal'), { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: .65, stagger: .05, ease: 'power2.out', clearProps: 'transform', scrollTrigger: { trigger: page, start: 'top top', once: true } });\n      page.querySelectorAll('.inv-section, .inv-film').forEach((section) => {\n        const items = section.querySelectorAll('.inv-reveal');\n        if (!items.length) return;\n        gsap.fromTo(items, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: .55, stagger: .06, ease: 'power2.out', scrollTrigger: { trigger: section, start: 'top 78%', once: true } });\n      });\n    }\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-21T08:13:18.410429+00:00",
      "modified": "2026-08-21T08:15:05.172738+00:00",
      "id": "var_ba51b65a1188"
    },
    "var_e5968808579b": {
      "type": "variant",
      "label": "Invilara — Infrastructure Ledger Revamp",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;500;600;700;800&family=Hind:wght@400;500;600;700&display=swap');\n@import url('https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css');\n\n#invilara-page {\n  --page-bg: #ffffff;\n  --surface: #f3f6f4;\n  --surface-strong: #e8efeb;\n  --ink: #09130f;\n  --text: #102019;\n  --muted: #5d6b63;\n  --line: #102019;\n  --line-soft: #cbd8d0;\n  --emerald: #14532d;\n  --emerald-deep: #0b311f;\n  --emerald-soft: #dcecdf;\n  --green: #2f7d4c;\n  --amber: #eab308;\n  --amber-deep: #a87800;\n  --amber-soft: #fff3bd;\n  --white: #ffffff;\n  --shadow: 8px 8px 0 rgba(9, 19, 15, .12);\n  --shadow-soft: 0 18px 45px rgba(9, 19, 15, .10);\n  --focus: #f3c72b;\n  background: var(--page-bg);\n  color: var(--text);\n  min-height: 100vh;\n  font-family: 'Hind', Arial, sans-serif;\n  font-size: 17px;\n  line-height: 1.45;\n  overflow-x: hidden;\n}\n\n#invilara-page.theme-dark {\n  --page-bg: #010b13;\n  --surface: #071a23;\n  --surface-strong: #0c2229;\n  --ink: #f1f8f4;\n  --text: #edf6f1;\n  --muted: #aec3bb;\n  --line: #dbeae1;\n  --line-soft: #29443c;\n  --emerald: #14532d;\n  --emerald-deep: #062218;\n  --emerald-soft: #12362b;\n  --green: #6ac98a;\n  --amber: #f6c928;\n  --amber-deep: #ffda54;\n  --amber-soft: #473a0b;\n  --white: #f7fbf8;\n  --shadow: 8px 8px 0 rgba(0, 0, 0, .32);\n  --shadow-soft: 0 18px 45px rgba(0, 0, 0, .34);\n  --focus: #ffdc55;\n}\n\n#invilara-page *, #invilara-page *::before, #invilara-page *::after { border-color: var(--line-soft); }\n#invilara-page a { color: inherit; text-decoration: none; }\n#invilara-page button { font: inherit; }\n#invilara-page img, #invilara-page video { display: block; max-width: 100%; }\n#invilara-page .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n#invilara-page .icon { display: inline-flex; width: 1.25em; height: 1.25em; align-items: center; justify-content: center; flex: 0 0 auto; color: currentColor; font-size: 1.2em; line-height: 1; }\n#invilara-page .skip-link { position: fixed; z-index: 100; top: -4rem; left: 1rem; padding: .8rem 1rem; background: var(--amber); color: #15120a; font-family: 'Encode Sans', sans-serif; font-weight: 800; border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); }\n#invilara-page .skip-link:focus { top: 1rem; }\n#invilara-page :focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }\n#invilara-page .scroll-line { position: fixed; z-index: 80; top: 0; left: 0; width: 100%; height: 4px; background: transparent; pointer-events: none; }\n#invilara-page .scroll-line span { display: block; width: 0; height: 100%; background: var(--amber); }\n#invilara-page .section-frame { width: min(1180px, calc(100% - 3rem)); margin: 0 auto; }\n#invilara-page .eyebrow { display: inline-flex; align-items: center; gap: .55rem; color: var(--amber-deep); font-family: 'Encode Sans', sans-serif; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }\n#invilara-page .eyebrow::before { content: ''; width: 1.9rem; height: 2px; background: var(--amber); }\n#invilara-page .section-heading { max-width: 720px; margin-bottom: 3rem; }\n#invilara-page .section-heading h2 { margin: .7rem 0 .8rem; color: var(--text); font-family: 'Encode Sans', sans-serif; font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 800; letter-spacing: -.055em; line-height: .99; }\n#invilara-page .section-heading p { max-width: 660px; margin: 0; color: var(--muted); font-size: 1.05rem; }\n#invilara-page .section { padding: 7rem 0; }\n\n#invilara-page .site-header { position: sticky; z-index: 60; top: 0; background: color-mix(in srgb, var(--page-bg) 94%, transparent); border-bottom: 2px solid var(--line); backdrop-filter: blur(14px); }\n#invilara-page .header-inner { display: flex; align-items: center; gap: 2rem; width: min(1180px, calc(100% - 3rem)); min-height: 76px; margin: 0 auto; }\n#invilara-page .brand { display: inline-flex; align-items: center; gap: .75rem; min-width: 250px; }\n#invilara-page .brand img { width: 138px; height: auto; }\n#invilara-page .brand-copy { display: grid; gap: .08rem; border-left: 1px solid var(--line-soft); padding-left: .75rem; }\n#invilara-page .brand-copy strong { color: var(--text); font-family: 'Encode Sans', sans-serif; font-size: .9rem; letter-spacing: .05em; }\n#invilara-page .brand-copy small { color: var(--muted); font-family: 'Encode Sans', sans-serif; font-size: .62rem; line-height: 1.15; letter-spacing: .04em; text-transform: uppercase; }\n#invilara-page .desktop-nav { display: flex; align-items: stretch; gap: .25rem; margin-left: auto; }\n#invilara-page .nav-link { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: .5rem .7rem; color: var(--muted); font-family: 'Encode Sans', sans-serif; font-size: .78rem; font-weight: 700; }\n#invilara-page .nav-link::after { content: ''; position: absolute; right: .7rem; bottom: .25rem; left: .7rem; height: 3px; background: var(--amber); transform: scaleX(0); transform-origin: left; }\n#invilara-page .nav-link:hover, #invilara-page .nav-link.is-active { color: var(--text); }\n#invilara-page .nav-link.is-active::after { transform: scaleX(1); }\n#invilara-page .header-actions { display: flex; align-items: center; gap: .5rem; }\n#invilara-page .theme-toggle, #invilara-page .menu-toggle { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; padding: 0; color: var(--text); background: transparent; border: 2px solid var(--line); cursor: pointer; }\n#invilara-page .theme-toggle:hover, #invilara-page .menu-toggle:hover { color: var(--amber-deep); background: var(--surface); }\n#invilara-page .header-login, #invilara-page .button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 46px; padding: .72rem 1rem; border: 2px solid v