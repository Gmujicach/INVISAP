<li data-kid=\"2-7-1-1-3-2-1\">\n                            <a data-kid=\"2-7-1-1-3-2-1-1\" href=\"#acceso\">\n                                Portal de funcionarios\n                            </a>\n                        </li>\n                        <li data-kid=\"2-7-1-1-3-2-2\">\n                            <a data-kid=\"2-7-1-1-3-2-2-1\" href=\"#contacto\">\n                                Solicitudes\n                            </a>\n                        </li>\n                        <li data-kid=\"2-7-1-1-3-2-3\">\n                            <a data-kid=\"2-7-1-1-3-2-3-1\" href=\"#contacto\">\n                                Información institucional\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"2-7-1-1-4\">\n                    <h2 class=\"footer-heading\" data-kid=\"2-7-1-1-4-1\">\n                        Conectar\n                    </h2>\n                    <ul class=\"footer-links\" data-kid=\"2-7-1-1-4-2\">\n                        <li data-kid=\"2-7-1-1-4-2-1\">\n                            <a data-kid=\"2-7-1-1-4-2-1-1\" href=\"mailto:info@invilara.gob.ve\">\n                                Correo institucional\n                            </a>\n                        </li>\n                        <li data-kid=\"2-7-1-1-4-2-2\">\n                            <a data-kid=\"2-7-1-1-4-2-2-1\" href=\"tel:+582514424548\">\n                                Línea de atención\n                            </a>\n                        </li>\n                        <li data-kid=\"2-7-1-1-4-2-3\">\n                            <a data-kid=\"2-7-1-1-4-2-3-1\" href=\"https://www.instagram.com/invilaraoficial\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                @invilaraoficial\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\" data-kid=\"2-7-1-2\">\n                <span data-kid=\"2-7-1-2-1\">\n                    © 2025 Instituto de Vialidad del Estado Lara (Invilara).\n                </span>\n                <span data-kid=\"2-7-1-2-2\">\n                    Todos los derechos reservados · Barquisimeto, Venezuela.\n                </span>\n            </div>\n        </div>\n    </footer>\n    <div aria-labelledby=\"lightboxTitle\" aria-modal=\"true\" class=\"lightbox\" data-dynamic=\"true\" data-kid=\"2-8\" data-name=\"image gallery lightbox\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"lightbox\" role=\"dialog\">\n        <div class=\"lightbox-dialog\" data-kid=\"2-8-1\">\n            <button aria-label=\"Cerrar galería\" class=\"lightbox-close\" data-kid=\"2-8-1-1\" id=\"lightboxClose\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-x\" data-kid=\"2-8-1-1-1\">\n                </i>\n            </button>\n            <button aria-label=\"Imagen anterior\" class=\"lightbox-arrow prev\" data-kid=\"2-8-1-2\" id=\"lightboxPrev\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-left\" data-kid=\"2-8-1-2-1\">\n                </i>\n            </button>\n            <img alt=\"\" data-dynamic=\"true\" data-kid=\"2-8-1-3\" data-name=\"lightbox image\" data-reason=\"src and alt attributes updated by script\" id=\"lightboxImage\" src=\"\"/>\n            <button aria-label=\"Imagen siguiente\" class=\"lightbox-arrow next\" data-kid=\"2-8-1-4\" id=\"lightboxNext\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-chevron-right\" data-kid=\"2-8-1-4-1\">\n                </i>\n            </button>\n            <div class=\"lightbox-meta\" data-kid=\"2-8-1-5\">\n                <span data-dynamic=\"true\" data-kid=\"2-8-1-5-1\" data-name=\"lightbox title text\" data-reason=\"text content replaced by script\" id=\"lightboxTitle\">\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"2-8-1-5-2\" data-name=\"lightbox counter text\" data-reason=\"text content replaced by script\" id=\"lightboxCount\">\n                </span>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const page = document.getElementById('invilaraPage');\n    const drawer = document.getElementById('mobileDrawer');\n    const drawerBackdrop = document.getElementById('drawerBackdrop');\n    const drawerOpen = document.getElementById('drawerOpen');\n    const drawerClose = document.getElementById('drawerClose');\n    let lastFocus = drawerOpen;\n\n    const setTheme = (theme) => {\n      page.dataset.theme = theme;\n      try { localStorage.setItem('invilara-theme', theme); } catch (error) {}\n      document.querySelectorAll('[data-theme-toggle]').forEach((control) => {\n        const dark = theme === 'dark';\n        control.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');\n        control.setAttribute('title', dark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');\n        const icon = control.querySelector('.theme-icon');\n        const label = control.querySelector('.theme-label');\n        if (icon) icon.className = `bx ${dark ? 'bx-sun' : 'bx-moon'} theme-icon`;\n        if (label) label.textContent = dark ? 'Modo claro' : 'Modo oscuro';\n      });\n    };\n    let savedTheme = 'light';\n    try { savedTheme = localStorage.getItem('invilara-theme') || 'light'; } catch (error) {}\n    setTheme(savedTheme === 'dark' ? 'dark' : 'light');\n    document.querySelectorAll('[data-theme-toggle]').forEach((control) => control.addEventListener('click', () => setTheme(page.dataset.theme === 'dark' ? 'light' : 'dark')));\n\n    const setDrawer = (open) => {\n      drawer.classList.toggle('is-open', open);\n      drawerBackdrop.classList.toggle('is-open', open);\n      drawer.setAttribute('aria-hidden', String(!open));\n      drawerBackdrop.setAttribute('aria-hidden', String(!open));\n      drawerOpen.setAttribute('aria-expanded', String(open));\n      if (open) { lastFocus = document.activeElement; document.body.style.overflow = 'hidden'; drawerClose.focus(); }\n      else { document.body.style.overflow = ''; (lastFocus || drawerOpen).focus(); }\n    };\n    drawerOpen.addEventListener('click', () => setDrawer(true));\n    drawerClose.addEventListener('click', () => setDrawer(false));\n    drawerBackdrop.addEventListener('click', () => setDrawer(false));\n    document.querySelectorAll('[data-drawer-link]').forEach((link) => link.addEventListener('click', () => setDrawer(false)));\n    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && drawer.classList.contains('is-open')) setDrawer(false); });\n\n    const reveals = document.querySelectorAll('[data-reveal]');\n    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .14 });\n      reveals.forEach((item) => revealObserver.observe(item));\n    } else reveals.forEach((item) => item.classList.add('is-visible'));\n\n    const navLinks = [...document.querySelectorAll('[data-nav-link]')];\n    const observedSections = [...document.querySelectorAll('main section[id]')];\n    const sectionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) navLinks.forEach((link) => link.setAttribute('aria-current', link.getAttribute('href') === `#${entry.target.id}` ? 'true' : 'false')); }), { rootMargin: '-35% 0px -55% 0px', threshold: 0 });\n    observedSections.forEach((section) => sectionObserver.observe(section));\n    const updateProgress = () => { const max = document.documentElement.scrollHeight - window.innerHeight; page.style.setProperty('--scroll-progress', max > 0 ? window.scrollY / max : 0); };\n    window.addEventListener('scroll', updateProgress, { passive: true }); updateProgress();\n\n    const serviceData = {\n      obras: { index: '01', title: 'Obras viales', description: 'Planificación, construcción, rehabilitación y mantenimiento de carreteras y vías urbanas para sostener la movilidad y la conexión entre comunidades.', action: 'Coordinamos intervenciones y seguimiento de obra.', audience: 'Municipios, parroquias y comunidades.' },\n      inspecciones: { index: '02', title: 'Inspecciones técnicas', description: 'Evaluamos el estado de la infraestructura y documentamos puntos críticos para orientar decisiones de conservación, seguridad y atención.', action: 'Registramos hallazgos y prioridades de campo.', audience: 'Equipos técnicos y responsables territoriales.' },\n      proyectos: { index: '03', title: 'Proyectos y contratos', description: 'Organizamos proyectos estratégicos y procesos de contratación con criterios técnicos, transparencia administrativa y responsabilidad pública.', action: 'Articulamos planificación, aliados y control.', audience: 'Proveedores, contratistas y áreas internas.' },\n      solicitudes: { index: '04', title: 'Solicitudes ciudadanas', description: 'Canalizamos requerimientos de las comunidades para conocer necesidades reales y ayudar a priorizar intervenciones viales en Lara.', action: 'Recibimos, derivamos y damos seguimiento.', audience: 'Ciudadanía, municipios y parroquias.' }\n    };\n    const serviceButtons = [...document.querySelectorAll('.service-option')];\n    const renderService = (key) => {\n      const item = serviceData[key]; if (!item) return;\n      serviceButtons.forEach((button) => { const active = button.dataset.service === key; button.setAttribute('aria-selected', String(active)); button.setAttribute('aria-expanded', String(active)); });\n      document.getElementById('serviceKicker').textContent = `Capacidad / ${item.index}`;\n      document.getElementById('serviceHeading').textContent = item.title;\n      document.getElementById('serviceDescription').textContent = item.description;\n      document.getElementById('serviceAction').textContent = item.action;\n      document.getElementById('serviceAudience').textContent = item.audience;\n    };\n    serviceButtons.forEach((button, index) => button.addEventListener('click', () => renderService(button.dataset.service)));\n    document.querySelector('.service-list').addEventListener('keydown', (event) => { if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return; event.preventDefault(); const current = serviceButtons.indexOf(document.activeElement); const next = event.key === 'ArrowDown' ? (current + 1) % serviceButtons.length : (current - 1 + serviceButtons.length) % serviceButtons.length; serviceButtons[next].focus(); serviceButtons[next].click(); });\n\n    const galleryItems = [...document.querySelectorAll('.gallery-item')];\n    const lightbox = document.getElementById('lightbox');\n    const lightboxImage = document.getElementById('lightboxImage');\n    const lightboxTitle = document.getElementById('lightboxTitle');\n    const lightboxCount = document.getElementById('lightboxCount');\n    let galleryIndex = 0; let galleryTrigger = null;\n    const renderGallery = () => { const item = galleryItems[galleryIndex]; const image = item.querySelector('img'); lightboxImage.src = image.src; lightboxImage.alt = image.alt; lightboxTitle.textContent = item.dataset.caption; lightboxCount.textContent = `${galleryIndex + 1} / ${galleryItems.length}`; };\n    const openGallery = (index) => { galleryIndex = index; galleryTrigger = document.activeElement; renderGallery(); lightbox.hidden = false; document.getElementById('lightboxClose').focus(); };\n    const closeGallery = () => { lightbox.hidden = true; if (galleryTrigger) galleryTrigger.focus(); };\n    galleryItems.forEach((item, index) => item.addEventListener('click', () => openGallery(index)));\n    document.getElementById('lightboxClose').addEventListener('click', closeGallery);\n    document.getElementById('lightboxPrev').addEventListener('click', () => { galleryIndex = (galleryIndex - 1 + galleryItems.length) % galleryItems.length; renderGallery(); });\n    document.getElementById('lightboxNext').addEventListener('click', () => { galleryIndex = (galleryIndex + 1) % galleryItems.length; renderGallery(); });\n    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) closeGallery(); });\n    document.addEventListener('keydown', (event) => { if (lightbox.hidden) return; if (event.key === 'Escape') closeGallery(); if (event.key === 'ArrowLeft') document.getElementById('lightboxPrev').click(); if (event.key === 'ArrowRight') document.getElementById('lightboxNext').click(); });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-21T08:13:07.828520+00:00",
      "modified": "2026-08-21T08:14:35.181055+00:00",
      "id": "var_12f0d5372368"
    },
    "var_ba51b65a1188": {
      "type": "variant",
      "label": "Invilara — Civic Grid Revamp",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Public+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css');\n\n.inv-page {\n  --inv-bg: #f8f9fa;\n  --inv-surface: #ffffff;\n  --inv-surface-soft: #eef3ef;\n  --inv-ink: #16231c;\n  --inv-muted: #56665c;\n  --inv-line: #d8e2da;\n  --inv-line-strong: #b8cdbd;\n  --inv-emerald: #14532d;\n  --inv-emerald-2: #15803d;\n  --inv-green: #22c55e;\n  --inv-gold: #ca8a04;\n  --inv-gold-soft: #fef3c7;\n  --inv-dark: #0e2117;\n  --inv-radius: 18px;\n  --inv-shadow: 0 20px 55px rgba(20,83,45,.12);\n  --inv-scroll-progress: 0;\n  min-height: 100vh;\n  overflow-x: hidden;\n  background: var(--inv-bg);\n  color: var(--inv-ink);\n  font-family: 'Public Sans', 'Segoe UI', sans-serif;\n  line-height: 1.55;\n  color-scheme: light;\n}\n\n.inv-page[data-theme='dark'] {\n  --inv-bg: #111815;\n  --inv-surface: #18231d;\n  --inv-surface-soft: #1e2d24;\n  --inv-ink: #f4f8f4;\n  --inv-muted: #a8b8ad;\n  --inv-line: #30443a;\n  --inv-line-strong: #4b6b57;\n  --inv-emerald: #0d3c24;\n  --inv-emerald-2: #1c974b;\n  --inv-green: #5ee77f;\n  --inv-gold: #f0bd35;\n  --inv-gold-soft: #403514;\n  --inv-dark: #08140d;\n  --inv-shadow: 0 24px 60px rgba(0,0,0,.28);\n  color-scheme: dark;\n}\n\n.inv-page a { color: inherit; text-decoration: none; }\n.inv-page button { font: inherit; }\n.inv-page img { max-width: 100%; }\n.inv-page .bx { line-height: 1; }\n.inv-page .inv-shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }\n.inv-page .inv-label { color: var(--inv-gold); font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }\n.inv-page .inv-kicker { color: var(--inv-muted); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.inv-page .inv-serif { font-family: 'Atkinson Hyperlegible', 'Segoe UI', sans-serif; }\n\n.inv-page .inv-skip {\n  position: fixed;\n  left: 18px;\n  top: -80px;\n  z-index: 300;\n  padding: 13px 18px;\n  border: 2px solid var(--inv-gold);\n  background: var(--inv-gold);\n  color: #1b1607;\n  font-weight: 800;\n  border-radius: 0 0 10px 10px;\n}\n.inv-page .inv-skip:focus { top: 0; }\n.inv-page :focus-visible { outline: 3px solid var(--inv-gold); outline-offset: 4px; }\n\n.inv-page .inv-progress {\n  position: fixed;\n  inset: 0 0 auto 0;\n  height: 4px;\n  z-index: 250;\n  background: rgba(20,83,45,.16);\n}\n.inv-page .inv-progress > span { display: block; height: 100%; width: calc(var(--inv-scroll-progress) * 100%); background: var(--inv-gold); }\n\n.inv-page .inv-topbar {\n  position: sticky;\n  top: 0;\n  z-index: 200;\n  min-height: 76px;\n  border-bottom: 1px solid rgba(255,255,255,.12);\n  background: var(--inv-emerald);\n  color: #fff;\n}\n.inv-page .inv-topbar-inner { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }\n.inv-page .inv-brand { display: inline-flex; align-items: center; gap: 12px; min-width: 190px; }\n.inv-page .inv-brand img { width: 156px; height: auto; padding: 6px 8px; border-radius: 8px; background: rgba(255,255,255,.94); }\n.inv-page .inv-brand-copy { display: grid; gap: 1px; color: #fff; }\n.inv-page .inv-brand-copy strong { font-size: .86rem; letter-spacing: .03em; }\n.inv-page .inv-brand-copy small { color: rgba(255,255,255,.68); font-size: .65rem; line-height: 1.2; }\n.inv-page .inv-nav { display: flex; align-items: center; gap: 4px; }\n.inv-page .inv-nav a { position: relative; min-height: 44px; display: inline-flex; align-items: center; padding: 0 13px; color: rgba(255,255,255,.74); font-size: .84rem; font-weight: 700; }\n.inv-page .inv-nav a::after { content: ''; position: absolute; left: 13px; right: 13px; bottom: 13px; height: 2px; background: var(--inv-gold); transform: scaleX(0); transform-origin: left; }\n.inv-page .inv-nav a:hover, .inv-page .inv-nav a.is-active { color: #fff; }\n.inv-page .inv-nav a.is-active::after { transform: scaleX(1); }\n.inv-page .inv-actions { display: flex; align-items: center; gap: 8px; }\n.inv-page .inv-theme,\n.inv-page .inv-menu-button,\n.inv-page .inv-drawer-close { min-width: 46px; min-height: 46px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.28); border-radius: 50%; background: transparent; color: #fff; cursor: pointer; }\n.inv-page .inv-theme:hover, .inv-page .inv-menu-button:hover, .inv-page .inv-drawer-close:hover { background: rgba(255,255,255,.1); }\n.inv-page .inv-theme i, .inv-page .inv-menu-button i, .inv-page .inv-drawer-close i { font-size: 1.25rem; }\n.inv-page .inv-login { min-height: 46px; display: inline-flex; align-items: center; gap: 8px; padding: 0 17px; border: 1px solid var(--inv-gold); border-radius: 8px; background: var(--inv-gold); color: #201808; font-size: .82rem; font-weight: 800; }\n.inv-page .inv-login:hover { background: #e3a20b; border-color: #e3a20b; }\n.inv-page .inv-menu-button { display: none; border-radius: 10px; }\n\n.inv-page .inv-hero { position: relative; display: grid; grid-template-columns: 108px minmax(0, 1fr) minmax(390px, .92fr); min-height: 650px; background: var(--inv-bg); border-bottom: 1px solid var(--inv-line); }\n.inv-page .inv-hero-rail { display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 40px 18px; background: var(--inv-emerald); color: #fff; }\n.inv-page .inv-rail-number { font-size: .74rem; font-weight: 800; letter-spacing: .18em; writing-mode: vertical-rl; transform: rotate(180deg); color: var(--inv-gold); }\n.inv-page .inv-rail-line { width: 1px; flex: 1; max-height: 220px; margin: 24px 0; background: rgba(255,255,255,.32); }\n.inv-page .inv-rail-links { display: grid; gap: 12px; }\n.inv-page .inv-rail-links a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.26); border-radius: 50%; color: rgba(255,255,255,.82); }\n.inv-page .inv-rail-links a:hover { color: var(--inv-gold); border-color: var(--inv-gold); }\n.inv-page .inv-hero-copy { display: flex; flex-direction: column; justify-content: center; padding: 62px clamp(32px, 6vw, 90px); }\n.inv-page .inv-hero-copy h1 { max-width: 710px; margin: 16px 0 22px; font-size: clamp(3rem, 5.2vw, 5.8rem); line-height: .98; letter-spacing: -.055em; font-weight: 800; color: var(--inv-ink); }\n.inv-page .inv-hero-copy h1 em { color: var(--inv-emerald-2); font-style: normal; }\n.inv-page[data-theme='dark'] .inv-hero-copy h1 em { color: var(--inv-green); }\n.inv-page .inv-hero-copy p { max-width: 590px; margin: 0 0 30px; color: var(--inv-muted); font-size: 1.08rem; }\n.inv-page .inv-hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }\n.inv-page .inv-button { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 20px; border: 1px solid var(--inv-emerald); border-radius: 8px; background: var(--inv-emerald); color: #fff; font-size: .86rem; font-weight: 800; }\n.inv-page .inv-button:hover { background: var(--inv-emerald-2); border-color: var(--inv-emerald-2); }\n.inv-page .inv-button.is-gold { border-color: var(--inv-gold); background: var(--inv-gold); color: #201808; }\n.inv-page .inv-button.is-gold:hover { background: #e3a20b; border-color: #e3a20b; }\n.inv-page .inv-button.is-quiet { border-color: var(--inv-line-strong); background: transparent; color: var(--inv-emerald); }\n.inv-page[data-theme='dark'] .inv-button.is-quiet { color: var(--inv-ink); }\n.inv-page .inv-button.is-quiet:hover { border-color: var(--inv-emerald-2); background: var(--inv-surface-soft); }\n.inv-page .inv-proofline { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--inv-line); color: var(--inv-muted); font-size: .75rem; font-weight: 700; }\n.inv-page .inv-proofline span { display: inline-flex; align-items: center; gap: 7px; }\n.inv-page .inv-proofline i { color: var(--inv-gold); font-size: 1rem; }\n.inv-page .inv-hero-media { position: relative; min-height: 650px; overflow: hidden; background: var(--inv-emerald); }\n.inv-page .inv-hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.92) contrast(1.02); }\n.inv-page .inv-hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,33,23,.3), transparent 42%), linear-gradient(0deg, rgba(14,33,23,.66), transparent 34%); pointer-events: none; }\n.inv-page .inv-media-caption { position: absolute; left: 28px; right: 28px; bottom: 28px; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; color: #fff; }\n.inv-page .inv-media-caption strong { display: block; max-width: 260px; font-family: 'Atkinson Hyperlegible', sans-serif; font-size: 1.35rem; line-height: 1.05; }\n.inv-page .inv-media-caption small { max-width: 150px; color: rgba(255,255,255,.75); font-size: .72rem; text-align: right; }\n\n.inv-page .inv-section { padding: 112px 0; }\n.inv-page .inv-section.is-soft { background: var(--inv-surface-soft); }\n.inv-page .inv-section-heading { display: grid; grid-template-columns: minmax(220px, .42fr) minmax(0, 1fr); gap: 56px; align-items: end; margin-bottom: 54px; }\n.inv-page .inv-section-heading h2 { max-width: 720px; margin: 8px 0 0; color: var(--inv-ink); font-family: 'Atkinson Hyperlegible', sans-serif; font-size: clamp(2.2rem, 4vw, 4.2rem); line-height: .98; letter-spacing: -.045em; }\n.inv-page .inv-section-heading p { max-width: 560px; margin: 0; color: var(--inv-muted); font-size: 1rem; }\n.inv-page .inv-rule { width: 96px; height: 4px; margin-top: 18px; background: linear-gradient(90deg, var(--inv-emerald-2), var(--inv-gold)); }\n\n.inv-page .inv-impact-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr); gap: 56px; align-items: start; }\n.in