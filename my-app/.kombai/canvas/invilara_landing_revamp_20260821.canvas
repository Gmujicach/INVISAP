s=\"film-section\" data-kid=\"2-6-3\" id=\"video\">\n            <div class=\"editorial-wrap film-inner\" data-kid=\"2-6-3-1\">\n                <div data-kid=\"2-6-3-1-1\" data-reveal=\"\">\n                    <div class=\"film-kicker\" data-kid=\"2-6-3-1-1-1\">\n                        02 / INVILARA EN MOVIMIENTO\n                    </div>\n                    <h2 class=\"film-title\" data-kid=\"2-6-3-1-1-2\" id=\"filmTitle\">\n                        El territorio también cuenta nuestra historia.\n                    </h2>\n                    <p class=\"film-copy\" data-kid=\"2-6-3-1-1-3\">\n                        Una mirada al trabajo cotidiano de la institución: equipos, vías y comunidades que forman parte de una misma responsabilidad pública.\n                    </p>\n                    <div class=\"film-meta\" data-kid=\"2-6-3-1-1-4\">\n                        <span data-kid=\"2-6-3-1-1-4-1\">\n                            Video institucional\n                        </span>\n                        <span data-kid=\"2-6-3-1-1-4-2\">\n                            Invilara · Lara\n                        </span>\n                    </div>\n                </div>\n                <figure class=\"film-frame\" data-kid=\"2-6-3-1-2\" data-reveal=\"\">\n                    <video aria-label=\"Video institucional de Invilara\" controls=\"\" data-kid=\"2-6-3-1-2-1\" muted=\"\" playsinline=\"\" poster=\"/api/local/images/static/img/3.jpeg\" preload=\"metadata\">\n                        <source data-kid=\"2-6-3-1-2-1-1\" src=\"/api/local/images/static/video/invilara.mp4\" type=\"video/mp4\"/>\n                        Tu navegador no puede reproducir este video.\n                    </video>\n                    <figcaption class=\"film-label\" data-kid=\"2-6-3-1-2-2\">\n                        <span data-kid=\"2-6-3-1-2-2-1\">\n                            Registro audiovisual institucional\n                        </span>\n                        <span data-kid=\"2-6-3-1-2-2-2\">\n                            Play · Pause · Explore\n                        </span>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section aria-labelledby=\"servicesTitle\" class=\"section\" data-kid=\"2-6-4\" id=\"servicios\">\n            <div class=\"editorial-wrap\" data-kid=\"2-6-4-1\">\n                <div class=\"section-head\" data-kid=\"2-6-4-1-1\" data-reveal=\"\">\n                    <div data-kid=\"2-6-4-1-1-1\">\n                        <div class=\"section-index\" data-kid=\"2-6-4-1-1-1-1\">\n                            03 / CAPACIDADES\n                        </div>\n                        <h2 class=\"section-title\" data-kid=\"2-6-4-1-1-1-2\" id=\"servicesTitle\">\n                            Una gestión que se puede entender.\n                        </h2>\n                    </div>\n                    <p class=\"section-intro\" data-kid=\"2-6-4-1-1-2\">\n                        Conoce cómo se organiza el trabajo vial y encuentra el punto de entrada adecuado para consultar, solicitar o acompañar cada proceso.\n                    </p>\n                </div>\n                <div class=\"services-grid\" data-kid=\"2-6-4-1-2\">\n                    <div aria-label=\"Capacidades de Invilara\" class=\"service-list\" data-kid=\"2-6-4-1-2-1\" role=\"tablist\">\n                        <button aria-controls=\"servicePanel\" aria-expanded=\"true\" aria-selected=\"true\" class=\"service-option\" data-dynamic=\"true\" data-kid=\"2-6-4-1-2-1-1\" data-name=\"service option for obras viales\" data-reason=\"aria-expanded and aria-selected updated by script\" data-service=\"obras\" role=\"tab\" type=\"button\">\n                            <span class=\"service-num\" data-kid=\"2-6-4-1-2-1-1-1\">\n                                01\n                            </span>\n                            <span class=\"service-name\" data-kid=\"2-6-4-1-2-1-1-2\">\n                    