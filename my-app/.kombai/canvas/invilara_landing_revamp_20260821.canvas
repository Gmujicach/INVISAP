      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&family=Playfair+Display:wght@600;700;800&display=swap');\n\n  .invilara-page {\n    --page-bg: #f4f0ec;\n    --page-surface: #fffaf5;\n    --page-surface-2: #e9e2da;\n    --page-ink: #232728;\n    --page-muted: #696762;\n    --page-green: #14532d;\n    --page-green-2: #15803d;\n    --page-gold: #ca8a04;\n    --page-gold-soft: #f4dfac;\n    --page-line: rgba(35, 39, 40, .18);\n    --page-line-strong: rgba(20, 83, 45, .48);\n    --page-shadow: 0 18px 50px rgba(48, 42, 35, .12);\n    --page-radius: 4px;\n    background: var(--page-bg);\n    color: var(--page-ink);\n    font-family: 'Literata', Georgia, serif;\n    line-height: 1.6;\n    min-height: 100vh;\n    overflow-x: hidden;\n    transition: background-color .25s ease, color .25s ease;\n  }\n\n  .invilara-page[data-theme='dark'] {\n    --page-bg: #2a3439;\n    --page-surface: #303d42;\n    --page-surface-2: #36474d;\n    --page-ink: #f2eee7;\n    --page-muted: #c2cbc6;\n    --page-green: #103a25;\n    --page-green-2: #31a967;\n    --page-gold: #e2b035;\n    --page-gold-soft: #55451c;\n    --page-line: rgba(242, 238, 231, .2);\n    --page-line-strong: rgba(91, 200, 132, .55);\n    --page-shadow: 0 18px 50px rgba(0, 0, 0, .26);\n  }\n\n  .invilara-page *,\n  .invilara-page *::before,\n  .invilara-page *::after { box-sizing: border-box; }\n\n  .invilara-page a { color: inherit; text-decoration: none; }\n  .invilara-page button { font: inherit; }\n  .invilara-page img,\n  .invilara-page video { display: block; max-width: 100%; }\n  .invilara-page ::selection { background: var(--page-gold); color: #1a1a16; }\n\n  .skip-link {\n    position: fixed;\n    left: 18px;\n    top: -80px;\n    z-index: 200;\n    padding: 11px 16px;\n    background: var(--page-gold);\n    color: #1b1a14 !important;\n    font: 600 13px/1.2 'Literata', Georgia, serif;\n    border: 2px solid #1b1a14;\n    transition: top .2s ease;\n  }\n  .skip-link:focus { top: 18px; }\n  .invilara-page :focus-visible {\n    outline: 3px solid var(--page-gold);\n    outline-offset: 4px;\n  }\n\n  .scroll-progress {\n    position: fixed;\n    inset: 0 0 auto;\n    z-index: 150;\n    height: 4px;\n    background: transparent;\n    pointer-events: none;\n  }\n  .scroll-progress::after {\n    content: '';\n    display: block;\n    width: calc(var(--scroll-progress, 0) * 100%);\n    height: 100%;\n    background: var(--page-gold);\n  }\n\n  .site-header {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    background: color-mix(in srgb, var(--page-bg) 92%, transparent);\n    border-bottom: 1px solid var(--page-line);\n    backdrop-filter: blur(16px);\n  }\n  .header-inner {\n    width: min(1160px, calc(100% - 48px));\n    min-height: 74px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    gap: 24px;\n  }\n  .brand {\n    display: inline-flex;\n    align-items: center;\n    gap: 11px;\n    min-width: 210px;\n  }\n  .brand img {\n    width: 138px;\n    height: auto;\n    filter: saturate(.9);\n  }\n  .brand-word {\n    display: none;\n    color: var(--page-green);\n    font: 700 17px/1 'Playfair Display', Georgia, serif;\n  }\n  .header-nav {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 4px;\n    flex: 1;\n  }\n  .header-nav a {\n    position: relative;\n    padding: 12px 11px;\n    color: var(--page-muted);\n    font: 500 12px/1.2 'Literata', Georgia, serif;\n    white-space: nowrap;\n  }\n  .header-nav a::after {\n    content: '';\n    position: absolute;\n    right: 11px;\n    bottom: 5px;\n    left: 11px;\n    height: 2px;\n    background: var(--page-gold);\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform .2s ease;\n  }\n  .header-nav a:hover,\n  .header-nav a[aria-current='true'] { color: var(--page-green-2); }\n  .header-nav a:hover::after,\n  .header-nav a[aria-current='true']::after { transform: scaleX(1); }\n  .header-actions { display: flex; align-items: center; gap: 8px; }\n  .theme-toggle,\n  .menu-toggle {\n    min-width: 46px;\n    min-height: 46px;\n    border: 1px solid var(--page-line);\n    background: transparent;\n    color: var(--page-ink);\n    cursor: pointer;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    transition: background-color .2s ease, border-color .2s ease, color .2s ease;\n  }\n  .theme-toggle:hover,\n  .menu-toggle:hover { background: var(--page-surface-2); border-color: var(--page-line-strong); }\n  .theme-toggle .theme-label { display: none; }\n  .header-login,\n  .access-button {\n    min-height: 46px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 0 17px;\n    background: var(--page-gold);\n    border: 1px solid var(--page-gold);\n    color: #1d1b15 !important;\n    font: 600 12px/1.1 'Literata', Georgia, serif;\n    transition: background-color .2s ease, transform .2s ease, box-shadow .2s ease;\n  }\n  .header-login:hover,\n  .access-button:hover { background: #e0a30b; transform: translateY(-2px); box-shadow: 0 8px 18px rgba(202, 138, 4, .22); }\n  .menu-toggle { display: none; }\n\n  .drawer-backdrop {\n    position: fixed;\n    inset: 0;\n    z-index: 110;\n    background: rgba(11, 22, 16, .64);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity .25s ease;\n  }\n  .drawer-backdrop.is-open { opacity: 1; pointer-events: auto; }\n  .mobile-drawer {\n    position: fixed;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 120;\n    width: min(360px, 88vw);\n    padding: 22px 22px 28px;\n    background: var(--page-green);\n    color: #fffaf5;\n    transform: translateX(102%);\n    box-shadow: -20px 0 45px rgba(0, 0, 0, .18);\n    transition: transform .28s ease;\n    display: flex;\n    flex-direction: column;\n  }\n  .mobile-drawer.is-open { transform: translateX(0); }\n  .drawer-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 22px; border-bottom: 1px solid rgba(255,255,255,.2); }\n  .drawer-kicker { font: 600 11px/1 'Literata', Georgia, serif; letter-spacing: .14em; text-transform: uppercase; color: #d8e5db; }\n  .drawer-close { min-width: 46px; min-height: 46px; border: 1px solid rgba(255,255,255,.25); background: transparent; color: #fffaf5; cursor: pointer; }\n  .drawer-nav { list-style: none; padding: 22px 0; margin: 0; }\n  .drawer-nav li { border-bottom: 1px solid rgba(255,255,255,.14); }\n  .drawer-nav a { display: flex; align-items: center; min-height: 54px; color: #fffaf5; font: 600 17px/1.2 'Playfair Display', Georgia, serif; }\n  .drawer-nav a:hover { color: #f4d88d; }\n  .drawer-bottom { margin-top: auto; display: grid; gap: 12px; }\n  .drawer-bottom .theme-toggle { width: 100%; border-color: rgba(255,255,255,.25); color: #fffaf5; justify-content: flex-start; padding: 0 15px; }\n  .drawer-bottom .theme-toggle .theme-label { display: inline; font-size: 13px; }\n  .drawer-bottom .header-login { width: 100%; }\n\n  .editorial-wrap { width: min(1160px, calc(100% - 48px)); margin: 0 auto; }\n  .hero-spread {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    min-height: 650px;\n    border-bottom: 1px solid var(--page-line);\n  }\n  .hero-photo { position: relative; min-height: 650px; overflow: hidden; background: var(--page-green); }\n  .hero-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.88) contrast(1.02); }\n  .hero-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 48%, rgba(8, 30, 18, .78)); pointer-events: none; }\n  .photo-caption { position: absolute; z-index: 1; right: 28px; bottom: 26px; left: 28px; display: flex; justify-content: space-between; gap: 16px; color: #fffaf5; font: 500 11px/1.45 'Literata', Georgia, serif; }\n  .photo-caption span:last-child { color: #f4d88d; text-align: right; }\n  .hero-copy { padding: 82px clamp(32px, 6vw, 88px) 70px; background: var(--page-surface); display: flex; flex-direction: column; justify-content: center; border-left: 10px solid var(--page-green); }\n  .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--page-green-2); font: 600 11px/1.2 'Literata', Georgia, serif; letter-spacing: .16em; text-transform: uppercase; }\n  .eyebrow::before { content: ''; width: 32px; height: 2px; background: var(--page-gold); }\n  .hero-title { margin: 24px 0 22px; max-width: 620px; color: var(--page-green); font: 800 clamp(3.2rem, 6vw, 5.9rem)/.96 'Playfair Display', Georgia, serif; letter-spacing: -.045em; }\n  .invilara-page[data-theme='dark'] .hero-title { color: #e6f0e9; }\n  .hero-lead { max-width: 570px; margin: 0; color: var(--page-muted); font: 400 clamp(15px, 1.5vw, 18px)/1.8 'Literata', Georgia, serif; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }\n  .hero-secondary { min-height: 46px; display: inline-flex; align-items: center; gap: 8px; padding: 0 17px; border: 1px solid var(--page-green); color: var(--page-green) !important; font: 600 12px/1.1 'Literata', Georgia, serif; transition: background-color .2s ease, color .2s ease; }\n  .hero-secondary:hover { background: var(--page-green); color: #fffaf5 !important; }\n  .hero-note { margin-top: 44px; padding-top: 15px; border-top: 1px solid var(--page-line); color: var(--page-muted); font: 500 11px/1.5 'Literata', Georgia, serif; }\n  .hero-note strong { color: var(--page-green-2); font-weight: 600; }\n\n  .section { padding: 104px 0; }\n  .section-green { background: var(--page-green); color: #fffaf5; }\n  .section-head { display: grid; grid-template-columns: minmax(230px, .7fr) minmax(0, 1.3fr); gap: 64px; align-items: end; padding-bottom: 30px; border-bottom: 1px solid var(--page-line); }\n  .section-green .section-head { border-color: rgba(255,255,255,.22); }\n  .section-index { margin-bottom: 12px; color: var(--page-gold); font: 600 11px/1 'Literata', Georgia, serif; letter-spacing: .16em; }\n  .section-title { margin: 0; color: var(--page-green); font: 700 clamp(2.6rem, 5vw, 5rem)/.98 'Playfair Display', Georgia, serif; letter-spacing: -.04em; }\n  .section-green .section-title { color: #f6efe4; }\n  .section-intro { margin: 0; max-width: 700px; color: var(--page-muted); font: 400 17px/1.75 'Literata', Georgia, serif; }\n  .section-green .section-intro { color: #d4e1d7; }\n\n  .about-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); gap: 72px; padding-top: 58px; align-items: start; }\n  .about-copy { max-width: 680px; color: var(--page-ink); font: 400 19px/1.85 'Literata', Georgia, serif; }\n  .about-copy strong { color: var(--page-green-2); font-weight: 600; }\n  .about-aside { border-top: 3px solid var(--page-green); }\n  .about-aside-row { display: grid; grid-template-columns: 32px 1fr; gap: 14px; padding: 17px 0; border-bottom: 1px solid var(--page-line); }\n  .about-aside-row b { color: var(--page-gold); font: 700 14px/1 'Playfair Display', Georgia, serif; }\n  .about-aside-row span { color: var(--page-muted); font: 500 13px/1.45 'Literata', Georgia, serif; }\n  .about-aside-row strong { display: block; margin-bottom: 3px; color: var(--page-green); font: 700 17px/1.2 'Playfair Display', Georgia, serif; }\n\n  .gallery { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 78px; gap: 14px; margin-top: 66px; }\n  .gallery-item { position: relative; min-width: 0; padding: 0; overflow: hidden; border: 0; background: var(--page-green); cursor: zoom-in; text-align: left; }\n  .gallery-item:nth-child(1) { grid-column: span 5; grid-row: span 5; }\n  .gallery-item:nth-child(2) { grid-column: span 3; grid-row: span 3; }\n  .gallery-item:nth-child(3) { grid-column: span 4; grid-row: span 4; }\n  .gallery-item:nth-child(4) { grid-column: span 3; grid-row: span 3; }\n  .gallery-item:nth-child(5) { grid-column: span 4; grid-row: span 4; }\n  .gallery-item:nth-child(6) { grid-column: span 5; grid-row: span 4; }\n  .gallery-item img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.88); transition: transform .5s ease, filter .5s ease; }\n  .gallery-item:hover img { transform: scale(1.045); filter: saturate(1.05); }\n  .gallery-item::after { content: ''; position: absolute; inset: 38% 0 0; background: linear-gradient(transparent, rgba(8, 30, 18, .82)); opacity: .85; }\n  .gallery-caption { position: absolute; z-index: 1; right: 14px; bottom: 12px; left: 14px; color: #fffaf5; font: 500 12px/1.35 'Literata', Georgia, serif; }\n\n  .film-section { position: relative; padding: 104px 0 116px; background: #20282b; color: #f4f0ec; overflow: hidden; }\n  .film-section::before,\n  .film-section::after { content: ''; position: absolute; right: 0; left: 0; height: 16px; background: repeating-linear-gradient(90deg, #131718 0, #131718 12px, #586268 12px, #586268 19px, #131718 19px, #131718 33px); opacity: .8; }\n  .film-section::before { top: 0; }\n  .film-section::after { bottom: 0; }\n  .film-inner { display: grid; grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr); gap: 72px; align-items: center; }\n  .film-kicker { color: #e2b035; font: 600 11px/1.2 'Literata', Georgia, serif; letter-spacing: .16em; text-transform: uppercase; }\n  .film-title { margin: 17px 0 18px; color: #f6efe4; font: 700 clamp(2.4rem, 4vw, 4.3rem)/1 'Playfair Display', Georgia, serif; letter-spacing: -.04em; }\n  .film-copy { color: #bfcbc4; font: 400 15px/1.75 'Literata', Georgia, serif; }\n  .film-meta { display: flex; gap: 18px; margin-top: 26px; color: #e2e7df; font: 500 11px/1.4 'Literata', Georgia, serif; }\n  .film-frame { position: relative; padding: 12px; background: #0f1516; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 24px 46px rgba(0,0,0,.3); }\n  .film-frame video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #0d1314; }\n  .film-label { display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; color: #b9c5be; font: 500 10px/1.3 'Literata', Georgia, serif; letter-spacing: .05em; text-transform: uppercase; }\n\n  .services-grid { display: grid; grid-template-columns: minmax(280px, .68fr) minmax(0, 1.32fr); gap: 72px; margin-top: 58px; align-items: start; }\n  .service-list { border-top: 1px solid var(--page-line); }\n  .service-option { width: 100%; display: grid; grid-template-columns: 42px 1fr 22px; gap: 12px; align-items: center; padding: 20px 0; border: 0; border-bottom: 1px solid var(--page-line); background: transparent; color: var(--page-muted); text-align: left; cursor: pointer; }\n  .service-option:hover,\n  .service-option[aria-expanded='true'] { color: var(--page-green); }\n  .service-option[aria-expanded='true'] { border-bottom-color: var(--page-green); }\n  .service-num { color: var(--page-gold); font: 600 11px/1 'Literata', Georgia, serif; }\n  .service-name { font: 700 clamp(1.25rem, 2.3vw, 2rem)/1.1 'Playfair Display', Georgia, serif; }\n  .service-arrow { font-size: 22px; text-align: right; }\n  .service-panel { min-height: 360px; padding: 38px 42px 34px; background: var(--page-surface-2); border-top: 5px solid var(--page-green); }\n  .service-panel-kicker { color: var(--page-green-2); font: 600 11px/1.2 'Literata', Georgia, serif; letter-spacing: .14em; text-transform: uppercase; }\n  .service-panel h3 { margin: 16px 0 14px; color: var(--page-green); font: 700 clamp(2rem, 4vw, 3.6rem)/1 'Playfair Display', Georgia, serif; letter-spacing: -.035em; }\n  .service-panel p { max-width: 660px; margin: 0; color: var(--page-muted); font: 400 15px/1.75 'Literata', Georgia, serif; }\n  .service-details { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 34px; margin: 28px 0; padding: 20px 0; border-top: 1px solid var(--page-line); border-bottom: 1px solid var(--page-line); }\n  .service-detail-label { display: block; margin-bottom: 5px; color: var(--page-gold); font: 600 10px/1.2 'Literata', Georgia, serif; letter-spacing: .1em; text-transform: uppercase; }\n  .service-detail-value { color: var(--page-ink); font: 500 13px/1.5 'Literata', Georgia, serif; }\n  .service-link { display: inline-flex; align-items: center; gap: 8px; color: var(--page-green-2) !important; font: 600 13px/1.3 'Literata', Georgia, serif; }\n  .service-link:hover { color: var(--page-gold) !important; }\n\n  .contact-section { padding: 0; background: var(--page-green); }\n  .contact-grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); }\n  .contact-info { padding: 90px clamp(28px, 7vw, 96px) 90px 0; color: #f4f0ec; }\n  .contact-info .section-index { color: #e2b035; }\n  .contact-info h2 { max-width: 550px; margin: 0 0 22px; color: #f6efe4; font: 700 clamp(2.8rem, 5vw, 5rem)/.98 'Playfair Display', Georgia, serif; letter-spacing: -.04em; }\n  .contact-info p { max-width: 520px; color: #d4e1d7; font: 400 15px/1.75 'Literata', Georgia, serif; }\n  .contact-list { list-style: none; padding: 26px 0 0; margin: 0; border-top: 1px solid rgba(255,255,255,.22); }\n  .contact-list li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; padding: 11px 0; color: #e8eee8; font: 500 13px/1.5 'Literata', Georgia, serif; }\n  .contact-list i { color: #e2b035; font-size: 19px; }\n  .contact-list a:hover { color: #f4d88d; }\n  .access-panel { margin: 55px 0; padding: 52px clamp(28px, 5vw, 70px); background: var(--page-surface); color: var(--page-ink); border-left: 10px solid var(--page-gold); display: flex; flex-direction: column; justify-content: center; }\n  .access-panel .section-index { color: var(--page-green-2); }\n  .access-panel h3 { max-width: 540px; margin: 0 0 16px; color: var(--page-green); font: 700 clamp(2.2rem, 4vw, 4.2rem)/.98 'Playfair Display', Georgia, serif; letter-spacing: -.04em; }\n  .access-panel p { max-width: 500px; margin: 0 0 28px; color: var(--page-muted); font: 400 15px/1.75 'Literata', Georgia, serif; }\n  .access-notice { margin-top: 22px; color: var(--page-muted); font: 500 11px/1.5 'Literata', Georgia, serif; }\n\n  .site-footer { padding: 68px 0 30px; background: #101c16; color: #ecf2eb; }\n  .footer-top { display: grid; grid-template-columns: minmax(220px, 1.1fr) repeat(3, minmax(130px, .7fr)); gap: 34px; padding-bottom: 48px; border-bottom: 1px solid rgba(255,255,255,.2); }\n  .footer-brand img { width: 150px; filter: brightness(0) invert(1); margin-bottom: 17px; }\n  .footer-brand p { max-width: 310px; margin: 0; color: #b9c8bc; font: 400 12px/1.7 'Literata', Georgia, serif; }\n  .footer-heading { margin: 0 0 15px; color: #e2b035; font: 600 11px/1.2 'Literata', Georgia, serif; letter-spacing: .13em; text-transform: uppercase; }\n  .footer-links { list-style: none; padding: 0; margin: 0; }\n  .footer-links li { margin-bottom: 9px; }\n  .footer-links a { color: #d9e4da; font: 400 12px/1.45 'Literata', Georgia, serif; }\n  .footer-links a:hover { color: #f4d88d; }\n  .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 24px; color: #a9b8ad; font: 400 10px/1.4 'Literata', Georgia, serif; }\n\n  .lightbox { position: fixed; inset: 0; z-index: 300; display: grid; place-items: center; padding: 24px; background: rgba(8, 18, 13, .87); }\n  .lightbox[hidden] { display: none; }\n  .lightbox-dialog { position: relative; width: min(920px, 100%); max-height: min(88vh, 780px); padding: 14px; background: var(--page-surface); border: 1px solid rgba(255,255,255,.25); box-shadow: var(--page-shadow); }\n  .lightbox-dialog img { width: 100%; max-height: 68vh; object-fit: contain; background: var(--page-surface-2); }\n  .lightbox-meta { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-top: 13px; color: var(--page-ink); font: 500 13px/1.45 'Literata', Georgia, serif; }\n  .lightbox-close, .lightbox-arrow { min-width: 44px; min-height: 44px; border: 1px solid var(--page-line); background: var(--page-surface); color: var(--page-ink); cursor: pointer; }\n  .lightbox-arrow { position: absolute; top: 50%; transform: translateY(-50%); background: var(--page-green); color: #fffaf5; border-color: var(--page-green); }\n  .lightbox-arrow.prev { left: -56px; }\n  .lightbox-arrow.next { right: -56px; }\n  .lightbox-close { position: absolute; top: -56px; right: 0; }\n\n  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }\n  [data-reveal].is-visible { opacity: 1; transform: none; }\n  @media (prefers-reduced-motion: reduce) {\n    .invilara-page *, .invilara-page *::before, .invilara-page *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }\n    [data-reveal] { opacity: 1; transform: none; }\n  }\n\n  @media (max-width: 980px) {\n    .header-inner, .editorial-wrap { width: min(100% - 36px, 760px); }\n    .header-nav, .header-actions .header-login { display: none; }\n    .menu-toggle { display: inline-flex; }\n    .brand { min-width: 0; flex: 1; }\n    .brand img { width: 132px; }\n    .hero-spread { grid-template-columns: 1fr; }\n    .hero-photo { min-height: 420px; }\n    .hero-copy { min-height: 520px; border-top: 10px solid var(--page-green); border-left: 0; padding: 60px 8vw; }\n    .section-head, .about-grid, .film-inner, .services-grid, .contact-grid { grid-template-columns: 1fr; gap: 40px; }\n    .about-grid { padding-top: 38px; }\n    .film-inner { gap: 34px; }\n    .contact-info { padding: 78px 0 48px; }\n    .access-panel { margin: 0 0 70px; }\n    .footer-top { grid-template-columns: 1.4fr 1fr 1fr; }\n    .footer-brand { grid-column: 1 / -1; }\n    .lightbox-arrow.prev { left: 10px; }\n    .lightbox-arrow.next { right: 10px; }\n  }\n\n  @media (max-width: 620px) {\n    .header-inner, .editorial-wrap { width: calc(100% - 32px); }\n    .site-header { position: sticky; }\n    .header-inner { min-height: 66px; }\n    .brand img { width: 118px; }\n    .theme-toggle { min-width: 44px; min-height: 44px; }\n    .hero-photo { min-height: 330px; }\n    .photo-caption { right: 16px; bottom: 17px; left: 16px; font-size: 10px; }\n    .hero-copy { min-height: auto; padding: 52px 22px 48px; }\n    .hero-title { font-size: clamp(2.7rem, 14vw, 4.5rem); }\n    .hero-lead { font-size: 15px; }\n    .hero-actions { display: grid; }\n    .hero-actions a { width: 100%; }\n    .section { padding: 74px 0; }\n    .section-head { gap: 20px; }\n    .section-title { font-size: 3rem; }\n    .about-copy { font-size: 16px; }\n    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 124px; gap: 9px; margin-top: 42px; }\n    .gallery-item:nth-child(1), .gallery-item:nth-child(6) { grid-column: span 2; grid-row: span 3; }\n    .gallery-item:nth-child(2), .gallery-item:nth-child(3), .gallery-item:nth-child(4), .gallery-item:nth-child(5) { grid-column: span 1; grid-row: span 2; }\n    .gallery-caption { font-size: 10px; }\n    .film-section { padding: 78px 0 88px; }\n    .film-title { font-size: 3rem; }\n    .service-panel { min-height: 0; padding: 28px 22px; }\n    .service-details { grid-template-columns: 1fr; gap: 13px; }\n    .access-panel { margin: 0 -16px 58px; padding: 44px 22px 50px; border-left: 0; border-top: 8px solid var(--page-gold); }\n    .footer-top { grid-template-columns: 1fr 1fr; gap: 30px 18px; }\n    .footer-brand { grid-column: 1 / -1; }\n    .footer-bottom { display: grid; gap: 8px; }\n    .lightbox { padding: 14px; }\n    .lightbox-dialog { padding: 9px; }\n    .lightbox-close { top: -52px; }\n  }\n</style>\n<div class=\"invilara-page\" data-kid=\"2\" data-theme=\"light\" id=\"invilaraPage\">\n    <a class=\"skip-link\" data-kid=\"2-1\" href=\"#contenido\">\n        Saltar al contenido principal\n    </a>\n    <div aria-hidden=\"true\" class=\"scroll-progress\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"scroll progress bar\" data-reason=\"width updated by script on scroll\">\n    </div>\n    <header class=\"site-header\" data-kid=\"2-3\" id=\"siteHeader\">\n        <div class=\"header-inner\" data-kid=\"2-3-1\">\n            <a aria-label=\"Invilara, volver al inicio\" class=\"brand\" data-kid=\"2-3-1-1\" href=\"#inicio\">\n                <img alt=\"Invilara\" data-kid=\"2-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/assets/img/INVILARA%20LOGO%20OFICIAL%20HORIZONTAL.png\"/>\n                <span class=\"brand-word\" data-kid=\"2-3-1-1-2\">\n                    Invilara\n                </span>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"header-nav\" data-kid=\"2-3-1-2\">\n                <a aria-current=\"true\" data-dynamic=\"true\" data-kid=\"2-3-1-2-1\" data-name=\"navigation link for home\" data-nav-link=\"\" data-reason=\"aria-current set to true/false by scroll intersection observer\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a data-dynamic=\"true\" data-kid=\"2-3-1-2-2\" data-name=\"navigation link for instituto\" data-nav-link=\"\" data-reason=\"aria-current set to true/false by scroll intersection observer\" href=\"#acerca\">\n                    Instituto\n                </a>\n                <a data-dynamic=\"true\" data-kid=\"2-3-1-2-3\" data-name=\"navigation link for en movimiento\" data-nav-link=\"\" data-reason=\"aria-current set to true/false by scroll intersection observer\" href=\"#video\">\n                    En movimiento\n                </a>\n                <a data-dynamic=\"true\" data-kid=\"2-3-1-2-4\" data-name=\"navigation link for capacidades\" data-nav-link=\"\" data-reason=\"aria-current set to true/false by scroll intersection observer\" href=\"#servicios\">\n                    Capacidades\n                </a>\n                <a data-dynamic=\"true\" data-kid=\"2-3-1-2-5\" data-name=\"navigation link for contacto\" data-nav-link=\"\" data-reason=\"aria-current set to true/false by scroll intersection observer\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <div class=\"header-actions\" data-kid=\"2-3-1-3\">\n                <a class=\"header-login\" data-kid=\"2-3-1-3-1\" href=\"#acceso\">\n                    <i aria-hidden=\"true\" class=\"bx bx-log-in-circle\" data-kid=\"2-3-1-3-1-1\">\n                    </i>\n                    Acceder al sistema\n                </a>\n                <button aria-label=\"Activar modo oscuro\" class=\"theme-toggle\" data-dynamic=\"true\" data-kid=\"2-3-1-3-2\" data-name=\"theme toggle button\" data-reason=\"aria-label, title, icon and label text updated by script\" data-theme-toggle=\"\" title=\"Cambiar modo de color\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bx bx-moon theme-icon\" data-kid=\"2-3-1-3-2-1\">\n                    </i>\n                    <span class=\"theme-label\" data-kid=\"2-3-1-3-2-2\">\n                        Modo oscuro\n                    </span>\n                </button>\n                <button aria-controls=\"mobileDrawer\" aria-expanded=\"false\" aria-label=\"Abrir menú\" class=\"menu-toggle\" data-dynamic=\"true\" data-kid=\"2-3-1-3-3\" data-name=\"menu toggle button\" data-reason=\"aria-expanded updated by script\" id=\"drawerOpen\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bx bx-menu\" data-kid=\"2-3-1-3-3-1\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <div aria-hidden=\"true\" class=\"drawer-backdrop\" data-dynamic=\"true\" data-kid=\"2-4\" data-name=\"mobile drawer backdrop\" data-reason=\"opacity and pointer-events toggled by script\" id=\"drawerBackdrop\">\n    </div>\n    <aside aria-hidden=\"true\" aria-label=\"Menú móvil\" class=\"mobile-drawer\" data-dynamic=\"true\" data-kid=\"2-5\" data-name=\"mobile drawer menu\" data-reason=\"transform and visibility toggled by script\" id=\"mobileDrawer\">\n        <div class=\"drawer-head\" data-kid=\"2-5-1\">\n            <span class=\"drawer-kicker\" data-kid=\"2-5-1-1\">\n                Instituto de Vialidad del Estado Lara\n            </span>\n            <button aria-label=\"Cerrar menú\" class=\"drawer-close\" data-kid=\"2-5-1-2\" id=\"drawerClose\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-x\" data-kid=\"2-5-1-2-1\">\n                </i>\n            </button>\n        </div>\n        <nav aria-label=\"Navegación móvil\" data-kid=\"2-5-2\">\n            <ul class=\"drawer-nav\" data-kid=\"2-5-2-1\">\n                <li data-kid=\"2-5-2-1-1\">\n                    <a data-drawer-link=\"\" data-kid=\"2-5-2-1-1-1\" href=\"#inicio\">\n                        Inicio\n                    </a>\n                </li>\n                <li data-kid=\"2-5-2-1-2\">\n                    <a data-drawer-link=\"\" data-kid=\"2-5-2-1-2-1\" href=\"#acerca\">\n                        El instituto\n                    </a>\n                </li>\n                <li data-kid=\"2-5-2-1-3\">\n                    <a data-drawer-link=\"\" data-kid=\"2-5-2-1-3-1\" href=\"#video\">\n                        En movimiento\n                    </a>\n                </li>\n                <li data-kid=\"2-5-2-1-4\">\n                    <a data-drawer-link=\"\" data-kid=\"2-5-2-1-4-1\" href=\"#servicios\">\n                        Capacidades\n                    </a>\n                </li>\n                <li data-kid=\"2-5-2-1-5\">\n                    <a data-drawer-link=\"\" data-kid=\"2-5-2-1-5-1\" href=\"#contacto\">\n                        Contacto\n                    </a>\n                </li>\n            </ul>\n        </nav>\n        <div class=\"drawer-bottom\" data-kid=\"2-5-3\">\n            <button aria-label=\"Activar modo oscuro\" class=\"theme-toggle\" data-kid=\"2-5-3-1\" data-theme-toggle=\"\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bx bx-moon theme-icon\" data-kid=\"2-5-3-1-1\">\n                </i>\n                <span class=\"theme-label\" data-kid=\"2-5-3-1-2\">\n                    Modo oscuro\n                </span>\n            </button>\n            <a class=\"header-login\" data-drawer-link=\"\" data-kid=\"2-5-3-2\" href=\"#acceso\">\n                <i aria-hidden=\"true\" class=\"bx bx-log-in-circle\" data-kid=\"2-5-3-2-1\">\n                </i>\n                Acceder al sistema\n            </a>\n        </div>\n    </aside>\n    <main data-kid=\"2-6\" id=\"contenido\">\n        <section aria-labelledby=\"heroTitle\" class=\"hero-spread\" data-kid=\"2-6-1\" id=\"inicio\">\n            <div class=\"hero-photo\" data-kid=\"2-6-1-1\">\n                <img alt=\"Fachada de la sede de Invilara en Barquisimeto\" data-kid=\"2-6-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/invilara_entrada.jpeg\"/>\n                <div class=\"photo-caption\" data-kid=\"2-6-1-1-2\">\n                    <span data-kid=\"2-6-1-1-2-1\">\n                        Sede principal · Barquisimeto\n                    </span>\n                    <span data-kid=\"2-6-1-1-2-2\">\n                        Una institución al servicio de Lara\n                    </span>\n                </div>\n            </div>\n            <div class=\"hero-copy\" data-kid=\"2-6-1-2\" data-reveal=\"\">\n                <div class=\"eyebrow\" data-kid=\"2-6-1-2-1\">\n                    Instituto de Vialidad del Estado Lara\n                </div>\n                <h1 class=\"hero-title\" data-kid=\"2-6-1-2-2\" id=\"heroTitle\">\n                    Conectamos a Lara a través de su vialidad.\n                </h1>\n                <p class=\"hero-lead\" data-kid=\"2-6-1-2-3\">\n                    Planificamos, construimos y conservamos las vías que unen municipios, parroquias y comunidades. Una gestión pública cercana, técnica y visible en el territorio.\n                </p>\n                <div class=\"hero-actions\" data-kid=\"2-6-1-2-4\">\n                    <a class=\"access-button\" data-kid=\"2-6-1-2-4-1\" href=\"#acceso\">\n                        <i aria-hidden=\"true\" class=\"bx bx-log-in-circle\" data-kid=\"2-6-1-2-4-1-1\">\n                        </i>\n                        Acceder al sistema\n                    </a>\n                    <a class=\"hero-secondary\" data-kid=\"2-6-1-2-4-2\" href=\"#acerca\">\n                        <i aria-hidden=\"true\" class=\"bx bx-arrow-down-right\" data-kid=\"2-6-1-2-4-2-1\">\n                        </i>\n                        Conocer Invilara\n                    </a>\n                </div>\n                <p class=\"hero-note\" data-kid=\"2-6-1-2-5\">\n                    <strong data-kid=\"2-6-1-2-5-1\">\n                        Obras · Inspecciones · Proyectos · Solicitudes\n                    </strong>\n                    <br data-kid=\"2-6-1-2-5-2\"/>\n                    Información institucional para quienes hacen y recorren Lara.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"aboutTitle\" class=\"section\" data-kid=\"2-6-2\" id=\"acerca\">\n            <div class=\"editorial-wrap\" data-kid=\"2-6-2-1\">\n                <div class=\"section-head\" data-kid=\"2-6-2-1-1\" data-reveal=\"\">\n                    <div data-kid=\"2-6-2-1-1-1\">\n                        <div class=\"section-index\" data-kid=\"2-6-2-1-1-1-1\">\n                            01 / EL INSTITUTO\n                        </div>\n                        <h2 class=\"section-title\" data-kid=\"2-6-2-1-1-1-2\" id=\"aboutTitle\">\n                            Trabajo visible, gestión que conecta.\n                        </h2>\n                    </div>\n                    <p class=\"section-intro\" data-kid=\"2-6-2-1-1-2\">\n                        Invilara es la institución responsable de convertir las necesidades de movilidad del Estado Lara en planificación, obra, seguimiento y atención. Nuestra labor ocurre en la carretera, en la comunidad y en cada municipio y parroquia que necesita mantenerse conectado.\n                    </p>\n                </div>\n                <div class=\"about-grid\" data-kid=\"2-6-2-1-2\">\n                    <p class=\"about-copy\" data-kid=\"2-6-2-1-2-1\" data-reveal=\"\">\n                        Desde la\n                        <strong data-kid=\"2-6-2-1-2-1-1\">\n                            construcción y rehabilitación\n                        </strong>\n                        hasta la inspección técnica y la gestión de solicitudes, articulamos equipos y recursos para que la infraestructura vial cumpla su propósito: facilitar el encuentro, el trabajo y el acceso a los servicios. Aquí la información no es un adorno; es parte de una gestión transparente y útil para la ciudadanía.\n                    </p>\n                    <div aria-label=\"Áreas de trabajo de Invilara\" class=\"about-aside\" data-kid=\"2-6-2-1-2-2\" data-reveal=\"\">\n                        <div class=\"about-aside-row\" data-kid=\"2-6-2-1-2-2-1\">\n                            <b data-kid=\"2-6-2-1-2-2-1-1\">\n                                01\n                            </b>\n                            <div data-kid=\"2-6-2-1-2-2-1-2\">\n                                <strong data-kid=\"2-6-2-1-2-2-1-2-1\">\n                                    Obras viales\n                                </strong>\n                                <span data-kid=\"2-6-2-1-2-2-1-2-2\">\n                                    Construcción, rehabilitación y mantenimiento en el territorio.\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"about-aside-row\" data-kid=\"2-6-2-1-2-2-2\">\n                            <b data-kid=\"2-6-2-1-2-2-2-1\">\n                                02\n                            </b>\n                            <div data-kid=\"2-6-2-1-2-2-2-2\">\n                                <strong data-kid=\"2-6-2-1-2-2-2-2-1\">\n                                    Inspecciones\n                                </strong>\n                                <span data-kid=\"2-6-2-1-2-2-2-2-2\">\n                                    Seguimiento técnico para priorizar seguridad y continuidad.\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"about-aside-row\" data-kid=\"2-6-2-1-2-2-3\">\n                            <b data-kid=\"2-6-2-1-2-2-3-1\">\n                                03\n                            </b>\n                            <div data-kid=\"2-6-2-1-2-2-3-2\">\n                                <strong data-kid=\"2-6-2-1-2-2-3-2-1\">\n                                    Proyectos y contratos\n                                </strong>\n                                <span data-kid=\"2-6-2-1-2-2-3-2-2\">\n                                    Planificación y alianzas con criterios de responsabilidad pública.\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"about-aside-row\" data-kid=\"2-6-2-1-2-2-4\">\n                            <b data-kid=\"2-6-2-1-2-2-4-1\">\n                                04\n                            </b>\n                            <div data-kid=\"2-6-2-1-2-2-4-2\">\n                                <strong data-kid=\"2-6-2-1-2-2-4-2-1\">\n                                    Solicitudes ciudadanas\n                                </strong>\n                                <span data-kid=\"2-6-2-1-2-2-4-2-2\">\n                                    Requerimientos que ayudan a orientar las intervenciones.\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div aria-label=\"Registro visual de obras y equipos de Invilara\" class=\"gallery\" data-kid=\"2-6-2-1-3\">\n                    <button aria-label=\"Abrir imagen: Rehabilitación y conservación de la vialidad\" class=\"gallery-item\" data-caption=\"Rehabilitación y conservación de la vialidad\" data-kid=\"2-6-2-1-3-1\" type=\"button\">\n                        <img alt=\"Trabajadores realizando labores sobre una vía\" data-kid=\"2-6-2-1-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                        <span class=\"gallery-caption\" data-kid=\"2-6-2-1-3-1-2\">\n                            Rehabilitación y conservación\n                        </span>\n                    </button>\n                    <button aria-label=\"Abrir imagen: Inspección del estado de la vía\" class=\"gallery-item\" data-caption=\"Inspección del estado de la vía\" data-kid=\"2-6-2-1-3-2\" type=\"button\">\n                        <img alt=\"Equipo realizando una inspección en campo\" data-kid=\"2-6-2-1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/2.jpeg\"/>\n                        <span class=\"gallery-caption\" data-kid=\"2-6-2-1-3-2-2\">\n                            Inspecciones en campo\n                        </span>\n                    </button>\n                    <button aria-label=\"Abrir imagen: Atención de puntos críticos en carretera\" class=\"gallery-item\" data-caption=\"Atención de puntos críticos en carretera\" data-kid=\"2-6-2-1-3-3\" type=\"button\">\n                        <img alt=\"Personal trabajando junto a una carretera\" data-kid=\"2-6-2-1-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/3.jpeg\"/>\n                        <span class=\"gallery-caption\" data-kid=\"2-6-2-1-3-3-2\">\n                            Puntos críticos\n      