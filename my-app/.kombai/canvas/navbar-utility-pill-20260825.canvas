      "html": "<link data-kid=\"1\" href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" data-kid=\"2\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link data-kid=\"3\" href=\"https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\"/>\n<link data-kid=\"4\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js\">\n</script>\n<style>\n    .demo-body {\n    margin: 0;\n    min-width: 0;\n    min-height: 100vh;\n    overflow-x: hidden;\n    background: #f4f6f8;\n    color: #25313a;\n    font-family: 'Open Sans', Arial, sans-serif;\n    font-size: 14px;\n  }\n\n  .dashboard-scene {\n    position: relative;\n    min-height: 760px;\n    overflow: hidden;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.96) 0 82px, transparent 82px),\n      #f4f6f8;\n  }\n\n  .dashboard-scene::after {\n    content: '';\n    position: absolute;\n    inset: 82px 0 0;\n    pointer-events: none;\n    background: linear-gradient(180deg, rgba(244,246,248,0) 0%, rgba(244,246,248,.3) 100%);\n  }\n\n  .dashboard-sidebar {\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 82px;\n    background: #0c5c31;\n    opacity: .96;\n  }\n\n  .dashboard-sidebar::before {\n    content: 'I';\n    position: absolute;\n    top: 24px;\n    left: 22px;\n    width: 38px;\n    height: 38px;\n    display: grid;\n    place-items: center;\n    border-radius: 12px;\n    background: #08b324;\n    color: #fff;\n    font-size: 20px;\n    font-weight: 700;\n    box-shadow: 0 8px 18px rgba(0,0,0,.16);\n  }\n\n  .dashboard-sidebar::after {\n    content: '•••\\A\\A•••\\A\\A•••\\A\\A•••\\A\\A•••';\n    white-space: pre;\n    position: absolute;\n    top: 112px;\n    left: 32px;\n    color: rgba(255,255,255,.55);\n    line-height: 1.7;\n    letter-spacing: 2px;\n  }\n\n  .dashboard-content {\n    position: relative;\n    z-index: 1;\n    margin-left: 82px;\n    padding: 36px 28px 52px;\n  }\n\n  .dashboard-heading {\n    max-width: 600px;\n    padding-top: 20px;\n  }\n\n  .dashboard-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 10px;\n    color: #0b7c38;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .dashboard-kicker i {\n    font-size: 13px;\n  }\n\n  .dashboard-heading h1 {\n    margin: 0;\n    color: #25313a;\n    font-size: clamp(28px, 3.5vw, 38px);\n    font-weight: 700;\n    letter-spacing: -.035em;\n    line-height: 1.08;\n  }\n\n  .dashboard-heading p {\n    margin: 9px 0 0;\n    color: #7a8791;\n    font-size: 14px;\n  }\n\n  .dashboard-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 16px;\n    margin-top: 28px;\n  }\n\n  .kpi-card,\n  .chart-card {\n    border: 1px solid rgba(32,55,68,.07);\n    background: rgba(255,255,255,.92);\n    box-shadow: 0 5px 18px rgba(29,46,57,.055);\n  }\n\n  .kpi-card {\n    min-height: 107px;\n    padding: 18px;\n    border-radius: 16px;\n  }\n\n  .kpi-top {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .kpi-label {\n    color: #87939b;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n\n  .kpi-value {\n    margin-top: 12px;\n    color: #25313a;\n    font-size: 28px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .kpi-icon {\n    width: 34px;\n    height: 34px;\n    display: grid;\n    place-items: center;\n    border-radius: 11px;\n    font-size: 16px;\n  }\n\n  .kpi-icon.green { background: #e8f7ec; color: #08a52f; }\n  .kpi-icon.amber { background: #fff5d9; color: #d59600; }\n  .kpi-icon.blue { background: #e7f5f8; color: #158aa0; }\n  .kpi-icon.purple { background: #f0edff; color: #7668c7; }\n\n  .dashboard-charts {\n    display: grid;\n    grid-template-columns: 1.05fr .95fr;\n    gap: 16px;\n    margin-top: 16px;\n  }\n\n  .chart-card {\n    min-height: 292px;\n    padding: 20px;\n    border-radius: 16px;\n  }\n\n  .chart-card-header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 18px;\n  }\n\n  .chart-card h2 {\n    margin: 0;\n    color: #45545e;\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .chart-card p {\n    margin: 5px 0 0;\n    color: #96a0a8;\n    font-size: 12px;\n  }\n\n  .chart-period {\n    padding: 6px 9px;\n    border: 1px solid #e6eaed;\n    border-radius: 8px;\n    color: #73808a;\n    font-size: 11px;\n    white-space: nowrap;\n  }\n\n  .chart-wrap {\n    position: relative;\n    height: 205px;\n  }\n\n  .utility-cluster {\n    position: absolute;\n    top: max(18px, env(safe-area-inset-top));\n    right: max(20px, env(safe-area-inset-right));\n    z-index: 20;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    min-height: 60px;\n    padding: 7px;\n    border: 1px solid rgba(22,52,36,.08);\n    border-radius: 50px;\n    background: #fff;\n    box-shadow: 0 14px 30px rgba(28,50,38,.14), 0 2px 6px rgba(28,50,38,.08);\n  }\n\n  .utility-trigger {\n    position: relative;\n    min-width: 44px;\n    min-height: 44px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    padding: 4px 10px;\n    border: 0;\n    border-radius: 999px;\n    background: transparent;\n    color: #5f6c74;\n    cursor: pointer;\n    font: inherit;\n    text-align: left;\n  }\n\n  .utility-trigger:hover {\n    background: #effaf2;\n    color: #087d2a;\n  }\n\n  .utility-trigger:focus-visible,\n  .menu-item:focus-visible,\n  .panel-action:focus-visible,\n  .theme-toggle:focus-visible {\n    outline: 3px solid rgba(8,179,36,.35);\n    outline-offset: 2px;\n  }\n\n  .utility-trigger i {\n    flex: 0 0 auto;\n    font-size: 20px;\n    line-height: 1;\n  }\n\n  .utility-trigger-profile {\n    padding-right: 13px;\n  }\n\n  .utility-divider {\n    width: 1px;\n    height: 28px;\n    background: #e4e9e5;\n  }\n\n  .notification-badge {\n    position: absolute;\n    top: 1px;\n    right: 1px;\n    min-width: 19px;\n    height: 19px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0 5px;\n    border: 2px solid #fff;\n    border-radius: 999px;\n    background: #dc3545;\n    color: #fff;\n    font-size: 10px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .profile-avatar {\n    width: 36px;\n    height: 36px;\n    flex: 0 0 auto;\n    border: 2px solid #d9efe0;\n    border-radius: 50%;\n    object-fit: cover;\n  }\n\n  .profile-copy {\n    display: flex;\n    min-width: 0;\n    flex-direction: column;\n    align-items: flex-start;\n    line-height: 1.15;\n  }\n\n  .profile-name {\n    max-width: 120px;\n    overflow: hidden;\n    color: #2c3a32;\n    font-size: 13px;\n    font-weight: 700;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .profile-role {\n    margin-top: 3px;\n    color: #8b9690;\n    font-size: 10px;\n    font-weight: 600;\n  }\n\n  .utility-panel {\n    position: absolute;\n    top: calc(100% + 12px);\n    right: 0;\n    width: min(360px, calc(100vw - 24px));\n    max-width: calc(100vw - 24px);\n    overflow: hidden;\n    border: 1px solid rgba(35,55,44,.09);\n    border-radius: 18px;\n    background: #fff;\n    box-shadow: 0 20px 45px rgba(23,42,30,.17), 0 4px 12px rgba(23,42,30,.08);\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(-7px) scale(.985);\n    transform-origin: top right;\n    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;\n    visibility: hidden;\n  }\n\n  .utility-panel.is-open {\n    opacity: 1;\n    pointer-events: auto;\n    transform: translateY(0) scale(1);\n    visibility: visible;\n  }\n\n  .panel-header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 18px 18px 14px;\n    border-bottom: 1px solid #eef1ef;\n  }\n\n  .panel-title-row {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n  }\n\n  .panel-title-row i {\n    color: #08a52f;\n    font-size: 17px;\n  }\n\n  .panel-title {\n    color: #2d3d34;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .panel-count {\n    min-width: 22px;\n    height: 22px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0 6px;\n    border-radius: 999px;\n    background: #fde8eb;\n    color: #c9283c;\n    font-size: 11px;\n    font-weight: 700;\n  }\n\n  .panel-actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    gap: 8px;\n  }\n\n  .panel-action {\n    min-height: 32px;\n    padding: 4px 7px;\n    border: 0;\n    border-radius: 7px;\n    background: transparent;\n    color: #087d2a;\n    cursor: pointer;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n  }\n\n  .panel-action:hover {\n    background: #effaf2;\n  }\n\n  .panel-action.secondary {\n    color: #718078;\n    font-weight: 600;\n  }\n\n  .notification-list {\n    max-height: 276px;\n    overflow-y: auto;\n  }\n\n  .notification-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 11px;\n    min-height: 78px;\n    padding: 14px 17px;\n    border-bottom: 1px solid #f0f2f1;\n    cursor: pointer;\n  }\n\n  .notification-item:last-child {\n    border-bottom: 0;\n  }\n\n  .notification-item:hover {\n    background: #f8fcf9;\n  }\n\n  .notification-icon {\n    width: 30px;\n    height: 30px;\n    display: grid;\n    flex: 0 0 auto;\n    place-items: center;\n    border-radius: 9px;\n    background: #eaf8ed;\n    color: #08a52f;\n    font-size: 14px;\n  }\n\n  .notification-item:nth-child(2) .notification-icon {\n    background: #fff5dc;\n    color: #c58a00;\n  }\n\n  .notification-item:nth-child(3) .notification-icon {\n    background: #e8f4f8;\n    color: #158aa0;\n  }\n\n  .notification-content {\n    min-width: 0;\n    flex: 1;\n  }\n\n  .notification-title {\n    color: #33433a;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.35;\n  }\n\n  .notification-detail {\n    margin-top: 4px;\n    color: #68776e;\n    font-size: 11px;\n    line-height: 1.4;\n  }\n\n  .notification-time {\n    margin-top: 5px;\n    color: #9aa59e;\n    font-size: 10px;\n  }\n\n  .notification-unread {\n    width: 7px;\n    height: 7px;\n    margin-top: 5px;\n    border-radius: 50%;\n    background: #dc3545;\n  }\n\n  .panel-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 11px 17px;\n    border-top: 1px solid #eef1ef;\n    background: #fbfcfb;\n    color: #7b8981;\n    font-size: 10px;\n  }\n\n  .panel-footer strong {\n    color: #4c5d53;\n    font-weight: 700;\n  }\n\n  .profile-panel {\n    padding: 10px;\n  }\n\n  .profile-summary {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    margin: 2px 2px 9px;\n    padding: 10px 9px 13px;\n    border-bottom: 1px solid #eef1ef;\n  }\n\n  .profile-summary .profile-avatar {\n    width: 42px;\n    height: 42px;\n  }\n\n  .profile-summary-copy strong {\n    display: block;\n    color: #2d3d34;\n    font-size: 13px;\n  }\n\n  .profile-summary-copy span {\n    display: block;\n    margin-top: 3px;\n    color: #89958e;\n    font-size: 10px;\n  }\n\n  .menu-item {\n    min-height: 44px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    width: 100%;\n    box-sizing: border-box;\n    padding: 8px 10px;\n    border: 0;\n    border-radius: 10px;\n    background: transparent;\n    color: #4c5c53;\n    cursor: pointer;\n    font: inherit;\n    font-size: 12px;\n    text-align: left;\n    text-decoration: none;\n  }\n\n  .menu-item:hover {\n    background: #f0faf2;\n    color: #087d2a;\n  }\n\n  .menu-item i {\n    width: 20px;\n    color: #08a52f;\n    font-size: 16px;\n    text-align: center;\n  }\n\n  .menu-item.danger {\n    color: #c73a4a;\n  }\n\n  .menu-item.danger i {\n    color: #dc3545;\n  }\n\n  .menu-divider {\n    height: 1px;\n    margin: 7px 7px;\n    background: #eef1ef;\n  }\n\n  .theme-toggle {\n    margin-left: auto;\n    appearance: none;\n    width: 42px;\n    height: 24px;\n    position: relative;\n    border: 0;\n    border-radius: 999px;\n    background: #c9d1cd;\n    cursor: pointer;\n    transition: background .18s ease;\n  }\n\n  .theme-toggle::after {\n    content: '';\n    position: absolute;\n    top: 3px;\n    left: 3px;\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: #fff;\n    box-shadow: 0 2px 5px rgba(24,42,32,.22);\n    transition: transform .18s ease;\n  }\n\n  .theme-toggle:checked {\n    background: #08b324;\n  }\n\n  .theme-toggle:checked::after {\n    transform: translateX(18px);\n  }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0,0,0,0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  .utility-live {\n    position: fixed;\n    right: 18px;\n    bottom: 18px;\n    z-index: 40;\n    max-width: 260px;\n    padding: 9px 12px;\n    border: 1px solid #dfe8e2;\n    border-radius: 10px;\n    background: #fff;\n    box-shadow: 0 8px 22px rgba(20,40,28,.12);\n    color: #526158;\n    font-size: 11px;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(5px);\n    transition: opacity .18s ease, transform .18s ease;\n  }\n\n  .utility-live.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .dark-mode .dashboard-scene {\n    background: #171f1b;\n  }\n\n  .dark-mode .dashboard-scene::after {\n    background: linear-gradient(180deg, rgba(23,31,27,0) 0%, rgba(23,31,27,.35) 100%);\n  }\n\n  .dark-mode .dashboard-scene::before {\n    background: #202b24;\n  }\n\n  .dark-mode .dashboard-heading h1,\n  .dark-mode .kpi-value {\n    color: #eef6f0;\n  }\n\n  .dark-mode .dashboard-heading p,\n  .dark-mode .chart-card p,\n  .dark-mode .kpi-label {\n    color: #95a69a;\n  }\n\n  .dark-mode .kpi-card,\n  .dark-mode .chart-card {\n    border-color: #2b3930;\n    background: #202a24;\n    box-shadow: 0 6px 18px rgba(0,0,0,.16);\n  }\n\n  .dark-mode .chart-card h2 {\n    color: #d8e6dc;\n  }\n\n  .dark-mode .chart-period {\n    border-color: #35443a;\n    color: #9eada3;\n  }\n\n  .dark-mode .utility-cluster,\n  .dark-mode .utility-panel,\n  .dark-mode .utility-live {\n    border-color: #35453a;\n    background: #222d26;\n    color: #dae8de;\n  }\n\n  .dark-mode .utility-trigger {\n    color: #c7d6ca;\n  }\n\n  .dark-mode .utility-trigger:hover,\n  .dark-mode .menu-item:hover,\n  .dark-mode .notification-item:hover,\n  .dark-mode .panel-action:hover {\n    background: #2b3d30;\n    color: #9ee7ad;\n  }\n\n  .dark-mode .profile-name,\n  .dark-mode .panel-title,\n  .dark-mode .profile-summary-copy strong,\n  .dark-mode .notification-title {\n    color: #e7f2e9;\n  }\n\n  .dark-mode .profile-role,\n  .dark-mode .profile-summary-copy span,\n  .dark-mode .notification-time {\n    color: #91a197;\n  }\n\n  .dark-mode .notification-detail,\n  .dark-mode .menu-item {\n    color: #b8c9bc;\n  }\n\n  .dark-mode .utility-divider,\n  .dark-mode .panel-header,\n  .dark-mode .notification-item,\n  .dark-mode .profile-summary,\n  .dark-mode .menu-divider,\n  .dark-mode .panel-footer {\n    border-color: #35453a;\n  }\n\n  .dark-mode .panel-footer {\n    background: #1e2922;\n    color: #91a197;\n  }\n\n  .dark-mode .panel-footer strong {\n    color: #c4d3c8;\n  }\n\n  @media (max-width: 720px) {\n    .dashboard-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .dashboard-charts {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  @media (max-width: 520px) {\n    .dashboard-sidebar {\n      width: 58px;\n    }\n\n    .dashboard-sidebar::before {\n      left: 11px;\n    }\n\n    .dashboard-sidebar::after {\n      left: 20px;\n    }\n\n    .dashboard-content {\n      margin-left: 58px;\n      padding: 104px 15px 42px;\n    }\n\n    .dashboard-heading {\n      padding-top: 0;\n    }\n\n    .dashboard-heading h1 {\n      font-size: 27px;\n    }\n\n    .utility-cluster {\n      top: max(12px, env(safe-area-inset-top));\n      right: max(12px, env(safe-area-inset-right));\n      min-height: 58px;\n      padding: 6px;\n    }\n\n    .profile-copy {\n      display: none;\n    }\n\n    .utility-trigger-profile {\n      width: 44px;\n      padding: 4px;\n    }\n\n    .utility-panel {\n      right: 0;\n      width: min(360px, calc(100vw - 24px));\n      max-width: calc(100vw - 24px);\n    }\n\n    .panel-header {\n      align-items: center;\n    }\n\n    .panel-actions {\n      gap: 4px;\n    }\n\n    .panel-action {\n      padding-inline: 5px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    .dashboard-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .panel-header {\n      flex-direction: column;\n      align-items: stretch;\n    }\n\n    .panel-actions {\n      justify-content: flex-start;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .utility-panel,\n    .utility-live,\n    .theme-toggle,\n    .theme-toggle::after {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"demo-body\" data-kid=\"5\" id=\"utilityDemo\">\n    <section aria-label=\"Vista previa del panel principal de INVILARA\" class=\"dashboard-scene\" data-kid=\"5-1\">\n        <aside aria-hidden=\"true\" class=\"dashboard-sidebar\" data-kid=\"5-1-1\">\n        </aside>\n        <main class=\"dashboard-content\" data-kid=\"5-1-2\">\n            <div class=\"dashboard-heading\" data-kid=\"5-1-2-1\">\n                <div class=\"dashboard-kicker\" data-kid=\"5-1-2-1-1\">\n                    <i class=\"bi bi-grid-1x2-fill\" data-kid=\"5-1-2-1-1-1\">\n                    </i>\n                    Panel de control\n                </div>\n                <h1 data-kid=\"5-1-2-1-2\">\n                    Sistema Invilara\n                </h1>\n                <p data-kid=\"5-1-2-1-3\">\n                    Sistema de Información para el Control de Solicitudes\n                </p>\n            </div>\n            <div aria-label=\"Indicadores resumidos\" class=\"dashboard-grid\" data-kid=\"5-1-2-2\">\n                <article class=\"kpi-card\" data-kid=\"5-1-2-2-1\">\n                    <div class=\"kpi-top\" data-kid=\"5-1-2-2-1-1\">\n                        <span class=\"kpi-label\" data-kid=\"5-1-2-2-1-1-1\">\n                            Total\n                            <br data-kid=\"5-1-2-2-1-1-1-1\"/>\n                            solicitudes\n                        </span>\n                        <span class=\"kpi-icon green\" data-kid=\"5-1-2-2-1-1-2\">\n                            <i class=\"bi bi-list-check\" data-kid=\"5-1-2-2-1-1-2-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"5-1-2-2-1-2\" data-name=\"total requests count\" data-reason=\"text replaced by Chart.js or script-injected analytics data\">\n                        8\n                    </div>\n                </article>\n                <article class=\"kpi-card\" data-kid=\"5-1-2-2-2\">\n                    <div class=\"kpi-top\" data-kid=\"5-1-2-2-2-1\">\n                        <span class=\"kpi-label\" data-kid=\"5-1-2-2-2-1-1\">\n                            Pendientes\n                        </span>\n                        <span class=\"kpi-icon amber\" data-kid=\"5-1-2-2-2-1-2\">\n                            <i class=\"bi bi-hourglass-split\" data-kid=\"5-1-2-2-2-1-2-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"5-1-2-2-2-2\" data-name=\"pending requests count\" data-reason=\"text replaced by Chart.js or script-injected analytics data\">\n                        3\n                    </div>\n                </article>\n                <article class=\"kpi-card\" data-kid=\"5-1-2-2-3\">\n                    <div class=\"kpi-top\" data-kid=\"5-1-2-2-3-1\">\n                        <span class=\"kpi-label\" data-kid=\"5-1-2-2-3-1-1\">\n                            En proceso\n                        </span>\n                        <span class=\"kpi-icon blue\" data-kid=\"5-1-2-2-3-1-2\">\n                            <i class=\"bi bi-arrow-repeat\" data-kid=\"5-1-2-2-3-1-2-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"5-1-2-2-3-2\" data-name=\"in progress requests count\" data-reason=\"text replaced by Chart.js or script-injected analytics data\">\n                        4\n                    </div>\n                </article>\n                <article class=\"kpi-card\" data-kid=\"5-1-2-2-4\">\n                    <div class=\"kpi-top\" data-kid=\"5-1-2-2-4-1\">\n                        <span class=\"kpi-label\" data-kid=\"5-1-2-2-4-1-1\">\n                            Completadas\n                        </span>\n                        <span class=\"kpi-icon purple\" data-kid=\"5-1-2-2-4-1-2\">\n                            <i class=\"bi bi-check2-circle\" data-kid=\"5-1-2-2-4-1-2-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"5-1-2-2-4-2\" data-name=\"completed requests count\" data-reason=\"text replaced by Chart.js or script-injected analytics data\">\n                        1\n                    </div>\n                </article>\n            </div>\n            <div class=\"dashboard-charts\" data-kid=\"5-1-2-3\">\n                <article class=\"chart-card\" data-kid=\"5-1-2-3-1\">\n                    <div class=\"chart-card-header\" data-kid=\"5-1-2-3-1-1\">\n                        <div data-kid=\"5-1-2-3-1-1-1\">\n                            <h2 data-kid=\"5-1-2-3-1-1-1-1\">\n                                <i class=\"bi bi-bar-chart-line-fill\" data-kid=\"5-1-2-3-1-1-1-1-1\" style=\"color:#08a52f;margin-right:7px;\">\n                                </i>\n                                Análisis por tipo de solicitud\n                            </h2>\n                            <p data-kid=\"5-1-2-3-1-1-1-2\">\n                                Solicitudes recibidas este mes\n                            </p>\n                        </div>\n                        <span class=\"chart-period\" data-kid=\"5-1-2-3-1-1-2\">\n                            Este mes\n                        </span>\n                    </div>\n                    <div class=\"chart-wrap\" data-kid=\"5-1-2-3-1-2\">\n                        <canvas aria-label=\"Gráfica de solicitudes por tipo\" data-dynamic=\"true\" data-kid=\"5-1-2-3-1-2-1\" data-name=\"requests analysis bar chart\" data-reason=\"canvas rendered and updated by Chart.js\" id=\"requestsChart\">\n                        </canvas>\n                    </div>\n                </article>\n                <article class=\"chart-card\" data-kid=\"5-1-2-3-2\">\n                    <div class=\"chart-card-header\" data-kid=\"5-1-2-3-2-1\">\n                        <div data-kid=\"5-1-2-3-2-1-1\">\n                            <h2 data-kid=\"5-1-2-3-2-1-1-1\">\n                                <i class=\"bi bi-pie-chart-fill\" data-kid=\"5-1-2-3-2-1-1-1-1\" style=\"color:#1595a8;margin-right:7px;\">\n                                </i>\n                                Distribución por estatus\n                            </h2>\n                            <p data-kid=\"5-1-2-3-2-1-1-2\">\n                                Estado general del sistema\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"chart-wrap\" data-kid=\"5-1-2-3-2-2\">\n                        <canvas aria-label=\"Gráfica de distribución por estatus\" data-dynamic=\"true\" data-kid=\"5-1-2-3-2-2-1\" data-name=\"status distribution doughnut chart\" data-reason=\"canvas rendered and updated by Chart.js\" id=\"statusChart\">\n                        </canvas>\n                    </div>\n                </article>\n            </div>\n        </main>\n        <div aria-label=\"Utilidades de cuenta\" class=\"utility-cluster\" data-kid=\"5-1-3\" id=\"utilityCluster\">\n            <button aria-controls=\"notificationPanel\" aria-expanded=\"false\" aria-label=\"Abrir notificaciones, 3 pendientes\" class=\"utility-trigger\" data-kid=\"5-1-3-1\" id=\"notificationTrigger\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bi bi-bell\" data-kid=\"5-1-3-1-1\">\n                </i>\n                <span aria-label=\"3 notificaciones pendientes\" class=\"notification-badge\" data-dynamic=\"true\" data-kid=\"5-1-3-1-2\" data-name=\"notification badge count\" data-reason=\"text and display state replaced by script when notifications are cleared\" id=\"notificationBadge\">\n                    3\n                </span>\n            </button>\n            <span aria-hidden=\"true\" class=\"utility-divider\" data-kid=\"5-1-3-2\">\n            </span>\n            <button aria-controls=\"profilePanel\" aria-expanded=\"false\" aria-label=\"Abrir menú de Mi Perfil para admin\" class=\"utility-trigger utility-trigger-profile\" data-kid=\"5-1-3-3\" id=\"profileTrigger\" type=\"button\">\n                <img alt=\"Avatar de admin\" class=\"profile-avatar\" data-kid=\"5-1-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=admin\"/>\n                <span class=\"profile-copy\" data-kid=\"5-1-3-3-2\">\n                    <span class=\"profile-name\" data-kid=\"5-1-3-3-2-1\">\n                        admin\n                    </span>\n                    <span class=\"profile-role\" data-kid=\"5-1-3-3-2-2\">\n                        Mi Perfil\n                    </span>\n                </span>\n            </button>\n            <section aria-hidden=\"true\" aria-label=\"Notificaciones\" class=\"utility-panel notification-panel\" data-kid=\"5-1-3-4\" id=\"notificationPanel\" role=\"dialog\">\n                <header class=\"panel-header\" data-kid=\"5-1-3-4-1\">\n                    <div class=\"panel-title-row\" data-kid=\"5-1-3-4-1-1\">\n                        <i aria-hidden=\"true\" class=\"bi bi-bell-fill\" data-kid=\"5-1-3-4-1-1-1\">\n                        </i>\n                        <span class=\"panel-title\" data-kid=\"5-1-3-4-1-1-2\">\n                            Notificaciones\n                        </span>\n                        <span class=\"panel-count\" data-dynamic=\"true\" data-kid=\"5-1-3-4-1-1-3\" data-name=\"notification panel count\" data-reason=\"text replaced by script when notifications are cleared\" id=\"panelCount\">\n                            3\n                        </span>\n                    </div>\n                    <div class=\"panel-actions\" data-kid=\"5-1-3-4-1-2\">\n                        <button class=\"panel-action\" data-kid=\"5-1-3-4-1-2-1\" id=\"markReadButton\" type=\"button\">\n                            Marcar leídas\n                        </button>\n                        <button class=\"panel-action secondary\" data-kid=\"5-1-3-4-1-2-2\" id=\"auditButton\" type=\"button\">\n                            Auditoría\n                        </button>\n                    </div>\n                </header>\n                <div class=\"notification-list\" data-kid=\"5-1-3-4-2\" id=\"notificationList\">\n                    <article class=\"notification-item\" data-kid=\"5-1-3-4-2-1\" tabindex=\"0\">\n                        <span class=\"notification-icon\" data-kid=\"5-1-3-4-2-1-1\">\n                            <i aria-hidden=\"true\" class=\"bi bi-clipboard2-check\" data-kid=\"5-1-3-4-2-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"notification-content\" data-kid=\"5-1-3-4-2-1-2\">\n                            <span class=\"notification-title\" data-kid=\"5-1-3-4-2-1-2-1\">\n                                Solicitud #184 requiere revisión\n                            </span>\n                            <span class=\"notification-detail\" data-kid=\"5-1-3-4-2-1-2-2\">\n                                La solicitud de servicios básicos está pendiente de validación.\n                            </span>\n                            <span class=\"notification-time\" data-kid=\"5-1-3-4-2-1-2-3\">\n                                Hace 12 min\n                            </span>\n                        </span>\n                        <span aria-label=\"No leída\" class=\"notification-unread\" data-dynamic=\"true\" data-kid=\"5-1-3-4-2-1-3\" data-name=\"first notification unread dot\" data-reason=\"element removed by script when marked as read\">\n                        </span>\n                    </article>\n                    <article class=\"notification-item\" data-kid=\"5-1-3-4-2-2\" tabindex=\"0\">\n                        <span class=\"notification-icon\" data-kid=\"5-1-3-4-2-2-1\">\n                            <i aria-hidden=\"true\" class=\"bi bi-building-check\" data-kid=\"5-1-3-4-2-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"notification-content\" data-kid=\"5-1-3-4-2-2-2\">\n                            <span class=\"notification-title\" data-kid=\"5-1-3-4-2-2-2-1\">\n                                Obra actualizada — Sector Centro\n                            </span>\n                            <span class=\"notification-detail\" data-kid=\"5-1-3-4-2-2-2-2\">\n                                Se registraron nuevos avances en la obra seleccionada.\n                            </span>\n                            <span class=\"notification-time\" data-kid=\"5-1-3-4-2-2-2-3\">\n                                Hace 1 h\n                            </span>\n                        </span>\n                        <span aria-label=\"No leída\" class=\"notification-unread\" data-dynamic=\"true\" data-kid=\"5-1-3-4-2-2-3\" data-name=\"second notification unread dot\" data-reason=\"element removed by script when marked as read\">\n                        </span>\n                    </article>\n                    <article class=\"notification-item\" data-kid=\"5-1-3-4-2-3\" tabindex=\"0\">\n                        <span class=\"notification-icon\" data-kid=\"5-1-3-4-2-3-1\">\n                            <i aria-hidden=\"true\" class=\"bi bi-person-check\" data-kid=\"5-1-3-4-2-3-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"notification-content\" data-kid=\"5-1-3-4-2-3-2\">\n                            <span class=\"notification-title\" data-kid=\"5-1-3-4-2-3-2-1\">\n                                Inicio de sesión — admin\n                            </span>\n                            <span class=\"notification-detail\" data-kid=\"5-1-3-4-2-3-2-2\">\n                                Tu sesión se inició correctamente.\n                            </span>\n                            <span class=\"notification-time\" data-kid=\"5-1-3-4-2-3-2-3\">\n                                Hoy, 08:42\n                            </span>\n                        </span>\n                        <span aria-label=\"No leída\" class=\"notification-unread\" data-dynamic=\"true\" data-kid=\"5-1-3-4-2-3-3\" data-name=\"third notification unread dot\" data-reason=\"element removed by script when marked as read\">\n                        </span>\n                    </article>\n                </div>\n                <footer class=\"panel-footer\" data-kid=\"5-1-3-4-3\">\n                    <span data-kid=\"5-1-3-4-3-1\">\n                        <strong data-dynamic=\"true\" data-kid=\"5-1-3-4-3-1-1\" data-name=\"notification summary text\" data-reason=\"text replaced by script when notifications are cleared\" id=\"notificationSummary\">\n                            3 pendientes\n                        </strong>\n                        · actualización en tiempo real\n                    </span>\n                    <span data-kid=\"5-1-3-4-3-2\">\n                        Esc para cerrar\n                    </span>\n                </footer>\n            </section>\n            <section aria-hidden=\"true\" aria-label=\"Menú de Mi Perfil\" class=\"utility-panel profile-panel\" data-kid=\"5-1-3-5\" id=\"profilePanel\" role=\"dialog\">\n                <div class=\"profile-summary\" data-kid=\"5-1-3-5-1\">\n                    <img alt=\"Avatar de admin\" class=\"profile-avatar\" data-kid=\"5-1-3-5-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=admin\"/>\n                    <span class=\"profile-summary-copy\" data-kid=\"5-1-3-5-1-2\">\n                        <strong data-kid=\"5-1-3-5-1-2-1\">\n                            admin\n                        </strong>\n                        <span data-kid=\"5-1-3-5-1-2-2\">\n                            Sesión activa · Administrador\n                        </span>\n                    </span>\n                </div>\n                <a class=\"menu-item\" data-kid=\"5-1-3-5-2\" href=\"#editar-perfil\">\n                    <i aria-hidden=\"true\" class=\"bi bi-person-vcard\" data-kid=\"5-1-3-5-2-1\">\n                    </i>\n                    <span data-kid=\"5-1-3-5-2-2\">\n                        Editar Perfil\n                    </span>\n                </a>\n                <label class=\"menu-item\" data-kid=\"5-1-3-5-3\" for=\"themeToggle\">\n                    <i aria-hidden=\"true\" class=\"bi bi-sun-fill\" data-dynamic=\"true\" data-kid=\"5-1-3-5-3-1\" data-name=\"theme icon\" data-reason=\"class changed by script on toggle\" id=\"themeIcon\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"5-1-3-5-3-2\" data-name=\"theme label text\" data-reason=\"text replaced by script on toggle\" id=\"themeLabel\">\n                        Modo Claro\n                    </span>\n                    <input aria-label=\"Activar modo oscuro\" class=\"theme-toggle\" data-dynamic=\"true\" data-kid=\"5-1-3-5-3-3\" data-name=\"theme toggle switch\" data-reason=\"checked state managed by script\" id=\"themeToggle\" role=\"switch\" type=\"checkbox\"/>\n                </label>\n                <a class=\"menu-item\" data-kid=\"5-1-3-5-4\" href=\"#configuracion\">\n                    <i aria-hidden=\"true\" class=\"bi bi-sliders\" data-kid=\"5-1-3-5-4-1\">\n                    </i>\n                    <span data-kid=\"5-1-3-5-4-2\">\n                        Configuración\n                    </span>\n                </a>\n                <div aria-hidden=\"true\" class=\"menu-divider\" data-kid=\"5-1-3-5-5\">\n                </div>\n                <a class=\"menu-item danger\" data-kid=\"5-1-3-5-6\" href=\"#cerrar-sesion\">\n                    <i aria-hidden=\"true\" class=\"bi bi-box-arrow-right\" data-kid=\"5-1-3-5-6-1\">\n                    </i>\n                    <span data-kid=\"5-1-3-5-6-2\">\n                        Cerrar Sesión\n                    </span>\n                </a>\n            </section>\n        </div>\n        <div aria-live=\"polite\" class=\"utility-live\" data-dynamic=\"true\" data-kid=\"5-1-4\" data-name=\"live accessibility announcer\" data-reason=\"text replaced by script on user interactions\" id=\"utilityLive\" role=\"status\">\n        </div>\n    </section>\n</div>\n<script>\n    (function () {\n    const demo = document.getElementById('utilityDemo');\n    const cluster = document.getElementById('utilityCluster');\n    const notificationTrigger = document.getElementById('notificationTrigger');\n    const profileTrigger = document.getElementById('profileTrigger');\n    const notificationPanel = document.getElementById('notificationPanel');\n    const profilePanel = document.getElementById('profilePanel');\n    const themeToggle = document.getElementById('themeToggle');\n    const themeLabel = document.getElementById('themeLabel');\n    const themeIcon = document.getElementById('themeIcon');\n    const live = document.getElementById('utilityLive');\n    const count = document.getElementById('panelCount');\n    const summary = document.getElementById('notificationSummary');\n    let lastTrigger = null;\n    let liveTimer = null;\n\n    function announce(message) {\n      live.textContent = message;\n      live.classList.add('is-visible');\n      window.clearTimeout(liveTimer);\n      liveTimer = window.setTimeout(function () { live.classList.remove('is-visible'); }, 2200);\n    }\n\n    function setPanel(panel, trigger, open) {\n      const isOpen = Boolean(open);\n      panel.classList.toggle('is-open', isOpen);\n      panel.setAttribute('aria-hidden', String(!isOpen));\n      trigger.setAttribute('aria-expanded', String(isOpen));\n      if (isOpen) lastTrigger = trigger;\n    }\n\n    function closePanels(returnFocus) {\n      const wasOpen = notificationPanel.classList.contains('is-open') || profilePanel.classList.contains('is-open');\n      setPanel(notificationPanel, notificationTrigger, false);\n      setPanel(profilePanel, profileTrigger, false);\n      if (returnFocus && lastTrigger && wasOpen) lastTrigger.focus();\n      lastTrigger = null;\n    }\n\n    function toggle(panel, trigger) {\n      const opening = !panel.classList.contains('is-open');\n      closePanels(false);\n      if (opening) {\n        setPanel(panel, trigger, true);\n        announce(panel === notificationPanel ? 'Notificaciones abiertas' : 'Menú de Mi Perfil abierto');\n      }\n    }\n\n    notificationTrigger.addEventListener('click', function () { toggle(notificationPanel, notificationTrigger); });\n    profileTrigger.addEventListener('click', function () { toggle(profilePanel, profileTrigger); });\n\n    document.addEventListener('click', function (event) {\n      if (!cluster.contains(event.target) && (notificationPanel.classList.contains('is-open') || profilePanel.classList.contains('is-open'))) closePanels(true);\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && (notificationPanel.classList.contains('is-open') || profilePanel.classList.contains('is-open'))) {\n        event.preventDefault();\n        closePanels(true);\n      }\n    });\n\n    themeToggle.addEventListener('change', function () {\n      const dark = themeToggle.checked;\n      demo.classList.toggle('dark-mode', dark);\n      themeLabel.textContent = dark ? 'Modo Oscuro' : 'Modo Claro';\n      themeIcon.className = dark ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';\n      themeToggle.setAttribute('aria-label', dark ? 'Desactivar modo oscuro' : 'Activar modo oscuro');\n      announce(dark ? 'Modo oscuro activado' : 'Modo claro activado');\n      renderCharts(dark);\n    });\n\n    document.getElementById('markReadButton').addEventListener('click', function () {\n      document.querySelectorAll('.notification-unread').forEach(function (dot) { dot.remove(); });\n      count.textContent = '0';\n      summary.textContent = 'Todo leído';\n      document.getElementById('notificationBadge').style.display = 'none';\n      notificationTrigger.setAttribute('aria-label', 'Abrir notificaciones, todo leído');\n      announce('Todas las notificaciones están marcadas como leídas');\n    });\n\n    document.getElementById('auditButton').addEventListener('click', function () {\n      announce('Abriendo la vista de auditoría');\n    });\n\n    document.querySelectorAll('.menu-item[href]').forEach(function (item) {\n      item.addEventListener('click', function () {\n        announce(item.textContent.trim() + ' seleccionado');\n        closePanels(false);\n      });\n    });\n\n    function renderCharts(dark) {\n      if (!window.Chart) return;\n      const ink = dark ? '#cbdacf' : '#52625a';\n      const grid = dark ? 'rgba(203,218,207,.12)' : 'rgba(82,98,90,.12)';\n      if (window.__requestsChart) {\n        window.__requestsChart.options.scales.x.ticks.color = ink;\n        window.__requestsChart.options.scales.y.ticks.color = ink;\n        window.__requestsChart.options.scales.x.grid.color = grid;\n        window.__requestsChart.options.scales.y.grid.color = grid;\n        window.__requestsChart.update();\n      }\n      if (window.__statusChart) {\n        window.__statusChart.options.plugins.legend.labels.color = ink;\n        window.__statusChart.update();\n      }\n    }\n\n    function initCharts() {\n      if (!window.Chart) return;\n      const dark = demo.classList.contains('dark-mode');\n      const ink = dark ? '#cbdacf' : '#52625a';\n      const grid = dark ? 'rgba(203,218,207,.12)' : 'rgba(82,98,90,.12)';\n      window.__requestsChart = new Chart(document.getElementById('requestsChart'), {\n        type: 'bar',\n        data: { labels: ['Particular', 'Comunidad', 'Institución'], datasets: [{ data: [4, 3, 1], backgroundColor: ['#1677ef', '#168b55', '#ffbd18'], borderRadius: 5, borderSkipped: false, barThickness: 34 }] },\n        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { grid: { display: false }, ticks: { color: ink, font: { family: 'Open Sans', size: 10 } } }, y: { beginAtZero: true, ticks: { stepSize: 1, color: ink, font: { family: 'Open Sans', size: 10 } }, grid: { color: grid } } } }\n      });\n      window.__statusChart = new Chart(document.getElementById('statusChart'), {\n        type: 'doughnut',\n        data: { labels: ['En proceso', 'Pendiente', 'Completada'], datasets: [{ data: [50, 37.5, 12.5], backgroundColor: ['#168b55', '#ffbd18', '#19b8d0'], borderWidth: 0 }] },\n        options: { responsive: true, maintainAspectRatio: false, cutout: '63%', plugins: { legend: { position: 'bottom', labels: { color: ink, boxWidth: 10, boxHeight: 10, padding: 14, font: { family: 'Open Sans', size: 10 } } }, tooltip: { enabled: false } } }\n      });\n    }\n\n    initCharts();\n  })();\n</script>\n",
