        "h": 1024
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');\n\n  :root {\n    color-scheme: dark;\n  }\n\n  .demo-page,\n  .demo-page * {\n    box-sizing: border-box;\n  }\n\n  .demo-page {\n    --canvas-bg: #232333;\n    --sidebar-bg: #1e1e2d;\n    --surface: #2b2c40;\n    --surface-raised: #323248;\n    --surface-soft: #27283a;\n    --border: #444564;\n    --ink: #f5f4fb;\n    --body-ink: #cfcde9;\n    --muted: #a2a3b7;\n    --quiet: #777991;\n    --accent: #08b324;\n    --accent-strong: #059b1f;\n    --accent-soft: rgba(8, 179, 36, .14);\n    --danger: #dc3545;\n    --danger-soft: rgba(220, 53, 69, .14);\n    --warning: #ffda6a;\n    --info: #6fc9db;\n    min-height: 900px;\n    width: 100%;\n    overflow: hidden;\n    position: relative;\n    background: var(--canvas-bg);\n    color: var(--body-ink);\n    font-family: 'Open Sans', sans-serif;\n    font-size: 14px;\n  }\n\n  .demo-page.is-light {\n    --canvas-bg: #f4f5fa;\n    --sidebar-bg: #ffffff;\n    --surface: #ffffff;\n    --surface-raised: #ffffff;\n    --surface-soft: #f7f8fb;\n    --border: #e3e5ec;\n    --ink: #263238;\n    --body-ink: #566273;\n    --muted: #7c8797;\n    --quiet: #9aa3b1;\n    --accent-soft: rgba(8, 179, 36, .1);\n    color-scheme: light;\n  }\n\n  .demo-layout {\n    display: grid;\n    grid-template-columns: 214px minmax(0, 1fr);\n    min-height: 900px;\n  }\n\n  .demo-sidebar {\n    background: var(--sidebar-bg);\n    border-right: 1px solid var(--border);\n    padding: 24px 14px;\n  }\n\n  .brand-lockup {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 0 11px 24px;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .brand-mark {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    border-radius: 10px;\n    background: var(--accent);\n    color: #fff;\n    font-size: 18px;\n  }\n\n  .brand-name {\n    color: var(--ink);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: .08em;\n  }\n\n  .brand-caption {\n    color: var(--muted);\n    display: block;\n    font-size: 9px;\n    letter-spacing: .05em;\n    margin-top: 2px;\n  }\n\n  .side-label {\n    color: var(--quiet);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    margin: 28px 11px 9px;\n    text-transform: uppercase;\n  }\n\n  .side-nav {\n    display: grid;\n    gap: 4px;\n  }\n\n  .side-link {\n    align-items: center;\n    border-radius: 10px;\n    color: var(--muted);\n    display: flex;\n    gap: 11px;\n    min-height: 42px;\n    padding: 0 11px;\n    text-decoration: none;\n  }\n\n  .side-link i {\n    color: var(--quiet);\n    display: inline-flex;\n    font-size: 16px;\n    width: 18px;\n  }\n\n  .side-link.active {\n    background: var(--accent-soft);\n    color: var(--ink);\n    font-weight: 600;\n  }\n\n  .side-link.active i {\n    color: var(--accent);\n  }\n\n  .demo-main {\n    min-width: 0;\n    position: relative;\n  }\n\n  .demo-header {\n    align-items: center;\n    border-bottom: 1px solid var(--border);\n    display: flex;\n    height: 78px;\n    justify-content: space-between;\n    padding: 0 28px;\n  }\n\n  .header-context {\n    color: var(--muted);\n    font-size: 12px;\n  }\n\n  .header-context strong {\n    color: var(--body-ink);\n    font-weight: 600;\n  }\n\n  .header-status {\n    align-items: center;\n    color: var(--quiet);\n    display: flex;\n    font-size: 11px;\n    gap: 8px;\n  }\n\n  .status-dot {\n    background: var(--accent);\n    border-radius: 50%;\n    box-shadow: 0 0 0 4px var(--accent-soft);\n    display: inline-block;\n    height: 7px;\n    width: 7px;\n  }\n\n  .dashboard-content {\n    padding: 34px 28px 70px;\n  }\n\n  .page-heading {\n    margin: 0 0 5px;\n    color: var(--ink);\n    font-size: 25px;\n    font-weight: 700;\n    letter-spacing: -.03em;\n  }\n\n  .page-subheading {\n    color: var(--muted);\n    font-size: 13px;\n    margin: 0 0 28px;\n  }\n\n  .metric-grid {\n    display: grid;\n    gap: 14px;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    margin-bottom: 18px;\n  }\n\n  .metric-card,\n  .report-card {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 14px;\n  }\n\n  .metric-card {\n    min-height: 106px;\n    padding: 17px 18px;\n  }\n\n  .metric-label {\n    color: var(--muted);\n    font-size: 11px;\n    text-transform: uppercase;\n  }\n\n  .metric-value {\n    color: var(--ink);\n    font-size: 25px;\n    font-weight: 700;\n    margin-top: 9px;\n  }\n\n  .metric-trend {\n    color: var(--accent);\n    font-size: 10px;\n    margin-top: 1px;\n  }\n\n  .report-grid {\n    display: grid;\n    gap: 18px;\n    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);\n  }\n\n  .report-card {\n    min-height: 260px;\n    padding: 20px;\n  }\n\n  .report-heading {\n    align-items: center;\n    color: var(--body-ink);\n    display: flex;\n    font-size: 14px;\n    font-weight: 600;\n    gap: 9px;\n    margin-bottom: 27px;\n  }\n\n  .report-heading i {\n    color: var(--accent);\n    font-size: 17px;\n  }\n\n  .bar-chart {\n    align-items: end;\n    border-bottom: 1px solid var(--border);\n    display: flex;\n    gap: 22px;\n    height: 155px;\n    justify-content: center;\n    padding: 0 20px;\n  }\n\n  .bar-column {\n    align-items: center;\n    display: flex;\n    flex-direction: column;\n    gap: 9px;\n    height: 100%;\n    justify-content: end;\n  }\n\n  .bar {\n    background: var(--accent);\n    border-radius: 6px 6px 0 0;\n    min-width: 42px;\n    opacity: .85;\n  }\n\n  .bar:nth-child(2) { background: #52b788; }\n  .bar:nth-child(3) { background: #ffbd45; }\n\n  .bar-caption {\n    color: var(--quiet);\n    font-size: 10px;\n  }\n\n  .donut {\n    align-items: center;\n    background: conic-gradient(var(--accent) 0 50%, #ffbd45 50% 87%, #23b7d3 87% 100%);\n    border-radius: 50%;\n    display: flex;\n    height: 142px;\n    justify-content: center;\n    margin: 8px auto 12px;\n    position: relative;\n    width: 142px;\n  }\n\n  .donut::after {\n    background: var(--surface);\n    border-radius: 50%;\n    content: '';\n    height: 84px;\n    position: absolute;\n    width: 84px;\n  }\n\n  .donut-label {\n    color: var(--ink);\n    font-size: 17px;\n    font-weight: 700;\n    position: relative;\n    z-index: 1;\n  }\n\n  /* Utility cluster */\n  .utility-stage {\n    position: absolute;\n    right: max(12px, env(safe-area-inset-right));\n    top: max(16px, env(safe-area-inset-top));\n    z-index: 20;\n  }\n\n  .utility-pill {\n    align-items: center;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 50px;\n    box-shadow: 0 12px 28px rgba(0, 0, 0, .27);\n    display: flex;\n    gap: 4px;\n    min-height: 58px;\n    padding: 6px;\n  }\n\n  .utility-trigger {\n    align-items: center;\n    background: transparent;\n    border: 0;\n    border-radius: 40px;\n    color: var(--body-ink);\n    cursor: pointer;\n    display: inline-flex;\n    font: inherit;\n    min-height: 44px;\n    padding: 5px 10px;\n    position: relative;\n  }\n\n  .utility-trigger:hover,\n  .utility-trigger[aria-expanded='true'] {\n    background: var(--accent-soft);\n    color: var(--ink);\n  }\n\n  .utility-trigger:focus-visible,\n  .panel-action:focus-visible,\n  .notification-delete:focus-visible,\n  .profile-menu-item:focus-visible,\n  .theme-switch:focus-visible,\n  .retry-button:focus-visible {\n    outline: 3px solid rgba(8, 179, 36, .7);\n    outline-offset: 3px;\n  }\n\n  .utility-trigger:active {\n    transform: scale(.98);\n  }\n\n  .notification-trigger {\n    justify-content: center;\n    width: 48px;\n  }\n\n  .utility-divider {\n    background: var(--border);\n    height: 28px;\n    width: 1px;\n  }\n\n  .utility-icon {\n    align-items: center;\n    display: inline-flex;\n    font-size: 20px;\n    height: 20px;\n    justify-content: center;\n    line-height: 1;\n    width: 20px;\n  }\n\n  .notification-badge {\n    align-items: center;\n    background: var(--danger);\n    border: 2px solid var(--surface);\n    border-radius: 999px;\n    color: #fff;\n    display: inline-flex;\n    font-size: 10px;\n    font-weight: 700;\n    height: 21px;\n    justify-content: center;\n    min-width: 21px;\n    padding: 0 5px;\n    position: absolute;\n    right: 3px;\n    top: 0;\n  }\n\n  .profile-trigger {\n    gap: 10px;\n    padding-left: 7px;\n    padding-right: 12px;\n  }\n\n  .profile-avatar {\n    border: 2px solid var(--accent);\n    border-radius: 50%;\n    display: block;\n    height: 36px;\n    object-fit: cover;\n    width: 36px;\n  }\n\n  .profile-copy {\n    display: flex;\n    flex-direction: column;\n    line-height: 1.15;\n    min-width: 68px;\n    text-align: left;\n  }\n\n  .profile-copy strong {\n    color: var(--ink);\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  .profile-copy span {\n    color: var(--muted);\n    font-size: 10px;\n    margin-top: 3px;\n  }\n\n  .profile-chevron {\n    color: var(--muted);\n    font-size: 13px;\n    margin-left: 3px;\n  }\n\n  .utility-panel {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 18px;\n    box-shadow: 0 18px 38px rgba(0, 0, 0, .34);\n    color: var(--body-ink);\n    overflow: hidden;\n    position: absolute;\n    right: 0;\n    top: calc(100% + 10px);\n    width: min(360px, calc(100vw - 24px));\n  }\n\n  .panel-header {\n    border-bottom: 1px solid var(--border);\n    padding: 16px 16px 13px;\n  }\n\n  .panel-heading-row {\n    align-items: flex-start;\n    display: flex;\n    gap: 12px;\n    justify-content: space-between;\n  }\n\n  .panel-title {\n    color: var(--ink);\n    font-size: 15px;\n    font-weight: 700;\n    margin: 0;\n  }\n\n  .panel-subtitle {\n    color: var(--muted);\n    font-size: 11px;\n    margin: 5px 0 0;\n  }\n\n  .count-badge {\n    align-items: center;\n    background: var(--danger);\n    border-radius: 999px;\n    color: #fff;\n    display: inline-flex;\n    font-size: 11px;\n    font-weight: 700;\n    height: 24px;\n    justify-content: center;\n    min-width: 24px;\n    padding: 0 7px;\n  }\n\n  .panel-actions {\n    align-items: center;\n    display: flex;\n    gap: 14px;\n    margin-top: 14px;\n  }\n\n  .panel-action {\n    align-items: center;\n    background: transparent;\n    border: 0;\n    border-radius: 7px;\n    color: var(--muted);\n    cursor: pointer;\n    display: inline-flex;\n    font: inherit;\n    font-size: 11px;\n    min-height: 44px;\n    padding: 7px 8px;\n    text-decoration: none;\n  }\n\n  .panel-action:hover {\n    background: var(--accent-soft);\n    color: var(--ink);\n  }\n\n  .panel-action.primary {\n    color: #63cf78;\n    font-weight: 600;\n  }\n\n  .notification-list {\n    max-height: 278px;\n    overflow-y: auto;\n    overscroll-behavior: contain;\n  }\n\n  .notification-item {\n    align-items: start;\n    border-bottom: 1px solid var(--border);\n    display: grid;\n    gap: 10px;\n    grid-template-columns: 34px minmax(0, 1fr) 44px;\n    padding: 15px 12px 15px 16px;\n  }\n\n  .notification-item:last-child {\n    border-bottom: 0;\n  }\n\n  .notification-item.is-read {\n    opacity: .68;\n  }\n\n  .notification-icon {\n    align-items: center;\n    background: var(--accent-soft);\n    border-radius: 10px;\n    color: #63cf78;\n    display: inline-flex;\n    font-size: 16px;\n    height: 34px;\n    justify-content: center;\n    width: 34px;\n  }\n\n  .notification-icon.info {\n    background: rgba(111, 201, 219, .13);\n    color: var(--info);\n  }\n\n  .notification-icon.auth {\n    background: rgba(162, 163, 183, .13);\n    color: var(--muted);\n  }\n\n  .notification-main {\n    min-width: 0;\n  }\n\n  .notification-title {\n    color: var(--ink);\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1.35;\n  }\n\n  .notification-meta {\n    align-items: center;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 7px;\n    margin-top: 7px;\n  }\n\n  .notification-priority,\n  .notification-date {\n    font-size: 10px;\n  }\n\n  .notification-priority {\n    color: #72d887;\n    font-weight: 600;\n  }\n\n  .notification-priority.medium {\n    color: var(--warning);\n  }\n\n  .notification-priority.low {\n    color: var(--muted);\n  }\n\n  .notification-date {\n    color: var(--muted);\n  }\n\n  .notification-date::before {\n    color: var(--border);\n    content: '•';\n    margin-right: 7px;\n  }\n\n  .notification-detail {\n    align-items: center;\n    background: transparent;\n    border: 0;\n    border-radius: 7px;\n    color: #63cf78;\n    cursor: pointer;\n    display: inline-flex;\n    font: inherit;\n    font-size: 10px;\n    font-weight: 700;\n    min-height: 44px;\n    padding: 7px 8px;\n    text-decoration: none;\n  }\n\n  .notification-detail:hover {\n    background: var(--accent-soft);\n    color: var(--ink);\n  }\n\n  .notification-detail i {\n    font-size: 11px;\n    margin-right: 5px;\n  }\n\n  .notification-details {\n    background: var(--surface-soft);\n    border-left: 2px solid var(--accent);\n    border-radius: 0 8px 8px 0;\n    color: var(--muted);\n    display: grid;\n    font-size: 10px;\n    gap: 4px;\n    line-height: 1.45;\n    margin-top: 7px;\n    padding: 9px 10px;\n    overflow-wrap: anywhere;\n  }\n\n  .notification-technical-label {\n    color: var(--quiet);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .notification-details code {\n    background: transparent;\n    color: var(--body-ink);\n    font: inherit;\n    font-weight: 600;\n    overflow-wrap: anywhere;\n  }\n\n  .notification-delete {\n    align-items: center;\n    align-self: start;\n    background: transparent;\n    border: 0;\n    border-radius: 9px;\n    color: var(--quiet);\n    cursor: pointer;\n    display: inline-flex;\n    font-size: 15px;\n    height: 44px;\n    justify-content: center;\n    padding: 0;\n    width: 44px;\n  }\n\n  .notification-delete:hover {\n    background: var(--danger-soft);\n    color: #f28b95;\n  }\n\n  .panel-status {\n    color: var(--muted);\n    font-size: 11px;\n    padding: 10px 16px 13px;\n  }\n\n  .panel-state {\n    align-items: center;\n    color: var(--muted);\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    justify-content: center;\n    min-height: 210px;\n    padding: 24px;\n    text-align: center;\n  }\n\n  .panel-state i {\n    color: var(--accent);\n    font-size: 28px;\n  }\n\n  .panel-state strong {\n    color: var(--ink);\n    font-size: 13px;\n  }\n\n  .panel-state p {\n    font-size: 11px;\n    line-height: 1.5;\n    margin: 0;\n    max-width: 250px;\n  }\n\n  .panel-state.is-error i {\n    color: var(--danger);\n  }\n\n  .retry-button {\n    background: transparent;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    color: var(--body-ink);\n    cursor: pointer;\n    font: inherit;\n    font-size: 11px;\n    min-height: 44px;\n    padding: 8px 14px;\n  }\n\n  .profile-panel {\n    width: min(300px, calc(100vw - 24px));\n  }\n\n  .profile-summary {\n    align-items: center;\n    border-bottom: 1px solid var(--border);\n    display: flex;\n    gap: 11px;\n    padding: 16px;\n  }\n\n  .profile-summary img {\n    border-radius: 50%;\n    height: 42px;\n    width: 42px;\n  }\n\n  .profile-summary strong {\n    color: var(--ink);\n    display: block;\n    font-size: 13px;\n  }\n\n  .profile-summary span {\n    color: var(--muted);\n    display: block;\n    font-size: 10px;\n    margin-top: 3px;\n  }\n\n  .profile-menu {\n    padding: 7px;\n  }\n\n  .profile-menu-item,\n  .theme-row {\n    align-items: center;\n    background: transparent;\n    border: 0;\n    border-radius: 10px;\n    color: var(--body-ink);\n    display: flex;\n    font: inherit;\n    gap: 11px;\n    min-height: 48px;\n    padding: 7px 10px;\n    text-align: left;\n    text-decoration: none;\n    width: 100%;\n  }\n\n  .profile-menu-item:hover,\n  .theme-row:hover {\n    background: var(--accent-soft);\n    color: var(--ink);\n  }\n\n  .profile-menu-item i,\n  .theme-row > i {\n    color: #63cf78;\n    display: inline-flex;\n    font-size: 17px;\n    justify-content: center;\n    width: 20px;\n  }\n\n  .profile-menu-item.logout {\n    color: #f28b95;\n  }\n\n  .profile-menu-item.logout i {\n    color: #f28b95;\n  }\n\n  .menu-copy {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .menu-copy strong {\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  .menu-copy small {\n    color: var(--muted);\n    font-size: 10px;\n  }\n\n  .theme-switch {\n    appearance: none;\n    background: var(--border);\n    border: 0;\n    border-radius: 999px;\n    cursor: pointer;\n    height: 24px;\n    margin-left: auto;\n    position: relative;\n    width: 44px;\n  }\n\n  .theme-switch::after {\n    background: #f8f8fb;\n    border-radius: 50%;\n    content: '';\n    height: 18px;\n    left: 3px;\n    position: absolute;\n    top: 3px;\n    transition: transform .2s ease;\n    width: 18px;\n  }\n\n  .theme-switch:checked {\n    background: var(--accent);\n  }\n\n  .theme-switch:checked::after {\n    transform: translateX(20px);\n  }\n\n  .menu-separator {\n    border: 0;\n    border-top: 1px solid var(--border);\n    margin: 7px 5px;\n  }\n\n  .sr-only {\n    height: 1px;\n    margin: -1px;\n    overflow: hidden;\n    position: absolute;\n    width: 1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  [hidden] {\n    display: none !important;\n  }\n\n  @media (max-width: 760px) {\n    .demo-layout {\n      grid-template-columns: 74px minmax(0, 1fr);\n    }\n\n    .demo-sidebar {\n      padding-left: 9px;\n      padding-right: 9px;\n    }\n\n    .brand-lockup {\n      justify-content: center;\n      padding-left: 0;\n      padding-right: 0;\n    }\n\n    .brand-copy,\n    .side-label,\n    .side-link span {\n      display: none;\n    }\n\n    .side-link {\n      justify-content: center;\n      padding: 0;\n    }\n\n    .side-link i {\n      width: auto;\n    }\n\n    .demo-header,\n    .dashboard-content {\n      padding-left: 18px;\n      padding-right: 18px;\n    }\n\n    .metric-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 520px) {\n    .demo-page {\n      min-height: 820px;\n    }\n\n    .demo-layout {\n      min-height: 820px;\n    }\n\n    .demo-header {\n      height: 70px;\n    }\n\n    .header-status {\n      display: none;\n    }\n\n    .dashboard-content {\n      padding-top: 28px;\n    }\n\n    .page-heading {\n      font-size: 21px;\n    }\n\n    .report-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .utility-stage {\n      right: max(12px, env(safe-area-inset-right));\n    }\n\n    .profile-copy,\n    .profile-chevron {\n      display: none;\n    }\n\n    .profile-trigger {\n      gap: 0;\n      padding-left: 6px;\n      padding-right: 6px;\n      width: 48px;\n    }\n\n    .profile-avatar {\n      height: 36px;\n      width: 36px;\n    }\n\n    .utility-pill {\n      gap: 3px;\n      min-height: 56px;\n    }\n\n    .panel-actions {\n      gap: 3px;\n      justify-content: space-between;\n    }\n\n    .panel-action {\n      font-size: 10px;\n      padding-left: 6px;\n      padding-right: 6px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .demo-page *,\n    .demo-page *::before,\n    .demo-page *::after {\n      animation-duration: .01ms !important;\n      animation-iteration-count: 1 !important;\n      scroll-behavior: auto !important;\n      transition-duration: .01ms !important;\n    }\n  }\n</style>\n<div class=\"demo-page\" data-kid=\"2\" data-theme=\"dark\" id=\"utilityDemo\">\n    <div class=\"demo-layout\" data-kid=\"2-1\">\n        <aside aria-label=\"Nave