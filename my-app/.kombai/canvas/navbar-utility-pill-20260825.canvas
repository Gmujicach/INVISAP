    },
    "var_f8b6a93f1eed": {
      "type": "variant",
      "label": "Pill cuenta activa · perfil abierto",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2248,
        "y": 0,
        "w": 1024,
        "h": 1024
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');\n\n  .design-frame {\n    --canvas: #f5f6f9;\n    --surface: #ffffff;\n    --surface-soft: #f8fafb;\n    --ink: #26343b;\n    --ink-soft: #52636d;\n    --muted: #7a8991;\n    --line: #e5ebee;\n    --brand: #08b324;\n    --brand-strong: #059b1f;\n    --brand-soft: #edf9ef;\n    --brand-ring: rgba(8, 179, 36, .22);\n    --danger: #c94752;\n    --danger-soft: #fff2f3;\n    --warning: #eaa90c;\n    --cyan: #0b9db7;\n    min-height: 760px;\n    position: relative;\n    overflow: hidden;\n    isolation: isolate;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: 'Open Sans', sans-serif;\n    font-size: 14px;\n    line-height: 1.4;\n  }\n\n  .design-frame *,\n  .design-frame *::before,\n  .design-frame *::after {\n    box-sizing: border-box;\n  }\n\n  .dashboard-surface {\n    position: relative;\n    min-height: 760px;\n    background: var(--canvas);\n  }\n\n  .dashboard-rail {\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 72px;\n    padding: 24px 14px;\n    border-right: 1px solid var(--line);\n    background: var(--surface);\n  }\n\n  .rail-mark {\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    margin: 0 auto 30px;\n    border-radius: 14px;\n    background: var(--brand-soft);\n    color: var(--brand-strong);\n    font-size: 1.15rem;\n  }\n\n  .rail-item {\n    width: 44px;\n    height: 44px;\n    display: grid;\n    place-items: center;\n    margin: 0 auto 10px;\n    border-radius: 13px;\n    color: #9aa8ae;\n    font-size: 1.05rem;\n  }\n\n  .rail-item.active {\n    background: var(--brand-soft);\n    color: var(--brand-strong);\n  }\n\n  .dashboard-content {\n    min-height: 760px;\n    margin-left: 72px;\n    padding: 34px 30px 42px;\n  }\n\n  .dashboard-context {\n    max-width: 615px;\n    padding-top: 16px;\n  }\n\n  .context-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    margin-bottom: 10px;\n    color: var(--brand-strong);\n    font-size: .72rem;\n    font-weight: 700;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .context-kicker i { font-size: .9rem; }\n\n  .dashboard-title {\n    margin: 0;\n    color: var(--ink);\n    font-size: 2rem;\n    font-weight: 700;\n    letter-spacing: -.035em;\n    line-height: 1.15;\n  }\n\n  .dashboard-subtitle {\n    margin: 7px 0 0;\n    color: var(--muted);\n    font-size: .9rem;\n  }\n\n  .dashboard-rule {\n    width: 100%;\n    height: 1px;\n    margin: 28px 0 20px;\n    background: var(--line);\n  }\n\n  .stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .stat-card {\n    min-height: 108px;\n    padding: 18px 16px;\n    border: 1px solid var(--line);\n    border-radius: 16px;\n    background: var(--surface);\n  }\n\n  .stat-topline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    color: var(--muted);\n    font-size: .7rem;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n  }\n\n  .stat-topline i { font-size: 1rem; color: var(--brand); }\n  .stat-value { display: block; margin-top: 10px; color: var(--ink); font-size: 1.65rem; font-weight: 700; line-height: 1; }\n  .stat-note { display: block; margin-top: 7px; color: var(--muted); font-size: .68rem; }\n\n  .dashboard-panels {\n    display: grid;\n    grid-template-columns: 1.12fr .88fr;\n    gap: 14px;\n    margin-top: 14px;\n  }\n\n  .dashboard-panel {\n    min-height: 224px;\n    padding: 20px;\n    border: 1px solid var(--line);\n    border-radius: 16px;\n    background: var(--surface);\n  }\n\n  .panel-heading {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--ink-soft);\n    font-size: .88rem;\n    font-weight: 700;\n  }\n\n  .panel-heading i { color: var(--brand); font-size: 1.05rem; }\n\n  .bar-chart {\n    height: 135px;\n    display: flex;\n    align-items: end;\n    gap: 20px;\n    margin: 24px 12px 0;\n    padding: 0 10px 22px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .bar-column { flex: 1; height: 100%; display: flex; align-items: end; justify-content: center; }\n  .bar { width: min(46px, 72%); border-radius: 8px 8px 0 0; background: #d8efe0; }\n  .bar.primary { height: 88%; background: var(--brand); }\n  .bar.secondary { height: 64%; background: #70c888; }\n  .bar.tertiary { height: 40%; background: #b7e1c1; }\n  .bar-label { display: block; margin-top: 7px; color: var(--muted); font-size: .65rem; text-align: center; }\n\n  .donut-area { display: grid; place-items: center; min-height: 170px; position: relative; }\n  .donut { width: 122px; height: 122px; border-radius: 50%; background: conic-gradient(var(--brand) 0 50%, #f5bb16 50% 82%, #22aec8 82% 100%); position: relative; }\n  .donut::after { content: ''; position: absolute; inset: 24px; border-radius: 50%; background: var(--surface); }\n  .donut-center { position: absolute; z-index: 1; inset: 0; display: grid; place-items: center; color: var(--ink); font-size: 1rem; font-weight: 700; }\n\n  .dashboard-footer-line {\n    position: absolute;\n    right: 30px;\n    bottom: 24px;\n    left: 102px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--muted);\n    font-size: .7rem;\n  }\n\n  .dashboard-footer-line span:last-child { color: var(--brand-strong); font-weight: 600; }\n\n  .utility-cluster {\n    position: absolute;\n    z-index: 30;\n    top: max(20px, env(safe-area-inset-top));\n    right: max(24px, env(safe-area-inset-right));\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    max-width: calc(100vw - 24px);\n    padding: 6px;\n    border: 1px solid rgba(34, 54, 63, .07);\n    border-radius: 50px;\n    background: var(--surface);\n    box-shadow: 0 12px 28px rgba(31, 52, 61, .14);\n  }\n\n  .utility-segment { position: relative; display: flex; align-items: center; }\n\n  .utility-divider {\n    width: 1px;\n    height: 30px;\n    margin: 0 3px;\n    background: var(--line);\n  }\n\n  .utility-trigger {\n    min-width: 44px;\n    min-height: 44px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 0;\n    border-radius: 50px;\n    background: transparent;\n    color: var(--ink-soft);\n    cursor: pointer;\n    font: inherit;\n    transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;\n  }\n\n  .utility-trigger:hover { color: var(--brand-strong); background: var(--brand-soft); }\n  .utility-trigger:focus-visible,\n  .menu-item:focus-visible,\n  .switch-control:focus-visible,\n  .popover-link:focus-visible,\n  .inline-action:focus-visible { outline: 3px solid var(--brand-ring); outline-offset: 3px; }\n\n  .notification-trigger { position: relative; width: 46px; height: 46px; }\n  .notification-trigger > i { font-size: 1.18rem; }\n\n  .notification-badge {\n    position: absolute;\n    top: -2px;\n    right: -1px;\n    min-width: 21px;\n    height: 21px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0 5px;\n    border: 2px solid var(--surface);\n    border-radius: 50px;\n    background: #d84851;\n    color: #fff;\n    font-size: .66rem;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .notification-badge[hidden] { display: none; }\n\n  .profile-trigger {\n    justify-content: flex-start;\n    gap: 10px;\n    padding: 4px 13px 4px 5px;\n    color: var(--ink);\n  }\n\n  .profile-trigger[aria-expanded=\"true\"] {\n    background: var(--brand-soft);\n    box-shadow: inset 0 0 0 2px var(--brand-ring);\n  }\n\n  .avatar {\n    width: 36px;\n    height: 36px;\n    flex: 0 0 36px;\n    display: block;\n    border: 2px solid var(--surface);\n    border-radius: 50%;\n    object-fit: cover;\n    box-shadow: 0 0 0 2px rgba(8, 179, 36, .2);\n  }\n\n  .profile-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; line-height: 1.15; }\n  .profile-name { max-width: 114px; overflow: hidden; color: var(--ink); font-size: .82rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }\n  .profile-label { margin-top: 3px; color: var(--muted); font-size: .67rem; }\n  .profile-chevron { margin-left: 2px; color: var(--muted); font-size: .72rem; }\n  .profile-compact-label { display: none; color: var(--ink); font-size: .73rem; font-weight: 700; }\n\n  .utility-popover {\n    position: absolute;\n    top: calc(100% + 13px);\n    right: 0;\n    width: min(360px, calc(100vw - 24px));\n    overflow: visible;\n    border: 1px solid var(--line);\n    border-radius: 18px;\n    background: var(--surface);\n    color: var(--ink);\n    box-shadow: 0 18px 38px rgba(31, 52, 61, .18);\n  }\n\n  .utility-popover[hidden] { display: none; }\n  .utility-popover::before { content: ''; position: absolute; top: -7px; right: 30px; width: 14px; height: 14px; transform: rotate(45deg); border-top: 1px solid var(--line); border-left: 1px solid var(--line); background: var(--surface); }\n  .profile-popover { width: min(280px, calc(100vw - 24px)); }\n  .profile-popover::before { right: 42px; }\n\n  .popover-profile-head {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 18px 18px 15px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .popover-profile-head .avatar { width: 48px; height: 48px; flex-basis: 48px; box-shadow: 0 0 0 3px var(--brand-ring); }\n  .popover-profile-name { margin: 0; color: var(--ink); font-size: .93rem; font-weight: 700; }\n  .popover-profile-role { margin: 3px 0 0; color: var(--muted); font-size: .73rem; }\n  .presence { display: inline-flex; align-items: center; gap: 5px; margin-top: 7px; color: var(--brand-strong); font-size: .68rem; font-weight: 600; }\n  .presence::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--brand); }\n\n  .menu-list { padding: 7px; }\n  .menu-item {\n    width: 100%;\n    min-height: 44px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 9px 10px;\n    border: 0;\n    border-radius: 11px;\n    background: transparent;\n    color: var(--ink-soft);\n    cursor: pointer;\n    font: inherit;\n    text-align: left;\n    transition: background-color .18s ease, color .18s ease;\n  }\n\n  .menu-item:hover { background: var(--surface-soft); color: var(--ink); }\n  .menu-item i { width: 22px; color: var(--brand-strong); font-size: 1rem; text-align: center; }\n  .menu-item-copy { flex: 1; min-width: 0; }\n  .menu-item-title { display: block; color: inherit; font-size: .79rem; font-weight: 600; }\n  .menu-item-note { display: block; margin-top: 2px; color: var(--muted); font-size: .66rem; }\n  .menu-item-chevron { width: auto !important; color: #9ba8ad !important; font-size: .72rem !important; }\n  .menu-item-danger { color: var(--danger); }\n  .menu-item-danger i { color: var(--danger); }\n  .menu-divider { height: 1px; margin: 5px 10px; background: var(--line); }\n\n  .menu-item-switch { cursor: default; }\n  .menu-item-switch:hover { color: var(--ink-soft); }\n  .switch-control {\n    width: 44px;\n    height: 26px;\n    position: relative;\n    flex: 0 0 44px;\n    padding: 0;\n    border: 0;\n    border-radius: 50px;\n    background: #d6dee1;\n    cursor: pointer;\n    transition: background-color .18s ease;\n  }\n\n  .switch-control::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(31, 52, 61, .18); transition: transform .18s ease; }\n  .switch-control[aria-checked=\"true\"] { background: var(--brand); }\n  .switch-control[aria-checked=\"true\"]::after { transform: translateX(18px); }\n  .switch-label { margin-left: auto; color: var(--muted); font-size: .66rem; }\n\n  .popover-header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 14px;\n    padding: 17px 17px 14px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .popover-eyebrow { display: block; margin-bottom: 3px; color: var(--brand-strong); font-size: .64rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n  .popover-title { margin: 0; color: var(--ink); font-size: .96rem; font-weight: 700; }\n  .count-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 21px; height: 21px; margin-left: 4px; padding: 0 6px; border-radius: 50px; background: var(--brand-soft); color: var(--brand-strong); font-size: .66rem; vertical-align: 2px; }\n  .popover-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 9px; }\n  .inline-action { min-height: 34px; border: 0; background: transparent; color: var(--brand-strong); cursor: pointer; font: inherit; font-size: .67rem; font-weight: 700; }\n  .inline-action[disabled] { color: #b0bcc0; cursor: not-allowed; }\n  .inline-action-danger { color: var(--danger); }\n\n  .notification-list { max-height: 280px; overflow: auto; padding: 5px 7px; }\n  .notification-list[hidden] { display: none; }\n  .notification-item { position: relative; display: grid; grid-template-columns: 32px minmax(0, 1fr) 34px; gap: 9px; align-items: start; min-height: 72px; padding: 11px 7px; border-radius: 11px; }\n  .notification-item + .notification-item { border-top: 1px solid var(--line); border-radius: 0; }\n  .notification-item.unread { background: var(--brand-soft); }\n  .notification-icon { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 10px; background: var(--surface); color: var(--brand-strong); font-size: .88rem; }\n  .notification-title { display: block; overflow: hidden; color: var(--ink); font-size: .72rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }\n  .notification-message { display: block; margin-top: 3px; overflow: hidden; color: var(--ink-soft); font-size: .68rem; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }\n  .notification-time { display: block; margin-top: 5px; color: var(--muted); font-size: .63rem; }\n  .notification-delete { width: 34px; height: 34px; display: grid; place-items: center; border: 0; border-radius: 10px; background: transparent; color: #a9b4b8; cursor: pointer; font: inherit; font-size: .82rem; }\n  .notification-delete:hover { background: var(--danger-soft); color: var(--danger); }\n  .notification-empty { padding: 30px 18px; color: var(--muted); font-size: .75rem; text-align: center; }\n  .notification-empty i { display: block; margin-bottom: 9px; color: var(--brand); font-size: 1.45rem; }\n  .notification-empty[hidden] { display: none; }\n\n  .delete-confirm { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-top: 1px solid #f2dadd; background: var(--danger-soft); color: var(--danger); font-size: .68rem; }\n  .delete-confirm[hidden] { display: none; }\n  .delete-confirm span { flex: 1; }\n  .delete-confirm button { min-height: 30px; padding: 4px 8px; border: 0; border-radius: 8px; background: transparent; color: inherit; cursor: pointer; font: inherit; font-size: .67rem; font-weight: 700; }\n  .delete-confirm button:hover { background: rgba(201, 71, 82, .1); }\n  .delete-confirm .cancel { color: var(--ink-soft); }\n\n  .popover-footer { padding: 11px 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: .68rem; text-align: center; }\n  .popover-footer button { padding: 0; border: 0; background: transparent; color: var(--brand-strong); cursor: pointer; font: inherit; font-weight: 700; }\n\n  .inline-feedback { position: absolute; z-index: 40; top: calc(max(20px, env(safe-area-inset-top)) + 72px); right: 24px; display: flex; align-items: center; gap: 8px; max-width: min(300px, calc(100vw - 24px)); padding: 10px 13px; border: 1px solid #c9ebd0; border-radius: 12px; background: var(--brand-soft); color: var(--brand-strong); font-size: .72rem; font-weight: 600; box-shadow: 0 10px 22px rgba(31, 52, 61, .1); }\n  .inline-feedback i { font-size: .9rem; }\n  .inline-feedback[hidden] { display: none; }\n\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\n\n  .design-frame.is-dark {\n    --canvas: #1e2929;\n    --surface: #263636;\n    --surface-soft: #2d4140;\n    --ink: #eef6f1;\n    --ink-soft: #c2d2cc;\n    --muted: #96aaa3;\n    --line: #38504d;\n    --brand-soft: #173e2b;\n    --brand-ring: rgba(76, 210, 103, .34);\n    --danger-soft: #452a2d;\n  }\n\n  .design-frame.is-dark .dashboard-rail { background: #183c2c; }\n  .design-frame.is-dark .utility-cluster { border-color: rgba(255,255,255,.08); box-shadow: 0 14px 30px rgba(0,0,0,.28); }\n  .design-frame.is-dark .utility-popover { box-shadow: 0 18px 38px rgba(0,0,0,.38); }\n  .design-frame.is-dark .notification-icon { background: #314543; }\n  .design-frame.is-dark .notification-badge { border-color: var(--surface); }\n  .design-frame.is-dark .dashboard-title,\n  .design-frame.is-dark .stat-value,\n  .design-frame.is-dark .popover-title,\n  .design-frame.is-dark .popover-profile-name,\n  .design-frame.is-dark .notification-title,\n  .design-frame.is-dark .profile-name { color: var(--ink); }\n  .design-frame.is-dark .donut::after { background: var(--surface); }\n\n  @media (max-width: 720px) {\n    .dashboard-content { padding-right: 18px; padding-left: 18px; }\n    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .dashboard-panels { grid-template-columns: 1fr; }\n    .dashboard-footer-line { right: 18px; left: 90px; }\n    .utility-cluster { right: max(12px, env(safe-area-inset-right)); }\n  }\n\n  @media (max-width: 414px) {\n    .design-frame, .dashboard-surface, .dashboard-content { min-height: 820px; }\n    .utility-cluster { top: max(12px, env(safe-area-inset-top)); right: max(12px, env(safe-area-inset-right)); padding: 5px; gap: 2px; }\n    .profile-trigger { padding-right: 8px; }\n    .profile-name { max-width: 92px; }\n    .utility-popover { width: min(360px, calc(100vw - 24px)); }\n    .inline-feedback { top: calc(max(12px, env(safe-area-inset-top)) + 68px); right: 12px; }\n    .dashboard-context { padding-top: 42px; }\n    .dashboard-title { font-size: 1.6rem; }\n  }\n\n  @media (max-width: 365px) {\n    .profile-copy { display: none; }\n    .profile-compact-label { display: inline; }\n    .profile-trigger { gap: 7px; padding-right: 10px; }\n    .profile-chevron { display: none; }\n    .dashboard-content { padding-right: 12px; padding-left: 12px; }\n    .dashboard-footer-line { right: 12px; left: 84px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .design-frame *, .design-frame *::before, .design-frame *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }\n  }\n</style>\n<div class=\"design-frame\" data-kid=\"2\" data-name=\"dashboard application container\" id=\"utilityDemo\">\n    <div class=\"dashboard-surface\" data-kid=\"2-1\" data-name=\"dashboard main surface\">\n        <aside aria-hidden=\"true\" class=\"dashboard-rail\" data-kid=\"2-1-1\" data-name=\"navigation rail\">\n            <div class=\"rail-mark\" data-kid=\"2-1-1-1\" data-name=\"application logo icon container\">\n                <i class=\"bi bi-buildings\" data-kid=\"2-1-1-1-1\" data-name=\"buildings icon\">\n                </i>\n            </div>\n            <div class=\"rail-item active\" data-kid=\"2-1-1-2\" data-name=\"dashboard navigation item\">\n                <i class=\"bi bi-grid-1x2-fill\" data-kid=\"2-1-1-2-1\" data-name=\"grid icon\">\n                </i>\n            </div>\n            <div class=\"rail-item\" data-kid=\"2-1-1-3\" data-name=\"requests navigation item\">\n                <i class=\"bi bi-clipboard-check\" data-kid=\"2-1-1-3-1\" data-name=\"clipboard check icon\">\n                </i>\n            </div>\n            <div class=\"rail-item\" data-kid=\"2-1-1-4\" data-name=\"users navigation item\">\n                <i class=\"bi bi-people-fill\" data-kid=\"2-1-1-4-1\" data-name=\"people icon\">\n                </i>\n            </div>\n            <div class=\"rail-item\" data-kid=\"2-1-1-5\" data-name=\"reports navigation item\">\n                <i class=\"bi bi-bar-chart-line\" data-kid=\"2-1-1-5-1\" data-name=\"bar chart icon\">\n                </i>\n            </div>\n            <div class=\"rail-item\" data-kid=\"2-1-1-6\" data-name=\"settings navigation item\">\n                <i class=\"bi bi-gear\" data-kid=\"2-1-1-6-1\" data-name=\"gear icon\">\n                </i>\n            </div>\n        </aside>\n        <main aria-label=\"Vista previa del panel administrativo\" class=\"dashboard-content\" data-kid=\"2-1-2\" data-name=\"main content area\">\n            <div class=\"dashboard-context\" data-kid=\"2-1-2-1\" data-name=\"context header\">\n                <span class=\"context-kicker\" data-kid=\"2-1-2-1-1\" data-name=\"section kicker with activity icon\">\n                    <i class=\"bi bi-activity\" data-kid=\"2-1-2-1-1-1\" data-name=\"activity icon\">\n                    </i>\n                    Panel operativo\n                </span>\n                <h1 class=\"dashboard-title\" data-kid=\"2-1-2-1-2\" data-name=\"dashboard main title\">\n                    Sistema Invilara\n                </h1>\n                <p class=\"dashboard-subtitle\" data-kid=\"2-1-2-1-3\" data-name=\"dashboard subtitle\">\n                    Sistema de Información para el Control de Solicitudes\n                </p>\n            </div>\n            <div class=\"dashboard-rule\" data-kid=\"2-1-2-2\" data-name=\"horizontal rule\">\n            </div>\n            <section aria-label=\"Resumen de solicitudes\" class=\"stats-grid\" data-kid=\"2-1-2-3\" data-name=\"stats summary grid\">\n                <article class=\"stat-card\" data-kid=\"2-1-2-3-1\" data-name=\"total requests stat card\">\n                    <div class=\"stat-topline\" data-kid=\"2-1-2-3-1-1\" data-name=\"total requests stat header\">\n                        <span data-kid=\"2-1-2-3-1-1-1\">\n                            Total solicitudes\n                        </span>\n                        <i class=\"bi bi-list-check\" data-kid=\"2-1-2-3-1-1-2\" data-name=\"list check icon\">\n                        </i>\n                    </div>\n                    <strong class=\"stat-value\" data-kid=\"2-1-2-3-1-2\" data-name=\"total requests count\">\n                        8\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"2-1-2-3-1-3\" data-name=\"total requests weekly change\">\n                        +2 esta semana\n                    </span>\n                </article>\n                <article class=\"stat-card\" data-kid=\"2-1-2-3-2\" data-name=\"pending requests stat card\">\n                    <div class=\"stat-topline\" data-kid=\"2-1-2-3-2-1\" data-name=\"pending requests stat header\">\n                        <span data-kid=\"2-1-2-3-2-1-1\">\n                            Pendientes\n                        </span>\n                        <i class=\"bi bi-hourglass-split\" data-kid=\"2-1-2-3-2-1-2\" data-name=\"hourglass icon\" style=\"color:#eaa90c\">\n                        </i>\n                    </div>\n                    <strong class=\"stat-value\" data-kid=\"2-1-2-3-2-2\" data-name=\"pending requests count\">\n                        3\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"2-1-2-3-2-3\" data-name=\"pending requests note\">\n                        Requieren revisión\n                    </span>\n                </article>\n                <article class=\"stat-card\" data-kid=\"2-1-2-3-3\" data-name=\"active requests stat card\">\n                    <div class=\"stat-topline\" data-kid=\"2-1-2-3-3-1\" data-name=\"active requests stat header\">\n                        <span data-kid=\"2-1-2-3-3-1-1\">\n                            En proceso\n                        </span>\n                        <i class=\"bi bi-arrow-repeat\" data-kid=\"2-1-2-3-3-1-2\" data-name=\"refresh icon\" style=\"color:#0b9db7\">\n                        </i>\n                    </div>\n                    <strong class=\"stat-value\" data-kid=\"2-1-2-3-3-2\" data-name=\"active requests count\">\n                        4\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"2-1-2-3-3-3\" data-name=\"active requests note\">\n                        Seguimiento activo\n                    </span>\n                </article>\n                <article class=\"stat-card\" data-kid=\"2-1-2-3-4\" data-name=\"completed requests stat card\">\n                    <div class=\"stat-topline\" data-kid=\"2-1-2-3-4-1\" data-name=\"completed requests stat header\">\n                        <span data-kid=\"2-1-2-3-4-1-1\">\n                            Completadas\n                        </span>\n                        <i class=\"bi bi-check2-circle\" data-kid=\"2-1-2-3-4-1-2\" data-name=\"check circle icon\">\n                        </i>\n                    </div>\n                    <strong class=\"stat-value\" data-kid=\"2-1-2-3-4-2\" data-name=\"completed requests count\">\n                        1\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"2-1-2-3-4-3\" data-name=\"completed requests note\">\n                        Cerradas este mes\n                    </span>\n                </article>\n            </section>\n            <section aria-label=\"Análisis del sistema\" class=\"dashboard-panels\" data-kid=\"2-1-2-4\" data-name=\"analysis panels section\">\n                <article class=\"dashboard-panel\" data-kid=\"2-1-2-4-1\" data-name=\"bar chart panel\">\n                    <div class=\"panel-heading\" data-kid=\"2-1-2-4-1-1\" data-name=\"bar chart panel header\">\n                        <i class=\"bi bi-bar-chart-line\" data-kid=\"2-1-2-4-1-1-1\" data-name=\"bar chart panel icon\">\n                        </i>\n                        Análisis por tipo de solicitud\n                    </div>\n                    <div aria-hidden=\"true\" class=\"bar-chart\" data-kid=\"2-1-2-4-1-2\" data-name=\"bar chart visual\">\n                        <div class=\"bar-column\" data-kid=\"2-1-2-4-1-2-1\" data-name=\"primary bar column\">\n                            <span class=\"bar primary\" data-kid=\"2-1-2-4-1-2-1-1\" data-name=\"primary bar\">\n                            </span>\n                            <span class=\"bar-label\" data-kid=\"2-1-2-4-1-2-1-2\" data-name=\"primary bar label\">\n                                Particular\n                            </span>\n                        </div>\n                        <div class=\"bar-column\" data-kid=\"2-1-2-4-1-2-2\" data-name=\"secondary bar column\">\n                            <span class=\"bar secondary\" data-kid=\"2-1-2-4-1-2-2-1\" data-name=\"secondary bar\">\n                            </span>\n                            <span class=\"bar-label\" data-kid=\"2-1-2-4-1-2-2-2\" data-name=\"secondary bar label\">\n                                Comunidad\n                            </span>\n                        </div>\n                        <div class=\"bar-column\" data-kid=\"2-1-2-4-1-2-3\" data-name=\"tertiary bar column\">\n                            <span class=\"bar tertiary\" data-kid=\"2-1-2-4-1-2-3-1\" data-name=\"tertiary bar\">\n                            </span>\n                            <span class=\"bar-label\" data-kid=\"2-1-2-4-1-2-3-2\" data-name=\"tertiary bar label\">\n                                Institución\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"dashboard-panel\" data-kid=\"2-1-2-4-2\" data-name=\"donut chart panel\">\n                    <div class=\"panel-heading\" data-kid=\"2-1-2-4-2-1\" data-name=\"donut chart panel header\">\n                        <i class=\"bi bi-pie-chart\" data-kid=\"2-1-2-4-2-1-1\" data-name=\"pie chart icon\">\n                        </i>\n                        Distribución por estatus\n                    </div>\n                    <div aria-hidden=\"true\" class=\"donut-area\" data-kid=\"2-1-2-4-2-2\" data-name=\"donut chart visual container\">\n                        <div class=\"donut\" data-kid=\"2-1-2-4-2-2-1\" data-name=\"donut chart element\">\n                            <span class=\"donut-center\" data-kid=\"2-1-2-4-2-2-1-1\" data-name=\"donut center label\">\n                                8 total\n                            </span>\n                        </div>\n                    </div>\n                </article>\n            </section>\n        </main>\n        <div class=\"dashboard-footer-line\" data-kid=\"2-1-3\" data-name=\"dashboard footer line\">\n            <span data-kid=\"2-1-3-1\" data-name=\"footer organization name\">\n                Instituto de Vialidad del Estado Lara · Vista administrativa\n            </span>\n            <span data-kid=\"2-1-3-2\" data-name=\"footer security badge\">\n                <i class=\"bi bi-shield-check\" data-kid=\"2-1-3-2-1\" data-name=\"shield icon\">\n                </i>\n                Sesión protegida\n            </span>\n        </div>\n        <div aria-label=\"Utilidades de cuenta\" class=\"utility-cluster\" data-kid=\"2-1-4\" data-name=\"utility cluster\" id=\"utilityCluster\">\n            <div class=\"utility-segment notification-segment\" data-kid=\"2-1-4-1\" data-name=\"notification utility segment\">\n                <button aria-controls=\"notificationPanel\" aria-expanded=\"false\" aria-label=\"Abrir notificaciones\" class=\"utility-trigger notification-trigger\" data-kid=\"2-1-4-1-1\" data-name=\"notification trigger button\" id=\"notificationTrigger\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bi bi-bell\" data-kid=\"2-1-4-1-1-1\" data-name=\"bell icon\">\n                    </i>\n                    <span class=\"notification-badge\" data-dynamic=\"true\" data-kid=\"2-1-4-1-1-2\" data-name=\"notification count badge\" data-reason=\"text value updated by notification script\" id=\"notificationBadge\">\n                        3\n                    </span>\n                </button>\n                <section aria-label=\"Panel de notificaciones\" class=\"utility-popover notification-popover\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2\" data-name=\"notification popover panel\" data-reason=\"popover visibility toggled by script\" hidden=\"\" id=\"notificationPanel\" role=\"region\">\n                    <header class=\"popover-header\" data-kid=\"2-1-4-1-2-1\" data-name=\"popover header\">\n                        <div data-kid=\"2-1-4-1-2-1-1\">\n                            <span class=\"popover-eyebrow\" data-kid=\"2-1-4-1-2-1-1-1\">\n                                Centro de actividad\n                            </span>\n                            <h2 class=\"popover-title\" data-kid=\"2-1-4-1-2-1-1-2\">\n                                Notificaciones\n                                <span class=\"count-pill\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2-1-1-2-1\" data-name=\"popover notification count\" data-reason=\"count text synchronized by script\" id=\"notificationCount\">\n                                    3\n                                </span>\n                            </h2>\n                        </div>\n                        <div class=\"popover-actions\" data-kid=\"2-1-4-1-2-1-2\">\n                            <button class=\"inline-action\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2-1-2-1\" data-name=\"mark all read button\" data-reason=\"disabled attribute updated by script\" id=\"markAll\" type=\"button\">\n                                Marcar leídas\n                            </button>\n                            <button class=\"inline-action inline-action-danger\" data-kid=\"2-1-4-1-2-1-2-2\" id=\"clearAll\" type=\"button\">\n                                Borrar\n                            </button>\n                        </div>\n                    </header>\n                    <div class=\"notification-list\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2-2\" data-name=\"notification list\" data-reason=\"items added/removed by script\" id=\"notificationList\" role=\"list\">\n                        <article class=\"notification-item unread\" data-kid=\"2-1-4-1-2-2-1\" data-unread=\"true\" role=\"listitem\">\n                            <span class=\"notification-icon\" data-kid=\"2-1-4-1-2-2-1-1\">\n                                <i aria-hidden=\"true\" class=\"bi bi-clipboard-check\" data-kid=\"2-1-4-1-2-2-1-1-1\">\n                                </i>\n                            </span>\n                            <div data-kid=\"2-1-4-1-2-2-1-2\">\n                                <strong class=\"notification-title\" data-kid=\"2-1-4-1-2-2-1-2-1\">\n                                    Solicitud pendiente de revisión\n                                </strong>\n                                <span class=\"notification-message\" data-kid=\"2-1-4-1-2-2-1-2-2\">\n                                    La solicitud #184 requiere asignación.\n                                </span>\n                                <time class=\"notification-time\" data-kid=\"2-1-4-1-2-2-1-2-3\">\n                                    hace 8 min\n                                </time>\n                            </div>\n                            <button aria-label=\"Eliminar: Solicitud pendiente de revisión\" class=\"notification-delete\" data-kid=\"2-1-4-1-2-2-1-3\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"bi bi-x-lg\" data-kid=\"2-1-4-1-2-2-1-3-1\">\n                                </i>\n                            </button>\n                        </article>\n                        <article class=\"notification-item unread\" data-kid=\"2-1-4-1-2-2-2\" data-unread=\"true\" role=\"listitem\">\n                            <span class=\"notification-icon\" data-kid=\"2-1-4-1-2-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"bi bi-images\" data-kid=\"2-1-4-1-2-2-2-1-1\">\n                                </i>\n                            </span>\n                            <div data-kid=\"2-1-4-1-2-2-2-2\">\n                                <strong class=\"notification-title\" data-kid=\"2-1-4-1-2-2-2-2-1\">\n                                    Nueva evidencia cargada\n                                </strong>\n                                <span class=\"notification-message\" data-kid=\"2-1-4-1-2-2-2-2-2\">\n                                    Se agregó evidencia a la obra El Recreo.\n                                </span>\n                                <time class=\"notification-time\" data-kid=\"2-1-4-1-2-2-2-2-3\">\n                                    hace 24 min\n                                </time>\n                            </div>\n                            <button aria-label=\"Eliminar: Nueva evidencia cargada\" class=\"notification-delete\" data-kid=\"2-1-4-1-2-2-2-3\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"bi bi-x-lg\" data-kid=\"2-1-4-1-2-2-2-3-1\">\n                                </i>\n                            </button>\n                        </article>\n                        <article class=\"notification-item unread\" data-kid=\"2-1-4-1-2-2-3\" data-unread=\"true\" role=\"listitem\">\n                            <span class=\"notification-icon\" data-kid=\"2-1-4-1-2-2-3-1\">\n                                <i aria-hidden=\"true\" class=\"bi bi-building-check\" data-kid=\"2-1-4-1-2-2-3-1-1\">\n                                </i>\n                            </span>\n                            <div data-kid=\"2-1-4-1-2-2-3-2\">\n                                <strong class=\"notification-title\" data-kid=\"2-1-4-1-2-2-3-2-1\">\n                                    Empresa actualizó su registro\n                                </strong>\n                                <span class=\"notification-message\" data-kid=\"2-1-4-1-2-2-3-2-2\">\n                                    Hay datos nuevos para validar.\n                                </span>\n                                <time class=\"notification-time\" data-kid=\"2-1-4-1-2-2-3-2-3\">\n                                    hace 1 h\n                                </time>\n                            </div>\n                            <button aria-label=\"Eliminar: Empresa actualizó su registro\" class=\"notification-delete\" data-kid=\"2-1-4-1-2-2-3-3\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"bi bi-x-lg\" data-kid=\"2-1-4-1-2-2-3-3-1\">\n                                </i>\n                            </button>\n                        </article>\n                    </div>\n                    <div class=\"notification-empty\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2-3\" data-name=\"empty notifications state\" data-reason=\"visibility toggled by script\" hidden=\"\" id=\"notificationEmpty\">\n                        <i aria-hidden=\"true\" class=\"bi bi-check2-circle\" data-kid=\"2-1-4-1-2-3-1\">\n                        </i>\n                        No tienes notificaciones pendientes.\n                    </div>\n                    <div class=\"delete-confirm\" data-dynamic=\"true\" data-kid=\"2-1-4-1-2-4\" data-name=\"delete confirmation bar\" data-reason=\"visibility toggled by script\" hidden=\"\" id=\"deleteConfirm\">\n                        <span data-kid=\"2-1-4-1-2-4-1\">\n                            ¿Borrar todas las notificaciones?\n                        </span>\n                        <button data-kid=\"2-1-4-1-2-4-2\" id=\"confirmClear\" type=\"button\">\n                            Borrar\n                        </button>\n                        <button class=\"cancel\" data-kid=\"2-1-4-1-2-4-3\" id=\"cancelClear\" type=\"button\">\n                            Cancelar\n                        </button>\n                    </div>\n                    <footer class=\"popover-footer\" data-kid=\"2-1-4-1-2-5\">\n                        <button data-kid=\"2-1-4-1-2-5-1\" id=\"historyAction\" type=\"button\">\n                            Ver historial completo\n                        </button>\n                    </footer>\n                </section>\n            </div>\n            <span aria-hidden=\"true\" class=\"utility-divider\" data-kid=\"2-1-4-2\">\n            </span>\n            <div class=\"utility-segment profile-segment\" data-kid=\"2-1-4-3\" data-name=\"profile utility segment\">\n                <button aria-controls=\"profilePanel\" aria-expanded=\"true\" aria-label=\"Perfil de admin, Mi Perfil\" class=\"utility-trigger profile-trigger\" data-kid=\"2-1-4-3-1\" data-name=\"profile trigger button\" id=\"profileTrigger\" type=\"button\">\n                    <img alt=\"Avatar de admin\" class=\"avatar\" data-kid=\"2-1-4-3-1-1\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.src='https://i.pravatar.cc/80?u=admin'\" src=\"/api/local/images/static/assets/img/avatars/1.png\"/>\n                    <span class=\"profile-copy\" data-kid=\"2-1-4-3-1-2\">\n                        <span class=\"profile-name\" data-kid=\"2-1-4-3-1-2-1\" data-name=\"profile name\">\n                            admin\n                        </span>\n                        <span class=\"profile-label\" data-kid=\"2-1-4-3-1-2-2\">\n                            Mi Perfil\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"profile-compact-label\" data-kid=\"2-1-4-3-1-3\" data-name=\"compact profile label\">\n                        Cuenta\n                    </span>\n                    <i aria-hidden=\"true\" class=\"bi bi-chevron-down profile-chevron\" data-kid=\"2-1-4-3-1-4\" data-name=\"chevron icon\">\n                    </i>\n                </button>\n                <section aria-label=\"Menú de perfil\" class=\"utility-popover profile-popover\" data-dynamic=\"true\" data-kid=\"2-1-4-3-2\" data-name=\"profile menu popover\" data-reason=\"popover visibility toggled by script\" id=\"profilePanel\" role=\"menu\">\n                    <header class=\"popover-profile-head\" data-kid=\"2-1-4-3-2-1\">\n                        <img alt=\"\" class=\"avatar\" data-kid=\"2-1-4-3-2-1-1\" decoding=\"async\" loading=\"lazy\" onerror=\"this.src='https://i.pravatar.cc/96?u=admin'\" src=\"/api/local/images/static/assets/img/avatars/1.png\"/>\n                        <div data-kid=\"2-1-4-3-2-1-2\">\n                            <p class=\"popover-profile-name\" data-kid=\"2-1-4-3-2-1-2-1\">\n                                admin\n                            </p>\n                            <p class=\"popover-profile-role\" data-kid=\"2-1-4-3-2-1-2-2\">\n                                Mi Perfil · Administrador\n                            </p>\n                            <span class=\"presence\" data-kid=\"2-1-4-3-2-1-2-3\">\n                                Sesión activa\n                            </span>\n                        </div>\n                    </header>\n                    <div class=\"menu-list\" data-kid=\"2-1-4-3-2-2\">\n                        <button class=\"menu-item\" data-kid=\"2-1-4-3-2-2-1\" id=\"editProfileAction\" role=\"menuitem\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"bi bi-person-vcard\" data-kid=\"2-1-4-3-2-2-1-1\">\n                            </i>\n                            <span class=\"menu-item-copy\" data-kid=\"2-1-4-3-2-2-1-2\">\n                                <span class=\"menu-item-title\" data-kid=\"2-1-4-3-2-2-1-2-1\">\n                                    Editar Perfil\n                                </span>\n                                <span class=\"menu-item-note\" data-kid=\"2-1-4-3-2-2-1-2-2\">\n                                    Actualiza tus datos personales\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"bi bi-chevron-right menu-item-chevron\" data-kid=\"2-1-4-3-2-2-1-3\">\n                            </i>\n                        </button>\n                        <div class=\"menu-item menu-item-switch\" data-kid=\"2-1-4-3-2-2-2\">\n                            <i aria-hidden=\"true\" class=\"bi bi-sun\" data-dynamic=\"true\" data-kid=\"2-1-4-3-2-2-2-1\" data-name=\"theme mode icon\" data-reason=\"class toggled by script\" id=\"themeIcon\">\n                            </i>\n                            <span class=\"menu-item-copy\" data-kid=\"2-1-4-3-2-2-2-2\">\n                                <span class=\"menu-item-title\" data-dynamic=\"true\" data-kid=\"2-1-4-3-2-2-2-2-1\" data-name=\"theme mode label\" data-reason=\"text content updated by script\" id=\"themeLabel\">\n                                    Modo Claro\n                                </span>\n                                <span class=\"menu-item-note\" data-kid=\"2-1-4-3-2-2-2-2-2\">\n                                    Preferencia de apariencia\n                                </span>\n                            </span>\n                            <span class=\"switch-label\" data-dynamic=\"true\" data-kid=\"2-1-4-3-2-2-2-3\" data-name=\"theme switch state text\" data-reason=\"text content updated by script\" id=\"switchState\">\n                                Claro\n                            </span>\n                            <button aria-checked=\"false\" aria-label=\"Activar modo oscuro\" class=\"switch-control\" data-dynamic=\"true\" data-kid=\"2-1-4-3-2-2-2-4\" data-name=\"theme switch control button\" data-reason=\"aria-checked attribute updated by script\" id=\"themeSwitch\" role=\"switch\" type=\"button\">\n                            </button>\n                        </div>\n                        <button class=\"menu-item\" data-kid=\"2-1-4-3-2-2-3\" id=\"configAction\" role=\"menuitem\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"bi bi-sliders2\" data-kid=\"2-1-4-3-2-2-3-1\">\n                            </i>\n                            <span class=\"menu-item-copy\" data-kid=\"2-1-4-3-2-2-3-2\">\n                                <span class=\"menu-item-title\" data-kid=\"2-1-4-3-2-2-3-2-1\">\n                                    Configuración\n                                </span>\n                                <span class=\"menu-item-note\" data-kid=\"2-1-4-3-2-2-3-2-2\">\n                                    Preferencias y accesibilidad\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"bi bi-chevron-right menu-item-chevron\" data-kid=\"2-1-4-3-2-2-3-3\">\n                            </i>\n                        </button>\n                        <div class=\"menu-divider\" data-kid=\"2-1-4-3-2-2-4\" role=\"separator\">\n                        </div>\n                        <button class=\"menu-item menu-item-danger\" data-kid=\"2-1-4-3-2-2-5\" id=\"logoutAction\" role=\"menuitem\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"bi bi-box-arrow-right\" data-kid=\"2-1-4-3-2-2-5-1\">\n                            </i>\n                            <span class=\"menu-item-copy\" data-kid=\"2-1-4-3-2-2-5-2\">\n                                <span class=\"menu-item-title\" data-kid=\"2-1-4-3-2-2-5-2-1\">\n                                    Cerrar Sesión\n                                </span>\n                                <span class=\"menu-item-note\" data-kid=\"2-1-4-3-2-2-5-2-2\">\n                                    Salir de forma segura\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </section>\n            </div>\n        </div>\n        <div aria-live=\"polite\" class=\"inline-feedback\" data-dynamic=\"true\" data-kid=\"2-1-5\" data-name=\"inline feedback banner\" data-reason=\"visibility and content updated by script\" hidden=\"\" id=\"inlineFeedback\" role=\"status\">\n            <i aria-hidden=\"true\" class=\"bi bi-check-circle\" data-kid=\"2-1-5-1\">\n            </i>\n            <span data-kid=\"2-1-5-2\" id=\"feedbackText\">\n            </span>\n        </div>\n        <div aria-atomic=\"true\" aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"2-1-6\" data-name=\"screen reader status announcer\" data-reason=\"text content updated by script\" id=\"utilityStatus\">\n        </div>\n    </div>\n    <script>\n        (() => {\n      const frame = document.getElementById('utilityDemo');\n      const cluster = document.getElementById('utilityCluster');\n      const profileTrigger = document.getElementById('profileTrigger');\n      const notificationTrigger = document.getElementById('notificationTrigger');\n      const profilePanel = document.getElementById('profilePanel');\n      const notificationPanel = document.getElementById('notificationPanel');\n      const panels = { profile: profilePanel, notifications: notificationPanel };\n      const triggers = { profile: profileTrigger, notifications: notificationTrigger };\n      const badge = document.getElementById('notificationBadge');\n      const count = document.getElementById('notificationCount');\n      const list = document.getElementById('notificationList');\n      const empty = document.getElementById('notificationEmpty');\n      const markAll = document.getElementById('markAll');\n      const clearAll = document.getElementById('clearAll');\n      const confirmBar = document.getElementById('deleteConfirm');\n      const feedback = document.getElementById('inlineFeedback');\n      const feedbackText = document.getElementById('feedbackText');\n      const status = document.getElementById('utilityStatus');\n      let activeMenu = 'profile';\n      let feedbackTimer;\n\n      function announce(message, visible = false) {\n        status.textContent = message;\n        if (!visible) return;\n        feedbackText.textContent = message;\n        feedback.hidden = false;\n        window.clearTimeout(feedbackTimer);\n        feedbackTimer = window.setTimeout(() => { feedback.hidden = true; }, 4200);\n      }\n\n      function closeMenus(restoreFocus = true) {\n        const previous = activeMenu;\n        Object.keys(panels).forEach((name) => {\n          panels[name].hidden = true;\n          triggers[name].setAttribute('aria-expanded', 'false');\n        });\n        activeMenu = null;\n        if (restoreFocus && previous) triggers[previous].focus({ preventScroll: true });\n      }\n\n      function openMenu(name) {\n        Object.keys(panels).forEach((menuName) => {\n          const isTarget = menuName === name;\n          panels[menuName].hidden = !isTarget;\n          triggers[menuName].setAttribute('aria-expanded', String(isTarget));\n        });\n        activeMenu = name;\n      }\n\n      function toggleMenu(name) {\n        const isOpen = activeMenu === name && !panels[name].hidden;\n        if (isOpen) closeMenus(true); else openMenu(name);\n      }\n\n      profileTrigger.addEventListener('click', (event) => { event.stopPropagation(); toggleMenu('profile'); });\n      notificationTrigger.addEventListener('click', (event) => { event.stopPropagation(); toggleMenu('notifications'); });\n      document.addEventListener('pointerdown', (event) => { if (activeMenu && !cluster.contains(event.target)) closeMenus(true); });\n      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && activeMenu) { event.preventDefault(); closeMenus(true); } });\n\n      document.getElementById('themeSwitch').addEventListener('click', (event) => {\n        event.stopPropagation();\n        const isDark = frame.classList.toggle('is-dark');\n        const control = event.currentTarget;\n        control.setAttribute('aria-checked', String(isDark));\n        control.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');\n        document.getElementById('themeLabel').textContent = isDark ? 'Modo Oscuro' : 'Modo Claro';\n        document.getElementById('switchState').textContent = isDark ? 'Oscuro' : 'Claro';\n        document.getElementById('themeIcon').className = isDark ? 'bi bi-moon-stars' : 'bi bi-sun';\n        announce(isDark ? 'Modo oscuro activado' : 'Modo claro activado', true);\n      });\n\n      document.getElementById('configAction').addEventListener('click', () => { closeMenus(true); announce('Configuración lista para abrir', true); });\n      document.getElementById('editProfileAction').addEventListener('click', () => { closeMenus(true); announce('Edición de perfil lista para abrir', true); });\n      document.getElementById('logoutAction').addEventListener('click', () => { closeMenus(true); announce('Cierre de sesión listo', true); });\n      document.getElementById('historyAction').addEventListener('click', () => announce('Historial completo listo para abrir', true));\n\n      function refreshNotifications() {\n        const items = Array.from(list.querySelectorAll('.notification-item'));\n        const unread = items.filter((item) => item.dataset.unread === 'true').length;\n        badge.textContent = unread;\n        count.textContent = unread;\n        badge.hidden = unread === 0;\n        markAll.disabled = unread === 0;\n        list.hidden = items.length === 0;\n        empty.hidden = items.length !== 0;\n      }\n\n      markAll.addEventListener('click', () => {\n        list.querySelectorAll('.notification-item').forEach((item) => { item.dataset.unread = 'false'; item.classList.remove('unread'); });\n        refreshNotifications();\n        announce('Todas las notificaciones están marcadas como leídas');\n      });\n\n      clearAll.addEventListener('click', () => { confirmBar.hidden = false; document.getElementById('cancelClear').focus({ preventScroll: true }); });\n      document.getElementById('cancelClear').addEventListener('click', () => { confirmBar.hidden = true; clearAll.focus({ preventScroll: true }); });\n      document.getElementById('confirmClear').addEventListener('click', () => {\n        list.replaceChildren();\n        confirmBar.hidden = true;\n        refreshNotifications();\n        announce('Notificaciones eliminadas');\n      });\n\n      list.addEventListener('click', (event) => {\n        const deleteButton = event.target.closest('.notification-delete');\n        if (!deleteButton) return;\n        const item = deleteButton.closest('.notification-item');\n        const title = item.querySelector('.notification-title').textContent;\n        item.remove();\n        refreshNotifications();\n        announce(title + ' eliminada');\n      });\n\n      refreshNotifications();\n    })();\n    </script>\n</div>\n",
