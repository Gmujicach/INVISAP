-2-2-3-2-2-2\" datetime=\"2026-08-24T18:42\">\n                                        24 ago 2026 · 06:42 PM\n                                    </time>\n                                </div>\n                                <button aria-expanded=\"false\" class=\"notification-detail\" data-kid=\"2-1-2-3-2-2-3-2-3\" data-name=\"notification detail toggle button\" data-notification-detail=\"true\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"bi bi-info-circle\" data-kid=\"2-1-2-3-2-2-3-2-3-1\" data-name=\"info icon\">\n                                    </i>\n                                    <span data-kid=\"2-1-2-3-2-2-3-2-3-2\" data-name=\"button label text\">\n                                        Ver detalles\n                                    </span>\n                                </button>\n                                <div class=\"notification-details\" data-dynamic=\"true\" data-kid=\"2-1-2-3-2-2-3-2-4\" data-name=\"notification details container\" data-reason=\"hidden attribute toggled by detail toggle button script\" hidden=\"\">\n                                    <span class=\"notification-technical-label\" data-kid=\"2-1-2-3-2-2-3-2-4-1\" data-name=\"technical detail label\">\n                                        Detalle técnico\n                                    </span>\n                                    <span data-kid=\"2-1-2-3-2-2-3-2-4-2\" data-name=\"normalized detail row\">\n                                        <strong data-kid=\"2-1-2-3-2-2-3-2-4-2-1\" data-name=\"normalized label\">\n                                            Normalizado:\n                                        </strong>\n                                        Inicio de sesión — admin\n                                    </span>\n                                    <span data-kid=\"2-1-2-3-2-2-3-2-4-3\" data-name=\"original title row\">\n                                        <strong data-kid=\"2-1-2-3-2-2-3-2-4-3-1\" data-name=\"original title label\">\n                                            Título original:\n                                        </strong>\n                                        <code data-kid=\"2-1-2-3-2-2-3-2-4-3-2\" data-name=\"original title code block\">\n                                            Login: Login\n                                        </code>\n                                    </span>\n                                    <span data-kid=\"2-1-2-3-2-2-3-2-4-4\" data-name=\"event related row\">\n                                        <strong data-kid=\"2-1-2-3-2-2-3-2-4-4-1\" data-name=\"event related label\">\n                                            Evento relacionado:\n                                        </strong>\n                                        <code data-kid=\"2-1-2-3-2-2-3-2-4-4-2\" data-name=\"event related code block\">\n                                            Logout: Login\n                                        </code>\n                                    </span>\n                                    <span data-kid=\"2-1-2-3-2-2-3-2-4-5\" data-name=\"api route row\">\n                                        <strong data-kid=\"2-1-2-3-2-2-3-2-4-5-1\" data-name=\"api route label\">\n                                            Ruta API:\n                                        </strong>\n                                        <code data-kid=\"2-1-2-3-2-2-3-2-4-5-2\" data-name=\"api route code block\">\n                                            POST /login\n                                        </code>\n                                    </span>\n                                </div>\n                            </div>\n                            <button aria-label=\"Eliminar notificación: Inicio de sesión admin\" class=\"notification-delete\" data-kid=\"2-1-2-3-2-2-3-3\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"bi bi-x-lg\" data-kid=\"2-1-2-3-2-2-3-3-1\">\n                                </i>\n                            </button>\n                        </article>\n                    </div>\n                    <div aria-live=\"polite\" class=\"panel-status\" data-dynamic=\"true\" data-kid=\"2-1-2-3-2-3\" data-name=\"notification status text\" data-reason=\"text content updated dynamically by notification script\" id=\"notificationStatus\" role=\"status\">\n                        Actualizado hace un momento\n                    </div>\n                    <div aria-live=\"polite\" class=\"panel-state\" data-dynamic=\"true\" data-kid=\"2-1-2-3-2-4\" data-name=\"empty state container\" data-reason=\"hidden attribute toggled by notification script\" hidden=\"\" id=\"emptyState\" role=\"status\">\n                        <i aria-hidden=\"true\" class=\"bi bi-check2-circle\" data-kid=\"2-1-2-3-2-4-1\">\n                        </i>\n                        <strong data-kid=\"2-1-2-3-2-4-2\">\n                            Todo al día\n                        </strong>\n                        <p data-kid=\"2-1-2-3-2-4-3\">\n                            No tienes notificaciones pendientes.\n                        </p>\n                    </div>\n                    <div class=\"panel-state is-error\" data-dynamic=\"true\" data-kid=\"2-1-2-3-2-5\" data-name=\"error state container\" data-reason=\"hidden attribute toggled by notification script\" hidden=\"\" id=\"errorState\" role=\"alert\">\n                        <i aria-hidden=\"true\" class=\"bi bi-cloud-slash\" data-kid=\"2-1-2-3-2-5-1\">\n                        </i>\n                        <strong data-kid=\"2-1-2-3-2-5-2\">\n                            No pudimos cargar las notificaciones\n                        </strong>\n                        <p data-kid=\"2-1-2-3-2-5-3\">\n                            Comprueba tu conexión e inténtalo de nuevo.\n                        </p>\n                        <button class=\"retry-button\" data-kid=\"2-1-2-3-2-5-4\" id=\"retryButton\" type=\"button\">\n                            Reintentar\n                        </button>\n                    </div>\n                </section>\n                <section aria-labelledby=\"profilePanelTitle\" class=\"utility-panel profile-panel\" data-dynamic=\"true\" data-kid=\"2-1-2-3-3\" data-name=\"profile panel container\" data-reason=\"hidden attribute toggled by UI interaction script\" hidden=\"\" id=\"profilePanel\">\n                    <div class=\"profile-summary\" data-kid=\"2-1-2-3-3-1\">\n                        <img alt=\"Avatar de admin\" data-kid=\"2-1-2-3-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=admin\"/>\n                        <div data-kid=\"2-1-2-3-3-1-2\">\n                            <strong data-kid=\"2-1-2-3-3-1-2-1\" id=\"profilePanelTitle\">\n                                admin\n                            </strong>\n                            <span data-kid=\"2-1-2-3-3-1-2-2\">\n                                Sesión activa · Administrador\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"profile-menu\" data-kid=\"2-1-2-3-3-2\">\n                        <a class=\"profile-menu-item\" data-kid=\"2-1-2-3-3-2-1\" data-menu-action=\"profile\" href=\"#\">\n                            <i aria-hidden=\"true\" class=\"bi bi-person-vcard\" data-kid=\"2-1-2-3-3-2-1-1\">\n                            </i>\n                            <span class=\"menu-copy\" data-kid=\"2-1-2-3-3-2-1-2\">\n                                <strong data-kid=\"2-1-2-3-3-2-1-2-1\">\n                                    Editar Perfil\n                                </strong>\n                                <small data-kid=\"2-1-2-3-3-2-1-2-2\">\n                                    Datos y foto de usuario\n                                </small>\n                            </span>\n                        </a>\n                        <label class=\"theme-row\" data-kid=\"2-1-2-3-3-2-2\" for=\"themeSwitch\">\n                            <i aria-hidden=\"true\" class=\"bi bi-moon-stars-fill\" data-dynamic=\"true\" data-kid=\"2-1-2-3-3-2-2-1\" data-name=\"theme icon\" data-reason=\"class list toggled by theme switch script\" id=\"themeIcon\">\n                            </i>\n                            <span class=\"menu-copy\" data-kid=\"2-1-2-3-3-2-2-2\">\n                                <strong data-dynamic=\"true\" data-kid=\"2-1-2-3-3-2-2-2-1\" data-name=\"theme label text\" data-reason=\"text content updated by theme switch script\" id=\"themeLabel\">\n                                    Modo oscuro\n                                </strong>\n                                <small data-kid=\"2-1-2-3-3-2-2-2-2\">\n                                    Preferencia de apariencia\n                                </small>\n                            </span>\n                            <input aria-label=\"Cambiar entre modo oscuro y modo claro\" checked=\"\" class=\"theme-switch\" data-dynamic=\"true\" data-kid=\"2-1-2-3-3-2-2-3\" data-name=\"theme toggle switch\" data-reason=\"checked attribute toggled by theme switch script\" id=\"themeSwitch\" role=\"switch\" type=\"checkbox\"/>\n                        </label>\n                        <a class=\"profile-menu-item\" data-kid=\"2-1-2-3-3-2-3\" data-menu-action=\"settings\" href=\"#\">\n                            <i aria-hidden=\"true\" class=\"bi bi-gear-wide-connected\" data-kid=\"2-1-2-3-3-2-3-1\">\n                            </i>\n                            <span class=\"menu-copy\" data-kid=\"2-1-2-3-3-2-3-2\">\n                                <strong data-kid=\"2-1-2-3-3-2-3-2-1\">\n                                    Configuración\n                                </strong>\n                                <small data-kid=\"2-1-2-3-3-2-3-2-2\">\n                                    Preferencias del sistema\n                                </small>\n                            </span>\n                        </a>\n                        <hr class=\"menu-separator\" data-kid=\"2-1-2-3-3-2-4\"/>\n                        <a class=\"profile-menu-item logout\" data-kid=\"2-1-2-3-3-2-5\" data-menu-action=\"logout\" href=\"#\">\n                            <i aria-hidden=\"true\" class=\"bi bi-power\" data-kid=\"2-1-2-3-3-2-5-1\">\n                            </i>\n                            <span class=\"menu-copy\" data-kid=\"2-1-2-3-3-2-5-2\">\n                                <strong data-kid=\"2-1-2-3-3-2-5-2-1\">\n                                    Cerrar Sesión\n                                </strong>\n                                <small data-kid=\"2-1-2-3-3-2-5-2-2\">\n                                    Finalizar sesión de admin\n                                </small>\n                            </span>\n                        </a>\n                    </div>\n                </section>\n            </div>\n        </main>\n    </div>\n</div>\n<script>\n    (() => {\n    const demo = document.getElementById('utilityDemo');\n    const stage = document.getElementById('utilityStage');\n    const triggers = {\n      notifications: document.getElementById('notificationsTrigger'),\n      profile: document.getElementById('profileTrigger')\n    };\n    const panels = {\n      notifications: document.getElementById('notificationsPanel'),\n      profile: document.getElementById('profilePanel')\n    };\n    const themeSwitch = document.getElementById('themeSwitch');\n    const themeIcon = document.getElementById('themeIcon');\n    const themeLabel = document.getElementById('themeLabel');\n    const notificationList = document.getElementById('notificationList');\n    const emptyState = document.getElementById('emptyState');\n    const errorState = document.getElementById('errorState');\n    const badge = document.getElementById('notificationBadge');\n    const count = document.getElementById('notificationCount');\n    const summary = document.getElementById('notificationSummary');\n    const status = document.getElementById('notificationStatus');\n    let lastTrigger = triggers.notifications;\n\n    function updateNotificationCount() {\n      const pending = notificationList.querySelectorAll('.notification-item[data-unread=\"true\"]').length;\n      badge.textContent = pending;\n      count.textContent = pending;\n      badge.hidden = pending === 0;\n      summary.textContent = pending === 0 ? 'No tienes notificaciones pendientes' : `${pending} notificaciones pendientes`;\n      status.textContent = pending === 0 ? 'Todo al día' : 'Actualizado hace un momento';\n      if (pending === 0 && !notificationList.children.length) emptyState.hidden = false;\n    }\n\n    function closePanels(restoreFocus = false) {\n      Object.keys(panels).forEach((name) => {\n        panels[name].hidden = true;\n        triggers[name].setAttribute('aria-expanded', 'false');\n      });\n      if (restoreFocus && lastTrigger) lastTrigger.focus();\n    }\n\n    function togglePanel(name) {\n      const isOpen = !panels[name].hidden;\n      closePanels(false);\n      if (!isOpen) {\n        panels[name].hidden = false;\n        triggers[name].setAttribute('aria-expanded', 'true');\n        lastTrigger = triggers[name];\n      }\n    }\n\n    Object.keys(triggers).forEach((name) => {\n      triggers[name].addEventListener('click', () => togglePanel(name));\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!stage.contains(event.target) && (!panels.notifications.hidden || !panels.profile.hidden)) closePanels(true);\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape' && (!panels.notifications.hidden || !panels.profile.hidden)) {\n        event.preventDefault();\n        closePanels(true);\n      }\n    });\n\n    document.getElementById('markReadButton').addEventListener('click', () => {\n      notificationList.querySelectorAll('.notification-item').forEach((item) => {\n        item.dataset.unread = 'false';\n        item.classList.add('is-read');\n      });\n      updateNotificationCount();\n      status.textContent = 'Notificaciones marcadas como leídas';\n    });\n\n    notificationList.addEventListener('click', (event) => {\n      const deleteButton = event.target.closest('.notification-delete');\n      if (deleteButton) {\n        const item = deleteButton.closest('.notification-item');\n        item.remove();\n        updateNotificationCount();\n        if (!notificationList.children.length) emptyState.hidden = false;\n        return;\n      }\n      if (event.target.closest('[data-notification-detail]')) return;\n      const item = event.target.closest('.notification-item');\n      if (item && item.dataset.unread === 'true') {\n        item.dataset.unread = 'false';\n        item.classList.add('is-read');\n        updateNotificationCount();\n      }\n    });\n\n    notificationList.addEventListener('click', (event) => {\n      const detailButton = event.target.closest('[data-notification-detail]');\n      if (!detailButton) return;\n      const item = detailButton.closest('.notification-item');\n      const details = item && item.querySelector('.notification-details');\n      const label = detailButton.querySelector('span');\n      if (!details) return;\n      const willOpen = details.hidden;\n      details.hidden = !willOpen;\n      detailButton.setAttribute('aria-expanded', String(willOpen));\n      if (label) label.textContent = willOpen ? 'Ocultar detalles' : 'Ver detalles';\n      status.textContent = willOpen ? 'Detalles técnicos visibles' : 'Detalles técnicos ocultos';\n    });\n\n    document.getElementById('retryButton').addEventListener('click', () => {\n      errorState.hidden = true;\n      emptyState.hidden = true;\n      status.textContent = 'Notificaciones actualizadas hace un momento';\n    });\n\n    document.querySelectorAll('[data-menu-action]').forEach((action) => {\n      action.addEventListener('click', (event) => {\n        event.preventDefault();\n        closePanels(true);\n      });\n    });\n\n    themeSwitch.addEventListener('change', () => {\n      const isDark = themeSwitch.checked;\n      demo.classList.toggle('is-light', !isDark);\n      demo.dataset.theme = isDark ? 'dark' : 'light';\n      themeLabel.textContent = isDark ? 'Modo oscuro' : 'Modo claro';\n      themeIcon.className = isDark ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';\n      status.textContent = isDark ? 'Modo oscuro activado' : 'Modo claro activado';\n    });\n\n    updateNotificationCount();\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-25T02:23:00.746377+00:00",
      "modified": "2026-08-25T02:37:49.241980+00:00",
