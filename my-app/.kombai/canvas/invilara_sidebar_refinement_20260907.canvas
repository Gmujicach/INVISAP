          </div>\n            </article>\n            <article class=\"analysis-panel\" data-kid=\"2-2-3-2\" data-name=\"analysis card\">\n                <h2 class=\"analysis-title\" data-kid=\"2-2-3-2-1\" data-name=\"analysis card title\">\n                    <i aria-hidden=\"true\" class=\"bi bi-pie-chart\" data-kid=\"2-2-3-2-1-1\" data-name=\"analysis icon\">\n                    </i>\n                    Distribución por Estatus\n                </h2>\n                <p class=\"analysis-subtitle\" data-kid=\"2-2-3-2-2\" data-name=\"analysis card subtitle\">\n                    Estado actual de las solicitudes\n                </p>\n                <div class=\"status-list\" data-kid=\"2-2-3-2-3\" data-name=\"status list\">\n                    <div class=\"status-row\" data-kid=\"2-2-3-2-3-1\" data-name=\"status list row\">\n                        <span data-kid=\"2-2-3-2-3-1-1\" data-name=\"status row label\">\n                            En Proceso\n                        </span>\n                        <div class=\"status-track\" data-kid=\"2-2-3-2-3-1-2\" data-name=\"status track\">\n                            <div class=\"status-fill\" data-kid=\"2-2-3-2-3-1-2-1\" data-name=\"status fill\" style=\"width:75%\">\n                            </div>\n                        </div>\n                        <strong data-kid=\"2-2-3-2-3-1-3\" data-name=\"status percentage\">\n                            75%\n                        </strong>\n                    </div>\n                    <div class=\"status-row\" data-kid=\"2-2-3-2-3-2\" data-name=\"status list row\">\n                        <span data-kid=\"2-2-3-2-3-2-1\" data-name=\"status row label\">\n                            Completada\n                        </span>\n                        <div class=\"status-track\" data-kid=\"2-2-3-2-3-2-2\" data-name=\"status track\">\n                            <div class=\"status-fill cyan\" data-kid=\"2-2-3-2-3-2-2-1\" data-name=\"status fill\" style=\"width:12.5%\">\n                            </div>\n                        </div>\n                        <strong data-kid=\"2-2-3-2-3-2-3\" data-name=\"status percentage\">\n                            12.5%\n                        </strong>\n                    </div>\n                    <div class=\"status-row\" data-kid=\"2-2-3-2-3-3\" data-name=\"status list row\">\n                        <span data-kid=\"2-2-3-2-3-3-1\" data-name=\"status row label\">\n                            Pendiente\n                        </span>\n                        <div class=\"status-track\" data-kid=\"2-2-3-2-3-3-2\" data-name=\"status track\">\n                            <div class=\"status-fill gold\" data-kid=\"2-2-3-2-3-3-2-1\" data-name=\"status fill\" style=\"width:12.5%\">\n                            </div>\n                        </div>\n                        <strong data-kid=\"2-2-3-2-3-3-3\" data-name=\"status percentage\">\n                            12.5%\n                        </strong>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <div class=\"workflow-strip\" data-kid=\"2-2-4\" data-name=\"workflow call to action strip\">\n            <i aria-hidden=\"true\" class=\"bi bi-clipboard-check\" data-kid=\"2-2-4-1\" data-name=\"call to action icon\">\n            </i>\n            <div data-kid=\"2-2-4-2\" data-name=\"call to action text group\">\n                <strong data-kid=\"2-2-4-2-1\" data-name=\"call to action title\">\n                    Seguimiento de gestión\n                </strong>\n                <span data-kid=\"2-2-4-2-2\" data-name=\"call to action description\">\n                    Consulta solicitudes, inspecciones y evidencias desde la navegación institucional.\n                </span>\n            </div>\n            <a data-kid=\"2-2-4-3\" data-name=\"call to action link\" href=\"#lista-de-solicitudes\">\n                Ver solicitudes\n                <i aria-hidden=\"true\" class=\"bi bi-arrow-right\" data-kid=\"2-2-4-3-1\" data-name=\"arrow icon\">\n                </i>\n            </a>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n    const shell = document.querySelector('[data-shell]');\n    const rail = document.querySelector('.navigation-shell');\n    const toggle = document.querySelector('[data-toggle-rail]');\n    const panel = document.querySelector('[data-context-panel]');\n    const closePanel = document.querySelector('[data-close-panel]');\n    const panelTitle = document.querySelector('[data-panel-title]');\n    const panelItems = document.querySelector('[data-panel-items]');\n    const panelPath = panel.querySelector('.panel-path span');\n    const panelIcon = panel.querySelector('.panel-path i');\n    const buttons = [...document.querySelectorAll('.rail-button')];\n\n    const groups = {\n      solicitudes: { title: 'Solicitudes', path: 'Solicitudes / gestión ciudadana', icon: 'bi-card-text', items: [['Registrar Solicitud','bi-person-bounding-box'],['Lista de Solicitudes','bi-list-task']] },\n      empresas: { title: 'Empresas', path: 'Empresas / registro institucional', icon: 'bi-building', items: [['Registrar Empresas','bi-plus-circle'],['Listar Empresas','bi-list-ul']] },\n      empleados: { title: 'Empleados', path: 'Empleados / gestión de personal', icon: 'bi-person', items: [['Registrar Empleados','bi-person-plus'],['Listar Empleados','bi-people']] },\n      inspecciones: { title: 'Inspecciones', path: 'Inspecciones / control de campo', icon: 'bi-clipboard-check', items: [['Registrar Inspeccion','bi-clipboard-plus'],['Listar Inspecciones','bi-list-ul']] },\n      evidencias: { title: 'Evidencias', path: 'Evidencias / soporte documental', icon: 'bi-images', items: [['Registrar Evidencias','bi-upload'],['Listar Evidencias','bi-folder2-open']] },\n      publicaciones: { title: 'Publicaciones', path: 'Publicaciones / comunicación institucional', icon: 'bi-newspaper', items: [['Registrar Publicaciones','bi-plus-circle'],['Listar Publicaciones','bi-list-ul']] },\n      reportes: { title: 'Reportes', path: 'Reportes / análisis institucional', icon: 'bi-bar-chart-line-fill', items: [['Reportes Excel','bi-file-earmark-excel'],['Reportes PDF','bi-file-earmark-pdf'],['Reportes Estadísticos','bi-bar-chart-line']] },\n      usuarios: { title: 'Usuarios', path: 'Usuarios / administración de acceso', icon: 'bi-people-fill', items: [['Registrar Usuarios','bi-person-plus'],['Listar Usuarios','bi-people']] }\n    };\n\n    function openPanel(key) {\n      const group = groups[key];\n      if (!group || shell.classList.contains('is-expanded')) return;\n      buttons.forEach(button => button.classList.toggle('is-current', button.dataset.panel === key));\n      panelTitle.textContent = group.title;\n      panelPath.textContent = group.path;\n      panelIcon.className = 'bi ' + group.icon;\n      panelItems.innerHTML = group.items.map(([label, icon]) => '<li><a href=\"#' + label.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '\"><i class=\"bi ' + icon + '\" aria-hidden=\"true\"></i>' + label + '</a></li>').join('');\n      panel.hidden = false;\n    }\n\n    function closeContextPanel() { panel.hidden = true; }\n\n    toggle.addEventListener('click', () => {\n      const expanded = shell.classList.toggle('is-expanded');\n      toggle.setAttribute('aria-expanded', String(expanded));\n      toggle.setAttribute('aria-label', expanded ? 'Colapsar menú lateral' : 'Expandir menú lateral');\n      toggle.querySelector('i').className = expanded ? 'bi bi-layout-sidebar-inset-reverse' : 'bi bi-layout-sidebar-inset';\n      if (expanded) closeContextPanel();\n    });\n\n    buttons.forEach(button => {\n      button.addEventListener('focus', () => openPanel(button.dataset.panel));\n      button.addEventListener('click', () => openPanel(button.dataset.panel));\n    });\n\n    closePanel.addEventListener('click', closeContextPanel);\n    document.addEventListener('keydown', event => {\n      if (event.key === 'Escape') closeContextPanel();\n    });\n\n    document.querySelector('.main-content').addEventListener('click', event => {\n      if (!event.target.closest('a')) closeContextPanel();\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-07T11:15:43.473507+00:00",
      "modified": "2026-09-07T11:16:49.088053+00:00",
      "id": "var_b2a1b7d26915"
    },
    "var_6e786674acdd": {
      "type": "variant",
      "label": "Rail compacto con panel de etiqueta",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap');\n\n:root {\n  --inv-green-950: #063b25;\n  --inv-green-900: #075c35;\n  --inv-green-800: #0b6b3d;\n  --inv-green-700: #0f7a46;\n  --inv-green-600: #169151;\n  --inv-green-100: #e6f2eb;\n  --inv-gold: #eab308;\n  --inv-gold-soft: #fff4c2;\n  --inv-ink: #14221d;\n  --inv-muted: #67756e;\n  --inv-line: #d8e1db;\n  --inv-surface: #ffffff;\n  --inv-canvas: #f4f7f5;\n  --inv-soft: #edf3ef;\n  --inv-blue: #2c7a89;\n  --inv-red: #b74b45;\n  --inv-rail: 88px;\n}\n\n.design-root {\n  min-height: 100vh;\n  background: var(--inv-canvas);\n  color: var(--inv-ink);\n  font-family: 'Public Sans', Arial, sans-serif;\n  font-size: 14px;\n  line-height: 1.4;\n}\n\n.design-root button {\n  font: inherit;\n}\n\n.app-shell {\n  min-height: 100vh;\n}\n\n.sidebar {\n  position: fixed;\n  inset: 0 auto 0 0;\n  z-index: 30;\n  width: var(--inv-rail);\n  overflow: hidden;\n  background: var(--inv-green-800);\n  border-right: 1px solid var(--inv-green-950);\n  color: #f7fbf8;\n}\n\n.sidebar.is-expanded {\n  width: 284px;\n}\n\n.brand-block {\n  height: 110px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px 14px;\n  border-bottom: 1px solid var(--inv-green-700);\n}\n\n.sidebar.is-expanded .brand-block {\n  justify-content: space-between;\n  padding-left: 22px;\n  padding-right: 16px;\n}\n\n.brand-link {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  color: #fff;\n  text-decoration: none;\n}\n\n.brand-logo {\n  display: block;\n  width: 48px;\n  height: auto;\n  object-fit: contain;\n}\n\n.sidebar.is-expanded .brand-logo {\n  width: 196px;\n  max-width: 196px;\n}\n\n.brand-copy {\n  display: none;\n  min-width: 0;\n  margin-left: 14px;\n}\n\n.sidebar.is-expanded .brand-copy {\n  display: block;\n}\n\n.brand-kicker {\n  display: block;\n  color: #bfe1cc;\n  font-family: 'Space Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.brand-name {\n  display: block;\n  margin-top: 4px;\n  color: #fff;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n}\n\n.sidebar-toggle {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  flex: 0 0 44px;\n  padding: 0;\n  border: 1px solid #9bd2ae;\n  border-radius: 6px;\n  color: #fff;\n  background: var(--inv-green-900);\n  cursor: pointer;\n}\n\n.sidebar-toggle:hover {\n  background: var(--inv-green-700);\n}\n\n.sidebar-toggle:focus-visible,\n.nav-item:focus-visible,\n.panel-close:focus-visible,\n.panel-action:focus-visible,\n.view-switch:focus-visible {\n  outline: 2px solid var(--inv-gold);\n  outline-offset: 3px;\n}\n\n.sidebar-nav {\n  height: calc(100vh - 110px);\n  overflow-y: auto;\n  padding: 14px 10px 22px;\n  scrollbar-color: #70b487 var(--inv-green-900);\n  scrollbar-width: thin;\n}\n\n.sidebar-nav::-webkit-scrollbar {\n  width: 7px;\n}\n\n.sidebar-nav::-webkit-scrollbar-track {\n  background: var(--inv-green-900);\n}\n\n.sidebar-nav::-webkit-scrollbar-thumb {\n  background: #70b487;\n  border-radius: 0;\n}\n\n.section-label {\n  display: none;\n  margin: 14px 12px 7px;\n  color: #bfe1cc;\n  font-family: 'Space Mono', monospace;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.sidebar.is-expanded .section-label {\n  display: block;\n}\n\n.nav-list,\n.nav-children {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.nav-item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  width: 100%;\n  min-height: 48px;\n  gap: 12px;\n  padding: 0 12px;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: #eaf6ee;\n  background: transparent;\n  text-align: left;\n  cursor: pointer;\n}\n\n.nav-item:hover {\n  background: var(--inv-green-700);\n  color: #fff;\n}\n\n.nav-item.is-current {\n  border-color: var(--inv-gold);\n  color: var(--inv-ink);\n  background: var(--inv-gold);\n}\n\n.nav-item.is-current::before {\n  position: absolute;\n  inset: 7px auto 7px 0;\n  width: 3px;\n  background: var(--inv-ink);\n  content: '';\n}\n\n.nav-item.is-current .nav-icon,\n.nav-item.is-current .chevron {\n  color: var(--inv-ink);\n}\n\n.nav-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 22px;\n  min-width: 22px;\n  height: 22px;\n  color: #eaf6ee;\n  font-size: 18px;\n  line-height: 1;\n}\n\n.nav-label {\n  display: none;\n  min-width: 0;\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.sidebar.is-expanded .nav-label {\n  display: block;\n}\n\n.chevron {\n  display: none;\n  width: 16px;\n  height: 16px;\n  color: #bfe1cc;\n  font-size: 13px;\n}\n\n.sidebar.is-expanded .has-children .chevron {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.nav-children {\n  display: none;\n  margin: 2px 0 7px 32px;\n  padding-left: 12px;\n  border-left: 1px solid #72b98a;\n}\n\n.sidebar.is-expanded .nav-children {\n  display: block;\n}\n\n.nav-child {\n  display: flex;\n  align-items: center;\n  min-height: 34px;\n  padding: 0 8px;\n  border: 0;\n  color: #cce8d4;\n  background: transparent;\n  font-size: 12px;\n  text-align: left;\n  cursor: pointer;\n}\n\n.nav-child:hover,\n.nav-child:focus-visible {\n  color: #fff;\n  background: var(--inv-green-700);\n  outline: none;\n}\n\n.rail-rule {\n  display: block;\n  height: 1px;\n  margin: 12px 13px;\n  background: #3e8d5d;\n}\n\n.sidebar.is-expanded .rail-rule {\n  margin: 13px 12px;\n  background: #4e9968;\n}\n\n.label-panel {\n  position: fixed;\n  top: 126px;\n  left: calc(var(--inv-rail) + 12px);\n  z-index: 25;\n  width: 276px;\n  border: 1px solid var(--inv-green-900);\n  border-left: 4px solid var(--inv-gold);\n  background: #fff;\n}\n\n.sidebar.is-expanded ~ .label-panel {\n  display: none;\n}\n\n.panel-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 16px 16px 13px;\n  border-bottom: 1px solid var(--inv-line);\n  background: var(--inv-soft);\n}\n\n.panel-eyebrow {\n  margin: 0 0 4px;\n  color: var(--inv-green-800);\n  font-family: 'Space Mono', monospace;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n}\n\n.panel-title {\n  margin: 0;\n  color: var(--inv-ink);\n  font-size: 18px;\n  font-weight: 800;\n  line-height: 1.15;\n}\n\n.panel-close {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  flex: 0 0 32px;\n  border: 1px solid var(--inv-line);\n  color: var(--inv-muted);\n  background: #fff;\n  cursor: pointer;\n}\n\n.panel-close:hover {\n  color: var(--inv-ink);\n  background: var(--inv-gold-soft);\n  border-color: var(--inv-gold);\n}\n\n.panel-body {\n  padding: 15px 16px 16px;\n}\n\n.panel-description {\n  margin: 0 0 14px;\n  color: var(--inv-muted);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.panel-meta {\n  display: inline-flex;\n  align-items: center;\n  min-height: 24px;\n  padding: 0 8px;\n  border: 1px solid #a9d2b5;\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n  font-family: 'Space Mono', monospace;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.panel-section-title {\n  margin: 17px 0 7px;\n  color: var(--inv-muted);\n  font-family: 'Space Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n}\n\n.panel-submodule {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 32px;\n  color: var(--inv-ink);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.panel-submodule i {\n  width: 16px;\n  height: 16px;\n  color: var(--inv-green-700);\n  font-size: 14px;\n}\n\n.panel-action {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 36px;\n  margin-top: 13px;\n  padding: 0 11px;\n  border: 1px solid var(--inv-green-800);\n  color: #fff;\n  background: var(--inv-green-800);\n  font-size: 12px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.panel-action:hover {\n  background: var(--inv-green-700);\n}\n\n.main {\n  min-height: 100vh;\n  margin-left: var(--inv-rail);\n  padding: 32px 42px 48px;\n}\n\n.sidebar.is-expanded ~ .label-panel ~ .main {\n  margin-left: 284px;\n}\n\n.topbar {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 26px;\n  margin-bottom: 28px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--inv-line);\n}\n\n.kicker {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-bottom: 9px;\n  color: var(--inv-green-800);\n  font-family: 'Space Mono', monospace;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .09em;\n  text-transform: uppercase;\n}\n\n.kicker-mark {\n  width: 24px;\n  height: 3px;\n  background: var(--inv-gold);\n}\n\n.page-title {\n  margin: 0;\n  color: var(--inv-ink);\n  font-size: 31px;\n  font-weight: 800;\n  letter-spacing: -.03em;\n}\n\n.page-subtitle {\n  margin: 6px 0 0;\n  color: var(--inv-muted);\n  font-size: 14px;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.view-switch {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  min-height: 42px;\n  padding: 0 14px;\n  border: 1px solid var(--inv-green-800);\n  color: var(--inv-green-900);\n  background: #fff;\n  font-size: 12px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.view-switch:hover {\n  color: #fff;\n  background: var(--inv-green-800);\n}\n\n.user-chip {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 42px;\n  padding: 0 12px;\n  border: 1px solid var(--inv-line);\n  background: #fff;\n}\n\n.user-avatar {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 26px;\n  height: 26px;\n  border: 1px solid var(--inv-green-700);\n  border-radius: 50%;\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n  font-size: 11px;\n  font-weight: 800;\n}\n\n.user-copy strong,\n.user-copy span {\n  display: block;\n}\n\n.user-copy strong {\n  color: var(--inv-ink);\n  font-size: 12px;\n}\n\n.user-copy span {\n  margin-top: 2px;\n  color: var(--inv-muted);\n  font-size: 10px;\n}\n\n.metric-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 14px;\n  margin-bottom: 25px;\n}\n\n.metric-card {\n  min-height: 126px;\n  padding: 17px 18px;\n  border: 1px solid var(--inv-line);\n  border-top: 3px solid var(--inv-green-800);\n  background: var(--inv-surface);\n}\n\n.metric-card.gold { border-top-color: var(--inv-gold); }\n.metric-card.blue { border-top-color: var(--inv-blue); }\n.metric-card.red { border-top-color: var(--inv-red); }\n\n.metric-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.metric-label {\n  color: var(--inv-muted);\n  font-family: 'Space Mono', monospace;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .06em;\n  text-transform: uppercase;\n}\n\n.metric-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  color: var(--inv-green-800);\n  background: var(--inv-green-100);\n  font-size: 17px;\n}\n\n.metric-card.gold .metric-icon { color: #8c6900; background: var(--inv-gold-soft); }\n.metric-card.blue .metric-icon { color: var(--inv-blue); background: #e2f1f3; }\n.metric-card.red .metric-icon { color: var(--inv-red); background: #f8e8e6; }\n\n.metric-value {\n  margin-top: 13px;\n  color: var(--inv-ink);\n  font-family: 'Space Mono', monospace;\n  font-size: 30px;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.metric-note {\n  margin-top: 7px;\n  color: var(--inv-muted);\n  font-size: 11px;\n}\n\n.analysis-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);\n  gap: 18px;\n}\n\n.analysis-card {\n  min-height: 286px;\n  padding: 20px;\n  border: 1px solid var(--inv-line);\n  background: #fff;\n}\n\n.analysis-card.wide {\n  grid-column: span 2;\n  min-height: 238px;\n}\n\n.analysis-title {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin: 0;\n  color: var(--inv-ink);\n  font-size: 16px;\n  font-weight: 800;\n}\n\n.analysis-title i {\n  width: 18px;\n  height: 18px;\n  color: var(--inv-green-800);\n  font-size: 16px;\n}\n\n.analysis-caption {\n  margin: 5px 0 17px 27px;\n  color: var(--inv-muted);\n  font-size: 12px;\n}\n\n.bar-row {\n  display: grid;\n  grid-template-columns: 148px minmax(0, 1fr) 36px;\n  align-items: center;\n  gap: 12px;\n  min-height: 36px;\n  border-bottom: 1px solid #edf1ee;\n}\n\n.bar-row:last-child { border-bottom: 0; }\n\n.bar-name,\n.bar-value {\n  color: var(--inv-ink);\n  font-size: 12px;\n}\n\n.bar-value {\n  color: var(--inv-muted);\n  font-family: 'Space Mono', monospace;\n  text-align: right;\n}\n\n.bar-track {\n  height: 10px;\n  background: var(--inv-soft);\n}\n\n.bar-fill {\n  height: 100%;\n  background: var(--inv-green-700);\n}\n\n.bar-fill.gold { background: var(--inv-gold); }\n.bar-fill.blue { background: var(--inv-blue); }\n.bar-fill.dark { background: var(--inv-green-950); }\n\n.status-list {\n  display: grid;\n  gap: 11px;\n  margin-top: 23px;\n}\n\n.status-row {\n  display: grid;\n  grid-template-columns: 10px 1fr auto;\n  align-items: center;\n  gap: 9px;\n  min-height: 28px;\n  color: var(--inv-ink);\n  font-size: 12px;\n}\n\n.status-dot {\n  width: 10px;\n  height: 10px;\n  background: var(--inv-green-700);\n}\n\n.status-dot.gold { background: var(--inv-gold); }\n.status-dot.blue { background: var(--inv-blue); }\n\n.status-count {\n  color: var(--inv-muted);\n  font-family: 'Space Mono', monospace;\n}\n\n.callout {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  margin-top: 18px;\n  padding: 15px 17px;\n  border: 1px solid #b6d6c0;\n  border-left: 4px solid var(--inv-gold);\n  background: var(--inv-green-100);\n}\n\n.callout strong {\n  display: block;\n  color: var(--inv-green-950);\n  font-size: 13px;\n}\n\n.callout span {\n  display: block;\n  margin-top: 3px;\n  color: var(--inv-muted);\n  font-size: 11px;\n}\n\n@media (max-width: 1060px) {\n  .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .analysis-grid { grid-template-columns: 1fr; }\n  .analysis-card.wide { grid-column: span 1; }\n  .main { padding-left: 26px; padding-right: 26px; }\n}\n\n/* Refinamiento Invilara: rail claro y estados verdes consistentes. */\n:root {\n  --inv-gold: var(--inv-green-600);\n  --inv-gold-soft: var(--inv-green-100);\n}\n\n.sidebar {\n  background: #fff;\n  border-right-color: var(--inv-line);\n  color: var(--inv-green-800);\n  box-shadow: 8px 0 18px rgba(6, 59, 37, .06);\n}\n\n.brand-block {\n  background: #fff;\n  border-bottom-color: var(--inv-line);\n}\n\n.brand-link,\n.brand-name {\n  color: var(--inv-green-900);\n}\n\n.brand-logo {\n  filter: brightness(0) saturate(100%) invert(25%) sepia(25%) saturate(1120%) hue-rotate(101deg) brightness(82%) contrast(96%);\n}\n\n.brand-kicker,\n.section-label {\n  color: var(--inv-green-700);\n}\n\n.sidebar-toggle {\n  border-color: #a9d2b5;\n  color: var(--inv-green-800);\n  background: #fff;\n}\n\n.sidebar-toggle:hover {\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n}\n\n.sidebar-toggle:focus-visible,\n.nav-item:focus-visible,\n.panel-close:focus-visible,\n.panel-action:focus-visible,\n.view-switch:focus-visible {\n  outline-color: var(--inv-green-600);\n}\n\n.sidebar-nav {\n  scrollbar-color: #a9d2b5 #f5f8f6;\n}\n\n.sidebar-nav::-webkit-scrollbar-track {\n  background: #f5f8f6;\n}\n\n.sidebar-nav::-webkit-scrollbar-thumb {\n  background: #a9d2b5;\n}\n\n.nav-item {\n  color: var(--inv-green-800);\n}\n\n.nav-item:hover,\n.nav-item:focus-visible {\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n}\n\n.nav-item.is-current,\n.nav-item.is-current:hover,\n.nav-item.is-current:focus-visible {\n  border-color: var(--inv-green-700);\n  color: #fff;\n  background: var(--inv-green-700);\n}\n\n.nav-item.is-current::before {\n  background: #fff;\n}\n\n.nav-item.is-current .nav-icon,\n.nav-item.is-current .chevron {\n  color: #fff;\n}\n\n.nav-icon {\n  color: var(--inv-green-800);\n}\n\n.chevron {\n  color: var(--inv-green-600);\n}\n\n.nav-children {\n  border-left-color: #b6d6c0;\n}\n\n.nav-child {\n  color: var(--inv-green-800);\n}\n\n.nav-child:hover,\n.nav-child:focus-visible {\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n}\n\n.rail-rule {\n  background: var(--inv-line);\n}\n\n.sidebar.is-expanded .rail-rule {\n  background: #c6ded0;\n}\n\n.label-panel {\n  border-color: var(--inv-green-800);\n  border-left-color: var(--inv-green-700);\n}\n\n.panel-close:hover {\n  color: var(--inv-green-900);\n  background: var(--inv-green-100);\n  border-color: var(--inv-green-600);\n}\n\n.metric-card.gold .metric-icon {\n  color: var(--inv-green-800);\n  background: var(--inv-green-100);\n}\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"design-root\" data-kid=\"2\">\n    <div class=\"app-shell\" data-kid=\"2-1\">\n        <aside aria-label=\"Navegación institucional\" class=\"sidebar\" data-kid=\"2-1-1\" data-name=\"sidebar container\" id=\"sidebar\">\n            <div class=\"brand-block\" data-kid=\"2-1-1-1\" data-name=\"brand area header\">\n                <a aria-label=\"Inicio — Control Invilara\" class=\"brand-link\" data-kid=\"2-1-1-1-1\" href=\"#\">\n                    <img alt=\"INVILARA — Instituto de Vialidad del Estado Lara\" class=\"brand-logo\" data-kid=\"2-1-1-1-1-1\" src=\"/api/local/images/static/assets/img/INVILARA%20LOGO%20OFICIAL%20HORIZONTAL_WHITE.png\"/>\n                    <spa