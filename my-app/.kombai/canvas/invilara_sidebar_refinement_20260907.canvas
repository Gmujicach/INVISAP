v aria-label=\"Usuario conectado: admin, Super Usuario\" class=\"user-chip\" data-kid=\"2-1-3-1-2-2\">\n                        <span class=\"user-avatar\" data-kid=\"2-1-3-1-2-2-1\">\n                            AD\n                        </span>\n                        <span class=\"user-copy\" data-kid=\"2-1-3-1-2-2-2\">\n                            <strong data-kid=\"2-1-3-1-2-2-2-1\">\n                                admin\n                            </strong>\n                            <span data-kid=\"2-1-3-1-2-2-2-2\">\n                                Super Usuario\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <section aria-labelledby=\"metricas-title\" data-kid=\"2-1-3-2\">\n                <h2 data-kid=\"2-1-3-2-1\" id=\"metricas-title\" style=\"position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);\">\n                    Métricas de solicitudes\n                </h2>\n                <div class=\"metric-grid\" data-kid=\"2-1-3-2-2\">\n                    <article class=\"metric-card\" data-kid=\"2-1-3-2-2-1\">\n                        <div class=\"metric-head\" data-kid=\"2-1-3-2-2-1-1\">\n                            <span class=\"metric-label\" data-kid=\"2-1-3-2-2-1-1-1\">\n                                Total solicitudes\n                            </span>\n                            <i aria-hidden=\"true\" class=\"metric-icon bi bi-list-task\" data-kid=\"2-1-3-2-2-1-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"metric-value\" data-kid=\"2-1-3-2-2-1-2\">\n                            08\n                        </div>\n                        <div class=\"metric-note\" data-kid=\"2-1-3-2-2-1-3\">\n                            Registradas en el sistema\n                        </div>\n                    </article>\n                    <article class=\"metric-card gold\" data-kid=\"2-1-3-2-2-2\">\n                        <div class=\"metric-head\" data-kid=\"2-1-3-2-2-2-1\">\n                            <span class=\"metric-label\" data-kid=\"2-1-3-2-2-2-1-1\">\n                                Pendientes\n                            </span>\n                            <i aria-hidden=\"true\" class=\"metric-icon bi bi-clock-history\" data-kid=\"2-1-3-2-2-2-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"metric-value\" data-kid=\"2-1-3-2-2-2-2\">\n                            01\n                        </div>\n                        <div class=\"metric-note\" data-kid=\"2-1-3-2-2-2-3\">\n                            Requieren priorización\n                        </div>\n                    </article>\n                    <article class=\"metric-card blue\" data-kid=\"2-1-3-2-2-3\">\n                        <div class=\"metric-head\" data-kid=\"2-1-3-2-2-3-1\">\n                            <span class=\"metric-label\" data-kid=\"2-1-3-2-2-3-1-1\">\n                                En proceso\n                            </span>\n                            <i aria-hidden=\"true\" class=\"metric-icon bi bi-arrow-repeat\" data-kid=\"2-1-3-2-2-3-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"metric-value\" data-kid=\"2-1-3-2-2-3-2\">\n                            06\n                        </div>\n                        <div class=\"metric-note\" data-kid=\"2-1-3-2-2-3-3\">\n                            Con seguimiento activo\n                        </div>\n                    </article>\n                    <article class=\"metric-card red\" data-kid=\"2-1-3-2-2-4\">\n                        <div class=\"metric-head\" data-kid=\"2-1-3-2-2-4-1\">\n                            <span class=\"metric-label\" data-kid=\"2-1-3-2-2-4-1-1\">\n                                Completadas\n                            </span>\n                            <i aria-hidden=\"true\" class=\"metric-icon bi bi-check-circle\" data-kid=\"2-1-3-2-2-4-1-2\">\n                            </i>\n                        </div>\n                        <div class=\"metric-value\" data-kid=\"2-1-3-2-2-4-2\">\n                            01\n                        </div>\n                        <div class=\"metric-note\" data-kid=\"2-1-3-2-2-4-3\">\n                            Procesadas recientemente\n                        </div>\n                    </article>\n                </div>\n            </section>\n            <section aria-label=\"Análisis de solicitudes\" class=\"analysis-grid\" data-kid=\"2-1-3-3\">\n                <article class=\"analysis-card\" data-kid=\"2-1-3-3-1\">\n                    <h2 class=\"analysis-title\" data-kid=\"2-1-3-3-1-1\">\n                        <i aria-hidden=\"true\" class=\"bi bi-bar-chart-line\" data-kid=\"2-1-3-3-1-1-1\">\n                        </i>\n                        Análisis por tipo de solicitud\n                    </h2>\n                    <p class=\"analysis-caption\" data-kid=\"2-1-3-3-1-2\">\n                        Distribución de requerimientos registrados.\n                    </p>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-1-3\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-1-3-1\">\n                            Particular\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-1-3-2\">\n                            <div class=\"bar-fill dark\" data-kid=\"2-1-3-3-1-3-2-1\" style=\"width:82%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-1-3-3\">\n                            04\n                        </span>\n                    </div>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-1-4\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-1-4-1\">\n                            Comunidad\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-1-4-2\">\n                            <div class=\"bar-fill\" data-kid=\"2-1-3-3-1-4-2-1\" style=\"width:62%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-1-4-3\">\n                            03\n                        </span>\n                    </div>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-1-5\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-1-5-1\">\n                            Institución\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-1-5-2\">\n                            <div class=\"bar-fill gold\" data-kid=\"2-1-3-3-1-5-2-1\" style=\"width:25%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-1-5-3\">\n                            01\n                        </span>\n                    </div>\n                </article>\n                <article class=\"analysis-card\" data-kid=\"2-1-3-3-2\">\n                    <h2 class=\"analysis-title\" data-kid=\"2-1-3-3-2-1\">\n                        <i aria-hidden=\"true\" class=\"bi bi-pie-chart\" data-kid=\"2-1-3-3-2-1-1\">\n                        </i>\n                        Distribución por estatus\n                    </h2>\n                    <p class=\"analysis-caption\" data-kid=\"2-1-3-3-2-2\">\n                        Lectura rápida del estado operativo.\n                    </p>\n                    <div class=\"status-list\" data-kid=\"2-1-3-3-2-3\">\n                        <div class=\"status-row\" data-kid=\"2-1-3-3-2-3-1\">\n                            <span class=\"status-dot\" data-kid=\"2-1-3-3-2-3-1-1\">\n                            </span>\n                            <span data-kid=\"2-1-3-3-2-3-1-2\">\n                                En proceso\n                            </span>\n                            <span class=\"status-count\" data-kid=\"2-1-3-3-2-3-1-3\">\n                                06 · 75%\n                            </span>\n                        </div>\n                        <div class=\"status-row\" data-kid=\"2-1-3-3-2-3-2\">\n                            <span class=\"status-dot gold\" data-kid=\"2-1-3-3-2-3-2-1\">\n                            </span>\n                            <span data-kid=\"2-1-3-3-2-3-2-2\">\n                                Pendiente\n                            </span>\n                            <span class=\"status-count\" data-kid=\"2-1-3-3-2-3-2-3\">\n                                01 · 13%\n                            </span>\n                        </div>\n                        <div class=\"status-row\" data-kid=\"2-1-3-3-2-3-3\">\n                            <span class=\"status-dot blue\" data-kid=\"2-1-3-3-2-3-3-1\">\n                            </span>\n                            <span data-kid=\"2-1-3-3-2-3-3-2\">\n                                Completada\n                            </span>\n                            <span class=\"status-count\" data-kid=\"2-1-3-3-2-3-3-3\">\n                                01 · 12%\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"callout\" data-kid=\"2-1-3-3-2-4\">\n                        <div data-kid=\"2-1-3-3-2-4-1\">\n                            <strong data-kid=\"2-1-3-3-2-4-1-1\">\n                                Prioridad de hoy\n                            </strong>\n                            <span data-kid=\"2-1-3-3-2-4-1-2\">\n                                Revisar la solicitud pendiente antes de asignar nueva obra.\n                            </span>\n                        </div>\n                        <i aria-hidden=\"true\" class=\"bi bi-arrow-up-right\" data-kid=\"2-1-3-3-2-4-2\" style=\"color:var(--inv-green-800); font-size:18px;\">\n                        </i>\n                    </div>\n                </article>\n                <article class=\"analysis-card wide\" data-kid=\"2-1-3-3-3\">\n                    <h2 class=\"analysis-title\" data-kid=\"2-1-3-3-3-1\">\n                        <i aria-hidden=\"true\" class=\"bi bi-map\" data-kid=\"2-1-3-3-3-1-1\">\n                        </i>\n                        Actividad por parroquia\n                    </h2>\n                    <p class=\"analysis-caption\" data-kid=\"2-1-3-3-3-2\">\n                        Solicitudes activas que requieren acompañamiento territorial.\n                    </p>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-3-3\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-3-3-1\">\n                            Cabudare\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-3-3-2\">\n                            <div class=\"bar-fill\" data-kid=\"2-1-3-3-3-3-2-1\" style=\"width:88%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-3-3-3\">\n                            03\n                        </span>\n                    </div>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-3-4\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-3-4-1\">\n                            Agua Viva\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-3-4-2\">\n                            <div class=\"bar-fill blue\" data-kid=\"2-1-3-3-3-4-2-1\" style=\"width:56%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-3-4-3\">\n                            02\n                        </span>\n                    </div>\n                    <div class=\"bar-row\" data-kid=\"2-1-3-3-3-5\">\n                        <span class=\"bar-name\" data-kid=\"2-1-3-3-3-5-1\">\n                            Juan de Villegas\n                        </span>\n                        <div class=\"bar-track\" data-kid=\"2-1-3-3-3-5-2\">\n                            <div class=\"bar-fill gold\" data-kid=\"2-1-3-3-3-5-2-1\" style=\"width:28%;\">\n                            </div>\n                        </div>\n                        <span class=\"bar-value\" data-kid=\"2-1-3-3-3-5-3\">\n                            01\n                        </span>\n                    </div>\n                </article>\n            </section>\n        </main>\n    </div>\n</div>\n<script>\n    (() => {\n  const sidebar = document.getElementById('sidebar');\n  const sidebarToggle = document.getElementById('sidebar-toggle');\n  const viewSwitch = document.getElementById('view-switch');\n  const toggleIcon = document.getElementById('sidebar-toggle-icon');\n  const panel = document.getElementById('label-panel');\n  const panelClose = document.getElementById('panel-close');\n  const panelTitle = document.getElementById('panel-title');\n  const panelType = document.getElementById('panel-type');\n  const panelDescription = document.getElementById('panel-description');\n  const panelItems = document.getElementById('panel-items');\n  const triggers = Array.from(document.querySelectorAll('[data-panel]'));\n  let lastTrigger = document.querySelector('[data-panel=\"solicitudes\"]');\n  const panelData = {\n    solicitudes: { title: 'Solicitudes', type: 'Módulo', description: 'Gestión de solicitudes ciudadanas y seguimiento de requerimientos del territorio.', items: ['Registrar Solicitud', 'Lista de Solicitudes'] },\n    empresas: { title: 'Empresas', type: 'Módulo', description: 'Registro y consulta de empresas vinculadas a la gestión institucional.', items: ['Registrar Empresas', 'Listar Empresas'] },\n    empleados: { title: 'Empleados', type: 'Módulo', description: 'Administración del personal que participa en la operación.', items: ['Registrar Empleados', 'Listar Empleados'] },\n    inspecciones: { title: 'Inspecciones', type: 'Módulo', description: 'Registro y seguimiento de inspecciones técnicas en territorio.', items: ['Registrar Inspeccion', 'Listar Inspecciones'] },\n    evidencias: { title: 'Evidencias', type: 'Módulo', description: 'Carga y consulta de evidencias asociadas a inspecciones.', items: ['Registrar Evidencias', 'Listar Evidencias'] },\n    publicaciones: { title: 'Publicaciones', type: 'Módulo', description: 'Gestión de publicaciones institucionales.', items: ['Registrar Publicaciones', 'Listar Publicaciones'] },\n    reportes: { title: 'Reportes', type: 'Módulo', description: 'Acceso a reportes operativos, Excel, PDF y estadísticos.', items: ['Reportes Excel', 'Reportes PDF', 'Reportes Estadísticos'] },\n    usuarios: { title: 'Usuarios', type: 'Módulo', description: 'Administración de cuentas y usuarios del sistema.', items: ['Registrar Usuarios', 'Listar Usuarios'] },\n    gravedad: { title: 'Gravedad de la Obra', type: 'Acción', description: 'Gestiona el nivel de gravedad asociado a una obra.', items: [] },\n    prioridad: { title: 'Prioridad', type: 'Acción', description: 'Define la prioridad de atención para las solicitudes.', items: [] },\n    proyectos: { title: 'Asignar Proyectos', type: 'Acción', description: 'Asigna proyectos y responsables a la operación.', items: [] },\n    maquinaria: { title: 'Maquinaria', type: 'Acción', description: 'Consulta y gestiona la maquinaria disponible.', items: [] },\n    contratacion: { title: 'Contratación', type: 'Acción', description: 'Gestiona los procesos de contratación institucional.', items: [] },\n    obras: { title: 'Obras', type: 'Acción', description: 'Administra las obras y su información principal.', items: [] },\n    informes: { title: 'Informe Avance de Obra', type: 'Acción', description: 'Consulta el avance registrado de las obras.', items: [] },\n    permisos: { title: 'Permisos por Rol', type: 'Acción', description: 'Administra permisos y acceso por rol.', items: [] },\n    respaldos: { title: 'Administrar Respaldos', type: 'Acción', description: 'Administra los respaldos del sistema.', items: [] },\n    bitacora: { title: 'Bitacora', type: 'Acción', description: 'Consulta el historial de acciones del sistema.', items: [] },\n    manual: { title: 'Manual del Sistema', type: 'Acción', description: 'Consulta la documentación de uso de INVILARA.', items: [] }\n  };\n\n  function setExpanded(expanded) {\n    sidebar.classList.toggle('is-expanded', expanded);\n    sidebarToggle.setAttribute('aria-expanded', String(expanded));\n    viewSwitch.setAttribute('aria-expanded', String(expanded));\n    sidebarToggle.setAttribute('aria-label', expanded ? 'Colapsar menú lateral' : 'Expandir menú lateral');\n    viewSwitch.querySelector('span').textContent = expanded ? 'Probar vista compacta' : 'Probar vista expandida';\n    toggleIcon.className = expanded ? 'bi bi-layout-sidebar-inset-reverse' : 'bi bi-layout-sidebar-inset';\n    if (expanded) closePanel(false);\n  }\n\n  function renderPanel(key, trigger) {\n    const data = panelData[key];\n    if (!data) return;\n    lastTrigger = trigger;\n    panelTitle.textContent = data.title;\n    panelType.textContent = data.type;\n    panelDescription.textContent = data.description;\n    panelClose.setAttribute('aria-label', 'Cerrar panel de ' + data.title);\n    panelItems.innerHTML = data.items.length ? data.items.map((item, index) => '<div class=\"panel-submodule\"><i class=\"bi ' + (index ? 'bi-list-ul' : 'bi-plus-circle') + '\" aria-hidden=\"true\"></i><span>' + item + '</span></div>').join('') : '<div class=\"panel-submodule\"><i class=\"bi bi-arrow-right-circle\" aria-hidden=\"true\"></i><span>Acceso directo al módulo</span></div>';\n    panel.querySelector('.panel-meta').textContent = data.items.length ? data.items.length + (data.items.length === 1 ? ' acción disponible' : ' acciones disponibles') : 'Acción directa';\n    panel.hidden = false;\n    triggers.forEach((item) => {\n      const isActive = item === trigger;\n      item.classList.toggle('is-current', isActive);\n      item.setAttribute('aria-expanded', String(isActive));\n    });\n  }\n\n  function closePanel(restoreFocus) {\n    panel.hidden = true;\n    if (lastTrigger) lastTrigger.setAttribute('aria-expanded', 'false');\n    if (restoreFocus && lastTrigger) lastTrigger.focus({ preventScroll: true });\n  }\n\n  sidebarToggle.addEventListener('click', () => setExpanded(!sidebar.classList.contains('is-expanded')));\n  viewSwitch.addEventListener('click', () => setExpanded(!sidebar.classList.contains('is-expanded')));\n  panelClose.addEventListener('click', () => closePanel(true));\n  triggers.forEach((trigger) => {\n    trigger.addEventListener('click', () => renderPanel(trigger.dataset.panel, trigger));\n    trigger.addEventListener('focus', () => {\n      if (!sidebar.classList.contains('is-expanded')) renderPanel(trigger.dataset.panel, trigger);\n    });\n  });\n  document.addEventListener('click', (event) => {\n    if (!panel.hidden && !panel.contains(event.target) && !sidebar.contains(event.target)) closePanel(false);\n  });\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && !panel.hidden) closePanel(true);\n  });\n  panel.hidden = false;\n})();\n</script>\n",
