      "html": "<link data-kid=\"1\" data-name=\"bootstrap icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n\n  :root {\n    --ink: #13231d;\n    --muted: #65746b;\n    --paper: #f3f7f3;\n    --surface: #ffffff;\n    --line: #d7e2da;\n    --sidebar: #073b27;\n    --sidebar-2: #0b4d31;\n    --sidebar-3: #166534;\n    --sidebar-line: #246447;\n    --sidebar-muted: #b8d7c4;\n    --gold: #eab308;\n    --gold-ink: #3d2d00;\n    --cyan: #0e7490;\n    --red: #b42318;\n  }\n\n  body {\n    margin: 0;\n    min-width: 1000px;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'DM Sans', Arial, sans-serif;\n  }\n\n  button, a { font: inherit; }\n  button { cursor: pointer; }\n  a { color: inherit; text-decoration: none; }\n\n  .workspace {\n    min-height: 900px;\n    display: flex;\n    background: var(--paper);\n  }\n\n  .navigation-shell {\n    position: relative;\n    z-index: 5;\n    width: 84px;\n    flex: 0 0 84px;\n    transition: width 240ms ease;\n  }\n\n  .navigation-shell.is-expanded {\n    width: 286px;\n    flex-basis: 286px;\n  }\n\n  .rail {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 84px;\n    height: 100vh;\n    min-height: 900px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    background: var(--sidebar);\n    border-right: 1px solid var(--sidebar-line);\n    transition: width 240ms ease;\n  }\n\n  .is-expanded .rail { width: 286px; }\n\n  .brand-bar {\n    min-height: 82px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 0 18px;\n    border-bottom: 1px solid var(--sidebar-line);\n  }\n\n  .brand-mark {\n    width: 38px;\n    height: 38px;\n    flex: 0 0 38px;\n    object-fit: cover;\n    object-position: left center;\n    background: var(--sidebar-2);\n  }\n\n  .brand-copy {\n    min-width: 0;\n    flex: 1;\n    opacity: 0;\n    overflow: hidden;\n    white-space: nowrap;\n    transition: opacity 160ms ease;\n  }\n\n  .is-expanded .brand-copy { opacity: 1; }\n\n  .brand-title {\n    display: block;\n    color: #ffffff;\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 0.9rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n  }\n\n  .brand-subtitle {\n    display: block;\n    margin-top: 3px;\n    color: var(--sidebar-muted);\n    font-size: 0.64rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .rail-toggle {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    flex: 0 0 44px;\n    padding: 0;\n    color: #ffffff;\n    background: transparent;\n    border: 1px solid var(--sidebar-line);\n    border-radius: 8px;\n  }\n\n  .rail-toggle:hover { background: var(--sidebar-2); }\n  .rail-toggle:focus-visible,\n  .rail-button:focus-visible,\n  .panel-close:focus-visible,\n  .nav-link:focus-visible {\n    outline: 2px solid var(--gold);\n    outline-offset: 2px;\n  }\n\n  .is-expanded .rail-toggle { margin-left: auto; }\n\n  .rail-nav {\n    display: grid;\n    gap: 4px;\n    flex: 1;\n    min-height: 0;\n    overflow-y: auto;\n    padding: 16px 12px 22px;\n    scrollbar-width: thin;\n    scrollbar-color: var(--sidebar-line) transparent;\n  }\n\n  .rail-nav::-webkit-scrollbar { width: 5px; }\n  .rail-nav::-webkit-scrollbar-track { background: transparent; }\n  .rail-nav::-webkit-scrollbar-thumb { background: var(--sidebar-line); }\n\n  .rail-section-label {\n    display: block;\n    margin: 11px 12px 5px;\n    color: #82b997;\n    font-size: 0.62rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    opacity: 0;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .is-expanded .rail-section-label { opacity: 1; }\n\n  .rail-button,\n  .nav-link {\n    position: relative;\n    display: flex;\n    align-items: center;\n    min-height: 44px;\n    width: 100%;\n    padding: 0 12px;\n    gap: 12px;\n    color: var(--sidebar-muted);\n    background: transparent;\n    border: 1px solid transparent;\n    border-radius: 7px;\n    text-align: left;\n  }\n\n  .rail-button:hover,\n  .nav-link:hover { color: #ffffff; background: var(--sidebar-2); }\n\n  .rail-button.is-current,\n  .nav-link.is-current {\n    color: #ffffff;\n    background: var(--sidebar-3);\n  }\n\n  .active-bar {\n    position: absolute;\n    top: 7px;\n    bottom: 7px;\n    left: 0;\n    width: 3px;\n    background: var(--gold);\n    opacity: 0;\n  }\n\n  .is-current .active-bar { opacity: 1; }\n\n  .rail-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 24px;\n    height: 24px;\n    flex: 0 0 24px;\n    color: currentColor;\n    font-size: 1.08rem;\n  }\n\n  .rail-label {\n    min-width: 0;\n    flex: 1;\n    overflow: hidden;\n    color: inherit;\n    font-size: 0.79rem;\n    font-weight: 600;\n    opacity: 0;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .is-expanded .rail-label { opacity: 1; }\n\n  .rail-caret {\n    color: #82b997;\n    font-size: 0.75rem;\n    opacity: 0;\n  }\n\n  .is-expanded .rail-caret { opacity: 1; }\n\n  .rail-footer {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 54px;\n    padding: 0 18px;\n    color: var(--sidebar-muted);\n    border-top: 1px solid var(--sidebar-line);\n    font-size: 0.68rem;\n  }\n\n  .rail-footer i { color: var(--gold); font-size: 1rem; }\n  .rail-footer span { opacity: 0; white-space: nowrap; }\n  .is-expanded .rail-footer span { opacity: 1; }\n\n  .context-panel {\n    position: fixed;\n    top: 82px;\n    left: 84px;\n    z-index: 9;\n    width: 292px;\n    min-height: 310px;\n    padding: 20px;\n    color: #ffffff;\n    background: var(--sidebar-2);\n    border: 1px solid var(--sidebar-line);\n    border-left: 0;\n  }\n\n  .context-panel[hidden] { display: none; }\n  .is-expanded .context-panel { display: none !important; }\n\n  .panel-topline {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 12px;\n    padding-bottom: 16px;\n    border-bottom: 1px solid var(--sidebar-line);\n  }\n\n  .panel-eyebrow {\n    margin: 0 0 6px;\n    color: var(--gold);\n    font-size: 0.62rem;\n    font-weight: 700;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n  }\n\n  .panel-title {\n    margin: 0;\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 1.38rem;\n    letter-spacing: -0.03em;\n  }\n\n  .panel-close {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    padding: 0;\n    color: var(--sidebar-muted);\n    background: transparent;\n    border: 1px solid var(--sidebar-line);\n    border-radius: 6px;\n  }\n\n  .panel-close:hover { color: #ffffff; background: var(--sidebar-3); }\n\n  .panel-path {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 16px 0;\n    color: var(--sidebar-muted);\n    font-size: 0.74rem;\n  }\n\n  .panel-path i { color: var(--gold); }\n\n  .panel-items {\n    display: grid;\n    gap: 6px;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .panel-items a {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 42px;\n    padding: 0 10px;\n    color: #ffffff;\n    background: #115c39;\n    border: 1px solid #28714d;\n    border-radius: 6px;\n    font-size: 0.78rem;\n    font-weight: 600;\n  }\n\n  .panel-items a:hover,\n  .panel-items a:focus-visible { background: #1b744b; outline: 2px solid var(--gold); outline-offset: 1px; }\n  .panel-items i { color: var(--gold); }\n\n  .panel-note {\n    margin: 18px 0 0;\n    padding-top: 14px;\n    color: #a9cbb8;\n    border-top: 1px solid var(--sidebar-line);\n    font-size: 0.69rem;\n    line-height: 1.45;\n  }\n\n  .main-content {\n    min-width: 0;\n    flex: 1;\n    padding: 28px 34px 46px;\n    transition: padding-left 240ms ease;\n  }\n\n  .topbar {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n    padding-bottom: 22px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .kicker {\n    margin: 0 0 8px;\n    color: #3e7d5a;\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n\n  .page-title {\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 2.25rem;\n    letter-spacing: -0.055em;\n  }\n\n  .page-description {\n    max-width: 600px;\n    margin: 8px 0 0;\n    color: var(--muted);\n    font-size: 0.86rem;\n  }\n\n  .user-context {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 8px 12px 8px 8px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    border-radius: 8px;\n  }\n\n  .avatar {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    color: var(--sidebar);\n    background: #dbeee0;\n    border: 1px solid #9bc8aa;\n    border-radius: 50%;\n    font-size: 0.7rem;\n    font-weight: 700;\n  }\n\n  .user-name { display: block; color: var(--ink); font-size: 0.78rem; font-weight: 700; }\n  .user-role { display: block; margin-top: 2px; color: var(--muted); font-size: 0.67rem; }\n\n  .dashboard-section { margin-top: 26px; }\n\n  .section-heading {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 13px;\n  }\n\n  .section-heading h2 {\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 1.02rem;\n  }\n\n  .section-heading span { color: var(--muted); font-size: 0.7rem; }\n\n  .stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .stat-card {\n    min-height: 104px;\n    padding: 16px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    border-top: 3px solid var(--sidebar-3);\n  }\n\n  .stat-card:nth-child(2) { border-top-color: var(--gold); }\n  .stat-card:nth-child(3) { border-top-color: var(--cyan); }\n  .stat-card:nth-child(4) { border-top-color: #4d9b66; }\n\n  .stat-label {\n    display: block;\n    color: var(--muted);\n    font-size: 0.66rem;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .stat-value {\n    display: block;\n    margin-top: 14px;\n    color: var(--ink);\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 2rem;\n    line-height: 1;\n  }\n\n  .analysis-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    margin-top: 18px;\n  }\n\n  .analysis-panel {\n    min-height: 280px;\n    padding: 20px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n  }\n\n  .analysis-title {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    font-size: 0.95rem;\n  }\n\n  .analysis-title i { color: var(--sidebar-3); }\n  .analysis-subtitle { margin: 6px 0 22px; color: var(--muted); font-size: 0.72rem; }\n\n  .bars { display: grid; gap: 15px; }\n  .bar-row { display: grid; grid-template-columns: 112px 1fr 30px; align-items: center; gap: 10px; color: var(--muted); font-size: 0.7rem; }\n  .bar-track { height: 12px; background: #e4eee7; }\n  .bar-fill { height: 100%; background: var(--sidebar-3); }\n  .bar-fill.gold { background: var(--gold); }\n  .bar-fill.cyan { background: #1592a8; }\n  .bar-value { color: var(--ink); font-weight: 700; text-align: right; }\n\n  .status-list { display: grid; gap: 15px; margin-top: 26px; }\n  .status-row { display: grid; grid-template-columns: 126px 1fr 48px; align-items: center; gap: 12px; color: var(--muted); font-size: 0.72rem; }\n  .status-track { height: 10px; background: #e4eee7; }\n  .status-fill { height: 100%; background: var(--sidebar-3); }\n  .status-fill.gold { background: var(--gold); }\n  .status-fill.cyan { background: #1592a8; }\n  .status-row strong { color: var(--ink); font-size: 0.75rem; text-align: right; }\n\n  .workflow-strip {\n    display: grid;\n    grid-template-columns: auto 1fr auto;\n    align-items: center;\n    gap: 16px;\n    margin-top: 18px;\n    padding: 15px 18px;\n    background: var(--sidebar);\n    color: #ffffff;\n    border: 1px solid var(--sidebar-line);\n  }\n\n  .workflow-strip i { color: var(--gold); font-size: 1.2rem; }\n  .workflow-strip strong { font-size: 0.78rem; }\n  .workflow-strip span { display: block; margin-top: 3px; color: var(--sidebar-muted); font-size: 0.69rem; }\n  .workflow-strip a { color: var(--gold); font-size: 0.72rem; font-weight: 700; }\n\n  @media (max-width: 1120px) {\n    body { min-width: 880px; }\n    .main-content { padding-left: 24px; padding-right: 24px; }\n    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n</style>\n<div class=\"workspace\" data-kid=\"2\" data-name=\"app workspace container\" data-shell=\"\">\n    <aside aria-label=\"Navegación principal\" class=\"navigation-shell\" data-kid=\"2-1\" data-name=\"navigation sidebar shell\">\n        <div class=\"rail\" data-kid=\"2-1-1\" data-name=\"rail container\">\n            <div class=\"brand-bar\" data-kid=\"2-1-1-1\" data-name=\"brand bar\">\n                <img alt=\"Logo INVILARA\" class=\"brand-mark\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo image\" src=\"/api/local/images/static/assets/img/INVILARA%20LOGO%20OFICIAL%20HORIZONTAL_WHITE.png\"/>\n                <div class=\"brand-copy\" data-kid=\"2-1-1-1-2\" data-name=\"brand text container\">\n                    <span class=\"brand-title\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand title text\">\n                        CONTROL INVILARA\n                    </span>\n                    <span class=\"brand-subtitle\" data-kid=\"2-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Gestión institucional\n                    </span>\n                </div>\n                <button aria-controls=\"layout-menu\" aria-expanded=\"false\" aria-label=\"Expandir menú lateral\" class=\"rail-toggle\" data-dynamic=\"true\" data-kid=\"2-1-1-1-3\" data-name=\"rail toggle button\" data-reason=\"aria-expanded, aria-label and icon class toggled by script\" data-toggle-rail=\"\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bi bi-layout-sidebar-inset\" data-dynamic=\"true\" data-kid=\"2-1-1-1-3-1\" data-name=\"toggle icon\" data-reason=\"icon class toggled by script\">\n                    </i>\n                </button>\n            </div>\n            <nav aria-label=\"Módulos del sistema\" class=\"rail-nav\" data-kid=\"2-1-1-2\" data-name=\"navigation rail menu\" id=\"layout-menu\">\n                <span class=\"rail-section-label\" data-kid=\"2-1-1-2-1\" data-name=\"rail section label\">\n                    Operación\n                </span>\n                <button aria-label=\"Solicitudes\" class=\"rail-button is-current\" data-dynamic=\"true\" data-kid=\"2-1-1-2-2\" data-name=\"rail navigation button\" data-panel=\"solicitudes\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"active-bar\" data-kid=\"2-1-1-2-2-1\" data-name=\"current indicator bar\">\n                    </span>\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-card-text\" data-kid=\"2-1-1-2-2-2\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-2-3\" data-name=\"navigation rail label\">\n                        Solicitudes\n                    </span>\n                    <i aria-hidden=\"true\" class=\"rail-caret bi bi-chevron-right\" data-kid=\"2-1-1-2-2-4\" data-name=\"navigation rail caret\">\n                    </i>\n                </button>\n                <button aria-label=\"Gravedad de la Obra\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-3\" data-name=\"rail navigation button\" data-panel=\"gravedad\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-exclamation-triangle\" data-kid=\"2-1-1-2-3-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-3-2\" data-name=\"navigation rail label\">\n                        Gravedad de la Obra\n                    </span>\n                </button>\n                <button aria-label=\"Prioridad\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-4\" data-name=\"rail navigation button\" data-panel=\"prioridad\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-arrow-up\" data-kid=\"2-1-1-2-4-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-4-2\" data-name=\"navigation rail label\">\n                        Prioridad\n                    </span>\n                </button>\n                <button aria-label=\"Asignar Proyectos\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-5\" data-name=\"rail navigation button\" data-panel=\"proyectos\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-folder\" data-kid=\"2-1-1-2-5-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-5-2\" data-name=\"navigation rail label\">\n                        Asignar Proyectos\n                    </span>\n                </button>\n                <button aria-label=\"Maquinaria\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-6\" data-name=\"rail navigation button\" data-panel=\"maquinaria\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-truck\" data-kid=\"2-1-1-2-6-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-6-2\" data-name=\"navigation rail label\">\n                        Maquinaria\n                    </span>\n                </button>\n                <button aria-label=\"Contratación\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-7\" data-name=\"rail navigation button\" data-panel=\"contratacion\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-briefcase\" data-kid=\"2-1-1-2-7-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-7-2\" data-name=\"navigation rail label\">\n                        Contratación\n                    </span>\n                </button>\n                <button aria-label=\"Empresas\" class=\"rail-button\" data-dynamic=\"true\" data-kid=\"2-1-1-2-8\" data-name=\"rail navigation button\" data-panel=\"empresas\" data-reason=\"class is-current toggled by script\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"rail-icon bi bi-building\" data-kid=\"2-1-1-2-8-1\" data-name=\"navigation rail icon\">\n                    </i>\n                    <span class=\"rail-label\" data-kid=\"2-1-1-2-8-2\" data-name=\"navigation rail label\">\n                        Empresas\n                    </span>\n                    <i aria-hidden=\"true\" class=\"rail-caret bi bi-chevron-right\" data-kid=\"2-1-1-2-8-3\" data-name=\"navigation rail caret\">\