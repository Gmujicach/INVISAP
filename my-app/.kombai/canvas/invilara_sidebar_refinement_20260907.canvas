    },
    "var_ac93c032dac0": {
      "type": "variant",
      "label": "Sidebar sólido con flyout accesible",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Public+Sans:wght@500;600;700&display=swap');\n\n  .inv-shell {\n    --inv-sidebar: #0b6b3d;\n    --inv-sidebar-deep: #07512f;\n    --inv-sidebar-hover: #115f3a;\n    --inv-sidebar-quiet: #c8ddd0;\n    --inv-accent: #eab308;\n    --inv-accent-soft: #fff7d6;\n    --inv-canvas: #f4f6f3;\n    --inv-panel: #ffffff;\n    --inv-ink: #1f2a25;\n    --inv-muted: #6c7972;\n    --inv-line: #d8dfda;\n    --inv-info: #1769aa;\n    min-height: 100vh;\n    color: var(--inv-ink);\n    background: var(--inv-canvas);\n    font-family: 'Open Sans', sans-serif;\n  }\n\n  .inv-shell *,\n  .inv-shell *::before,\n  .inv-shell *::after { box-sizing: border-box; }\n\n  .inv-sidebar {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 20;\n    display: flex;\n    width: 294px;\n    flex-direction: column;\n    overflow: hidden;\n    color: #ffffff;\n    background: var(--inv-sidebar);\n    border-right: 1px solid var(--inv-sidebar-deep);\n    transition: width 180ms ease;\n  }\n\n  .inv-brand {\n    position: relative;\n    display: flex;\n    min-height: 134px;\n    flex-direction: column;\n    justify-content: center;\n    gap: 15px;\n    padding: 22px 18px 18px 22px;\n    background: var(--inv-sidebar-deep);\n    border-bottom: 1px solid #2a7651;\n  }\n\n  .inv-brand-lockup {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0;\n  }\n\n  .inv-brand-lockup img {\n    display: block;\n    width: 132px;\n    max-width: 132px;\n    height: auto;\n    object-fit: contain;\n  }\n\n  .inv-brand-copy {\n    min-width: 0;\n    color: #ffffff;\n    font-family: 'Public Sans', sans-serif;\n    font-size: 0.72rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    line-height: 1.18;\n    text-transform: uppercase;\n  }\n\n  .inv-brand-note {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--inv-sidebar-quiet);\n    font-size: 0.68rem;\n    letter-spacing: 0.04em;\n  }\n\n  .inv-brand-note i { color: var(--inv-accent); font-size: 0.72rem; }\n\n  .inv-compact-mark {\n    display: none;\n    align-items: center;\n    justify-content: center;\n    width: 42px;\n    height: 42px;\n    color: #ffffff;\n    border: 1px solid #4a9b70;\n    border-radius: 8px;\n    font-family: 'Public Sans', sans-serif;\n    font-size: 0.85rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n  }\n\n  .inv-toggle {\n    position: absolute;\n    top: 19px;\n    right: 14px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    padding: 0;\n    color: #ffffff;\n    background: #0d7845;\n    border: 1px solid #5aa278;\n    border-radius: 8px;\n    cursor: pointer;\n    font-size: 1.08rem;\n  }\n\n  .inv-toggle:hover { background: #188451; }\n  .inv-toggle:focus-visible,\n  .inv-nav-parent:focus-visible,\n  .inv-nav-child:focus-visible,\n  .inv-flyout button:focus-visible,\n  .inv-demo-button:focus-visible {\n    outline: 2px solid var(--inv-accent);\n    outline-offset: 2px;\n  }\n\n  .inv-nav-legend {\n    padding: 16px 22px 8px;\n    color: #9fc5ad;\n    font-size: 0.64rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .inv-menu {\n    flex: 1 1 auto;\n    min-height: 0;\n    margin: 0;\n    padding: 0 12px 22px;\n    overflow-y: auto;\n    scrollbar-color: #4d9970 transparent;\n    scrollbar-width: thin;\n  }\n\n  .inv-menu::-webkit-scrollbar { width: 6px; }\n  .inv-menu::-webkit-scrollbar-track { background: transparent; }\n  .inv-menu::-webkit-scrollbar-thumb { background: #4d9970; border-radius: 5px; }\n\n  .inv-nav-group { margin: 0 0 3px; }\n\n  .inv-nav-parent,\n  .inv-nav-child,\n  .inv-nav-single {\n    position: relative;\n    display: flex;\n    align-items: center;\n    width: 100%;\n    min-height: 43px;\n    gap: 11px;\n    padding: 9px 11px;\n    color: #f7fbf8;\n    background: transparent;\n    border: 1px solid transparent;\n    border-radius: 6px;\n    font: inherit;\n    font-size: 0.8rem;\n    text-align: left;\n    text-decoration: none;\n    cursor: pointer;\n  }\n\n  .inv-nav-parent:hover,\n  .inv-nav-child:hover,\n  .inv-nav-single:hover { background: var(--inv-sidebar-hover); }\n\n  .inv-nav-parent[aria-expanded=\"true\"] { background: #0e7543; }\n\n  .inv-nav-parent.is-current,\n  .inv-nav-single.is-current {\n    color: #1f2a25;\n    background: var(--inv-accent);\n    border-left: 3px solid var(--inv-sidebar-deep);\n    font-weight: 700;\n  }\n\n  .inv-nav-parent.is-current:hover,\n  .inv-nav-single.is-current:hover { background: #f1c21a; }\n\n  .inv-nav-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 22px;\n    min-width: 22px;\n    color: #ffffff;\n    font-size: 1.02rem;\n    line-height: 1;\n  }\n\n  .inv-nav-parent.is-current .inv-nav-icon,\n  .inv-nav-single.is-current .inv-nav-icon { color: var(--inv-sidebar-deep); }\n\n  .inv-nav-copy { flex: 1; min-width: 0; }\n  .inv-nav-copy strong { display: block; font-weight: 600; }\n  .inv-nav-copy small { display: block; margin-top: 2px; color: #a9c9b5; font-size: 0.62rem; }\n  .inv-nav-parent.is-current .inv-nav-copy small { color: #5b4b09; }\n\n  .inv-nav-chevron { color: #b8d5c3; font-size: 0.72rem; }\n  .inv-nav-parent.is-current .inv-nav-chevron { color: var(--inv-sidebar-deep); }\n  .inv-group-mark { display: none; }\n\n  .inv-submenu {\n    display: none;\n    gap: 2px;\n    margin: 2px 0 5px 21px;\n    padding: 4px 0 4px 12px;\n    border-left: 1px solid #55946e;\n  }\n\n  .inv-nav-group.is-open > .inv-submenu { display: grid; }\n\n  .inv-nav-child {\n    min-height: 34px;\n    padding: 7px 10px;\n    color: #cfe2d6;\n    font-size: 0.74rem;\n  }\n\n  .inv-nav-child i { width: 17px; color: #a9c9b5; }\n  .inv-nav-child.is-current { color: #ffffff; background: #166f43; font-weight: 700; }\n  .inv-nav-child.is-current i { color: var(--inv-accent); }\n\n  .inv-nav-single { margin-top: 3px; }\n  .inv-nav-single .inv-nav-icon { color: #c6ddce; }\n\n  .inv-flyout {\n    position: fixed;\n    top: 146px;\n    left: 310px;\n    z-index: 40;\n    display: none;\n    width: 276px;\n    padding: 17px;\n    color: var(--inv-ink);\n    background: #ffffff;\n    border: 1px solid #b7c7bd;\n    border-left: 4px solid var(--inv-accent);\n  }\n\n  .inv-flyout.is-open { display: block; }\n  .inv-flyout-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--inv-line); }\n  .inv-flyout-kicker { margin: 0 0 4px; color: #5b6e63; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }\n  .inv-flyout h3 { margin: 0; color: var(--inv-sidebar-deep); font-family: 'Public Sans', sans-serif; font-size: 1rem; }\n  .inv-flyout-copy { margin: 12px 0; color: var(--inv-muted); font-size: 0.72rem; line-height: 1.45; }\n  .inv-flyout-close { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; padding: 0; color: var(--inv-muted); background: transparent; border: 1px solid var(--inv-line); border-radius: 5px; cursor: pointer; }\n  .inv-flyout-close:hover { color: var(--inv-sidebar-deep); background: #f2f6f3; }\n  .inv-flyout-items { display: grid; gap: 5px; }\n  .inv-flyout-items button { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 8px 9px; color: var(--inv-sidebar-deep); background: #f6f8f6; border: 1px solid #d4ddd7; border-radius: 5px; font: inherit; font-size: 0.74rem; text-align: left; cursor: pointer; }\n  .inv-flyout-items button:hover { background: var(--inv-accent-soft); border-color: #d4aa0a; }\n  .inv-flyout-items i { color: #b48700; }\n  .inv-flyout-hint { display: flex; align-items: center; gap: 6px; margin-top: 12px; color: #6d7c72; font-size: 0.62rem; }\n  .inv-flyout-hint i { color: var(--inv-sidebar); }\n\n  .inv-main {\n    min-height: 100vh;\n    margin-left: 294px;\n    padding: 28px 36px 42px;\n    transition: margin-left 180ms ease;\n  }\n\n  .inv-topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-bottom: 23px; border-bottom: 1px solid var(--inv-line); }\n  .inv-eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 8px; color: var(--inv-sidebar); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }\n  .inv-eyebrow span { display: inline-block; width: 26px; height: 2px; background: var(--inv-accent); }\n  .inv-topbar h1 { margin: 0; color: #1d2924; font-family: 'Public Sans', sans-serif; font-size: 2rem; letter-spacing: -0.03em; }\n  .inv-topbar p { margin: 6px 0 0; color: var(--inv-muted); font-size: 0.86rem; }\n  .inv-user { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: var(--inv-panel); border: 1px solid var(--inv-line); border-radius: 7px; }\n  .inv-user-avatar { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; color: var(--inv-sidebar-deep); background: #dceee2; border: 1px solid #9dc7ac; border-radius: 50%; font-size: 0.78rem; font-weight: 700; }\n  .inv-user strong { display: block; color: #24322b; font-size: 0.74rem; }\n  .inv-user small { display: block; margin-top: 2px; color: var(--inv-muted); font-size: 0.63rem; }\n\n  .inv-context { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: 24px 0 18px; padding: 14px 16px; background: #eef4ef; border: 1px solid #c9d9cd; border-left: 3px solid var(--inv-sidebar); }\n  .inv-context-copy { display: flex; align-items: center; gap: 11px; }\n  .inv-context-copy i { color: var(--inv-sidebar); font-size: 1.1rem; }\n  .inv-context-copy strong { display: block; color: #24332b; font-size: 0.78rem; }\n  .inv-context-copy span { display: block; margin-top: 3px; color: var(--inv-muted); font-size: 0.68rem; }\n  .inv-demo-button { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 7px 11px; color: var(--inv-sidebar-deep); background: #ffffff; border: 1px solid #8ab49a; border-radius: 5px; font: inherit; font-size: 0.7rem; font-weight: 700; cursor: pointer; }\n  .inv-demo-button:hover { color: #1f2a25; background: var(--inv-accent-soft); border-color: #d4aa0a; }\n\n  .inv-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }\n  .inv-metric, .inv-analysis { background: var(--inv-panel); border: 1px solid var(--inv-line); border-radius: 7px; }\n  .inv-metric { display: flex; align-items: center; gap: 12px; min-height: 108px; padding: 16px; }\n  .inv-metric-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; color: var(--inv-sidebar); background: #e2f1e7; border: 1px solid #b3d5bd; border-radius: 6px; font-size: 1.1rem; }\n  .inv-metric:nth-child(2) .inv-metric-icon { color: #a37b00; background: #fff7d6; border-color: #ead58a; }\n  .inv-metric:nth-child(3) .inv-metric-icon { color: var(--inv-info); background: #e4f0f8; border-color: #bcd3e5; }\n  .inv-metric:nth-child(4) .inv-metric-icon { color: #216f56; background: #e3f3ea; border-color: #b6d7c3; }\n  .inv-metric-label { color: var(--inv-muted); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }\n  .inv-metric-value { margin-top: 4px; color: #23332a; font-family: 'Public Sans', sans-serif; font-size: 1.42rem; font-weight: 700; }\n\n  .inv-analysis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }\n  .inv-analysis { min-height: 306px; padding: 20px; }\n  .inv-analysis-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--inv-line); }\n  .inv-analysis-kicker { margin: 0 0 4px; color: var(--inv-muted); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }\n  .inv-analysis h2 { margin: 0; color: #24322b; font-family: 'Public Sans', sans-serif; font-size: 1rem; }\n  .inv-analysis-head i { color: var(--inv-sidebar); font-size: 1.15rem; }\n  .inv-bars { display: grid; gap: 14px; margin-top: 23px; }\n  .inv-bar-row { display: grid; grid-template-columns: 128px 1fr 30px; align-items: center; gap: 10px; color: #57665d; font-size: 0.7rem; }\n  .inv-bar-track { height: 12px; overflow: hidden; background: #edf1ee; border: 1px solid #dde5df; }\n  .inv-bar-fill { height: 100%; background: var(--inv-sidebar); }\n  .inv-bar-fill.gold { background: var(--inv-accent); }\n  .inv-bar-fill.blue { background: #2c7ab7; }\n  .inv-bar-value { color: #24322b; font-weight: 700; text-align: right; }\n  .inv-status-list { display: grid; gap: 10px; margin-top: 23px; }\n  .inv-status-row { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 9px; min-height: 42px; padding: 8px 10px; background: #f7f9f7; border: 1px solid #e1e8e2; }\n  .inv-status-dot { width: 9px; height: 9px; background: var(--inv-sidebar); border-radius: 50%; }\n  .inv-status-dot.gold { background: var(--inv-accent); }\n  .inv-status-dot.blue { background: #2c7ab7; }\n  .inv-status-row span { color: #55645b; font-size: 0.72rem; }\n  .inv-status-row strong { color: #23332a; font-size: 0.76rem; }\n\n  .inv-shell.is-collapsed .inv-sidebar { width: 84px; }\n  .inv-shell.is-collapsed .inv-brand { align-items: center; padding: 18px 0; }\n  .inv-shell.is-collapsed .inv-brand-lockup,\n  .inv-shell.is-collapsed .inv-brand-note,\n  .inv-shell.is-collapsed .inv-nav-legend { display: none; }\n  .inv-shell.is-collapsed .inv-compact-mark { display: inline-flex; }\n  .inv-shell.is-collapsed .inv-toggle { position: static; margin-top: 10px; }\n  .inv-shell.is-collapsed .inv-menu { padding: 15px 10px 20px; }\n  .inv-shell.is-collapsed .inv-nav-parent,\n  .inv-shell.is-collapsed .inv-nav-single { justify-content: center; width: 56px; min-height: 48px; margin: 3px auto; padding: 10px 0; }\n  .inv-shell.is-collapsed .inv-nav-copy,\n  .inv-shell.is-collapsed .inv-nav-chevron,\n  .inv-shell.is-collapsed .inv-submenu { display: none; }\n  .inv-shell.is-collapsed .inv-nav-icon { width: auto; min-width: 0; font-size: 1.18rem; }\n  .inv-shell.is-collapsed .inv-group-mark { display: block; position: absolute; right: 8px; bottom: 8px; width: 5px; height: 5px; background: var(--inv-accent); border-radius: 50%; }\n  .inv-shell.is-collapsed .inv-nav-parent.is-current,\n  .inv-shell.is-collapsed .inv-nav-single.is-current { border-left: 0; border-bottom: 3px solid var(--inv-sidebar-deep); }\n  .inv-shell.is-collapsed .inv-main { margin-left: 84px; }\n  .inv-shell.is-collapsed .inv-flyout { left: 100px; }\n\n  @media (max-width: 1020px) {\n    .inv-main { padding-right: 24px; padding-left: 24px; }\n    .inv-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n</style>\n<div class=\"inv-shell\" data-kid=\"2\" data-name=\"application shell\" id=\"invilaraShell\">\n    <aside aria-label=\"Navegación institucional\" class=\"inv-sidebar\" data-kid=\"2-1\" data-name=\"sidebar navigation container\" id=\"invilaraSidebar\">\n        <div class=\"inv-brand\" data-kid=\"2-1-1\" data-name=\"sidebar brand area\">\n            <div class=\"inv-brand-lockup\" data-kid=\"2-1-1-1\" data-name=\"brand logo and title wrapper\">\n                <img alt=\"INVILARA\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/assets/img/INVILARA%20LOGO%20OFICIAL%20HORIZONTAL_WHITE.png\"/>\n                <span class=\"inv-brand-copy\" data-kid=\"2-1-1-1-2\" data-name=\"brand name text\">\n                    Control\n                    <br data-kid=\"2-1-1-1-2-1\"/>\n                    Invilara\n                </span>\n            </div>\n            <span aria-hidden=\"true\" class=\"inv-compact-mark\" data-kid=\"2-1-1-2\" data-name=\"collapsed sidebar indicator mark\">\n                IV\n            </span>\n            <div class=\"inv-brand-note\" data-kid=\"2-1-1-3\" data-name=\"navigation note label container\">\n                <i aria-hidden=\"true\" class=\"bi bi-signpost-2-fill\" data-kid=\"2-1-1-3-1\" data-name=\"navigation note icon\">\n                </i>\n                <span data-kid=\"2-1-1-3-2\" data-name=\"navigation note text\">\n                    Navegación institucional\n                </span>\n            </div>\n            <button aria-controls=\"invilaraSidebar\" aria-expanded=\"true\" aria-label=\"Colapsar menú lateral\" class=\"inv-toggle\" data-dynamic=\"true\" data-kid=\"2-1-1-4\" data-name=\"sidebar toggle button\" data-reason=\"aria attributes, title, and icon class toggled by click\" id=\"invilaraToggle\" title=\"Colapsar menú lateral\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bi bi-chevron-left\" data-dynamic=\"true\" data-kid=\"2-1-1-4-1\" data-name=\"sidebar toggle icon\" data-reason=\"icon class name toggled by script\">\n                </i>\n            </button>\n        </div>\n        <nav aria-label=\"Módulos del sistema\" class=\"inv-menu\" data-kid=\"2-1-2\" data-name=\"navigation menu container\">\n            <div class=\"inv-nav-group is-open\" data-dynamic=\"true\" data-kid=\"2-1-2-1\" data-module=\"Solicitudes\" data-name=\"navigation group for Solicitudes\" data-reason=\"is-open class and aria-expanded state toggled by script\">\n                <button aria-expanded=\"true\" class=\"inv-nav-parent is-current\" data-dynamic=\"true\" data-flyout-copy=\"Gestiona el registro y seguimiento de las solicitudes ciudadanas.\" data-flyout-title=\"Solicitudes\" data-kid=\"2-1-2-1-1\" data-name=\"group parent button for Solicitudes\" data-reason=\"aria-expanded class and is-current class toggled by s