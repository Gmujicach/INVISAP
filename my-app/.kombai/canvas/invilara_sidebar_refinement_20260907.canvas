invilaraFlyoutTitle\">\n                    Solicitudes\n                </h3>\n            </div>\n            <button aria-label=\"Cerrar submódulos\" class=\"inv-flyout-close\" data-kid=\"2-2-1-2\" data-name=\"flyout close button\" id=\"invilaraFlyoutClose\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bi bi-x-lg\" data-kid=\"2-2-1-2-1\">\n                </i>\n            </button>\n        </div>\n        <p class=\"inv-flyout-copy\" data-dynamic=\"true\" data-kid=\"2-2-2\" data-name=\"flyout description text\" data-reason=\"text content updated by script\" id=\"invilaraFlyoutCopy\">\n            Gestiona el registro y seguimiento de las solicitudes ciudadanas.\n        </p>\n        <div class=\"inv-flyout-items\" data-dynamic=\"true\" data-kid=\"2-2-3\" data-name=\"flyout items container\" data-reason=\"buttons injected by script\" id=\"invilaraFlyoutItems\">\n        </div>\n        <div class=\"inv-flyout-hint\" data-kid=\"2-2-4\">\n            <i aria-hidden=\"true\" class=\"bi bi-keyboard\" data-kid=\"2-2-4-1\">\n            </i>\n            <span data-kid=\"2-2-4-2\">\n                Escape para cerrar · toque para seleccionar\n            </span>\n        </div>\n    </aside>\n    <main class=\"inv-main\" data-kid=\"2-3\" data-name=\"main content area\" id=\"invilaraMain\">\n        <header class=\"inv-topbar\" data-kid=\"2-3-1\" data-name=\"top navigation bar\">\n            <div data-kid=\"2-3-1-1\" data-name=\"page breadcrumb and heading\">\n                <p class=\"inv-eyebrow\" data-kid=\"2-3-1-1-1\" data-name=\"eyebrow label container\">\n                    <span data-kid=\"2-3-1-1-1-1\">\n                    </span>\n                    Panel de control institucional\n                </p>\n                <h1 data-kid=\"2-3-1-1-2\" data-name=\"page title\">\n                    Sistema Invilara\n                </h1>\n                <p data-kid=\"2-3-1-1-3\" data-name=\"page description\">\n                    Sistema de Información para el Control de Solicitudes\n                </p>\n            </div>\n            <div class=\"inv-user\" data-kid=\"2-3-1-2\" data-name=\"user profile info area\">\n                <span class=\"inv-user-avatar\" data-kid=\"2-3-1-2-1\">\n                    AD\n                </span>\n                <div data-kid=\"2-3-1-2-2\">\n                    <strong data-kid=\"2-3-1-2-2-1\">\n                        admin\n                    </strong>\n                    <small data-kid=\"2-3-1-2-2-2\">\n                        Super Usuario\n                    </small>\n                </div>\n                <i aria-hidden=\"true\" class=\"bi bi-chevron-down\" data-kid=\"2-3-1-2-3\">\n                </i>\n            </div>\n        </header>\n        <section aria-label=\"Demostración del comportamiento del sidebar\" class=\"inv-context\" data-kid=\"2-3-2\" data-name=\"context demonstration banner\">\n            <div class=\"inv-context-copy\" data-kid=\"2-3-2-1\" data-name=\"context banner info\">\n                <i aria-hidden=\"true\" class=\"bi bi-layout-sidebar-inset\" data-kid=\"2-3-2-1-1\">\n                </i>\n                <div data-kid=\"2-3-2-1-2\">\n                    <strong data-kid=\"2-3-2-1-2-1\">\n                        Rail colapsado con flyout contextual\n                    </strong>\n                    <span data-kid=\"2-3-2-1-2-2\">\n                        Los grupos mantienen un indicador claro y revelan sus submódulos con click o foco.\n                    </span>\n                </div>\n            </div>\n            <button class=\"inv-demo-button\" data-kid=\"2-3-2-2\" data-name=\"demo button\" id=\"invilaraDemo\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"2-3-2-2-1\">\n                </i>\n                Probar flyout Solicitudes\n            </button>\n        </section>\n        <section aria-label=\"Métricas principales\" class=\"inv-metrics\" data-kid=\"2-3-3\" data-name=\"metrics dashboard section\">\n            <article class=\"inv-metric\" data-kid=\"2-3-3-1\">\n                <span class=\"inv-metric-icon\" data-kid=\"2-3-3-1-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-list-task\" data-kid=\"2-3-3-1-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"2-3-3-1-2\">\n                    <div class=\"inv-metric-label\" data-kid=\"2-3-3-1-2-1\">\n                        Total Solicitudes\n                    </div>\n                    <div class=\"inv-metric-value\" data-kid=\"2-3-3-1-2-2\">\n                        8\n                    </div>\n                </div>\n            </article>\n            <article class=\"inv-metric\" data-kid=\"2-3-3-2\">\n                <span class=\"inv-metric-icon\" data-kid=\"2-3-3-2-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-clock-history\" data-kid=\"2-3-3-2-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"2-3-3-2-2\">\n                    <div class=\"inv-metric-label\" data-kid=\"2-3-3-2-2-1\">\n                        Pendientes\n                    </div>\n                    <div class=\"inv-metric-value\" data-kid=\"2-3-3-2-2-2\">\n                        1\n                    </div>\n                </div>\n            </article>\n            <article class=\"inv-metric\" data-kid=\"2-3-3-3\">\n                <span class=\"inv-metric-icon\" data-kid=\"2-3-3-3-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-arrow-repeat\" data-kid=\"2-3-3-3-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"2-3-3-3-2\">\n                    <div class=\"inv-metric-label\" data-kid=\"2-3-3-3-2-1\">\n                        En Proceso\n                    </div>\n                    <div class=\"inv-metric-value\" data-kid=\"2-3-3-3-2-2\">\n                        6\n                    </div>\n                </div>\n            </article>\n            <article class=\"inv-metric\" data-kid=\"2-3-3-4\">\n                <span class=\"inv-metric-icon\" data-kid=\"2-3-3-4-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-check-circle\" data-kid=\"2-3-3-4-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"2-3-3-4-2\">\n                    <div class=\"inv-metric-label\" data-kid=\"2-3-3-4-2-1\">\n                        Completadas / Procesadas\n                    </div>\n                    <div class=\"inv-metric-value\" data-kid=\"2-3-3-4-2-2\">\n                        1\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section aria-label=\"Análisis del sistema\" class=\"inv-analysis-grid\" data-kid=\"2-3-4\" data-name=\"analysis dashboard section\">\n            <article class=\"inv-analysis\" data-kid=\"2-3-4-1\">\n                <div class=\"inv-analysis-head\" data-kid=\"2-3-4-1-1\">\n                    <div data-kid=\"2-3-4-1-1-1\">\n                        <p class=\"inv-analysis-kicker\" data-kid=\"2-3-4-1-1-1-1\">\n                            Lectura operativa\n                        </p>\n                        <h2 data-kid=\"2-3-4-1-1-1-2\">\n                            Análisis por Tipo de Solicitud\n                        </h2>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"bi bi-bar-chart-line\" data-kid=\"2-3-4-1-1-2\">\n                    </i>\n                </div>\n                <div class=\"inv-bars\" data-kid=\"2-3-4-1-2\">\n                    <div class=\"inv-bar-row\" data-kid=\"2-3-4-1-2-1\">\n                        <span data-kid=\"2-3-4-1-2-1-1\">\n                            Particular\n                        </span>\n                        <div class=\"inv-bar-track\" data-kid=\"2-3-4-1-2-1-2\">\n                            <div class=\"inv-bar-fill\" data-kid=\"2-3-4-1-2-1-2-1\" style=\"width:82%\">\n                            </div>\n                        </div>\n                        <strong class=\"inv-bar-value\" data-kid=\"2-3-4-1-2-1-3\">\n                            4\n                        </strong>\n                    </div>\n                    <div class=\"inv-bar-row\" data-kid=\"2-3-4-1-2-2\">\n                        <span data-kid=\"2-3-4-1-2-2-1\">\n                            Comunidad\n                        </span>\n                        <div class=\"inv-bar-track\" data-kid=\"2-3-4-1-2-2-2\">\n                            <div class=\"inv-bar-fill\" data-kid=\"2-3-4-1-2-2-2-1\" style=\"width:62%\">\n                            </div>\n                        </div>\n                        <strong class=\"inv-bar-value\" data-kid=\"2-3-4-1-2-2-3\">\n                            3\n                        </strong>\n                    </div>\n                    <div class=\"inv-bar-row\" data-kid=\"2-3-4-1-2-3\">\n                        <span data-kid=\"2-3-4-1-2-3-1\">\n                            Institución\n                        </span>\n                        <div class=\"inv-bar-track\" data-kid=\"2-3-4-1-2-3-2\">\n                            <div class=\"inv-bar-fill gold\" data-kid=\"2-3-4-1-2-3-2-1\" style=\"width:24%\">\n                            </div>\n                        </div>\n                        <strong class=\"inv-bar-value\" data-kid=\"2-3-4-1-2-3-3\">\n                            1\n                        </strong>\n                    </div>\n                </div>\n            </article>\n            <article class=\"inv-analysis\" data-kid=\"2-3-4-2\">\n                <div class=\"inv-analysis-head\" data-kid=\"2-3-4-2-1\">\n                    <div data-kid=\"2-3-4-2-1-1\">\n                        <p class=\"inv-analysis-kicker\" data-kid=\"2-3-4-2-1-1-1\">\n                            Seguimiento de atención\n                        </p>\n                        <h2 data-kid=\"2-3-4-2-1-1-2\">\n                            Distribución por Estatus\n                        </h2>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"bi bi-pie-chart\" data-kid=\"2-3-4-2-1-2\">\n                    </i>\n                </div>\n                <div class=\"inv-status-list\" data-kid=\"2-3-4-2-2\">\n                    <div class=\"inv-status-row\" data-kid=\"2-3-4-2-2-1\">\n                        <span class=\"inv-status-dot\" data-kid=\"2-3-4-2-2-1-1\">\n                        </span>\n                        <span data-kid=\"2-3-4-2-2-1-2\">\n                            En Proceso\n                        </span>\n                        <strong data-kid=\"2-3-4-2-2-1-3\">\n                            75%\n                        </strong>\n                    </div>\n                    <div class=\"inv-status-row\" data-kid=\"2-3-4-2-2-2\">\n                        <span class=\"inv-status-dot blue\" data-kid=\"2-3-4-2-2-2-1\">\n                        </span>\n                        <span data-kid=\"2-3-4-2-2-2-2\">\n                            Completada\n                        </span>\n                        <strong data-kid=\"2-3-4-2-2-2-3\">\n                            12.5%\n                        </strong>\n                    </div>\n                    <div class=\"inv-status-row\" data-kid=\"2-3-4-2-2-3\">\n                        <span class=\"inv-status-dot gold\" data-kid=\"2-3-4-2-2-3-1\">\n                        </span>\n                        <span data-kid=\"2-3-4-2-2-3-2\">\n                            Pendiente\n                        </span>\n                        <strong data-kid=\"2-3-4-2-2-3-3\">\n                            12.5%\n                        </strong>\n                    </div>\n                </div>\n            </article>\n        </section>\n    </main>\n</div>\n<script>\n    (() => {\n    const shell = document.getElementById('invilaraShell');\n    const toggle = document.getElementById('invilaraToggle');\n    const flyout = document.getElementById('invilaraFlyout');\n    const flyoutTitle = document.getElementById('invilaraFlyoutTitle');\n    const flyoutCopy = document.getElementById('invilaraFlyoutCopy');\n    const flyoutItems = document.getElementById('invilaraFlyoutItems');\n    const flyoutClose = document.getElementById('invilaraFlyoutClose');\n    const demo = document.getElementById('invilaraDemo');\n    let flyoutOpener = null;\n\n    const setCollapsed = (collapsed) => {\n      shell.classList.toggle('is-collapsed', collapsed);\n      toggle.setAttribute('aria-expanded', String(!collapsed));\n      toggle.setAttribute('aria-label', collapsed ? 'Expandir menú lateral' : 'Colapsar menú lateral');\n      toggle.title = collapsed ? 'Expandir menú lateral' : 'Colapsar menú lateral';\n      toggle.querySelector('i').className = collapsed ? 'bi bi-list' : 'bi bi-chevron-left';\n    };\n\n    const closeFlyout = (restoreFocus = false) => {\n      flyout.classList.remove('is-open');\n      flyout.setAttribute('aria-hidden', 'true');\n      if (restoreFocus && flyoutOpener) flyoutOpener.focus();\n      flyoutOpener = null;\n    };\n\n    const openFlyout = (parent) => {\n      const group = parent.closest('.inv-nav-group');\n      const submenu = group ? group.querySelector('.inv-submenu') : null;\n      flyoutTitle.textContent = parent.dataset.flyoutTitle || group?.dataset.module || 'Módulo';\n      flyoutCopy.textContent = parent.dataset.flyoutCopy || 'Selecciona una acción para continuar.';\n      flyoutItems.innerHTML = '';\n      if (submenu) {\n        submenu.querySelectorAll(':scope > button').forEach((source) => {\n          const item = document.createElement('button');\n          item.type = 'button';\n          item.innerHTML = source.innerHTML;\n          item.addEventListener('click', () => closeFlyout());\n          flyoutItems.appendChild(item);\n        });\n      }\n      flyoutOpener = parent;\n      flyout.classList.add('is-open');\n      flyout.setAttribute('aria-hidden', 'false');\n      flyoutClose.focus();\n    };\n\n    toggle.addEventListener('click', () => {\n      setCollapsed(!shell.classList.contains('is-collapsed'));\n      if (!shell.classList.contains('is-collapsed')) closeFlyout();\n    });\n\n    document.querySelectorAll('.inv-nav-group > .inv-nav-parent').forEach((parent) => {\n      parent.addEventListener('click', () => {\n        if (shell.classList.contains('is-collapsed')) {\n          openFlyout(parent);\n          return;\n        }\n        const group = parent.closest('.inv-nav-group');\n        const expanded = parent.getAttribute('aria-expanded') === 'true';\n        parent.setAttribute('aria-expanded', String(!expanded));\n        group.classList.toggle('is-open', !expanded);\n        const chevron = parent.querySelector('.inv-nav-chevron');\n        if (chevron) chevron.className = !expanded ? 'inv-nav-chevron bi bi-chevron-down' : 'inv-nav-chevron bi bi-chevron-right';\n      });\n      parent.addEventListener('focus', () => {\n        if (shell.classList.contains('is-collapsed')) openFlyout(parent);\n      });\n    });\n\n    document.querySelectorAll('.inv-nav-single, .inv-nav-child').forEach((link) => {\n      link.addEventListener('click', (event) => event.preventDefault());\n    });\n\n    flyoutClose.addEventListener('click', () => closeFlyout(true));\n    demo.addEventListener('click', () => {\n      setCollapsed(true);\n      const requests = document.querySelector('.inv-nav-group[data-module=\"Solicitudes\"] > .inv-nav-parent');\n      openFlyout(requests);\n    });\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape' && flyout.classList.contains('is-open')) closeFlyout(true);\n    });\n    document.addEventListener('pointerdown', (event) => {\n      if (!flyout.contains(event.target) && !event.target.closest('.inv-nav-parent') && !event.target.closest('#invilaraDemo')) closeFlyout();\n    });\n  })();\n</script>\n",
