                              </span>\n                                <span class=\"inv-status\" data-kid=\"1-4-1-3-2-3-2-1-2\">\n                                    <i aria-hidden=\"true\" class=\"bi bi-check-circle-fill\" data-kid=\"1-4-1-3-2-3-2-1-2-1\">\n                                    </i>\n                                    Activo\n                                </span>\n                            </div>\n                            <h3 class=\"inv-report-title\" data-kid=\"1-4-1-3-2-3-2-2\">\n                                #102 · Informe Mayor\n                            </h3>\n                            <p class=\"inv-report-description\" data-kid=\"1-4-1-3-2-3-2-3\">\n                                Rehabilitación vial de la comunidad La Esperanza y control de hitos de ejecución del contrato.\n                            </p>\n                            <div class=\"inv-report-meta\" data-kid=\"1-4-1-3-2-3-2-4\">\n                                <span data-kid=\"1-4-1-3-2-3-2-4-1\">\n                                    <i aria-hidden=\"true\" class=\"bi bi-calendar3\" data-kid=\"1-4-1-3-2-3-2-4-1-1\">\n                                    </i>\n                                    28/08/2026\n                                </span>\n                                <span data-kid=\"1-4-1-3-2-3-2-4-2\">\n                                    <i aria-hidden=\"true\" class=\"bi bi-person-check\" data-kid=\"1-4-1-3-2-3-2-4-2-1\">\n                                    </i>\n                                    Inspector de obra\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"inv-report-side\" data-kid=\"1-4-1-3-2-3-3\">\n                            <div class=\"inv-progress-label\" data-kid=\"1-4-1-3-2-3-3-1\">\n                                <span data-kid=\"1-4-1-3-2-3-3-1-1\">\n                                    Avance de obra\n                                </span>\n                                <strong data-kid=\"1-4-1-3-2-3-3-1-2\">\n                                    35%\n                                </strong>\n                            </div>\n                            <div class=\"inv-progress-track\" data-kid=\"1-4-1-3-2-3-3-2\">\n                                <div class=\"inv-progress-fill\" data-kid=\"1-4-1-3-2-3-3-2-1\" style=\"width:35%\">\n                                </div>\n                            </div>\n                            <span class=\"inv-evidence-count\" data-kid=\"1-4-1-3-2-3-3-3\">\n                                <i aria-hidden=\"true\" class=\"bi bi-images\" data-kid=\"1-4-1-3-2-3-3-3-1\">\n                                </i>\n                                8 evidencias fotográficas\n                            </span>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"inv-check\" data-kid=\"1-4-1-3-2-3-4\">\n                            <i class=\"bi bi-check-lg\" data-kid=\"1-4-1-3-2-3-4-1\">\n                            </i>\n                        </span>\n                    </article>\n                </div>\n                <div class=\"inv-no-results\" data-kid=\"1-4-1-3-3\" id=\"noReports\">\n                    <i aria-hidden=\"true\" class=\"bi bi-search\" data-kid=\"1-4-1-3-3-1\">\n                    </i>\n                    <strong data-kid=\"1-4-1-3-3-2\">\n                        No encontramos informes\n                    </strong>\n                    <div class=\"mt-1 text-xs\" data-kid=\"1-4-1-3-3-3\">\n                        Pruebe con otro número, tipo o descripción.\n                    </div>\n                </div>\n            </div>\n            <footer class=\"inv-modal-footer\" data-kid=\"1-4-1-4\">\n                <button class=\"inv-btn inv-btn-secondary js-cancel-report\" data-kid=\"1-4-1-4-1\" type=\"button\">\n                    Cancelar\n                </button>\n                <button class=\"inv-btn inv-btn-primary js-confirm-report\" data-kid=\"1-4-1-4-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"bi bi-link-45deg\" data-kid=\"1-4-1-4-2-1\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-4-1-4-2-2\" data-name=\"confirm vinculation button label\" data-reason=\"text updated by selection script\" id=\"confirmLabel\">\n                        Vincular informe #104\n                    </span>\n                </button>\n            </footer>\n        </section>\n    </div>\n</div>\n<script>\n    (() => {\n    const modal = document.getElementById('reportModal');\n    const cards = [...document.querySelectorAll('.inv-report-card')];\n    const search = document.getElementById('reportSearch');\n    const filter = document.getElementById('reportTypeFilter');\n    const hiddenInput = document.getElementById('informe_avance_obra_id_informe');\n    const counter = document.getElementById('selectionCounter');\n    const confirmLabel = document.getElementById('confirmLabel');\n    const noReports = document.getElementById('noReports');\n    const visibleCount = document.getElementById('visibleReportCount');\n    const summaryTitle = document.getElementById('summaryTitle');\n    const summaryDescription = document.getElementById('summaryDescription');\n    const summaryEvidence = document.getElementById('summaryEvidence');\n    const summaryImage = document.getElementById('summaryImage');\n    let committedId = hiddenInput.value || '104';\n    let draftId = committedId;\n\n    const cardById = id => cards.find(card => card.dataset.id === String(id));\n\n    function setDraft(id) {\n      draftId = String(id);\n      cards.forEach(card => {\n        const active = card.dataset.id === draftId;\n        card.classList.toggle('selected', active);\n        card.setAttribute('aria-pressed', active ? 'true' : 'false');\n      });\n      counter.textContent = draftId ? '1 seleccionado' : '0 seleccionados';\n      const selected = cardById(draftId);\n      confirmLabel.textContent = selected ? `Vincular informe #${selected.dataset.id}` : 'Vincular informe';\n    }\n\n    function updateSummary(card) {\n      if (!card) return;\n      hiddenInput.value = card.dataset.id;\n      summaryTitle.textContent = card.dataset.title;\n      summaryDescription.textContent = card.dataset.description;\n      summaryEvidence.textContent = card.dataset.evidence;\n      summaryImage.src = card.dataset.image;\n      summaryImage.alt = `Vista previa del informe ${card.dataset.id}`;\n    }\n\n    function openModal() {\n      draftId = committedId;\n      setDraft(draftId);\n      modal.classList.remove('hidden');\n      document.body.classList.add('overflow-hidden');\n      window.setTimeout(() => search.focus(), 40);\n    }\n\n    function closeModal() {\n      draftId = committedId;\n      setDraft(draftId);\n      modal.classList.add('hidden');\n      document.body.classList.remove('overflow-hidden');\n    }\n\n    function applyFilters() {\n      const query = search.value.trim().toLowerCase();\n      const selectedType = filter.value.toLowerCase();\n      let count = 0;\n      cards.forEach(card => {\n        const matchesQuery = !query || card.dataset.search.includes(query);\n        const matchesType = selectedType === 'all' || card.dataset.type.toLowerCase() === selectedType;\n        const visible = matchesQuery && matchesType;\n        card.style.display = visible ? '' : 'none';\n        if (visible) count += 1;\n      });\n      noReports.style.display = count ? 'none' : 'block';\n      visibleCount.textContent = `${count} informe${count === 1 ? '' : 's'}`;\n    }\n\n    cards.forEach(card => {\n      const select = () => setDraft(card.dataset.id);\n      card.addEventListener('click', select);\n      card.addEventListener('keydown', event => {\n        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); select(); }\n      });\n    });\n\n    search.addEventListener('input', applyFilters);\n    filter.addEventListener('change', applyFilters);\n    document.querySelectorAll('.js-open-report-modal').forEach(button => button.addEventListener('click', openModal));\n    document.querySelectorAll('.js-close-report-modal, .js-cancel-report').forEach(button => button.addEventListener('click', closeModal));\n    document.querySelector('.js-confirm-report').addEventListener('click', () => {\n      const selected = cardById(draftId);\n      if (!selected) return;\n      committedId = draftId;\n      updateSummary(selected);\n      closeModal();\n    });\n    modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });\n    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });\n\n    setDraft(committedId);\n    updateSummary(cardById(committedId));\n    applyFilters();\n    document.body.classList.add('overflow-hidden');\n  })();\n</script>\n",
