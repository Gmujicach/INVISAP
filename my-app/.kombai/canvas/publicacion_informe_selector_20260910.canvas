      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap');\n  :root {\n    --inv-surface: #ffffff;\n    --inv-soft: #f7f8fb;\n    --inv-border: #e3e5ec;\n    --inv-ink: #263238;\n    --inv-body: #566273;\n    --inv-muted: #7c8797;\n    --inv-green: #08b324;\n    --inv-green-dark: #2d6a4f;\n    --inv-green-deep: #1b4332;\n    --inv-green-soft: rgba(8, 179, 36, 0.10);\n    --inv-yellow: #ffd60a;\n    --inv-blue: #0d6efd;\n    --inv-shadow: 0 18px 40px rgba(36, 48, 58, 0.18);\n  }\n  .admin-shell { font-family: 'Public Sans', sans-serif; color: var(--inv-ink); }\n  .admin-shell h1, .admin-shell h2, .admin-shell h3, .admin-shell h4, .admin-shell h5, .admin-shell h6 { font-family: 'Open Sans', sans-serif; }\n  .soft-shadow { box-shadow: 0 10px 24px rgba(36, 48, 58, 0.08); }\n  .selection-card { border: 1px solid var(--inv-border); background: var(--inv-surface); border-radius: 14px; cursor: pointer; transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }\n  .selection-card:hover { border-color: rgba(8, 179, 36, 0.52); transform: translateY(-1px); box-shadow: 0 8px 18px rgba(8, 179, 36, 0.10); }\n  .selection-card.is-selected { border: 2px solid var(--inv-green); background: #f1fbf3; box-shadow: 0 8px 20px rgba(8, 179, 36, 0.14); }\n  .selection-card.is-selected .selection-check { opacity: 1; transform: scale(1); }\n  .selection-check { opacity: 0; transform: scale(.78); transition: opacity 180ms ease, transform 180ms ease; }\n  .report-thumb { width: 74px; height: 62px; object-fit: cover; border-radius: 10px; flex: 0 0 auto; }\n  .detail-gallery img { object-fit: cover; display: block; width: 100%; }\n  .gallery-tile { position: relative; overflow: hidden; border-radius: 12px; background: #dde4e1; min-height: 104px; }\n  .gallery-tile img { height: 100%; min-height: 104px; transition: transform 220ms ease; }\n  .gallery-tile:hover img { transform: scale(1.035); }\n  .gallery-label { position: absolute; left: 8px; bottom: 8px; padding: 4px 8px; border-radius: 999px; background: rgba(27, 67, 50, .92); color: #fff; font: 700 10px/1 'Open Sans', sans-serif; letter-spacing: .08em; }\n  .modal-scroll { scrollbar-color: #b7c8be transparent; }\n  .modal-scroll::-webkit-scrollbar { width: 8px; }\n  .modal-scroll::-webkit-scrollbar-track { background: transparent; }\n  .modal-scroll::-webkit-scrollbar-thumb { background: #c3d1c8; border-radius: 999px; }\n  .stage-rule { height: 3px; width: 30px; border-radius: 999px; background: var(--inv-green); }\n  .stage-rule.yellow { background: var(--inv-yellow); }\n  .stage-rule.blue { background: var(--inv-blue); }\n  .field-shell { border: 1px solid var(--inv-border); background: var(--inv-soft); border-radius: 12px; }\n  .modal-backdrop { background: rgba(20, 30, 27, .55); backdrop-filter: blur(3px); }\n  .chip { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 5px 9px; font-size: 11px; font-weight: 700; white-space: nowrap; }\n  .report-list { max-height: 512px; }\n  @media (max-width: 991px) { .report-list { max-height: none; } }\n</style>\n<div class=\"admin-shell min-h-screen bg-[var(--inv-soft)]\" data-kid=\"1\">\n    <header class=\"border-b border-[var(--inv-border)] bg-white px-4 py-3 sm:px-8\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-4\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--inv-green-deep)] text-lg text-white shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"bx bx-buildings\" data-kid=\"1-1-1-1-1-1\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"m-0 text-[10px] font-bold uppercase tracking-[.18em] text-[var(--inv-muted)]\" data-kid=\"1-1-1-1-2-1\">\n                        INVISAP · Panel administrativo\n                    </p>\n                    <p class=\"m-0 text-sm font-bold text-[var(--inv-ink)]\" data-kid=\"1-1-1-1-2-2\">\n                        Gestión de publicaciones\n                    </p>\n                </div>\n            </div>\n            <div class=\"hidden items-center gap-3 text-xs text-[var(--inv-muted)] sm:flex\" data-kid=\"1-1-1-2\">\n                <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"bx bx-shield-quarter text-[var(--inv-green)]\" data-kid=\"1-1-1-2-1-1\">\n                    </i>\n                    Sesión protegida\n                </span>\n                <span class=\"h-5 w-px bg-[var(--inv-border)]\" data-kid=\"1-1-1-2-2\">\n                </span>\n                <span data-kid=\"1-1-1-2-3\">\n                    Registro institucional\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1180px] px-4 py-6 sm:px-8 sm:py-8\" data-kid=\"1-2\">\n        <div class=\"mb-5 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <div class=\"mb-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[.16em] text-[var(--inv-muted)]\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-1.5 w-8 rounded-full bg-[var(--inv-yellow)]\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    Publicaciones / Nuevo registro\n                </div>\n                <h1 class=\"m-0 text-2xl font-extrabold tracking-[-.025em] text-[var(--inv-ink)] sm:text-[30px]\" data-kid=\"1-2-1-1-2\">\n                    Registrar publicación\n                </h1>\n                <p class=\"mt-1.5 max-w-[620px] text-sm leading-6 text-[var(--inv-body)]\" data-kid=\"1-2-1-1-3\">\n                    Complete los datos para difundir información institucional y vincule el informe fotográfico correcto.\n                </p>\n            </div>\n            <div class=\"rounded-full border border-[var(--inv-border)] bg-white px-3 py-2 text-xs font-semibold text-[var(--inv-muted)]\" data-kid=\"1-2-1-2\">\n                <i class=\"bx bx-info-circle mr-1 text-[var(--inv-green)]\" data-kid=\"1-2-1-2-1\">\n                </i>\n                Campos obligatorios marcados con *\n            </div>\n        </div>\n        <section class=\"soft-shadow overflow-hidden rounded-[18px] border border-[var(--inv-border)] bg-white\" data-kid=\"1-2-2\">\n            <div class=\"flex items-center justify-between gap-4 border-b border-[var(--inv-border)] bg-[var(--inv-green-deep)] px-5 py-4 text-white sm:px-7\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"m-0 text-[10px] font-bold uppercase tracking-[.18em] text-white/65\" data-kid=\"1-2-2-1-1-1\">\n                        Nueva publicación\n                    </p>\n                    <h2 class=\"m-0 mt-1 text-lg font-bold\" data-kid=\"1-2-2-1-1-2\">\n                        Información de difusión\n                    </h2>\n                </div>\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-xl\" data-kid=\"1-2-2-1-2\">\n                    <i class=\"bx bx-news\" data-kid=\"1-2-2-1-2-1\">\n                    </i>\n                </div>\n            </div>\n            <form class=\"p-5 sm:p-7\" data-kid=\"1-2-2-2\">\n                <div class=\"grid gap-5 md:grid-cols-2\" data-kid=\"1-2-2-2-1\">\n                    <label class=\"block md:col-span-2\" data-kid=\"1-2-2-2-1-1\">\n                        <span class=\"mb-2 block text-sm font-bold text-[var(--inv-ink)]\" data-kid=\"1-2-2-2-1-1-1\">\n                            Título de la Publicación\n                            <b class=\"text-red-500\" data-kid=\"1-2-2-2-1-1-1-1\">\n                                *\n                            </b>\n                        </span>\n                        <div class=\"flex items-center rounded-xl border border-[var(--inv-border)] bg-white px-3 focus-within:border-[var(--inv-green)] focus-within:ring-4 focus-within:ring-green-100\" data-kid=\"1-2-2-2-1-1-2\">\n                            <i class=\"bx bx-card-text mr-2 text-lg text-[var(--inv-green)]\" data-kid=\"1-2-2-2-1-1-2-1\">\n                            </i>\n                            <input class=\"w-full border-0 bg-transparent py-3 text-sm outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"publication title input\" data-reason=\"value dynamically set by application state\" placeholder=\"Título impactante y descriptivo\" value=\"Avance de rehabilitación vial en el municipio\"/>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-2-2-2-1-2\">\n                        <span class=\"mb-2 block text-sm font-bold text-[var(--inv-ink)]\" data-kid=\"1-2-2-2-1-2-1\">\n                            Responsable\n                            <b class=\"text-red-500\" data-kid=\"1-2-2-2-1-2-1-1\">\n                                *\n                            </b>\n                        </span>\n                        <div class=\"flex items-center rounded-xl border border-[var(--inv-border)] bg-white px-3\" data-kid=\"1-2-2-2-1-2-2\">\n                            <i class=\"bx bx-user mr-2 text-lg text-[var(--inv-green)]\" data-kid=\"1-2-2-2-1-2-2-1\">\n                            </i>\n                            <input class=\"w-full border-0 bg-transparent py-3 text-sm outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"responsible person input\" data-reason=\"value dynamically set by application state\" value=\"María González\"/>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-2-2-2-1-3\">\n                        <span class=\"mb-2 block text-sm font-bold text-[var(--inv-ink)]\" data-kid=\"1-2-2-2-1-3-1\">\n                            Fecha de Emisión\n                            <b class=\"text-red-500\" data-kid=\"1-2-2-2-1-3-1-1\">\n                                *\n                            </b>\n                        </span>\n                        <div class=\"flex items-center rounded-xl border border-[var(--inv-border)] bg-white px-3\" data-kid=\"1-2-2-2-1-3-2\">\n                            <i class=\"bx bx-calendar-event mr-2 text-lg text-[var(--inv-green)]\" data-kid=\"1-2-2-2-1-3-2-1\">\n                            </i>\n                            <input class=\"w-full border-0 bg-transparent py-3 text-sm outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3-2-2\" data-name=\"publication date input\" data-reason=\"value dynamically set by application state\" type=\"date\" value=\"2026-09-10\"/>\n                        </div>\n                    </label>\n                    <div class=\"md:col-span-2\" data-kid=\"1-2-2-2-1-4\">\n                        <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-2-2-2-1-4-1\">\n                            <label class=\"text-sm font-bold text-[var(--inv-ink)]\" data-kid=\"1-2-2-2-1-4-1-1\">\n                                Vincular Informe (Fotos de Obra)\n                                <b class=\"text-red-500\" data-kid=\"1-2-2-2-1-4-1-1-1\">\n                                    *\n                                </b>\n                            </label>\n                            <span class=\"text-[11px] font-semibold text-[var(--inv-muted)]\" data-kid=\"1-2-2-2-1-4-1-2\">\n                                Se guardará el ID del informe seleccionado\n                            </span>\n                        </div>\n                        <input data-dynamic=\"true\" data-kid=\"1-2-2-2-1-4-2\" data-name=\"selected report hidden ID\" data-reason=\"value dynamically set by script\" id=\"informe_avance_obra_id_informe\" name=\"informe_avance_obra_id_informe\" type=\"hidden\" value=\"104\"/>\n                        <div class=\"field-shell flex flex-col gap-3 p-3 sm:flex-row sm:items-center sm:justify-between sm:p-4\" data-kid=\"1-2-2-2-1-4-3\">\n                            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-2-1-4-3-1\">\n                                <div class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--inv-green-soft)] text-2xl text-[var(--inv-green-dark)]\" data-kid=\"1-2-2-2-1-4-3-1-1\">\n                                    <i class=\"bx bx-file-find\" data-kid=\"1-2-2-2-1-4-3-1-1-1\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-2-1-4-3-1-2\">\n                                    <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-2-1-4-3-1-2-1\">\n                                        <span class=\"text-sm font-extrabold text-[var(--inv-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-4-3-1-2-1-1\" data-name=\"selected report name label\" data-reason=\"text replaced dynamically by selection script\" id=\"selectedReportLabel\">\n                                            Informe #104 · Avance Mensual\n                                        </span>\n                                        <span class=\"chip bg-amber-100 text-amber-800\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-4-3-1-2-1-2\" data-name=\"selected report status chip\" data-reason=\"text and class replaced dynamically by selection script\" id=\"selectedReportStatus\">\n                                            <i class=\"bx bx-time-five\" data-kid=\"1-2-2-2-1-4-3-1-2-1-2-1\">\n                                            </i>\n                                            En Ejecución\n                                        </span>\n            