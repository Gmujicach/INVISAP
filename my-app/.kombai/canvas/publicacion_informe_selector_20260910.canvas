2-1-2-1-2\" data-name=\"preview modal status chip\" data-reason=\"text and class updated dynamically by selection script\" id=\"detailStatus\">\n                                <i class=\"bx bx-time-five\" data-kid=\"1-3-1-2-1-2-1-2-1\">\n                                </i>\n                                En Ejecución\n                            </span>\n                        </div>\n                        <div class=\"mt-4 flex flex-wrap gap-2\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"preview modal detail chips container\" data-reason=\"content dynamically generated by selection script\" id=\"detailChips\">\n                            <span class=\"chip bg-[var(--inv-green-soft)] text-[var(--inv-green-dark)]\" data-kid=\"1-3-1-2-1-2-2-1\">\n                                <i class=\"bx bx-file\" data-kid=\"1-3-1-2-1-2-2-1-1\">\n                                </i>\n                                Avance Mensual\n                            </span>\n                            <span class=\"chip bg-blue-50 text-blue-700\" data-kid=\"1-3-1-2-1-2-2-2\">\n                                <i class=\"bx bx-trending-up\" data-kid=\"1-3-1-2-1-2-2-2-1\">\n                                </i>\n                                68% de avance\n                            </span>\n                            <span class=\"chip bg-slate-100 text-[var(--inv-body)]\" data-kid=\"1-3-1-2-1-2-2-3\">\n                                <i class=\"bx bx-calendar\" data-kid=\"1-3-1-2-1-2-2-3-1\">\n                                </i>\n                                10/09/2026\n                            </span>\n                        </div>\n                        <div class=\"mt-5 rounded-[14px] border border-[var(--inv-border)] bg-[var(--inv-soft)] p-4\" data-kid=\"1-3-1-2-1-2-3\">\n                            <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-3-1-2-1-2-3-1\">\n                                <span class=\"stage-rule\" data-kid=\"1-3-1-2-1-2-3-1-1\">\n                                </span>\n                                <h4 class=\"m-0 text-xs font-extrabold uppercase tracking-[.13em] text-[var(--inv-green-dark)]\" data-kid=\"1-3-1-2-1-2-3-1-2\">\n                                    Descripción técnica\n                                </h4>\n                            </div>\n                            <p class=\"m-0 text-sm leading-6 text-[var(--inv-body)]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-3-2\" data-name=\"preview modal description text\" data-reason=\"text updated dynamically by selection script\" id=\"detailDescription\">\n                                Se verifica la continuidad de la rehabilitación vial en el tramo urbano priorizado. Durante la jornada se ejecutaron labores de nivelación, colocación de base granular y preparación para la carpeta de rodamiento, manteniendo seguimiento del cronograma y control de calidad en campo.\n                            </p>\n                        </div>\n                        <div class=\"mt-5\" data-kid=\"1-3-1-2-1-2-4\">\n                            <div class=\"mb-3 flex flex-wrap items-end justify-between gap-2\" data-kid=\"1-3-1-2-1-2-4-1\">\n                                <div data-kid=\"1-3-1-2-1-2-4-1-1\">\n                                    <p class=\"m-0 text-[10px] font-bold uppercase tracking-[.16em] text-[var(--inv-muted)]\" data-kid=\"1-3-1-2-1-2-4-1-1-1\">\n                                        Evidencias fotográficas\n                                    </p>\n                                    <h4 class=\"m-0 mt-1 text-base font-extrabold text-[var(--inv-ink)]\" data-kid=\"1-3-1-2-1-2-4-1-1-2\">\n                                        Registro visual por etapa\n                                    </h4>\n                                </div>\n                                <span class=\"text-[11px] font-semibold text-[var(--inv-muted)]\" data-kid=\"1-3-1-2-1-2-4-1-2\">\n                                    <i class=\"bx bx-images mr-1 text-[var(--inv-green)]\" data-kid=\"1-3-1-2-1-2-4-1-2-1\">\n                                    </i>\n                                    4 evidencias vinculadas\n                                </span>\n                            </div>\n                            <div class=\"detail-gallery grid gap-3 sm:grid-cols-2\" data-kid=\"1-3-1-2-1-2-4-2\">\n                                <div class=\"sm:row-span-2\" data-kid=\"1-3-1-2-1-2-4-2-1\">\n                                    <div class=\"gallery-tile h-full min-h-[220px]\" data-kid=\"1-3-1-2-1-2-4-2-1-1\">\n                                        <img alt=\"Evidencia antes del avance\" class=\"h-full min-h-[220px]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-4-2-1-1-1\" data-name=\"before-after report image 1\" data-reason=\"src attribute updated dynamically by selection script\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                                        <span class=\"gallery-label\" data-kid=\"1-3-1-2-1-2-4-2-1-1-2\">\n                                            ANTES · 01\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"gallery-tile\" data-kid=\"1-3-1-2-1-2-4-2-2\">\n                                    <img alt=\"Evidencia antes de la obra\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-4-2-2-1\" data-name=\"before-after report image 2\" data-reason=\"src attribute updated dynamically by selection script\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/2.jpeg\"/>\n                                    <span class=\"gallery-label\" data-kid=\"1-3-1-2-1-2-4-2-2-2\">\n                                        ANTES · 02\n                                    </span>\n                                </div>\n                                <div class=\"gallery-tile\" data-kid=\"1-3-1-2-1-2-4-2-3\">\n                                    <img alt=\"Evidencia durante el avance\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-4-2-3-1\" data-name=\"before-after report image 3\" data-reason=\"src attribute updated dynamically by selection script\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/3.jpeg\"/>\n                                    <span class=\"gallery-label\" data-kid=\"1-3-1-2-1-2-4-2-3-2\" style=\"background:rgba(117,83,0,.92)\">\n                                        DURANTE · 01\n                                    </span>\n                                </div>\n                                <div class=\"gallery-tile\" data-kid=\"1-3-1-2-1-2-4-2-4\">\n                                    <img alt=\"Evidencia después del avance\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-4-2-4-1\" data-name=\"before-after report image 4\" data-reason=\"src attribute updated dynamically by selection script\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/4.jpeg\"/>\n                                    <span class=\"gallery-label\" data-kid=\"1-3-1-2-1-2-4-2-4-2\" style=\"background:rgba(13,110,253,.92)\">\n                                        DESPUÉS · 01\n                                    </span>\n                                </div>\n                                <div class=\"rounded-xl border border-dashed border-[var(--inv-border)] bg-[var(--inv-soft)] p-3\" data-kid=\"1-3-1-2-1-2-4-2-5\">\n                                    <div class=\"flex h-full min-h-[104px] flex-col justify-center\" data-kid=\"1-3-1-2-1-2-4-2-5-1\">\n                                        <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-2-1-2-4-2-5-1-1\">\n                                            <span class=\"stage-rule yellow\" data-kid=\"1-3-1-2-1-2-4-2-5-1-1-1\">\n                                            </span>\n                                            <span class=\"text-[10px] font-extrabold uppercase tracking-[.12em] text-[var(--inv-body)]\" data-kid=\"1-3-1-2-1-2-4-2-5-1-1-2\">\n                                                Durante\n                                            </span>\n                                        </div>\n                                        <p class=\"m-0 mt-2 text-[11px] leading-5 text-[var(--inv-muted)]\" data-kid=\"1-3-1-2-1-2-4-2-5-1-2\">\n                                            Seguimiento fotográfico disponible en el informe seleccionado.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 flex-col-reverse justify-between gap-3 border-t border-[var(--inv-border)] bg-white px-4 py-3.5 sm:flex-row sm:items-center sm:px-6\" data-kid=\"1-3-1-3\">\n                <p class=\"m-0 flex items-center gap-2 text-xs text-[var(--inv-muted)]\" data-kid=\"1-3-1-3-1\">\n                    <i class=\"bx bx-lock-alt text-[var(--inv-green)]\" data-kid=\"1-3-1-3-1-1\">\n                    </i>\n                    <span data-kid=\"1-3-1-3-1-2\">\n                        Solo se vinculará el informe seleccionado al registro.\n                    </span>\n                </p>\n                <div class=\"flex justify-end gap-2\" data-kid=\"1-3-1-3-2\">\n                    <button class=\"rounded-xl border border-[var(--inv-border)] bg-white px-4 py-2.5 text-xs font-bold text-[var(--inv-body)] hover:bg-[var(--inv-soft)]\" data-kid=\"1-3-1-3-2-1\" id=\"cancelModal\" type=\"button\">\n                        Cancelar\n                    </button>\n                    <button class=\"rounded-xl bg-[var(--inv-green)] px-5 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-[var(--inv-green-dark)]\" data-kid=\"1-3-1-3-2-2\" id=\"confirmReport\" type=\"button\">\n                        <i class=\"bx bx-check-circle mr-1\" data-kid=\"1-3-1-3-2-2-1\">\n                        </i>\n                        Vincular este informe\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<link data-kid=\"2\" href=\"https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css\" rel=\"stylesheet\"/>\n<script>\n    const reportData = {\n    104: { type: 'Avance Mensual', project: 'Rehabilitación vial municipal', status: 'En Ejecución', statusClass: 'bg-amber-100 text-amber-800', icon: 'bx-time-five', date: '10/09/2026', progress: '68%', description: 'Se verifica la continuidad de la rehabilitación vial en el tramo urbano priorizado. Durante la jornada se ejecutaron labores de nivelación, colocación de base granular y preparación para la carpeta de rodamiento, manteniendo seguimiento del cronograma y control de calidad en campo.', images: ['1.jpeg','2.jpeg','3.jpeg','4.jpeg'] },\n    103: { type: 'Ficha Inspección Técnica', project: 'Mejoramiento de drenajes y aceras', status: 'Aprobado', statusClass: 'bg-green-100 text-green-800', icon: 'bx-check-circle', date: '03/09/2026', progress: '82%', description: 'La inspección técnica confirma que los trabajos revisados cumplen con las especificaciones previstas. Se recomienda mantener la señalización preventiva y completar las actividades menores antes de la recepción de la etapa.', images: ['2.jpeg','3.jpeg','4.jpeg','1.jpeg'] },\n    102: { type: 'Informe Mayor', project: 'Intervención integral de vialidad', status: 'Culminado', statusClass: 'bg-blue-100 text-blue-700', icon: 'bx-check-double', date: '27/08/2026', progress: '100%', description: 'El informe documenta la culminación de la intervención, con verificación de acabados, limpieza del frente de trabajo y cierre de las actividades comprometidas. Las evidencias respaldan la condición final reportada.', images: ['3.jpeg','4.jpeg','1.jpeg','2.jpeg'] }\n  };\n  const modal = document.getElementById('reportModal');\n  const hiddenId = document.getElementById('informe_avance_obra_id_informe');\n  const reportSearch = document.getElementById('reportSearch');\n  const reportList = document.getElementById('reportList');\n  const noReports = document.getElementById('noReports');\n  const reportCount = document.getElementById('reportCount');\n  let selectedId = 104;\n  function imagePath(file) { return '/api/local/images/static/img/' + file; }\n  function renderDetail(id) {\n    const r = reportData[id];\n    if (!r) return;\n    selectedId = Number(id);\n    hiddenId.value = selectedId;\n    document.querySelectorAll('[data-report-id]').forEach(card => card.classList.toggle('is-selected', Number(card.dataset.reportId) === selectedId));\n    document.getElementById('detailTitle').textContent = 'Vista previa del informe #' + selectedId;\n    document.getElementById('detailSubtitle').textContent = r.type + ' · ' + r.project;\n    const status = document.getElementById('detailStatus');\n    status.className = 'chip ' + r.statusClass;\n    status.innerHTML = '<i class=\"bx ' + r.icon + '\"></i> ' + r.status;\n    document.getElementById('detailChips').innerHTML = '<span class=\"chip bg-[var(--inv-green-soft)] text-[var(--inv-green-dark)]\"><i class=\"bx bx-file\"></i> ' + r.type + '</span><span class=\"chip bg-blue-50 text-blue-700\"><i class=\"bx bx-trending-up\"></i> ' + r.progress + ' de avance</span><span class=\"chip bg-slate-100 text-[var(--inv-body)]\"><i class=\"bx bx-calendar\"></i> ' + r.date + '</span>';\n    document.getElementById('detailDescription').textContent = r.description;\n    const detailGallery = document.querySelector('.detail-gallery');\n    const labels = ['ANTES · 01','ANTES · 02','DURANTE · 01','DESPUÉS · 01'];\n    detailGallery.querySelectorAll('.gallery-tile img').forEach((img, index) => { img.src = imagePath(r.images[index]); });\n    document.getElementById('selectedReportLabel').textContent = 'Informe #' + selectedId + ' · ' + r.type;\n    document.getElementById('selectedReportMeta').textContent = r.project + ' · ' + r.progress + ' de avance · ' + r.date;\n    const formStatus = document.getElementById('selectedReportStatus');\n    formStatus.className = 'chip ' + r.statusClass;\n    formStatus.innerHTML = '<i class=\"bx ' + r.icon + '\"></i> ' + r.status;\n  }\n  function setModal(open) { modal.classList.toggle('hidden', !open); modal.classList.toggle('flex', open); }\n  document.querySelectorAll('[data-report-id]').forEach(card => card.addEventListener('click', () => renderDetail(card.dataset.reportId)));\n  document.getElementById('changeReport').addEventListener('click', () => setModal(true));\n  document.getElementById('closeModal').addEventListener('click', () => setModal(false));\n  document.getElementById('cancelModal').addEventListener('click', () => setModal(false));\n  document.getElementById('confirmReport').addEventListener('click', () => setModal(false));\n  reportSearch.addEventListener('input', event => { const term = event.target.value.toLowerCase().trim(); let visible = 0; document.querySelectorAll('[data-report-id]').forEach(card => { const id = card.dataset.reportId; const r = reportData[id]; const match = !term || (id + ' ' + r.type + ' ' + r.project + ' ' + r.status).toLowerCase().includes(term); card.classList.toggle('hidden', !match); if (match) visible++; }); noReports.classList.toggle('hidden', visible > 0); reportCount.textContent = visible + (visible === 1 ? ' informe disponible' : ' informes disponibles'); });\n  renderDetail(104);\n</script>\n",
      "comments": [],
      "created": "2026-09-10T02:28:49.131556+00:00",
      "modified": "2026-09-10T02:29:48.904495+00:00",
      "id": "var_c40c47472334"
    },
    "var_8069df5ce006": {
      "type": "variant",
      "label": "Selector de informes — Inventario fotográfico horizontal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&family=Public+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css');\n\n  :root {\n    --inv-green: #08b324;\n    --inv-green-deep: #2d6a4f;\n    --inv-green-ink: #1b4332;\n    --inv-yellow: #ffd60a;\n    --inv-yellow-deep: #d89d00;\n    --inv-blue: #0d6efd;\n    --surface: #ffffff;\n    --surface-soft: #f7f8fb;\n    --ink: #263238;\n    --body: #566273;\n    --muted: #7c8797;\n    --border: #e3e5ec;\n    --shadow: 0 20px 54px rgba(24, 39, 33, .18);\n  }\n\n  .bi {\n    display: inline-flex;\n    width: 1em;\n    height: 1em;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n  }\n\n  .inv-shell {\n    min-height: 100vh;\n    background: var(--surface-soft);\n    color: var(--ink);\n    font-family: 'Open Sans', Arial, sans-serif;\n  }\n\n  .inv-topline {\n    height: 6px;\n    background: var(--inv-green);\n  }\n\n  .inv-page-header {\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 20px clamp(20px, 4vw, 56px);\n  }\n\n  .inv-brand-lockup {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .inv-brand-mark {\n    width: 40px;\n    height: 40px;\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: #e9f8ed;\n    color: var(--inv-green-deep);\n    font-size: 1.3rem;\n  }\n\n  .inv-brand-name {\n    font-family: 'Public Sans', sans-serif;\n    font-weight: 800;\n    letter-spacing: .08em;\n    font-size: .9rem;\n    color: var(--inv-green-ink);\n  }\n\n  .inv-brand-sub {\n    margin: 2px 0 0;\n    color: var(--muted);\n    font-size: .68rem;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  .inv-breadcrumb {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--muted);\n    font-size: .72rem;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    font-weight: 700;\n  }\n\n  .inv-content {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 34px clamp(20px, 4vw, 56px) 72px;\n  }\n\n  .inv-page-title {\n    margin: 0;\n    font-family: 'Public Sans', sans-serif;\n    font-size: clamp(1.55rem, 2vw, 2rem);\n    line-height: 1.15;\n    font-weight: 800;\n    color: var(--ink);\n  }\n\n  .inv-page-copy {\n    margin: 9px 0 0;\n    max-width: 670px;\n    color: var(--body);\n    font-size: .92rem;\n    line-height: 1.65;\n  }\n\n  .inv-form-card {\n    margin-top: 28px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 18px;\n    box-shadow: 0 10px 28px rgba(36, 48, 58, .07);\n    overflow: hidden;\n  }\n\n  .inv-form-card-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    padding: 21px 26px;\n    background: linear-gradient(90deg, var(--inv-green-deep), #3b805f);\n    color: white;\n  }\n\n  .inv-form-card-head h2 {\n    margin: 0;\n    font-family: 'Public Sans', sans-serif;\n    font-size: 1.05rem;\n    font-weight: 800;\n  }\n\n  .inv-form-card-head p {\n    margin: 5px 0 0;\n    color: rgba(255,255,255,.78);\n    font-size: .78rem;\n  }\n\n  .inv-form-card-body {\n    padding: 28px;\n  }\n\n  .inv-label {\n    display: block;\n    margin: 0 0 8px;\n    color: var(--ink);\n    font-size: .78rem;\n    font-weight: 800;\n    letter-spacing: .02em;\n  }\n\n  .inv-control {\n    width: 100%;\n    min-height: 46px;\n    padding: 11px 14px;\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    color: var(--ink);\n    background: #fff;\n    font: inherit;\n    font-size: .86rem;\n    outline: none;\n  }\n\n  .inv-control:focus {\n    border-color: var(--inv-green);\n    box-shadow: 0 0 0 3px rgba(8,179,36,.12);\n  }\n\n  .inv-textarea { min-height: 132px; resize: vertical; }\n\n  .inv-link-field {\n    min-height: 172px;\n    border: 1px solid #cfe8d5;\n    border-radius: 14px;\n    background: #f8fdf9;\n    padding: 15px;\n  }\n\n  .inv-link-field-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .inv-link-title {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    color: var(--inv-green-ink);\n    font-size: .8rem;\n    font-weight: 800;\n  }\n\n  .inv-link-title .bi { color: var(--inv-green); font-size: 1rem; }\n\n  .inv-change-btn {\n    border: 1px solid #a7d4b0;\n    border-radius: 999px;\n    background: #fff;\n    color: var(--inv-green-deep);\n    padding: 7px 12px;\n    font: inherit;\n    font-size: .73rem;\n    font-weight: 800;\n    cursor: pointer;\n  }\n\n  .inv-change-btn:hover { background: #e9f8ed; }\n\n  .inv-selected-summary {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    margin-top: 15px;\n    padding: 12px;\n    border-radius: 10px;\n    background: #fff;\n    border: 1px solid #e5efe7;\n  }\n\n  .inv-summary-thumb {\n    width: 54px;\n    height: 54px;\n    flex: 0 0 auto;\n    border-radius: 9px;\n    overflow: hidden;\n    background: #dbeee0;\n  }\n\n  .inv-summary-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n  .inv-summary-meta { min-width: 0; }\n  .inv-summary-meta strong { display: block; color: var(--ink); font-size: .83rem; }\n  .inv-summary-meta span { display: block; color: var(--body); font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n  .inv-modal-layer {\n    position: fixed;\n    inset: 0;\n    z-index: 80;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 22px;\n    background: rgba(18, 30, 25, .58);\n    backdrop-filter: blur(4px);\n  }\n\n  .inv-modal {\n    width: min(1100px, 100%);\n    max-height: min(92vh, 840px);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    border-radius: 18px;\n    background: var(--surface);\n    box-shadow: var(--shadow);\n    border: 1px solid rgba(255,255,255,.55);\n  }\n\n  .inv-modal-header {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 18px;\n    padding: 20px 24px 18px;\n    background: linear-gradient(135deg, var(--inv-green-deep), var(--inv-green));\n    color: white;\n  }\n\n  .inv-modal-kicker {\n    margin-bottom: 4px;\n    color: rgba(255,255,255,.76);\n    font-size: .65rem;\n    font-weight: 800;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .inv-modal-title {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin: 0;\n    font-family: 'Public Sans', sans-serif;\n    color: white;\n    font-size: 1.22rem;\n    line-height: 1.2;\n    font-weight: 800;\n  }\n\n  .inv-modal-help {\n    margin: 7px 0 0;\n    max-width: 620px;\n    color: rgba(255,255,255,.84);\n    font-size: .78rem;\n    line-height: 1.45;\n  }\n\n  .inv-modal-close {\n    width: 34px;\n    height: 34px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(255,255,255,.55);\n    border-radius: 50%;\n    background: rgba(255,255,255,.12);\n    color: white;\n    font-size: 1rem;\n    cursor: pointer;\n  }\n\n  .inv-modal-close:hover { background: rgba(255,255,255,.24); }\n\n  .inv-modal-toolbar {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 24px;\n    background: #fbfcfd;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .inv-search {\n    position: relative;\n    flex: 1 1 420px;\n  }\n\n  .inv-search .bi {\n    position: absolute;\n    left: 13px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: var(--muted);\n    font-size: .92rem;\n  }\n\n  .inv-search input {\n    width: 100%;\n    min-height: 42px;\n    border: 1px solid var(--border);\n    border-radius: 9px;\n    padding: 9px 12px 9px 37px;\n    background: white;\n    color: var(--ink);\n    font: inherit;\n    font-size: .8rem;\n    outline: none;\n  }\n\n  .inv-search input:focus { border-color: var(--inv-green); box-shadow: 0 0 0 3px rgba(8,179,36,.11); }\n\n  .inv-filter {\n    min-height: 42px;\n    min-width: 170px;\n    border: 1px solid var(--border);\n    border-radius: 9px;\n    padding: 9px 12px;\n    color: var(--body);\n    background: white;\n    font: inherit;\n    font-size: .8rem;\n    outline: none;\n  }\n\n  .inv-counter {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    min-height: 42px;\n    padding: 0 12px;\n    border-radius: 9px;\n    background: #e9f8ed;\n    color: var(--inv-green-deep);\n    font-size: .76rem;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n\n  .inv-counter .bi { color: var(--inv-green); }\n\n  .inv-modal-body {\n    min-height: 0;\n    overflow-y: auto;\n    padding: 17px 24px 22px;\n    background: #f7f8fb;\n  }\n\n  .inv-list-intro {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 12px;\n    color: var(--muted);\n    font-size: .72rem;\n  }\n\n  .inv-list-intro strong { color: var(--body); }\n\n  .inv-report-list {\n    display: grid;\n    gap: 10px;\n  }\n\n  .inv-report-card {\n    position: relative;\n    display: grid;\n    grid-template-columns: 180px minmax(0, 1fr) 190px 34px;\n    align-items: center;\n    gap: 17px;\n    min-height: 148px;\n    padding: 13px 16px 13px 14px;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: 14px;\n    background: white;\n    cursor: pointer;\n    transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease, transform .2s ease;\n  }\n\n  .inv-report-card::before {\n    content: '';\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 4px;\n    background: transparent;\n  }\n\n  .inv-report-card:hover {\n    border-color: #9ecfaa;\n    box-shadow: 0 7px 17px rgba(45,106,79,.10);\n    transform: translateY(-1px);\n  }\n\n  .inv-report-card.selected {\n    border-color: var(--inv-green-deep);\n    background: #f1fbf3;\n    box-shadow: 0 8px 22px rgba(45,106,79,.14);\n  }\n\n  .inv-report-card.selected::before { background: var(--inv-yellow); }\n\n  .inv-mosaic {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    grid-template-rows: repeat(2, 1fr);\n    gap: 3px;\n    height: 118px;\n    overflow: hidden;\n    border-radius: 10px;\n    background: #dfe9e2;\n  }\n\n  .inv-mosaic-item { position: relative; min-width: 0; min-height: 0; overflow: hidden; }\n  .inv-mosaic-item img { width: 100%; height: 100%; object-fit: cover; display: block; }\n  .inv-mosaic-tag {\n    position: absolute;\n    left: 5px;\n    bottom: 5px;\n    padding: 3px 5px;\n    border-radius: 4px;\n    background: rgba(26, 40, 34, .76);\n    color: white;\n    font-size: .52rem;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: .08em;\n  }\n  .inv-mosaic-tag.during { background: rgba(216,157,0,.9); color: #fff; }\n  .inv-mosaic-tag.after { background: rgba(13,110,253,.9); }\n\n  .inv-report-main { min-width: 0; }\n  .inv-report-eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--muted);\n    font-size: .66rem;\n    font-weight: 800;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .inv-report-title {\n    margin: 6px 0 0;\n    color: var(--ink);\n    font-family: 'Public Sans', sans-serif;\n    font-size: 1rem;\n    line-height: 1.22;\n    font-weight: 800;\n  }\n\n  .inv-report-description {\n    display: -webkit-box;\n    margin: 9px 0 11px;\n    overflow: hidden;\n    color: var(--body);\n    font-size: .75rem;\n    line-height: 1.48;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n  }\n\n  .inv-report-meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 7px 14px;\n    color: var(--muted);\n    font-size: .68rem;\n  }\n\n  .inv-report-meta span { display: inline-flex; align-items: center; gap: 5px; }\n  .inv-report-meta .bi { color: var(--inv-green-deep); }\n\n  .inv-status {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 4px 8px;\n    border-radius: 999px;\n    background: #e9f8ed;\n    color: var(--inv-green-deep);\n    font-size: .62rem;\n    font-weight: 800;\n  }\n\n  .inv-report-side {\n    align-self: stretch;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 10px;\n    padding-left: 16px;\n    border-left: 1px solid #e8ece9;\n  }\n\n  .inv-progress-label {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    color: var(--body);\n    font-size: .67rem;\n    font-weight: 700;\n  }\n\n  .inv-progress-label strong { color: var(--inv-green-deep); font-size: .85rem; }\n  .inv-progress-track { width: 100%; height: 7px; overflow: hidden; border-radius: 99px; background: #e7eee9; }\n  .inv-progress-fill { height: 100%; border-radius: inherit; background: var(--inv-green); }\n  .inv-evidence-count { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: .68rem; }\n  .inv-evidence-count .bi { color: var(--inv-green-deep); }\n\n  .inv-check {\n    width: 27px;\n    height: 27px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid #cfd8d1;\n    border-radius: 50%;\n    color: transparent;\n    background: white;\n    font-size: .88rem;\n  }\n\n  .inv-report-card.selected .inv-check {\n    border-color: var(--inv-green);\n    color: white;\n    background: var(--inv-green);\n  }\n\n  .inv-no-results { display: none; padding: 36px 20px; text-align: center; color: var(--muted); }\n  .inv-no-results .bi { display: block; margin: 0 auto 8px; color: #a6b1aa; font-size: 1.8rem; }\n\n  .inv-modal-footer {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 10px;\n    padding: 15px 24px;\n    border-top: 1px solid var(--border);\n    background: white;\n  }\n\n  .inv-btn {\n    min-height: 40px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    border-radius: 9px;\n    padding: 0 15px;\n    font: inherit;\n    font-size: .78rem;\n    font-weight: 800;\n    cursor: pointer;\n  }\n\n  .inv-btn-secondary { border: 1px solid var(--border); color: var(--body); background: white; }\n  .inv-btn-secondary:hover { background: #f4f5f7; }\n  .inv-btn-primary { border: 1px solid var(--inv-green); color: white; background: var(--inv-green); box-shadow: 0 5px 12px rgba(8,179,36,.18); }\n  .inv-btn-primary:hover { background: var(--inv-green-deep); border-color: var(--inv-green-deep); }\n\n  .inv-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n  @media (max-width: 900px) {\n    .inv-report-card { grid-template-columns: 150px minmax(0, 1fr) 155px 30px; gap: 13px; }\n    .inv-mosaic { height: 105px; }\n    .inv-modal-toolbar { flex-wrap: wrap; }\n    .inv-search { flex-basis: 100%; }\n  }\n\n  @media (max-width: 700px) {\n    .inv-page-header { padding: 16px 18px; }\n    .inv-content { padding: 24px 16px 48px; }\n    .inv-form-card-body { padding: 20px; }\n    .inv-form-card-head { align-items: flex-start; flex-direction: column; padding: 18px 20px; }\n    .inv-modal-layer { align-items: flex-end; padding: 0; }\n    .inv-modal { width: 100%; max-height: 94vh; border-radius: 18px 18px 0 0; }\n    .inv-modal-header, .inv-modal-toolbar, .inv-modal-body, .inv-modal-footer { padding-left: 16px; padding-right: 16px; }\n    .inv-report-card { grid-template-columns: 92px minmax(0, 1fr) 28px; gap: 10px; padding: 10px; }\n    .inv-mosaic { height: 92px; }\n    .inv-report-side { grid-column: 2 / 3; grid-row: 2; padding: 9px 0 0; border-left: 0; border-top: 1px solid #e8ece9; }\n    .inv-report-card > .inv-check { grid-column: 3; grid-row: 1; align-self: start; }\n    .inv-report-title { font-size: .84rem; }\n    .inv-report-description { font-size: .69rem; margin: 6px 0 8px; }\n    .inv-report-meta { font-size: .61rem; gap: 5px 8px; }\n    .inv-modal-footer { padding-bottom: max(15px, env(safe-area-inset-bottom)); }\n  }\n</style>\n<div class=\"inv-shell\" data-kid=\"1\">\n    <div class=\"inv-topline\" data-kid=\"1-1\">\n    </div>\n    <header class=\"inv-page-header\" data-kid=\"1-2\">\n        <div class=\"flex items-center justify-between gap-5 flex-wrap\" data-kid=\"1-2-1\">\n            <div class=\"inv-brand-lockup\" data-kid=\"1-2-1-1\">\n                <div class=\"inv-brand-mark\" data-kid=\"1-2-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-buildings-fill\" data-kid=\"1-2-1-1-1-1\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-1-1-2\">\n                    <div class=\"inv-brand-name\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name text\">\n                        INVISAP\n                    </div>\n                    <p class=\"inv-brand-sub\" data-kid=\"1-2-1-1-2-2\">\n                        Instituto de Vivienda · Panel administrativo\n                    </p>\n                </div>\n            </div>\n            <div class=\"inv-breadcrumb\" data-kid=\"1-2-1-2\">\n                <span data-kid=\"1-2-1-2-1\">\n                    Publicaciones\n                </span>\n                <i aria-hidden=\"true\" class=\"bi bi-chevron-right\" data-kid=\"1-2-1-2-2\">\n                </i>\n                <strong class=\"text-slate-700\" data-kid=\"1-2-1-2-3\" data-name=\"current page breadcrumb label\">\n                    Registrar publicación\n                </strong>\n            </div>\n        </div>\n    </header>\n    <main class=\"inv-content\" data-kid=\"1-3\">\n        <div class=\"flex items-start justify-between gap-6 flex-wrap\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"inv-breadcrumb mb-3\" data-kid=\"1-3-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"bi bi-megaphone-fill text-green-700\" data-kid=\"1-3-1-1-1-1\">\n                    </i>\n                    <span data-kid=\"1-3-1-1-1-2\">\n                        Módulo de publicaciones\n                    </span>\n                </div>\n                <h1 class=\"inv-page-title\" data-kid=\"1-3-1-1-2\" data-name=\"page title header\">\n                    Registrar publicación institucional\n                </h1>\n                <p class=\"inv-page-copy\" data-kid=\"1-3-1-1-3\">\n                    Complete los datos de la publicación y vincule el informe de avance que respalda visualmente la información de la obra.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 shadow-sm\" data-kid=\"1-3-1-2\">\n                <i aria-hidden=\"true\" class=\"bi bi-shield-check text-green-600\" data-kid=\"1-3-1-2-1\">\n                </i>\n                Registro con respaldo fotográfico\n            </div>\n        </div>\n        <section aria-label=\"Formulario de registro de publicación\" class=\"inv-form-card\" data-kid=\"1-3-2\">\n            <div class=\"inv-form-card-head\" data-kid=\"1-3-2-1\">\n                <div data-kid=\"1-3-2-1-1\">\n                    <h2 data-kid=\"1-3-2-1-1-1\">\n                        <i aria-hidden=\"true\" class=\"bi bi-file-earmark-plus me-2\" data-kid=\"1-3-2-1-1-1-1\">\n                        </i>\n                        Nueva publicación\n                    </h2>\n                    <p data-kid=\"1-3-2-1-1-2\">\n                        La publicación quedará vinculada al informe seleccionado para facilitar su trazabilidad.\n                    </p>\n                </div>\n                <span class=\"rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[.12em] text-white/90\" data-kid=\"1-3-2-1-2\">\n                    Borrador activo\n                </span>\n            </div>\n            <div class=\"inv-form-card-body\" data-kid=\"1-3-2-2\">\n                <form action=\"/form-registrar-publicacion\" class=\"grid grid-cols-12 gap-x-6 gap-y-5\" data-kid=\"1-3-2-2-1\" id=\"formRegistrarPublicacion\" method=\"POST\">\n                    <div class=\"col-span-12\" data-kid=\"1-3-2-2-1-1\">\n                        <label class=\"inv-label\" data-kid=\"1-3-2-2-1-1-1\" for=\"titulo_publicacion\">\n                            Título de la publicación\n                        </label>\n                        <input class=\"inv-control\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"form title input\" data-reason=\"value reinitialized by script on load\" id=\"titulo_publicacion\" name=\"titulo_publicacion\" placeholder=\"Título impactante y descriptivo\" value=\"Avance de rehabilitación vial — Sector La Esperanza\"/>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-6\" data-kid=\"1-3-2-2-1-2\">\n                        <label class=\"inv-label\" data-kid=\"1-3-2-2-1-2-1\" for=\"nombre_responsable\">\n                            Responsable\n                        </label>\n                        <input class=\"inv-control\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2-2\" data-name=\"form responsible name input\" data-reason=\"value reinitialized by script on load\" id=\"nombre_responsable\" name=\"nombre_responsable\" placeholder=\"Nombre del responsable\" value=\"María González\"/>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-6\" data-kid=\"1-3-2-2-1-3\">\n                        <label class=\"inv-label\" data-kid=\"1-3-2-2-1-3-1\" for=\"fecha_publicacion\">\n                            Fecha de emisión\