  "nodes": {
    "var_20ba80fab5e7": {
      "type": "variant",
      "label": "Selector de informes — Galería fiel al módulo de evidencias",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&family=Public+Sans:wght@400;500;600;700;800&display=swap');\n\n  :root {\n    --surface: #ffffff;\n    --surface-soft: #f7f8fb;\n    --surface-muted: #eef1f3;\n    --border: #e3e5ec;\n    --ink: #263238;\n    --body: #566273;\n    --muted: #7c8797;\n    --quiet: #9aa3b1;\n    --green: #08b324;\n    --green-deep: #2d6a4f;\n    --green-dark: #1b4332;\n    --green-soft: #e8f7eb;\n    --yellow: #ffd60a;\n    --yellow-soft: #fff6c9;\n    --blue: #0d6efd;\n    --blue-soft: #eaf3ff;\n    --danger: #dc3545;\n    --shadow-panel: 0 22px 48px rgba(36, 48, 58, .18);\n    --shadow-card: 0 10px 26px rgba(36, 48, 58, .08);\n  }\n\n  .publication-demo {\n    min-height: 100vh;\n    margin: 0;\n    padding: 26px clamp(18px, 4vw, 64px) 64px;\n    background: var(--surface-soft);\n    color: var(--ink);\n    font-family: \"Open Sans\", \"Public Sans\", system-ui, sans-serif;\n  }\n\n  .admin-shell {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .admin-crumb {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    margin-bottom: 18px;\n    color: var(--muted);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .admin-crumb .dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--yellow);\n  }\n\n  .publication-card {\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: 18px;\n    background: var(--surface);\n    box-shadow: var(--shadow-card);\n  }\n\n  .publication-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 20px 26px;\n    color: white;\n    background: var(--green-deep);\n  }\n\n  .publication-heading {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n  }\n\n  .publication-heading .heading-icon {\n    display: grid;\n    width: 42px;\n    height: 42px;\n    place-items: center;\n    border: 1px solid rgba(255,255,255,.3);\n    border-radius: 12px;\n    background: rgba(255,255,255,.12);\n    font-size: 20px;\n  }\n\n  .publication-heading h1,\n  .publication-heading p {\n    margin: 0;\n  }\n\n  .publication-heading h1 {\n    font-family: \"Public Sans\", \"Open Sans\", sans-serif;\n    font-size: 20px;\n    font-weight: 800;\n    letter-spacing: -.02em;\n  }\n\n  .publication-heading p {\n    margin-top: 4px;\n    color: rgba(255,255,255,.74);\n    font-size: 12px;\n  }\n\n  .header-status {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 8px 11px;\n    border: 1px solid rgba(255,255,255,.22);\n    border-radius: 999px;\n    color: #f4fff5;\n    background: rgba(255,255,255,.09);\n    font-size: 11px;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  .header-status i { color: #baf2c0; }\n\n  .publication-body { padding: 30px clamp(20px, 4vw, 44px) 34px; }\n\n  .form-intro { max-width: 680px; margin-bottom: 26px; }\n  .form-intro h2 { margin: 0 0 8px; font-size: 24px; font-weight: 800; letter-spacing: -.03em; }\n  .form-intro p { margin: 0; color: var(--body); font-size: 13px; line-height: 1.6; }\n\n  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 22px; }\n  .field { min-width: 0; }\n  .field-wide { grid-column: 1 / -1; }\n  .field label { display: block; margin-bottom: 8px; color: var(--ink); font-size: 12px; font-weight: 800; }\n  .field label .required { color: var(--danger); }\n  .field-help { margin: 7px 0 0; color: var(--muted); font-size: 11px; line-height: 1.45; }\n\n  .control,\n  .report-trigger,\n  .input-group { width: 100%; }\n  .control {\n    min-height: 46px;\n    padding: 12px 14px;\n    border: 1px solid var(--border);\n    border-radius: 11px;\n    outline: none;\n    color: var(--ink);\n    background: var(--surface);\n    font: inherit;\n    font-size: 13px;\n  }\n  textarea.control { min-height: 118px; resize: vertical; }\n  .control::placeholder { color: #b1b9c3; }\n  .control:focus { border-color: rgba(8,179,36,.65); box-shadow: 0 0 0 4px rgba(8,179,36,.10); }\n\n  .input-group { display: flex; align-items: stretch; }\n  .input-icon { display: grid; width: 45px; flex: 0 0 45px; place-items: center; border: 1px solid var(--border); border-right: 0; border-radius: 11px 0 0 11px; color: var(--green-deep); background: var(--surface-muted); }\n  .input-group .control { border-radius: 0 11px 11px 0; }\n\n  .report-field-wrap { position: relative; }\n  .report-trigger {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    min-height: 88px;\n    padding: 13px 14px;\n    border: 1px solid #cfe4d3;\n    border-radius: 14px;\n    color: var(--ink);\n    background: #fbfffc;\n    text-align: left;\n    cursor: pointer;\n    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;\n  }\n  .report-trigger:hover { border-color: var(--green); box-shadow: 0 8px 18px rgba(8,179,36,.12); transform: translateY(-1px); }\n  .report-trigger-main { display: flex; min-width: 0; align-items: center; gap: 12px; }\n  .report-trigger-icon { display: grid; width: 42px; height: 42px; flex: 0 0 42px; place-items: center; border-radius: 12px; color: var(--green-deep); background: var(--green-soft); font-size: 20px; }\n  .report-trigger-copy { min-width: 0; }\n  .report-trigger-copy strong { display: block; overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }\n  .report-trigger-copy span { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; }\n  .report-trigger-action { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; padding: 9px 12px; border: 0; border-radius: 9px; color: white; background: var(--green); font-size: 11px; font-weight: 800; white-space: nowrap; }\n  .report-trigger-action i { font-size: 14px; }\n\n  .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border); }\n  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 42px; padding: 10px 17px; border: 1px solid transparent; border-radius: 10px; font: inherit; font-size: 12px; font-weight: 800; cursor: pointer; }\n  .btn-outline { color: var(--body); border-color: var(--border); background: var(--surface); }\n  .btn-primary { color: #fff; background: var(--green); box-shadow: 0 8px 14px rgba(8,179,36,.18); }\n\n  .modal-backdrop {\n    position: fixed;\n    inset: 0;\n    z-index: 20;\n    background: rgba(31, 46, 40, .43);\n    backdrop-filter: blur(3px);\n  }\n\n  .report-modal {\n    position: fixed;\n    inset: 0;\n    z-index: 21;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 22px;\n  }\n\n  .report-modal[hidden], .modal-backdrop[hidden] { display: none; }\n\n  .modal-dialog {\n    display: flex;\n    width: min(1050px, 100%);\n    max-height: min(880px, calc(100vh - 42px));\n    flex-direction: column;\n    overflow: hidden;\n    border: 1px solid rgba(255,255,255,.55);\n    border-radius: 18px;\n    background: var(--surface);\n    box-shadow: var(--shadow-panel);\n  }\n\n  .modal-header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 18px;\n    padding: 20px 24px;\n    color: #fff;\n    background: var(--green-deep);\n  }\n  .modal-title-wrap { display: flex; align-items: flex-start; gap: 12px; }\n  .modal-title-icon { display: grid; width: 40px; height: 40px; flex: 0 0 40px; place-items: center; border: 1px solid rgba(255,255,255,.26); border-radius: 12px; background: rgba(255,255,255,.12); font-size: 20px; }\n  .modal-header h3 { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -.02em; }\n  .modal-header p { margin: 5px 0 0; color: rgba(255,255,255,.73); font-size: 12px; }\n  .modal-close { display: grid; width: 34px; height: 34px; flex: 0 0 34px; place-items: center; border: 1px solid rgba(255,255,255,.42); border-radius: 50%; color: white; background: rgba(255,255,255,.12); cursor: pointer; font-size: 17px; }\n  .modal-close:hover { background: rgba(255,255,255,.22); }\n\n  .modal-body { overflow: auto; padding: 18px 24px 24px; background: var(--surface-soft); }\n\n  .modal-summary {\n    display: grid;\n    grid-template-columns: minmax(220px, 1.4fr) minmax(165px, .8fr) auto;\n    align-items: end;\n    gap: 12px;\n    margin-bottom: 16px;\n    padding: 13px;\n    border: 1px solid var(--border);\n    border-radius: 13px;\n    background: var(--surface);\n  }\n  .summary-field label { display: block; margin-bottom: 6px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }\n  .summary-control { width: 100%; height: 38px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; outline: none; color: var(--ink); background: var(--surface-soft); font: inherit; font-size: 12px; }\n  .summary-control:focus { border-color: rgba(8,179,36,.65); box-shadow: 0 0 0 3px rgba(8,179,36,.09); }\n  .selected-count { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 13px; border: 1px solid #cce8d0; border-radius: 8px; color: var(--green-deep); background: var(--green-soft); font-size: 12px; font-weight: 800; white-space: nowrap; }\n  .selected-count i { color: var(--green); font-size: 15px; }\n\n  .gallery-legend { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 13px; }\n  .gallery-legend p { margin: 0; color: var(--body); font-size: 11px; }\n  .gallery-legend p i { margin-right: 5px; color: var(--green); }\n  .evidence-key { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; color: var(--muted); font-size: 10px; font-weight: 700; }\n  .key-item { display: inline-flex; align-items: center; gap: 4px; }\n  .key-dot { width: 7px; height: 7px; border-radius: 50%; }\n  .key-before { background: var(--green); } .key-during { background: var(--yellow); } .key-after { background: var(--blue); }\n\n  .report-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }\n  .report-card {\n    position: relative;\n    overflow: hidden;\n    min-width: 0;\n    border: 2px solid transparent;\n    border-radius: 14px;\n    background: var(--surface);\n    box-shadow: 0 3px 10px rgba(36,48,58,.06);\n    cursor: pointer;\n    transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease, transform .2s ease;\n  }\n  .report-card:hover { box-shadow: 0 10px 22px rgba(36,48,58,.12); transform: translateY(-2px); }\n  .report-card.selected { border-color: var(--green); background: var(--green-soft); box-shadow: 0 10px 22px rgba(8,179,36,.14); }\n  .report-check { position: absolute; top: 11px; right: 11px; z-index: 2; display: grid; width: 27px; height: 27px; place-items: center; border: 2px solid #fff; border-radius: 50%; color: #fff; background: rgba(124,135,151,.74); box-shadow: 0 3px 8px rgba(0,0,0,.18); font-size: 13px; }\n  .report-card.selected .report-check { background: var(--green); }\n  .report-card:not(.selected) .report-check i { display: none; }\n\n  .report-card-top { padding: 14px 14px 12px; }\n  .report-meta-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 9px; }\n  .report-number { color: var(--green-deep); font-family: \"Public Sans\", sans-serif; font-size: 12px; font-weight: 800; }\n  .report-type { display: inline-flex; max-width: 70%; overflow: hidden; padding: 5px 8px; border-radius: 999px; color: var(--green-deep); background: var(--green-soft); font-size: 10px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }\n  .report-card:nth-child(2) .report-type { color: #8b6500; background: var(--yellow-soft); }\n  .report-card:nth-child(3) .report-type { color: #1259a7; background: var(--blue-soft); }\n  .report-card h4 { overflow: hidden; margin: 0 0 8px; color: var(--ink); font-size: 13px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }\n  .report-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 10px; color: var(--body); font-size: 10px; }\n  .report-fact { display: flex; align-items: center; gap: 5px; min-width: 0; }\n  .report-fact i { flex: 0 0 auto; color: var(--green-deep); font-size: 12px; }\n  .report-fact span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .report-status { display: inline-flex; align-items: center; gap: 5px; color: #936d00; font-weight: 800; }\n  .report-status .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); }\n  .report-description { display: -webkit-box; overflow: hidden; min-height: 44px; margin: 12px 0 0; color: var(--body); font-size: 10.5px; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }\n  .progress-track { height: 6px; margin-top: 11px; overflow: hidden; border-radius: 999px; background: #e8ecef; }\n  .progress-fill { height: 100%; border-radius: inherit; background: var(--green); }\n  .report-progress-row { display: flex; justify-content: space-between; margin-top: 5px; color: var(--muted); font-size: 9px; font-weight: 700; }\n\n  .evidence-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; padding: 10px 14px 14px; border-top: 1px solid rgba(227,229,236,.84); }\n  .evidence-thumb { position: relative; min-width: 0; height: 56px; overflow: hidden; border-radius: 8px; background: #d9dee2; }\n  .evidence-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .evidence-thumb::after { position: absolute; inset: auto 0 0; height: 34%; content: \"\"; background: linear-gradient(transparent, rgba(0,0,0,.48)); }\n  .stage-badge { position: absolute; bottom: 4px; left: 5px; z-index: 1; padding: 2px 4px; border-radius: 4px; color: white; font-size: 8px; font-weight: 800; letter-spacing: .04em; }\n  .stage-before { background: var(--green); } .stage-during { color: #594500; background: var(--yellow); } .stage-after { background: var(--blue); }\n  .thumb-more { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; color: #fff; background: rgba(38,50,56,.55); font-size: 12px; font-weight: 800; }\n\n  .modal-footer { display: flex; align-items: center; justify-content: flex-end; gap: 9px; padding: 14px 24px; border-top: 1px solid var(--border); background: var(--surface); }\n  .btn-cancel { color: var(--body); border-color: var(--border); background: var(--surface); }\n  .btn-link-report { color: white; background: var(--green); box-shadow: 0 7px 14px rgba(8,179,36,.18); }\n  .btn-link-report:disabled { cursor: not-allowed; opacity: .55; box-shadow: none; }\n\n  @media (max-width: 900px) {\n    .report-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .modal-summary { grid-template-columns: 1fr 1fr; }\n    .selected-count { justify-content: center; }\n  }\n  @media (max-width: 640px) {\n    .publication-demo { padding: 14px 10px 30px; }\n    .publication-header { align-items: flex-start; flex-direction: column; padding: 17px; }\n    .publication-body { padding: 22px 16px; }\n    .form-grid { grid-template-columns: 1fr; }\n    .field-wide { grid-column: auto; }\n    .report-trigger { align-items: flex-start; flex-direction: column; }\n    .report-trigger-action { width: 100%; }\n    .modal-body { padding: 15px 13px 18px; }\n    .modal-header { padding: 16px; }\n    .modal-footer { padding: 12px 13px; }\n    .modal-summary { grid-template-columns: 1fr; }\n    .report-grid { grid-template-columns: 1fr; }\n    .gallery-legend { align-items: flex-start; flex-direction: column; }\n    .evidence-key { justify-content: flex-start; }\n    .form-actions { align-items: stretch; flex-direction: column-reverse; }\n  }\n</style>\n<div class=\"publication-demo\" data-kid=\"2\">\n    <main class=\"admin-shell\" data-kid=\"2-1\">\n        <div class=\"admin-crumb\" data-kid=\"2-1-1\">\n            <span class=\"dot\" data-kid=\"2-1-1-1\">\n            </span>\n            Módulo de publicaciones\n            <i class=\"bi bi-chevron-right\" data-kid=\"2-1-1-2\">\n            </i>\n            Registrar\n        </div>\n        <section aria-label=\"Formulario de registrar publicación\" class=\"publication-card\" data-kid=\"2-1-2\">\n            <header class=\"publication-header\" data-kid=\"2-1-2-1\">\n                <div class=\"publication-heading\" data-kid=\"2-1-2-1-1\">\n                    <span class=\"heading-icon\" data-kid=\"2-1-2-1-1-1\">\n                        <i class=\"bi bi-megaphone-fill\" data-kid=\"2-1-2-1-1-1-1\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-1-2-1-1-2\">\n                        <h1 data-kid=\"2-1-2-1-1-2-1\">\n                            Registrar Publicación\n                        </h1>\n                        <p data-kid=\"2-1-2-1-1-2-2\">\n                            Difunde información institucional con evidencia verificable.\n                        </p>\n                    </div>\n                </div>\n                <span class=\"header-status\" data-kid=\"2-1-2-1-2\">\n                    <i class=\"bi bi-shield-check\" data-kid=\"2-1-2-1-2-1\">\n                    </i>\n                    Registro institucional\n                </span>\n            </header>\n            <div class=\"publication-body\" data-kid=\"2-1-2-2\">\n                <div class=\"form-intro\" data-kid=\"2-1-2-2-1\">\n                    <h2 data-kid=\"2-1-2-2-1-1\">\n                        Nueva publicación\n                    </h2>\n                    <p data-kid=\"2-1-2-2-1-2\">\n                        Completa los datos de la noticia y vincula un informe de avance para publicar sus evidencias fotográficas junto con el contenido.\n                    </p>\n                </div>\n                <form action=\"{{ url_for('home_bp.formRegistrarPublicacion') }}\" data-kid=\"2-1-2-2-2\" id=\"formRegistrarPublicacion\" method=\"POST\">\n                    <div class=\"form-grid\" data-kid=\"2-1-2-2-2-1\">\n                        <div class=\"field field-wide\" data-kid=\"2-1-2-2-2-1-1\">\n                            <label data-kid=\"2-1-2-2-2-1-1-1\" for=\"titulo_publicacion\">\n                                Título de la publicación\n                                <span class=\"required\" data-kid=\"2-1-2-2-2-1-1-1-1\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"input-group\" data-kid=\"2-1-2-2-2-1-1-2\">\n                                <span class=\"input-icon\" data-kid=\"2-1-2-2-2-1-1-2-1\">\n                                    <i class=\"bi bi-card-text\" data-kid=\"2-1-2-2-2-1-1-2-1-1\">\n                                    </i>\n                                </span>\n                                <input class=\"control\" data-kid=\"2-1-2-2-2-1-1-2-2\" data-name=\"publication title input field\" id=\"titulo_publicacion\" name=\"titulo_publicacion\" placeholder=\"Título impactante y descriptivo\" required=\"\" type=\"text\" value=\"Rehabilitación vial avanza en el municipio Iribarren\"/>\n                            </div>\n                        </div>\n                        <div class=\"field\" data-kid=\"2-1-2-2-2-1-2\">\n                            <label data-kid=\"2-1-2-2-2-1-2-1\" for=\"nombre_responsable\">\n                                Responsable\n                                <span class=\"required\" data-kid=\"2-1-2-2-2-1-2-1-1\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"input-group\" data-kid=\"2-1-2-2-2-1-2-2\">\n                                <span class=\"input-icon\" data-kid=\"2-1-2-2-2-1-2-2-1\">\n                                    <i class=\"bi bi-person-badge\" data-kid=\"2-1-2-2-2-1-2-2-1-1\">\n                                    </i>\n                                </span>\n                                <input class=\"control\" data-kid=\"2-1-2-2-2-1-2-2-2\" data-name=\"responsible name input field\" id=\"nombre_responsable\" name=\"nombre_responsable\" placeholder=\"Nombre del responsable\" required=\"\" type=\"text\" value=\"María González\"/>\n                            </div>\n                        </div>\n                        <div class=\"field\" data-kid=\"2-1-2-2-2-1-3\">\n                            <label data-kid=\"2-1-2-2-2-1-3-1\" for=\"fecha_publicacion\">\n                                Fecha de emisión\n                                <span class=\"required\" data-kid=\"2-1-2-2-2-1-3-1-1\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"input-group\" data-kid=\"2-1-2-2-2-1-3-2\">\n                                <span class=\"input-icon\" data-kid=\"2-1-2-2-2-1-3-2-1\">\n                                    <i class=\"bi bi-calendar-event\" data-kid=\"2-1-2-2-2-1-3-2-1-1\">\n                                    </i>\n                                </span>\n                                <input class=\"control\" data-kid=\"2-1-2-2-2-1-3-2-2\" data-name=\"publication date input field\" id=\"fecha_publicacion\" name=\"fecha_publicacion\" required=\"\" type=\"date\" value=\"2026-09-10\"/>\n                            </div>\n                        </div>\n                        <div class=\"field field-wide\" data-kid=\"2-1-2-2-2-1-4\">\n                            <label data-kid=\"2-1-2-2-2-1-4-1\" for=\"informe_avance_obra_id_informe\">\n               