                <div class=\"evidence-strip\" data-kid=\"4-1-2-3-2-3\">\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-2-3-1\">\n                            <img alt=\"Evidencia antes del informe 103\" data-kid=\"4-1-2-3-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/2.jpeg\"/>\n                            <span class=\"stage-badge stage-before\" data-kid=\"4-1-2-3-2-3-1-2\">\n                                ANTES\n                            </span>\n                        </div>\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-2-3-2\">\n                            <img alt=\"Evidencia durante del informe 103\" data-kid=\"4-1-2-3-2-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/4.jpeg\"/>\n                            <span class=\"stage-badge stage-during\" data-kid=\"4-1-2-3-2-3-2-2\">\n                                DURANTE\n                            </span>\n                        </div>\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-2-3-3\">\n                            <img alt=\"Evidencia después del informe 103\" data-kid=\"4-1-2-3-2-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                            <span class=\"stage-badge stage-after\" data-kid=\"4-1-2-3-2-3-3-2\">\n                                DESPUÉS\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article aria-pressed=\"false\" class=\"report-card\" data-id=\"102\" data-kid=\"4-1-2-3-3\" data-name=\"report card item\" data-search=\"102 informe mayor urbanismo plaza bolivar culminacion\" data-type=\"Informe Mayor\" role=\"button\" tabindex=\"0\">\n                    <span class=\"report-check\" data-kid=\"4-1-2-3-3-1\">\n                        <i class=\"bi bi-check-lg\" data-kid=\"4-1-2-3-3-1-1\">\n                        </i>\n                    </span>\n                    <div class=\"report-card-top\" data-kid=\"4-1-2-3-3-2\">\n                        <div class=\"report-meta-line\" data-kid=\"4-1-2-3-3-2-1\">\n                            <span class=\"report-number\" data-kid=\"4-1-2-3-3-2-1-1\">\n                                #102\n                            </span>\n                            <span class=\"report-type\" data-kid=\"4-1-2-3-3-2-1-2\">\n                                Informe Mayor\n                            </span>\n                        </div>\n                        <h4 data-kid=\"4-1-2-3-3-2-2\">\n                            Plaza Bolívar · Urbanismo\n                        </h4>\n                        <div class=\"report-facts\" data-kid=\"4-1-2-3-3-2-3\">\n                            <span class=\"report-fact\" data-kid=\"4-1-2-3-3-2-3-1\">\n                                <i class=\"bi bi-calendar3\" data-kid=\"4-1-2-3-3-2-3-1-1\">\n                                </i>\n                                <span data-kid=\"4-1-2-3-3-2-3-1-2\">\n                                    28 ago 2026\n                                </span>\n                            </span>\n                            <span class=\"report-fact report-status\" data-kid=\"4-1-2-3-3-2-3-2\">\n                                <span class=\"status-dot\" data-kid=\"4-1-2-3-3-2-3-2-1\">\n                                </span>\n                                <span data-kid=\"4-1-2-3-3-2-3-2-2\">\n                                    En Ejecución\n                                </span>\n                            </span>\n                        </div>\n                        <p class=\"report-description\" data-kid=\"4-1-2-3-3-2-4\">\n                            Avance de la intervención urbana y recuperación de áreas verdes, mobiliario y accesibilidad del espacio público.\n                        </p>\n                        <div class=\"progress-track\" data-kid=\"4-1-2-3-3-2-5\">\n                            <div class=\"progress-fill\" data-kid=\"4-1-2-3-3-2-5-1\" style=\"width: 81%\">\n                            </div>\n                        </div>\n                        <div class=\"report-progress-row\" data-kid=\"4-1-2-3-3-2-6\">\n                            <span data-kid=\"4-1-2-3-3-2-6-1\">\n                                Avance de obra\n                            </span>\n                            <strong data-kid=\"4-1-2-3-3-2-6-2\">\n                                81%\n                            </strong>\n                        </div>\n                    </div>\n                    <div class=\"evidence-strip\" data-kid=\"4-1-2-3-3-3\">\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-3-3-1\">\n                            <img alt=\"Evidencia antes del informe 102\" data-kid=\"4-1-2-3-3-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/3.jpeg\"/>\n                            <span class=\"stage-badge stage-before\" data-kid=\"4-1-2-3-3-3-1-2\">\n                                ANTES\n                            </span>\n                        </div>\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-3-3-2\">\n                            <img alt=\"Evidencia durante del informe 102\" data-kid=\"4-1-2-3-3-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/1.jpeg\"/>\n                            <span class=\"stage-badge stage-during\" data-kid=\"4-1-2-3-3-3-2-2\">\n                                DURANTE\n                            </span>\n                        </div>\n                        <div class=\"evidence-thumb\" data-kid=\"4-1-2-3-3-3-3\">\n                            <img alt=\"Evidencia después del informe 102\" data-kid=\"4-1-2-3-3-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/static/img/4.jpeg\"/>\n                            <span class=\"stage-badge stage-after\" data-kid=\"4-1-2-3-3-3-3-2\">\n                                DESPUÉS\n                            </span>\n                            <span class=\"thumb-more\" data-kid=\"4-1-2-3-3-3-3-3\">\n                                +4\n                            </span>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </div>\n        <footer class=\"modal-footer\" data-kid=\"4-1-3\">\n            <button class=\"btn btn-cancel\" data-kid=\"4-1-3-1\" id=\"cancelModal\" type=\"button\">\n                Cancelar\n            </button>\n            <button class=\"btn btn-link-report\" data-dynamic=\"true\" data-kid=\"4-1-3-2\" data-name=\"confirm report selection button\" data-reason=\"disabled state toggled dynamically based on selection\" id=\"confirmReport\" type=\"button\">\n                <i class=\"bi bi-link-45deg\" data-kid=\"4-1-3-2-1\">\n                </i>\n                Vincular informe seleccionado\n            </button>\n        </footer>\n    </section>\n</div>\n<script>\n    (() => {\n    const modal = document.getElementById('reportModal');\n    const backdrop = document.getElementById('modalBackdrop');\n    const trigger = document.getElementById('reportTrigger');\n    const close = document.getElementById('closeModal');\n    const cancel = document.getElementById('cancelModal');\n    const confirm = document.getElementById('confirmReport');\n    const hiddenInput = document.getElementById('informe_avance_obra_id_informe');\n    const selectedCount = document.getElementById('selectedCount').querySelector('span');\n    const label = document.getElementById('selectedReportLabel');\n    const meta = document.getElementById('selectedReportMeta');\n    const cards = [...document.querySelectorAll('.report-card')];\n    const search = document.getElementById('reportSearch');\n    const typeFilter = document.getElementById('reportTypeFilter');\n\n    const openModal = () => {\n      modal.hidden = false;\n      backdrop.hidden = false;\n      document.body.style.overflow = 'hidden';\n      close.focus();\n    };\n    const closeModal = () => {\n      modal.hidden = true;\n      backdrop.hidden = true;\n      document.body.style.overflow = '';\n      trigger.focus();\n    };\n    const refreshCount = () => {\n      const selected = cards.filter(card => card.classList.contains('selected')).length;\n      selectedCount.textContent = `${selected} seleccionado${selected === 1 ? '' : 's'}`;\n      confirm.disabled = selected === 0;\n    };\n    const selectCard = card => {\n      cards.forEach(item => {\n        item.classList.remove('selected');\n        item.setAttribute('aria-pressed', 'false');\n      });\n      card.classList.add('selected');\n      card.setAttribute('aria-pressed', 'true');\n      refreshCount();\n    };\n    const applyFilters = () => {\n      const query = search.value.trim().toLowerCase();\n      const type = typeFilter.value;\n      cards.forEach(card => {\n        const matchesQuery = !query || card.dataset.search.includes(query);\n        const matchesType = type === 'all' || card.dataset.type === type;\n        card.style.display = matchesQuery && matchesType ? '' : 'none';\n      });\n    };\n\n    trigger.addEventListener('click', openModal);\n    close.addEventListener('click', closeModal);\n    cancel.addEventListener('click', closeModal);\n    backdrop.addEventListener('click', closeModal);\n    document.addEventListener('keydown', event => {\n      if (event.key === 'Escape' && !modal.hidden) closeModal();\n    });\n    cards.forEach(card => {\n      card.addEventListener('click', () => selectCard(card));\n      card.addEventListener('keydown', event => {\n        if (event.key === 'Enter' || event.key === ' ') {\n          event.preventDefault();\n          selectCard(card);\n        }\n      });\n    });\n    search.addEventListener('input', applyFilters);\n    typeFilter.addEventListener('change', applyFilters);\n    confirm.addEventListener('click', () => {\n      const chosen = cards.find(card => card.classList.contains('selected'));\n      if (!chosen) return;\n      hiddenInput.value = chosen.dataset.id;\n      label.textContent = `Informe #${chosen.dataset.id} · ${chosen.dataset.type}`;\n      meta.textContent = 'Informe vinculado · evidencias listas para publicar';\n      closeModal();\n    });\n    refreshCount();\n  })();\n</script>\n",
