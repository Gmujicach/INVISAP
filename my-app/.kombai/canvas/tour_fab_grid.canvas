-name=\"help question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-11-1-2-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-11-1-2-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n</div>\n<div class=\"spec\" data-kid=\"1-1-12\" data-name=\"dark active state specimen cell\">\n<div class=\"stage dark\" data-kid=\"1-1-12-1\" data-mode=\"active\" data-name=\"dark active system guide stage\">\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-12-1-1\" data-name=\"dark active system guide menu panel\" role=\"menu\">\n<div class=\"panel-in\" data-kid=\"1-1-12-1-1-1\" data-name=\"dark active guide panel content container\">\n<p class=\"panel-head\" data-kid=\"1-1-12-1-1-1-1\" data-name=\"system guide panel title\">Guía del sistema</p>\n<button class=\"tile tile-start\" data-kid=\"1-1-12-1-1-1-2\" data-name=\"start guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-map\" data-kid=\"1-1-12-1-1-1-2-1\" data-name=\"map icon\"></i><span class=\"tile-label\" data-kid=\"1-1-12-1-1-1-2-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-12-1-1-1-3\" data-name=\"stop guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-12-1-1-1-3-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-12-1-1-1-3-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Detener guía del sistema\" class=\"fab\" data-kid=\"1-1-12-1-2\" data-name=\"dark active system guide floating action button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-12-1-2-1\" data-name=\"floating button icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-12-1-2-1-1\" data-name=\"help question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-12-1-2-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-12-1-2-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n</div>\n</div>\n</div>\n<script>\n  document.querySelectorAll('.stage').forEach(function (stage) {\n    var fab = stage.querySelector('.fab');\n    fab.addEventListener('click', function (e) {\n      e.preventDefault();\n      e.stopPropagation();\n      var open = stage.classList.toggle('is-open');\n      fab.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n    stage.addEventListener('click', function (e) {\n      if (e.target.closest('.panel')) return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n    });\n    stage.addEventListener('keydown', function (e) {\n      if (e.key !== 'Escape') return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n      fab.focus();\n    });\n  });\n  window.addEventListener('load', function () {\n    document.querySelectorAll('.stage[data-autoopen]').forEach(function (stage, i) {\n      setTimeout(function () { stage.classList.add('is-open'); }, 220 + i * 140);\n    });\n  });\n</script>\n",
