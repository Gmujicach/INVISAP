      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n  *,*::before,*::after{box-sizing:border-box}\n  body{margin:0;background:#fff;font-family:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;color:#1f2a37;-webkit-font-smoothing:antialiased}\n\n  .band{padding:32px 0 36px}\n  .band-light{background:#eaf0ea}\n  .band-dark{background:#232333}\n  .wrap{width:1012px;margin:0 auto}\n  .group-label{margin:0 0 18px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#87978b}\n  .band-dark .group-label{color:#7f819a}\n  .grid{display:grid;grid-template-columns:repeat(3,320px);gap:26px}\n  .spec{margin:0;display:flex;flex-direction:column;gap:10px}\n  .cap{margin:0;font-size:12px;font-weight:500;color:#7d8b80}\n  .band-dark .cap{color:#8f92a8}\n\n  .stage{position:relative;width:320px;height:264px;border-radius:14px;background:#f9fbf9;\n    box-shadow:inset 0 0 0 1px #dee8de,inset 0 2px 6px rgba(24,45,30,.05);overflow:hidden}\n  .stage.dark{background:#1c1d2b;box-shadow:inset 0 0 0 1px #32334a,inset 0 2px 8px rgba(0,0,0,.35)}\n\n  .ring{position:absolute;right:11px;bottom:11px;z-index:2;width:68px;height:68px;transform:rotate(-90deg);pointer-events:none}\n  .ring circle{fill:none;stroke-width:2;stroke-linecap:round}\n  .ring-base{stroke:rgba(8,179,36,.22)}\n  .ring-prog{stroke:#08b324;stroke-dasharray:201;stroke-dashoffset:201;transition:stroke-dashoffset .5s cubic-bezier(.3,.8,.3,1) .05s}\n  .stage.is-open .ring-prog{stroke-dashoffset:0}\n  .stage.dark .ring-base{stroke:rgba(53,209,82,.28)}\n  .stage.dark .ring-prog{stroke:#35d152}\n  .stage[data-mode=\"active\"] .ring-base{stroke:rgba(220,53,69,.5)}\n  .stage[data-mode=\"active\"] .ring-prog{stroke:#dc3545;stroke-dashoffset:201}\n  .stage[data-mode=\"active\"].is-open .ring-prog{stroke-dashoffset:0}\n\n  .fab{position:absolute;right:16px;bottom:16px;z-index:3;width:58px;height:58px;padding:0;border-radius:50%;\n    border:2px solid rgba(255,255,255,.55);background:linear-gradient(135deg,#08b324 0%,#059b1f 100%);color:#fff;\n    box-shadow:0 4px 12px rgba(8,179,36,.35);cursor:pointer;display:flex;align-items:center;justify-content:center;\n    transition:transform .24s cubic-bezier(.2,.8,.2,1),box-shadow .24s ease,background .24s ease}\n  .fab:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(8,179,36,.45)}\n  .fab:active{transform:scale(.96)}\n  .fab:focus-visible{outline:3px solid rgba(8,179,36,.32);outline-offset:4px}\n  .glyph{position:relative;display:block;width:100%;height:100%}\n  .glyph i{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.45rem;line-height:1;\n    transition:opacity .16s ease,transform .3s cubic-bezier(.2,.8,.2,1)}\n  .glyph .i-x{opacity:0;transform:rotate(-70deg) scale(.65)}\n  .glyph .i-stop{opacity:0;font-size:.95rem}\n  .stage.is-open .glyph .i-q{opacity:0;transform:rotate(70deg) scale(.65)}\n  .stage.is-open .glyph .i-x{opacity:1;transform:none}\n  .stage[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#dc3545 0%,#a71d2a 100%);box-shadow:0 4px 14px rgba(220,53,69,.42)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-q{opacity:0;transform:scale(.65)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-stop{opacity:1}\n  .stage.dark .fab{background:linear-gradient(135deg,#059b1f 0%,#047a18 100%);box-shadow:0 4px 14px rgba(0,0,0,.45)}\n  .stage.dark[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#c82333 0%,#a71d2a 100%)}\n\n  .panel{position:absolute;right:86px;bottom:16px;z-index:2;width:96px;padding:6px;\n    background:#fff;border:1px solid #dbe6dc;border-radius:12px;\n    box-shadow:0 14px 28px -16px rgba(20,38,28,.45);\n    transform-origin:100% 80%;transform:translateX(8px) scale(.96);opacity:0;visibility:hidden;pointer-events:none;\n    transition:transform .26s cubic-bezier(.2,.9,.24,1),opacity .18s ease,visibility 0s linear .26s}\n  .stage.is-open .panel{transform:none;opacity:1;visibility:visible;pointer-events:auto;\n    transition:transform .26s cubic-bezier(.2,.9,.24,1),opacity .18s ease,visibility 0s}\n  .stage.dark .panel{background:#2b2c40;border-color:#3a3b53;box-shadow:0 14px 28px -14px rgba(0,0,0,.7)}\n\n  .tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;width:100%;height:88px;padding:0;\n    background:#fcfdfc;border:1px solid #e7efe8;border-radius:8px;color:#1f2a37;cursor:pointer;\n    opacity:0;transform:translateX(10px);\n    transition:opacity .2s ease,transform .28s cubic-bezier(.2,.9,.24,1),border-color .18s ease,background .18s ease}\n  .stage.is-open .tile{opacity:1;transform:none;transition-delay:.06s}\n  .tile i{font-size:22px;line-height:1;color:#a9b6ad;transform:scale(.94);\n    transition:color .22s ease .1s,transform .28s cubic-bezier(.2,.9,.24,1) .1s}\n  .stage.is-open .tile i{color:#08b324;transform:none}\n  .tile-label{font-size:11px;font-weight:600;line-height:1.1;opacity:0;transform:translateY(3px);\n    transition:opacity .16s ease,transform .2s ease}\n  .stage.is-open .tile-label{opacity:1;transform:none;transition-delay:.18s}\n  .tile:hover{border-color:#08b324;background:#f6fdf7}\n  .tile:focus-visible{outline:2px solid rgba(8,179,36,.45);outline-offset:2px}\n  .tile-stop{display:none}\n  .stage[data-mode=\"active\"] .tile-start{display:none}\n  .stage[data-mode=\"active\"] .tile-stop{display:flex}\n  .stage.is-open .tile-stop i{color:#dc3545}\n  .tile-stop:hover{border-color:#dc3545;background:#fff6f7}\n  .stage.dark .tile{background:#2f3047;border-color:#414361;color:#fff}\n  .stage.dark.is-open .tile i{color:#35d152}\n  .stage.dark.is-open .tile-stop i{color:#ff6b78}\n  .stage.dark .tile:hover{background:#35364f;border-color:#35d152}\n  .stage.dark .tile-stop:hover{border-color:#dc3545}\n\n  /* Placa mecanizada: marco, asiento hundido y ventana de lampara */\n  .panel{width:108px;padding:5px;border-radius:3px;border-color:#cddcd0;\n    background:linear-gradient(180deg,#ffffff 0%,#f7fbf7 100%);\n    box-shadow:0 12px 24px -16px rgba(20,38,28,.5),inset 0 1px 0 #fff}\n  .stage.dark .panel{background:linear-gradient(180deg,#2b2c40 0%,#262739 100%);border-color:#3b3d55;\n    box-shadow:0 12px 24px -14px rgba(0,0,0,.75),inset 0 1px 0 #3c3e56}\n  .tile{height:92px;border-radius:2px;background:#f2f7f2;border-color:#e0eae0;box-shadow:inset 0 1px 3px rgba(24,45,30,.07)}\n  .stage.dark .tile{background:#232436;border-color:#363851;box-shadow:inset 0 1px 3px rgba(0,0,0,.35)}\n  .tile i{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;font-size:19px;\n    background:#f8fbf8;box-shadow:inset 0 0 0 1px #d6e3d8}\n  .stage.dark .tile i{background:#26273a;box-shadow:inset 0 0 0 1px #414361}\n  .stage.is-open .tile i{color:#08b324;background:#f1fbf2;box-shadow:inset 0 0 0 1px #9fdcae,0 0 0 3px rgba(8,179,36,.1)}\n  .stage.dark.is-open .tile i{color:#35d152;background:#1f2c24;box-shadow:inset 0 0 0 1px #2c7a41,0 0 0 3px rgba(53,209,82,.08)}\n  .stage.is-open .tile-stop i{color:#dc3545;background:#fff4f5;box-shadow:inset 0 0 0 1px #f0b7bd,0 0 0 3px rgba(220,53,69,.09)}\n  .stage.dark.is-open .tile-stop i{color:#ff6b78;background:#2f2330;box-shadow:inset 0 0 0 1px #7a3b45,0 0 0 3px rgba(255,107,120,.08)}\n</style>\n<div class=\"board\" data-kid=\"1\" data-name=\"guide system demo board\">\n<section class=\"band band-light\" data-kid=\"1-1\" data-name=\"light theme demo band\">\n<div class=\"wrap\" data-kid=\"1-1-1\" data-name=\"light theme demo wrapper\">\n<p class=\"group-label\" data-kid=\"1-1-1-1\" data-name=\"light band group label\">Claro</p>\n<div class=\"grid\" data-kid=\"1-1-1-2\" data-name=\"light theme state demo grid\">\n<figure class=\"spec\" data-kid=\"1-1-1-2-1\" data-name=\"closed state demo figure\">\n<div class=\"stage\" data-kid=\"1-1-1-2-1-1\" data-name=\"closed state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"closed state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"closed state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-1-1-2-1-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-1-1-2-1-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-1-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-1-2-1-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-1-2-1-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-1-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-1-2-1-1-3\" data-name=\"guide toggle floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-1-2-1-1-3-1\" data-name=\"guide toggle icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-1-2-1-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-1-2-1-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-1-2-1-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-1-1-2-1-2\" data-name=\"closed state caption\">Cerrado</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-1-1-2-2\" data-name=\"open state demo figure\">\n<div class=\"stage\" data-autoopen=\"\" data-kid=\"1-1-1-2-2-1\" data-name=\"open state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"open state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"open state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-1-1-2-2-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-1-1-2-2-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-2-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-1-2-2-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-1-2-2-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-2-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-1-2-2-1-3\" data-name=\"guide toggle floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-1-2-2-1-3-1\" data-name=\"guide toggle icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-1-2-2-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-1-2-2-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-1-2-2-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-1-1-2-2-2\" data-name=\"open state caption\">Abierto</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-1-1-2-3\" data-name=\"active state demo figure\">\n<div class=\"stage\" data-kid=\"1-1-1-2-3-1\" data-mode=\"active\" data-name=\"active state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"active state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"active state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-1-1-2-3-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-1-1-2-3-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-3-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-1-2-3-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-1-2-3-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-1-2-3-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Detener guía del sistema\" class=\"fab\" data-kid=\"1-1-1-2-3-1-3\" data-name=\"stop guide floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-1-2-3-1-3-1\" data-name=\"stop guide icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-1-2-3-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-1-2-3-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-1-2-3-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-1-1-2-3-2\" data-name=\"active state caption\">En curso</figcaption>\n</figure>\n</div>\n</div>\n</section>\n<section class=\"band band-dark\" data-kid=\"1-2\" data-name=\"dark theme demo band\">\n<div class=\"wrap\" data-kid=\"1-2-1\" data-name=\"dark theme demo wrapper\">\n<p class=\"group-label\" data-kid=\"1-2-1-1\" data-name=\"dark band group label\">Oscuro</p>\n<div class=\"grid\" data-kid=\"1-2-1-2\" data-name=\"dark theme state demo grid\">\n<figure class=\"spec\" data-kid=\"1-2-1-2-1\" data-name=\"closed state demo figure\">\n<div class=\"stage dark\" data-kid=\"1-2-1-2-1-1\" data-name=\"closed state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"closed state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"closed state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-2-1-2-1-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-1-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-2-1-2-1-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-1-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-2-1-2-1-1-3\" data-name=\"guide toggle floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-2-1-2-1-1-3-1\" data-name=\"guide toggle icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-2-1-2-1-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-1-2-1-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-1-2-1-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-1-2-1-2\" data-name=\"closed state caption\">Cerrado</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-2-1-2-2\" data-name=\"open state demo figure\">\n<div class=\"stage dark\" data-autoopen=\"\" data-kid=\"1-2-1-2-2-1\" data-name=\"open state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"open state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"open state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-2-1-2-2-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-2-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-2-1-2-2-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-2-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"guide toggle floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-2-1-2-2-1-3-1\" data-name=\"guide toggle icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-2-1-2-2-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-1-2-2-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-1-2-2-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-1-2-2-2\" data-name=\"open state caption\">Abierto</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-2-1-2-3\" data-name=\"active state demo figure\">\n<div class=\"stage dark\" data-kid=\"1-2-1-2-3-1\" data-mode=\"active\" data-name=\"active state guide stage\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"active state progress ring decoration\" viewbox=\"0 0 68 68\"><circle class=\"ring-base\" cx=\"34\" cy=\"34\" r=\"32\"></circle><circle class=\"ring-prog\" cx=\"34\" cy=\"34\" r=\"32\"></circle></svg>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"active state guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-2-1-2-3-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-signpost-2\" data-kid=\"1-2-1-2-3-1-2-1-1\" data-name=\"signpost icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-3-1-2-1-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-2-1-2-3-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-2-1-2-3-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-2-1-2-3-1-2-2-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Detener guía del sistema\" class=\"fab\" data-kid=\"1-2-1-2-3-1-3\" data-name=\"stop guide floating button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-2-1-2-3-1-3-1\" data-name=\"stop guide icon wrapper\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-2-1-2-3-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-1-2-3-1-3-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-1-2-3-1-3-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-1-2-3-2\" data-name=\"active state caption\">En curso</figcaption>\n</figure>\n</div>\n</div>\n</section>\n</div>\n<script>\n  document.querySelectorAll('.stage').forEach(function (stage) {\n    var fab = stage.querySelector('.fab');\n    fab.addEventListener('click', function (e) {\n      e.preventDefault();\n      e.stopPropagation();\n      var open = stage.classList.toggle('is-open');\n      fab.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n    stage.addEventListener('click', function (e) {\n      if (e.target.closest('.panel')) return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n    });\n    stage.addEventListener('keydown', function (e) {\n      if (e.key !== 'Escape') return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n      fab.focus();\n    });\n  });\n  window.addEventListener('load', function () {\n    document.querySelectorAll('.stage[data-autoopen]').forEach(function (stage, i) {\n      setTimeout(function () { stage.classList.add('is-open'); }, 220 + i * 140);\n    });\n  });\n</script>\n",
