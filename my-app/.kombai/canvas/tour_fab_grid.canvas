      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n  *,*::before,*::after{box-sizing:border-box}\n  body{margin:0;background:#f2f4f7;font-family:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;color:#1f2a37;-webkit-font-smoothing:antialiased}\n\n  .sheet{padding:44px 40px 56px;display:flex;flex-direction:column;gap:32px}\n  .group{display:flex;flex-direction:column;gap:12px}\n  .group-label{margin:0;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#93a1ae}\n  .grid{display:grid;grid-template-columns:repeat(3,300px);gap:26px 34px;justify-content:center}\n  .spec{margin:0;display:flex;flex-direction:column;gap:10px}\n  .cap{margin:0;font-size:12px;font-weight:500;color:#7b8794}\n\n  .stage{position:relative;width:300px;height:252px;background:#fff;border:1px solid #e4e8ee;border-radius:16px;overflow:hidden}\n  .stage.dark{background:#232333;border-color:#35364d}\n\n  .fab{position:absolute;right:16px;bottom:16px;z-index:3;width:58px;height:58px;padding:0;border-radius:50%;\n    border:2px solid rgba(255,255,255,.55);background:linear-gradient(135deg,#08b324 0%,#059b1f 100%);color:#fff;\n    box-shadow:0 6px 16px rgba(8,179,36,.32);cursor:pointer;display:flex;align-items:center;justify-content:center;\n    transition:transform .26s cubic-bezier(.2,.8,.2,1),box-shadow .26s ease,background .26s ease}\n  .fab:hover{transform:translateY(-1px) scale(1.05);box-shadow:0 10px 22px rgba(8,179,36,.42)}\n  .fab:active{transform:scale(.96)}\n  .fab:focus-visible{outline:3px solid rgba(8,179,36,.35);outline-offset:4px}\n  .glyph{position:relative;display:block;width:100%;height:100%}\n  .glyph i{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.45rem;line-height:1;\n    transition:opacity .18s ease,transform .32s cubic-bezier(.2,.8,.2,1)}\n  .glyph .i-x{opacity:0;transform:rotate(-70deg) scale(.65)}\n  .glyph .i-stop{opacity:0;font-size:.95rem}\n  .stage.is-open .glyph .i-q{opacity:0;transform:rotate(70deg) scale(.65)}\n  .stage.is-open .glyph .i-x{opacity:1;transform:none}\n  .stage[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#dc3545 0%,#a71d2a 100%);box-shadow:0 8px 22px rgba(220,53,69,.45)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-q{opacity:0;transform:scale(.65)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-stop{opacity:1}\n\n  .leader{position:absolute;right:44px;bottom:74px;z-index:2;width:2px;height:14px;opacity:0;\n    background-image:linear-gradient(to bottom,#c3cdd8 50%,transparent 0);background-size:2px 5px;background-repeat:repeat-y;\n    transition:opacity .2s ease .12s}\n  .stage.is-open .leader{opacity:1}\n  .stage.dark .leader{background-image:linear-gradient(to bottom,#4b4d6a 50%,transparent 0)}\n\n  .panel{position:absolute;right:16px;bottom:88px;z-index:2;width:124px;padding:10px;\n    background:#fff;border:1px solid #e3e8ee;border-radius:14px 14px 6px 14px;\n    box-shadow:0 22px 44px -20px rgba(20,38,58,.4),0 2px 6px rgba(20,38,58,.06);\n    transform-origin:100% 100%;transform:translateY(8px) scale(.94);opacity:0;visibility:hidden;pointer-events:none;\n    transition:transform .3s cubic-bezier(.2,.9,.24,1),opacity .2s ease,visibility 0s linear .3s}\n  .stage.is-open .panel{transform:none;opacity:1;visibility:visible;pointer-events:auto;\n    transition:transform .3s cubic-bezier(.2,.9,.24,1),opacity .2s ease,visibility 0s}\n  .stage.dark .panel{background:#2b2c40;border-color:#3a3b53;box-shadow:0 22px 44px -20px rgba(0,0,0,.8)}\n\n  .tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:100%;height:96px;padding:0;\n    background:#fff;border:1px solid #dfe5ec;border-radius:12px;color:#1f2a37;cursor:pointer;\n    opacity:0;transform:translateY(10px);\n    transition:opacity .22s ease,transform .34s cubic-bezier(.2,.9,.24,1),border-color .18s ease,background .18s ease,box-shadow .22s ease}\n  .stage.is-open .tile{opacity:1;transform:none;transition-delay:.08s}\n  .tile i{font-size:26px;line-height:1;color:#08b324;transition:color .18s ease,transform .24s ease}\n  .tile-label{font-size:11.5px;font-weight:600;letter-spacing:.01em;line-height:1.1;opacity:0;transform:translateY(4px);\n    transition:opacity .18s ease,transform .24s ease}\n  .stage.is-open .tile-label{opacity:1;transform:none;transition-delay:.2s}\n  .tile:hover{border-color:#08b324;background:#f7fdf8;box-shadow:0 8px 18px -10px rgba(8,179,36,.6)}\n  .tile:hover i{transform:scale(1.06)}\n  .tile:focus-visible{outline:2px solid rgba(8,179,36,.5);outline-offset:2px}\n  .tile-stop{display:none}\n  .stage[data-mode=\"active\"] .tile-start{display:none}\n  .stage[data-mode=\"active\"] .tile-stop{display:flex}\n  .tile-stop i{color:#dc3545}\n  .tile-stop:hover{border-color:#dc3545;background:#fff6f7;box-shadow:0 8px 18px -10px rgba(220,53,69,.55)}\n  .stage.dark .tile{background:#2b2c40;border-color:#43455f;color:#fff}\n  .stage.dark .tile i{color:#35d152}\n  .stage.dark .tile-stop i{color:#ff6b78}\n  .stage.dark .tile:hover{background:#32334c;border-color:#35d152}\n  .stage.dark .fab{background:linear-gradient(135deg,#059b1f 0%,#047a18 100%);box-shadow:0 8px 22px rgba(0,0,0,.5)}\n  .stage.dark[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#c82333 0%,#a71d2a 100%)}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"component showcase sheet\">\n<section class=\"group\" data-kid=\"1-1\" data-name=\"light theme component group\">\n<p class=\"group-label\" data-kid=\"1-1-1\" data-name=\"section group label\">Claro</p>\n<div class=\"grid\" data-kid=\"1-1-2\" data-name=\"light theme stage grid\">\n<figure class=\"spec\" data-kid=\"1-1-2-1\" data-name=\"collapsed state spec card\">\n<div class=\"stage\" data-kid=\"1-1-2-1-1\" data-name=\"collapsible menu container in collapsed state\">\n<span aria-hidden=\"true\" class=\"leader\" data-kid=\"1-1-2-1-1-1\" data-name=\"connector leader dot for open state\"></span>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-2-1-1-2\" data-name=\"floating guide menu panel\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"start guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-compass\" data-kid=\"1-1-2-1-1-2-1-1\" data-name=\"compass icon\"></i><span class=\"tile-label\" data-kid=\"1-1-2-1-1-2-1-2\" data-name=\"menu tile label text\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"stop guide menu tile\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-2-1-1-2-2-2\" data-name=\"menu tile label text\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-2-1-1-3\" data-name=\"green circular toggle FAB button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-2-1-1-3-1\" data-name=\"FAB icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-2-1-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-2-1-1-3-1-2\" data-name=\"close X icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-2-1-1-3-1-3\" data-name=\"stop square icon in FAB\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-1-2-1-2\" data-name=\"spec card caption text\">Cerrado</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-1-2-2\" data-name=\"open state spec card\">\n<div class=\"stage\" data-autoopen=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1\" data-name=\"collapsible menu 