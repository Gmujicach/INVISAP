      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n  *,*::before,*::after{box-sizing:border-box}\n  body{margin:0;background:#f4f2ea;font-family:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;color:#26313d;-webkit-font-smoothing:antialiased}\n\n  .board{padding:40px 40px 52px}\n  .matrix{display:grid;grid-template-columns:84px 470px 470px;column-gap:26px;row-gap:22px;justify-content:center;align-items:center}\n  .col-head{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8b8371;padding-bottom:2px}\n  .row-label{font-size:12px;font-weight:600;color:#6d6759;margin:0;align-self:center}\n  .spec{margin:0}\n\n  .stage{position:relative;width:470px;height:268px;border-radius:4px;border:1px solid #e2dccc;overflow:hidden;\n    background-color:#fdfbf5;\n    background-image:linear-gradient(to right,rgba(38,49,61,.028) 1px,transparent 1px),linear-gradient(to bottom,rgba(38,49,61,.028) 1px,transparent 1px);\n    background-size:24px 24px}\n  .stage.dark{background-color:#232333;border-color:#35364d;\n    background-image:linear-gradient(to right,rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.03) 1px,transparent 1px)}\n\n  .fab{position:absolute;right:16px;bottom:16px;z-index:3;width:58px;height:58px;padding:0;border-radius:50%;\n    border:2px solid rgba(255,255,255,.55);background:linear-gradient(135deg,#08b324 0%,#059b1f 100%);color:#fff;\n    box-shadow:0 8px 20px rgba(8,179,36,.4);cursor:pointer;display:flex;align-items:center;justify-content:center;\n    transition:transform .28s cubic-bezier(.2,.85,.25,1),border-radius .28s cubic-bezier(.2,.85,.25,1),box-shadow .26s ease,background .26s ease}\n  .fab:hover{transform:translateY(-1px) scale(1.04);box-shadow:0 12px 26px rgba(8,179,36,.48)}\n  .fab:active{transform:scale(.96)}\n  .fab:focus-visible{outline:3px solid rgba(8,179,36,.35);outline-offset:4px}\n  .stage.is-open .fab{border-radius:12px;transform:scale(.94)}\n  .glyph{position:relative;display:block;width:100%;height:100%}\n  .glyph i{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.45rem;line-height:1;\n    transition:opacity .16s ease,transform .32s cubic-bezier(.2,.85,.25,1)}\n  .glyph .i-x{opacity:0;transform:rotate(-70deg) scale(.65)}\n  .glyph .i-stop{opacity:0;font-size:.95rem}\n  .stage.is-open .glyph .i-q{opacity:0;transform:rotate(70deg) scale(.65)}\n  .stage.is-open .glyph .i-x{opacity:1;transform:none}\n  .stage[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#dc3545 0%,#a71d2a 100%);box-shadow:0 8px 22px rgba(220,53,69,.44);border-color:rgba(255,255,255,.5)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-q{opacity:0;transform:scale(.65)}\n  .stage[data-mode=\"active\"]:not(.is-open) .glyph .i-stop{opacity:1}\n  .stage.dark .fab{background:linear-gradient(135deg,#059b1f 0%,#047a18 100%);box-shadow:0 8px 22px rgba(0,0,0,.5)}\n  .stage.dark[data-mode=\"active\"] .fab{background:linear-gradient(135deg,#c82333 0%,#a71d2a 100%)}\n\n  .panel{position:absolute;right:16px;bottom:90px;z-index:2;width:150px;padding:2px;background:#08b324;\n    clip-path:polygon(13px 0,100% 0,100% calc(100% - 13px),calc(100% - 13px) 100%,0 100%,0 13px);\n    transform-origin:100% 100%;transform:translateY(10px) scale(.97);opacity:0;visibility:hidden;pointer-events:none;\n    transition:transform .3s cubic-bezier(.2,.85,.25,1),opacity .2s ease,visibility 0s linear .3s}\n  .stage.is-open .panel{transform:none;opacity:1;visibility:visible;pointer-events:auto;\n    transition:transform .3s cubic-bezier(.2,.85,.25,1),opacity .2s ease,visibility 0s}\n\n  .panel-in{padding:11px 12px 13px;background:#fbfaf4;\n    clip-path:polygon(12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%,0 12px);\n    perspective:700px}\n  .stage.dark .panel-in{background:#262739}\n\n  .panel-head{margin:0 0 11px;padding-bottom:8px;border-bottom:1px dashed #ddd5c2;font-size:10.5px;font-weight:600;letter-spacing:.03em;color:#5b6673}\n  .stage.dark .panel-head{color:#aab4c6;border-bottom-color:#3f4055}\n\n  .tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:96px;height:96px;margin:0 auto;padding:0;\n    background:#fff;border:1.5px solid rgba(8,179,36,.45);border-radius:0;color:#26313d;cursor:pointer;\n    transform-origin:50% 100%;transform:translateY(14px) rotateX(16deg);opacity:0;\n    transition:opacity .22s ease,transform .34s cubic-bezier(.2,.85,.25,1),border-color .18s ease,background .18s ease}\n  .stage.is-open .tile{transform:none;opacity:1;transition-delay:.09s}\n  .tile i{font-size:27px;line-height:1;color:#08b324}\n  .tile-label{font-size:11.5px;font-weight:600;line-height:1.1;letter-spacing:.01em}\n  .tile:hover{border-color:#08b324;background:#f6fdf7}\n  .tile:focus-visible{outline:2px solid rgba(8,179,36,.55);outline-offset:3px}\n  .tile-stop{display:none}\n  .stage[data-mode=\"active\"] .tile-start{display:none}\n  .stage[data-mode=\"active\"] .tile-stop{display:flex}\n  .tile-stop{border-color:rgba(220,53,69,.45)}\n  .tile-stop i{color:#dc3545}\n  .tile-stop:hover{border-color:#dc3545;background:#fff6f7}\n  .stage.dark .tile{background:#2b2c40;border-color:rgba(53,209,82,.6);color:#eef2f7}\n  .stage.dark .tile i{color:#35d152}\n  .stage.dark .tile:hover{background:#32334c;border-color:#35d152}\n  .stage.dark .tile-stop{border-color:rgba(255,107,120,.55)}\n  .stage.dark .tile-stop i{color:#ff6b78}\n  .stage.dark .tile-stop:hover{border-color:#ff6b78;background:#35293a}\n</style>\n<div class=\"board\" data-kid=\"1\" data-name=\"guide demo board\">\n<div class=\"matrix\" data-kid=\"1-1\" data-name=\"demo state matrix grid\">\n<div data-kid=\"1-1-1\" data-name=\"empty matrix corner cell\"></div>\n<div class=\"col-head\" data-kid=\"1-1-2\" data-name=\"light theme column header\">Claro</div>\n<div class=\"col-head\" data-kid=\"1-1-3\" data-name=\"dark theme column header\">Oscuro</div>\n<p class=\"row-label\" data-kid=\"1-1-4\" data-name=\"closed state row label\">Cerrado</p>\n<div class=\"spec\" data-kid=\"1-1-5\" data-name=\"light closed state specimen cell\">\n<div class=\"stage\" data-kid=\"1-1-5-1\" data-name=\"light closed system guide stage\">\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-5-1-1\" data-name=\"light system guide menu panel\" role=\"menu\">\n<div class=\"panel-in\" data-kid=\"1-1-5-1-1-1\" data-name=\"light guide panel content container\">\n<p class=\"panel-head\" data-kid=\"1-1-5-1-1-1-1\" data-name=\"system guide panel title\">Guía del sistema</p>\n<button class=\"tile tile-start\" data-kid=\"1-1-5-1-1-1-2\" data-name=\"start guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-map\" data-kid=\"1-1-5-1-1-1-2-1\" data-name=\"map icon\"></i><span class=\"tile-label\" data-kid=\"1-1-5-1-1-1-2-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-5-1-1-1-3\" data-name=\"stop guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-5-1-1-1-3-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-5-1-1-1-3-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-5-1-2\" data-name=\"light system guide floating action button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-5-1-2-1\" data-name=\"floating button icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-5-1-2-1-1\" data-name=\"help question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-5-1-2-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-5-1-2-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n</div>\n<div class=\"spec\" data-kid=\"1-1-6\" data-name=\"dark closed state specimen cell\">\n<div class=\"stage dark\" data-kid=\"1-1-6-1\" data-name=\"dark closed system guide stage\">\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-6-1-1\" data-name=\"dark system guide menu panel\" role=\"menu\">\n<div class=\"panel-in\" data-kid=\"1-1-6-1-1-1\" data-name=\"dark guide panel content container\">\n<p class=\"panel-head\" data-kid=\"1-1-6-1-1-1-1\" data-name=\"system guide panel title\">Guía del sistema</p>\n<button class=\"tile tile-start\" data-kid=\"1-1-6-1-1-1-2\" data-name=\"start guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-map\" data-kid=\"1-1-6-1-1-1-2-1\" data-name=\"map icon\"></i><span class=\"tile-label\" data-kid=\"1-1-6-1-1-1-2-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-6-1-1-1-3\" data-name=\"stop guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-6-1-1-1-3-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-6-1-1-1-3-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-6-1-2\" data-name=\"dark system guide floating action button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-6-1-2-1\" data-name=\"floating button icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-6-1-2-1-1\" data-name=\"help question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-1-6-1-2-1-2\" data-name=\"close x icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-1-6-1-2-1-3\" data-name=\"stop square icon\"></i></span>\n</button>\n</div>\n</div>\n<p class=\"row-label\" data-kid=\"1-1-7\" data-name=\"open state row label\">Abierto</p>\n<div class=\"spec\" data-kid=\"1-1-8\" data-name=\"light open state specimen cell\">\n<div class=\"stage\" data-autoopen=\"\" data-kid=\"1-1-8-1\" data-name=\"light open system guide stage\">\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-1-8-1-1\" data-name=\"light open system guide menu panel\" role=\"menu\">\n<div class=\"panel-in\" data-kid=\"1-1-8-1-1-1\" data-name=\"light open guide panel content container\">\n<p class=\"panel-head\" data-kid=\"1-1-8-1-1-1-1\" data-name=\"system guide panel title\">Guía del sistema</p>\n<button class=\"tile tile-start\" data-kid=\"1-1-8-1-1-1-2\" data-name=\"start guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-map\" data-kid=\"1-1-8-1-1-1-2-1\" data-name=\"map icon\"></i><span class=\"tile-label\" data-kid=\"1-1-8-1-1-1-2-2\" data-name=\"start guide tile label\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-1-8-1-1-1-3\" data-name=\"stop guide tile button\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-1-8-1-1-1-3-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-1-8-1-1-1-3-2\" data-name=\"stop guide tile label\">Detener guía</span></button>\n</div>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-1-8-1-2\" data-name=\"light open system guide floating action button\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-1-8-1-2-1\" data-name=\"floating button icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-1-8-1-2-1-1\" data-name=\"help question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\"