icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-2-1-1-3-1-2\" data-name=\"close X icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-2-1-1-3-1-3\" data-name=\"stop square icon in FAB\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-2-1-2\" data-name=\"spec card caption text\">Cerrado</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-2-2-2\" data-name=\"open state spec card dark theme\">\n<div class=\"stage dark\" data-autoopen=\"\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1\" data-name=\"collapsible menu container in open state dark theme\" data-reason=\"is-open class and panel visibility applied by script on load (data-autoopen)\">\n<span aria-hidden=\"true\" class=\"leader\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1\" data-name=\"connector leader dot for open state\" data-reason=\"opacity set visible by script when is-open is added\"></span>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"floating guide menu panel dark theme true\" data-reason=\"panel visibility/transform revealed by script (data-autoopen on load)\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"start guide menu tile dark theme\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-compass\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"compass icon\"></i><span class=\"tile-label\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"menu tile label text\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"stop guide menu tile dark theme\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"menu tile label text\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Guía del sistema\" class=\"fab\" data-kid=\"1-2-2-2-1-3\" data-name=\"green circular toggle FAB button dark theme\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"FAB icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"close X icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-2-2-1-3-1-3\" data-name=\"stop square icon in FAB\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-2-2-2\" data-name=\"spec card caption text\">Abierto</figcaption>\n</figure>\n<figure class=\"spec\" data-kid=\"1-2-2-3\" data-name=\"active mode spec card dark theme\">\n<div class=\"stage dark\" data-kid=\"1-2-2-3-1\" data-mode=\"active\" data-name=\"collapsible menu container in active mode dark theme\">\n<span aria-hidden=\"true\" class=\"leader\" data-kid=\"1-2-2-3-1-1\" data-name=\"connector leader dot\"></span>\n<div aria-label=\"Guía del sistema\" class=\"panel\" data-kid=\"1-2-2-3-1-2\" data-name=\"floating guide menu panel dark theme\" role=\"menu\">\n<button class=\"tile tile-start\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"start guide menu tile dark theme\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-compass\" data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"compass icon\"></i><span class=\"tile-label\" data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"menu tile label text\">Iniciar guía</span></button>\n<button class=\"tile tile-stop\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"stop guide menu tile dark theme\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"bi bi-stop-fill\" data-kid=\"1-2-2-3-1-2-2-1\" data-name=\"stop square icon\"></i><span class=\"tile-label\" data-kid=\"1-2-2-3-1-2-2-2\" data-name=\"menu tile label text\">Detener guía</span></button>\n</div>\n<button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"Detener guía del sistema\" class=\"fab\" data-kid=\"1-2-2-3-1-3\" data-name=\"red active circular toggle FAB button dark theme\" type=\"button\">\n<span class=\"glyph\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"FAB icon glyph container\"><i aria-hidden=\"true\" class=\"bi bi-question-lg i-q\" data-kid=\"1-2-2-3-1-3-1-1\" data-name=\"question mark icon\"></i><i aria-hidden=\"true\" class=\"bi bi-x-lg i-x\" data-kid=\"1-2-2-3-1-3-1-2\" data-name=\"close X icon\"></i><i aria-hidden=\"true\" class=\"bi bi-stop-fill i-stop\" data-kid=\"1-2-2-3-1-3-1-3\" data-name=\"stop square icon in FAB\"></i></span>\n</button>\n</div>\n<figcaption class=\"cap\" data-kid=\"1-2-2-3-2\" data-name=\"spec card caption text\">En curso</figcaption>\n</figure>\n</div>\n</section>\n</div>\n<script>\n  document.querySelectorAll('.stage').forEach(function (stage) {\n    var fab = stage.querySelector('.fab');\n    fab.addEventListener('click', function (e) {\n      e.preventDefault();\n      e.stopPropagation();\n      var open = stage.classList.toggle('is-open');\n      fab.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n    stage.addEventListener('click', function (e) {\n      if (e.target.closest('.panel')) return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n    });\n    stage.addEventListener('keydown', function (e) {\n      if (e.key !== 'Escape') return;\n      stage.classList.remove('is-open');\n      fab.setAttribute('aria-expanded', 'false');\n      fab.focus();\n    });\n  });\n  window.addEventListener('load', function () {\n    document.querySelectorAll('.stage[data-autoopen]').forEach(function (stage, i) {\n      setTimeout(function () { stage.classList.add('is-open'); }, 220 + i * 140);\n    });\n  });\n</script>\n",
