      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css');\n\n  :root {\n    --invilara-verde: #2d6a4f;\n    --invilara-verde-claro: #52b788;\n    --invilara-amarillo: #ffd60a;\n    --invilara-amarillo-oscuro: #ffc300;\n    --invilara-negro: #212529;\n    --invilara-blanco: #ffffff;\n    --invilara-rojo: #dc3545;\n    --invilara-azul: #0d6efd;\n    \n    /* Dark Mode Palette */\n    --dark-bg: #232333;\n    --dark-surface: #2b2c40;\n    --dark-text: #cfcde9;\n    --dark-border: #444564;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--dark-bg);\n    color: var(--dark-text);\n  }\n\n  .dark-mode-container {\n    background-color: var(--dark-bg);\n    color: var(--dark-text);\n  }\n\n  .card-dark {\n    background-color: var(--dark-surface);\n    border: 1px solid var(--dark-border);\n    color: var(--dark-text);\n  }\n\n  .input-dark {\n    background-color: var(--dark-bg);\n    border: 1px solid var(--dark-border);\n    color: var(--dark-text);\n  }\n\n  .input-dark::placeholder {\n    color: var(--invilara-amarillo-oscuro);\n    opacity: 0.6;\n    font-style: italic;\n  }\n\n  /* Status Colors Overrides */\n  .bg-aprobados { background-color: var(--invilara-azul); }\n  .bg-culminados { background-color: var(--invilara-verde); }\n  .bg-ejecucion { background-color: var(--invilara-amarillo-oscuro); color: var(--invilara-negro); }\n\n  .table-dark {\n    border-color: var(--dark-border);\n  }\n\n  .table-dark th {\n    background-color: var(--dark-surface);\n    color: var(--dark-text);\n    border-color: var(--dark-border);\n  }\n\n  .table-dark td {\n    border-color: var(--dark-border);\n  }\n\n  .table-dark tr:hover {\n    background-color: rgba(68, 69, 100, 0.3);\n  }\n</style>\n\n<div class=\"dark-mode-container min-h-screen p-6\" data-kid=\"1\">\n  \n  <div class=\"mb-6\" data-kid=\"2\">\n    <div class=\"card-dark flex items-center justify-between p-4 rounded-sm shadow-sm\" data-kid=\"3\">\n      <h5 class=\"text-xl font-bold flex items-center gap-2 text-[var(--invilara-azul)]\" data-kid=\"4\">\n        <i class=\"bx bx-file-blank\" data-kid=\"5\"></i>\n        Informes de Avance de Obras\n      </h5>\n      <button class=\"bg-[var(--invilara-verde)] hover:bg-[var(--invilara-verde-claro)] text-white px-4 py-2 rounded-md font-semibold text-sm transition-all flex items-center gap-2\" data-kid=\"6\">\n        <i class=\"bx bx-plus\" data-kid=\"7\"></i>\n        Registrar Informe\n      </button>\n    </div>\n  </div>\n\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6\" data-kid=\"8\">\n    \n    <div class=\"card-dark rounded-xl p-6 text-center transition-transform hover:-translate-y-1\" data-kid=\"9\">\n      <h6 class=\"text-xs uppercase tracking-wider opacity-70 mb-2 flex items-center justify-center gap-1\" data-kid=\"10\">\n        <i class=\"bx bx-file\" data-kid=\"11\"></i> Total Informes\n      </h6>\n      <h3 class=\"text-4xl font-bold text-[var(--invilara-azul)]\" data-kid=\"12\">12</h3>\n    </div>\n\n    \n    <div class=\"bg-aprobados text-white rounded-xl p-6 text-center shadow-md transition-transform hover:-translate-y-1\" data-kid=\"13\">\n      <h6 class=\"text-xs uppercase tracking-wider mb-2 flex items-center justify-center gap-1\" data-kid=\"14\">\n        <i class=\"bx bx-check-circle\" data-kid=\"15\"></i> Aprobados\n      </h6>\n      <h3 class=\"text-4xl font-bold\" data-kid=\"16\">5</h3>\n    </div>\n\n    \n    <div class=\"bg-ejecucion rounded-xl p-6 text-center shadow-md transition-transform hover:-translate-y-1\" data-kid=\"17\">\n      <h6 class=\"text-xs uppercase tracking-wider mb-2 flex items-center justify-center gap-1\" data-kid=\"18\">\n        <i class=\"bx bx-time\" data-kid=\"19\"></i> En Ejecución\n      </h6>\n      <h3 class=\"text-4xl font-bold\" data-kid=\"20\">4</h3>\n    </div>\n\n    \n    <div class=\"bg-culminados text-white rounded-xl p-6 text-center shadow-md transition-transform hover:-translate-y-1\" data-kid=\"21\">\n      <h6 class=\"text-xs uppercase tracking-wider mb-2 flex items-center justify-center gap-1\" data-kid=\"22\">\n        <i class=\"bx bx-check-double\" data-kid=\"23\"></i> Culminados\n      </h6>\n      <h3 class=\"text-4xl font-bold\" data-kid=\"24\">3</h3>\n    </div>\n  </div>\n\n  \n  <div class=\"card-dark rounded-sm shadow-sm overflow-hidden mb-6\" data-kid=\"25\">\n    <div class=\"overflow-x-auto\" data-kid=\"26\">\n      <table class=\"w-full text-left table-dark border-collapse\" data-kid=\"27\">\n        <thead data-kid=\"28\">\n          <tr class=\"border-b border-[var(--dark-border)]\" data-kid=\"29\">\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"30\">#</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"31\">Tipo de Informe</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"32\">Estado</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"33\">Población Beneficiada</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"34\">% Avance</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"35\">Gerente/Inspector</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider\" data-kid=\"36\">Fecha</th>\n            <th class=\"p-4 text-xs font-semibold uppercase tracking-wider text-center\" data-kid=\"37\">Acciones</th>\n          </tr>\n        </thead>\n        <tbody class=\"divide-y divide-[var(--dark-border)]\" data-kid=\"38\">\n          <tr class=\"transition-colors\" data-kid=\"39\">\n            <td class=\"p-4 font-bold text-[var(--invilara-azul)]\" data-kid=\"40\">001</td>\n            <td class=\"p-4\" data-kid=\"41\">