      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css');\n\n  :root {\n    --invilara-verde: #2d6a4f;\n    --invilara-verde-claro: #52b788;\n    --invilara-amarillo: #ffd60a;\n    --invilara-amarillo-oscuro: #ffc300;\n    --invilara-negro: #212529;\n    --invilara-gris-claro: #e9ecef;\n    --invilara-rojo: #dc3545;\n    --invilara-azul: #0d6efd;\n    \n    /* Dark Mode Tokens */\n    --dm-bg-page: #232333;\n    --dm-bg-surface: #2b2c40;\n    --dm-text-primary: #cfcde9;\n    --dm-text-muted: #a3a1bc;\n    --dm-border: #444564;\n    --dm-input-bg: #232333;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--dm-bg-page);\n    color: var(--dm-text-primary);\n    margin: 0;\n    padding: 2rem;\n  }\n\n  .card {\n    background-color: var(--dm-bg-surface);\n    border: 1px solid var(--dm-border);\n    border-radius: 8px;\n    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);\n    overflow: hidden;\n  }\n\n  .card-header {\n    padding: 1rem 1.5rem;\n    border-bottom: 1px solid var(--dm-border);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .card-body {\n    padding: 1.5rem;\n  }\n\n  .form-label {\n    display: block;\n    font-weight: 600;\n    margin-bottom: 0.5rem;\n    font-size: 0.9rem;\n  }\n\n  .form-label.required::after {\n    content: \" *\";\n    color: var(--invilara-rojo);\n  }\n\n  .form-control, .form-select {\n    width: 100%;\n    background-color: var(--dm-input-bg);\n    border: 1px solid var(--dm-border);\n    color: var(--dm-text-primary);\n    padding: 0.75rem 1rem;\n    border-radius: 6px;\n    font-size: 0.95rem;\n    transition: all 0.2s;\n  }\n\n  .form-control:focus {\n    outline: none;\n    border-color: var(--invilara-verde);\n    box-shadow: 0 0 0 2px rgba(45, 106, 79, 0.2);\n  }\n\n  .form-control::placeholder {\n    color: var(--invilara-amarillo-oscuro);\n    opacity: 0.6;\n    font-style: italic;\n  }\n\n  .input-group {\n    display: flex;\n  }\n\n  .input-group-text {\n    background-color: var(--dm-border);\n    border: 1px solid var(--dm-border);\n    color: var(--dm-text-primary);\n    padding: 0.75rem;\n    border-radius: 6px 0 0 6px;\n    border-right: 0;\n  }\n\n  .input-group .form-control {\n    border-radius: 0 6px 6px 0;\n  }\n\n  .btn-invilara-primary {\n    background-color: var(--invilara-verde);\n    color: white;\n    padding: 0.75rem 2rem;\n    border-radius: 9999px;\n    font-weight: 600;\n    border: none;\n    cursor: pointer;\n    transition: all 0.3s;\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n  }\n\n  .btn-invilara-primary:hover {\n    background-color: var(--invilara-verde-claro);\n    transform: translateY(-1px);\n  }\n\n  .btn-outline-secondary {\n    background-color: transparent;\n    color: var(--dm-text-muted);\n    padding: 0.75rem 2rem;\n    border-radius: 9999px;\n    font-weight: 600;\n    border: 1px solid var(--dm-border);\n    cursor: pointer;\n    transition: all 0.3s;\n  }\n\n  .section-title {\n    color: var(--dm-text-muted);\n    border-bottom: 1px solid var(--dm-border);\n    padding-bottom: 0.5rem;\n    margin-bottom: 1.5rem;\n    font-size: 0.9rem;\n    font-weight: 600;\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n  }\n\n  .alert-info {\n    background-color: rgba(13, 110, 253, 0.1);\n    border: 1px solid rgba(13, 110, 253, 0.2);\n    color: #8bb9fe;\n    padding: 1rem;\n    border-radius: 6px;\n    margin-bottom: 1.5rem;\n    font-size: 0.85rem;\n  }\n\n  .file-input-wrapper {\n    border: 2px dashed var(--dm-border);\n    border-radius: 8px;\n    padding: 1.5rem;\n    text-align: center;\n    transition: border-color 0.3s;\n  }\n\n  .file-input-wrapper:hover {\n    border-color: var(--invilara-verde);\n  }\n\n  /* Custom styling for requested sections */\n  .highlight-section {\n    background-color: rgba(255, 255, 255, 0.02);\n    border-radius: 8px;\n    padding: 1rem;\n    border: 1px solid var(--dm-border);\n  }\n\n  .text-invilara-verde {\n    color: var(--invilara-verde);\n  }\n</style>\n\n<div class=\"max-w-6xl mx-auto space-y-6\" data-kid=\"1\">\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-4 gap-4 mb-6\" data-kid=\"2\">\n    <div class=\"card p-4 text-center\" data-kid=\"3\">\n      <div class=\"text-sm text-(--dm-text-muted) uppercase tracking-wider mb-1\" data-kid=\"4\"><i class=\"bx bx-file mr-1\" data-kid=\"5\"></i>Total Informes</div>\n      <div class=\"text-3xl font-bold text-blue-400\" data-kid=\"6\">24</div>\n    </div>\n    <div class=\"card p-4 text-center border-l-4 border-blue-500\" data-kid=\"7\">\n      <div class=\"text-sm text-(--dm-text-muted) uppercase tracking-wider mb-1\" data-kid=\"8\"><i class=\"bx bx-check-circle mr-1\" data-kid=\"9\"></i>Aprobados</div>\n      <div class=\"text-3xl font-bold text-blue-500\" data-kid=\"10\">12</div>\n    </div>\n    <div class=\"card p-4 text-center border-l-4 border-yellow-500\" data-kid=\"11\">\n      <div class=\"text-sm text-(--dm-text-muted) uppercase tracking-wider mb-1\" data-kid=\"12\"><i class=\"bx bx-time mr-1\" data-kid=\"13\"></i>En Ejecución</div>\n      <div class=\"text-3xl font-bold text-yellow-500\" data-kid=\"14\">8</div>\n    </div>\n    <div class=\"card p-4 text-center border-l-4 border-[#2d6a4f]\" data-kid=\"15\">\n      <div class=\"text-sm text-(--dm-text-muted) uppercase tracking-wider mb-1\" data-kid=\"16\"><i class=\"bx bx-check-double mr-1\" data-kid=\"17\"></i>Culminados</div>\n      <div class=\"text-3xl font-bold text-[#2d6a4f]\" data-kid=\"18\">4</div>\n    </div>\n  </div>\n\n  <div class=\"card shadow-lg\" data-kid=\"19\">\n    <div class=\"card-header bg-[#2d6a4f] text-white\" data-kid=\"20\">\n      <h5 class=\"m-0 flex items-center gap-2 text-lg font-bold\" data-kid=\"21\">\n        <i class=\"bx bx-file-blank\" data-kid=\"22\"></i> Registrar Informe de Avance de Obra\n      </h5>\n    </div>\n\n    <div class=\"card-body\" data-kid=\"23\">\n      <form id=\"formInformeAvance\" data-kid=\"24\">\n        \n        \n        <div class=\"section-title\" data-kid=\"25\">\n          <i class=\"bx bx-info-circle\" data-kid=\"26\"></i> Información Básica del Informe\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\" data-kid=\"27\">\n          <div data-kid=\"28\">\n            <label class=\"form-label required\" data-kid=\"29\">Tipo de Informe</label>\n            <select class=\"form-select\" data-kid=\"30\">\n              <option disabled data-kid=\"31\">Seleccione el tipo de informe...</option>\n              <option selected data-kid=\"32\">Ficha Inspección Técnica</option>\n              <option data-kid=\"33\">Informe Menor</option>\n              <option data-kid=\"34\">Informe Mayor</option>\n              <option data-kid=\"35\">Avance Mensual</option>\n            </select>\n            <p class=\"mt-1 text-xs text-(--dm-text-muted)\" data-kid=\"36\">Seleccione el tipo según la naturaleza del avance</p>\n          </div>\n\n          <div data-kid=\"37\">\n            <label class=\"form-label required\" data-kid=\"38\">Estado de la Obra</label>\n            <select class=\"form-select\" data-kid=\"39\">\n              <option disabled data-kid=\"40\">Seleccione el estado actual...</option>\n              <option selected data-kid=\"41\">⏳ En Ejecución</option>\n              <option data-kid=\"42\">✓ Aprobado</option>\n              <option data-kid=\"43\">✓✓ Culminado</option>\n              <option data-kid=\"44\">⏸ Paralizado</option>\n            </select>\n            <p class=\"mt-1 text-xs text-(--dm-text-muted)\" data-kid=\"45\">Estado actual de la obra o proyecto</p>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-6\" data-kid=\"46\">\n          <div class=\"md:col-span-2\" data-kid=\"47\">\n            <label class=\"form-label required\" data-kid=\"48\">Población Beneficiada</label>\n            <input type=\"text\" class=\"form-control\" placeholder=\"Ej: Comunidad La Salle, Sector El Cuji (aprox. 500 familias)\" data-kid=\"49\">\n            <p class=\"mt-1 text-xs text-(--dm-text-muted)\" data-kid=\"50\">Describa la población o comunidad beneficiada (3-200 caracteres)</p>\n          </div>\n\n          <div data-kid=\"51\">\n            <label class=\"form-label\" data-kid=\"52\">% de Avance</label>\n            <div class=\"input-group\" data-kid=\"53\">\n              <span class=\"input-group-text\" data-kid=\"54\">%</span>\n              <input type=\"number\" class=\"form-control\" value=\"45\" min=\"0\" max=\"100\" data-kid=\"55\">\n            </div>\n            <p class=\"mt-1 text-xs text-(--dm-text-muted)\" data-kid=\"56\">Porcentaje de avance (0-100)</p>\n          </div>\n        </div>\n\n        \n        <div class=\"section-title\" data-kid=\"57\">\n          <i class=\"bx bx-user\" data-kid=\"58\"></i> Responsable del Informe\n        </div>\n\n        <div class=\"mb-6\" data-kid=\"59\">\n          <label class=\"form-label required\" data-kid=\"60\">Gerente o Inspector Responsable</label>\n          <select class=\"form-select\" data-kid=\"61\">\n            <option selected data-kid=\"62\">Juan Pérez - Inspector de Obras (Gerencia Técnica)</option>\n            <option data-kid=\"63\">María García - Gerente de Infraestructura</option>\n          </select>\n        </div>\n\n        \n        <div class=\"section-title\" data-kid=\"64\">\n          <i class=\"bx bx-edit\" data-kid=\"65\"></i> Observaciones Técnicas\n        </div>\n\n        <div class=\"mb-6 highlight-section\" data-kid=\"66\">\n          <label class=\"form-label\" data-kid=\"67\">Observaciones del Inspector</label>\n          <textarea class=\"form-control min-h-[120px]\" placeholder=\"Describa las observaciones técnicas captadas en campo, incidencias, recomendaciones, estado de materiales, avance de trabajos, etc. (Máximo 500 caracteres)\" data-kid=\"68\"></textarea>\n          <p class=\"mt-1 text-xs text-(--dm-text-muted)\" data-kid=\"69\">Campo opcional para detalles técnicos adicionales</p>\n        </div>\n\n        \n        <div class=\"section-title\" data-kid=\"70\">\n          <i class=\"bx bx-camera\" data-kid=\"71\"></i> Evidencias Fotográficas (Antes, Durante, Después)\n        </div>\n\n        <div class=\"alert-info\" data-kid=\"72\">\n          <i class=\"bx bx-info-circle\" data-kid=\"73\"></i>\n          <strong data-kid=\"74\">Importante:</strong> Máximo 5 imágenes por etapa. Las imágenes serán comprimidas automáticamente.\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-8\" data-kid=\"75\">\n          <div class=\"highlight-section space-y-3\" data-kid=\"76\">\n            <label class=\"form-label flex items-center gap-2\" data-kid=\"77\"><i class=\"bx bx-image-add text-invilara-verde\" data-kid=\"78\"></i> Fotos ANTES</label>\n            <div class=\"file-input-wrapper\" data-kid=\"79\">\n              <i class=\"bx bx-cloud-upload text-3xl text-(--dm-text-muted) mb-2\" data-kid=\"80\"></i>\n              <div class=\"text-xs text-(--dm-text-muted)\" data-kid=\"81\">Arrastre o haga clic para subir</div>\n              <input type=\"file\" class=\"hidden\" id=\"fileAntes\" data-kid=\"82\">\n            </div>\n          </div>\n\n          <div class=\"highlight-section space-y-3\" data-kid=\"83\">\n            <label class=\"form-label flex items-center gap-2\" data-kid=\"84\"><i class=\"bx bx-image-add text-invilara-verde\" data-kid=\"85\"></i> Fotos DURANTE</label>\n            <div class=\"file-input-wrapper\" data-kid=\"86\">\n              <i class=\"bx bx-cloud-upload text-3xl text-(--dm-text-muted) mb-2\" data-kid=\"87\"></i>\n              <div class=\"text-xs text-(--dm-text-muted)\" data-kid=\"88\">Arrastre o haga clic para subir</div>\n              <input type=\"file\" class=\"hidden\" id=\"fileDurante\" data-kid=\"89\">\n            </div>\n          </div>\n\n          <div class=\"highlight-section space-y-3\" data-kid=\"90\">\n            <label class=\"form-label flex items-center gap-2\" data-kid=\"91\"><i class=\"bx bx-image-add text-invilara-verde\" data-kid=\"92\"></i> Fotos DESPUÉS</label>\n            <div class=\"file-input-wrapper\" data-kid=\"93\">\n              <i class=\"bx bx-cloud-upload text-3xl text-(--dm-text-muted) mb-2\" data-kid=\"94\"></i>\n              <div class=\"text-xs text-(--dm-text-muted)\" data-kid=\"95\">Arrastre o haga clic para subir</div>\n              <input type=\"file\" class=\"hidden\" id=\"fileDespues\" data-kid=\"96\">\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"pt-6 border-t border-(--dm-border) text-center space-x-4\" data-kid=\"97\">\n          <button type=\"button\" class=\"btn-invilara-primary\" data-kid=\"98\">\n            <i class=\"bx bx-save\" data-kid=\"99\"></i> Registrar Informe\n          </button>\n          <button type=\"button\" class=\"btn-outline-secondary\" data-kid=\"100\">\n            <i class=\"bx bx-x\" data-kid=\"101\"></i> Cancelar\n          </button>\n        </div>\n        \n      </form>\n    </div>\n  </div>\n</div>",
